/target
**/*.rs.bk
*.pdb

# Local developer configuration and anything holding credentials.
/.env
/.env.local
*.local.toml

# Never commit an API key or a captured token.
/secrets/

# IDE
/.idea/
/.vscode/

# Development cache for the Minecraft options tooling: client JARs, Mojang
# metadata, analyzer output, and the generated remote feed.
/tools/minecraft-options/.cache/

# Where tools/licenses/provision-tools.sh puts the pinned cargo-about and
# cargo-deny binaries. What they produce is committed; they are not.
/license-tools/
__pycache__/

tools/auto-screenshot-tool/screenshots
tools/auto-screenshot-tool/artwork
/web/static/img/ephervex/
