// The palettes the interface can be painted in, and the one shape they share.
//
// This is the only module that writes a color. Everything else reads the
// `Theme` token of the same name, which resolves through the active palette.

// Every color token `Theme` exposes, under the same name. What each one is
// for is documented on the token.
export struct ThemePalette {
    // The scheme the shipped widgets paint in under this palette.
    widget-scheme: ColorScheme,
    background: color,
    surface: color,
    field: color,
    elevated: color,
    overlay: color,
    border: color,
    bar: color,
    header-ribbon-1: color,
    header-ribbon-2: color,
    header-ribbon-3: color,
    header-ribbon-4: color,
    header-ribbon-5: color,
    header-ribbon-6: color,
    well: color,
    selection: color,
    selection-card: color,
    selection-strong: color,
    toggle-on: color,
    toggle-knob: color,
    capture-active: color,
    accent: color,
    accent-secondary: color,
    success: color,
    warning: color,
    danger: color,
    primary-fill: color,
    primary-fill-hover: color,
    on-primary: color,
    danger-fill: color,
    danger-fill-hover: color,
    text: color,
    text-secondary: color,
    text-muted: color,
    on-danger: color,
    log-error: color,
    server: color,
    modrinth: color,
    curseforge: color,
    vanilla: color,
    forge: color,
    neoforge: color,
    group-tone-1: color,
    group-tone-2: color,
    group-tone-3: color,
    group-tone-4: color,
    group-tone-5: color,
    group-tone-6: color,
    shadow: color,
    scrim: color,
    shadow-hard: color,
    border-strong: color,
    accent-primary: color,
    on-accent: color,
    state-running: color,
    state-building: color,
    state-attention: color,
    state-stopped: color,
    state-server: color,
    note-fill: color,
    danger-soft: color,
    grid-line: color,
    terminal: color,
    on-terminal: color,
    on-terminal-muted: color,
    terminal-error: color,
}

// Ephervex's own palettes. Each sets every field of `ThemePalette`.
export global BuiltInPalettes {
    // The one built-in look. Tones that are drawn as text are held dark enough to read on every surface.
    out property <ThemePalette> workbench: {
        widget-scheme: ColorScheme.light,
        background: #ebe5ff,
        surface: #ffffff,
        field: #ffffff,
        elevated: #faf8ff,
        overlay: #ffffff,
        border: #15111f1f,
        bar: #e5e0f2,
        header-ribbon-1: #00000000,
        header-ribbon-2: #00000000,
        header-ribbon-3: #00000000,
        header-ribbon-4: #00000000,
        header-ribbon-5: #00000000,
        header-ribbon-6: #00000000,
        well: #f3f0fa,
        selection: #fff7c2,
        selection-card: #fffbe3,
        selection-strong: #ffe04a,
        toggle-on: #6cefb3,
        toggle-knob: #15111f,
        capture-active: #fff7c2,
        accent: #3555da,
        accent-secondary: #6433ff,
        success: #117142,
        warning: #855b00,
        danger: #bb2c22,
        primary-fill: #ffe04a,
        primary-fill-hover: #ffe9a8,
        on-primary: #15111f,
        danger-fill: #ff9cc5,
        danger-fill-hover: #ffbfd9,
        text: #15111f,
        text-secondary: #5b5470,
        text-muted: #675e84,
        on-danger: #15111f,
        log-error: #bb2c22,
        server: #0066ac,
        modrinth: #0e7137,
        curseforge: #b5360d,
        vanilla: #4f6c2b,
        forge: #3c639f,
        neoforge: #9e4b35,
        group-tone-1: #0066ac,
        group-tone-2: #0d7143,
        group-tone-3: #756100,
        group-tone-4: #6433ff,
        group-tone-5: #c40052,
        group-tone-6: #aa4100,
        shadow: #15111f59,
        scrim: #15111f99,
        shadow-hard: #15111f,
        border-strong: #15111f,
        accent-primary: #ffe04a,
        on-accent: #15111f,
        state-running: #6cefb3,
        state-building: #c9b8ff,
        state-attention: #ff9cc5,
        state-stopped: #8bd0ff,
        state-server: #8bd0ff,
        note-fill: #fff7c2,
        danger-soft: #ffd9d5,
        grid-line: #15111f0d,
        terminal: #15111f,
        on-terminal: #e8e3f6,
        on-terminal-muted: #8e86ab,
        terminal-error: #ff8b80,
    };
}
