// The palettes the interface can be painted in, and the one shape they share.
//
// This is the only module that writes a color. Everything else reads the
// `Theme` token of the same name, which resolves through the active palette.

// Every color token `Theme` exposes, under the same name. What each one is
// for is documented on the token.
export struct ThemePalette {
    // The scheme the shipped widgets paint in under this palette.
    widget-scheme: ColorScheme,
    background: color,
    surface: color,
    field: color,
    elevated: color,
    overlay: color,
    border: color,
    bar: color,
    header-ribbon-1: color,
    header-ribbon-2: color,
    header-ribbon-3: color,
    header-ribbon-4: color,
    header-ribbon-5: color,
    header-ribbon-6: color,
    well: color,
    selection: color,
    selection-card: color,
    selection-strong: color,
    toggle-on: color,
    toggle-knob: color,
    capture-active: color,
    accent: color,
    accent-secondary: color,
    success: color,
    warning: color,
    danger: color,
    primary-fill: color,
    primary-fill-hover: color,
    on-primary: color,
    danger-fill: color,
    danger-fill-hover: color,
    text: color,
    text-secondary: color,
    text-muted: color,
    on-danger: color,
    log-error: color,
    server: color,
    modrinth: color,
    curseforge: color,
    vanilla: color,
    forge: color,
    neoforge: color,
    group-tone-1: color,
    group-tone-2: color,
    group-tone-3: color,
    group-tone-4: color,
    group-tone-5: color,
    group-tone-6: color,
    shadow: color,
    scrim: color,
    shadow-hard: color,
    border-strong: color,
    accent-primary: color,
    on-accent: color,
    state-running: color,
    state-building: color,
    state-attention: color,
    state-stopped: color,
    state-server: color,
    note-fill: color,
    danger-soft: color,
    ok-soft: color,
    grid-line: color,
    terminal: color,
    on-terminal: color,
    on-terminal-muted: color,
    terminal-error: color,
    chip-forge: color,
    chip-neoforge: color,
    chip-vanilla: color,
}

// Ephervex's own palettes. Each sets every field of `ThemePalette`.
export global BuiltInPalettes {
