// The palettes the interface can be painted in, and the one shape they share.
//
// This is the only module that writes a color. Everything else reads the
// `Theme` token of the same name, which resolves through the active palette.

// Every color token `Theme` exposes, under the same name. What each one is
// for is documented on the token.
export struct ThemePalette {
    // The scheme the shipped widgets paint in under this palette.
    widget-scheme: ColorScheme,
    background: color,
    surface: color,
    field: color,
    elevated: color,
    overlay: color,
    border: color,
    bar: color,
    well: color,
    selection: color,
    selection-card: color,
    selection-strong: color,
    toggle-on: color,
    toggle-knob: color,
    capture-active: color,
    accent: color,
    accent-secondary: color,
    success: color,
    warning: color,
    danger: color,
    primary-fill: color,
    primary-fill-hover: color,
    on-primary: color,
    danger-fill: color,
    danger-fill-hover: color,
    text: color,
    text-secondary: color,
    text-muted: color,
    on-danger: color,
    log-error: color,
    server: color,
    modrinth: color,
    curseforge: color,
    vanilla: color,
    forge: color,
    neoforge: color,
    shadow: color,
    scrim: color,
}

// Ephervex's own palettes. Each sets every field of `ThemePalette`.
export global BuiltInPalettes {
    out property <ThemePalette> dark: {
        widget-scheme: ColorScheme.dark,
        background: #101315,
        surface: #171b1e,
        field: #101315,
        elevated: #1e2428,
        overlay: #2b333a,
        border: #30373c,
        bar: #11171a,
        well: #0b0e10,
        selection: #192d32,
        selection-card: #17272c,
        selection-strong: #244a4e,
        toggle-on: #285e63,
        toggle-knob: #5dbbc3,
        capture-active: #16383e,
        accent: #5dbbc3,
        accent-secondary: #78a8c2,
        success: #62c58b,
        warning: #ddb76a,
        danger: #e06c75,
        primary-fill: #2d7d84,
        primary-fill-hover: #368b93,
        on-primary: #e8ecef,
        danger-fill: #61272e,
        danger-fill-hover: #7b3038,
        text: #e8ecef,
        text-secondary: #a6b0b6,
        text-muted: #6f797f,
        on-danger: #fff0f1,
        log-error: #ef9a9f,
        server: #a888df,
        modrinth: #1bd96a,
        curseforge: #f16436,
        vanilla: #91bd59,
        forge: #5981c0,
        neoforge: #a44e37,
        shadow: #00000080,
        scrim: #00000099,
    };
    out property <ThemePalette> light: {
        widget-scheme: ColorScheme.light,
        background: #e9edef,
        surface: #f4f7f8,
        field: #ffffff,
        elevated: #fbfcfd,
        overlay: #ffffff,
        border: #c6ced3,
        bar: #dfe5e7,
        well: #f8fafb,
        selection: #d6e9ec,
        selection-card: #dce9ec,
        selection-strong: #bfe0e3,
        toggle-on: #15707a,
        toggle-knob: #ffffff,
        capture-active: #d0eaed,
        accent: #15707a,
        accent-secondary: #2f6b8a,
        success: #1f8a51,
        warning: #8a6212,
        danger: #b3323d,
        primary-fill: #15707a,
        primary-fill-hover: #1a8691,
        on-primary: #ffffff,
        danger-fill: #f6dcdf,
        danger-fill-hover: #eec5ca,
        text: #131719,
        text-secondary: #4a565c,
        text-muted: #77838a,
        on-danger: #7d1d27,
        log-error: #b3323d,
        server: #6b45b0,
        modrinth: #109e4b,
        curseforge: #d2491b,
        vanilla: #5d8a2c,
        forge: #3a5f9c,
        neoforge: #8b3a24,
        shadow: #0000004d,
        scrim: #00000099,
    };
}
