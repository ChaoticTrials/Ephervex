// The server.properties values new servers start with.

import { ScrollView } from "std-widgets.slint";
import { AppButton, LabeledToggle } from "../components/controls.slint";
import { BodyText, Divider } from "../components/text.slint";
import { GuiI18n } from "../globals.slint";
import { ServerPropertyGroup } from "../models.slint";
import { Theme } from "../theme.slint";
import { ServerPropertyGroupCard } from "../workspace/host-settings.slint";

// The same grouped settings a server's Properties tab shows, as defaults: a
// key with one is written into every new server's file that lacks it, and a
// key without one is left to the server. Servers that exist keep their files.
export component ServerDefaultsPanel inherits VerticalLayout {
    in property <[ServerPropertyGroup]> groups;
    in property <int> edits;
    in property <bool> invalid;
    in property <bool> show-advanced;
    callback edit(string, string);
    callback choose(string, int);
    callback reset(string);
    callback advanced(bool);
    callback discard();
    callback save();
    spacing: 12px;
    HorizontalLayout { spacing: 12px; vertical-stretch: 0;
        BodyText { text: GuiI18n.text("gui-server-defaults-detail"); color: Theme.text-muted; wrap: word-wrap; horizontal-stretch: 1; }
        VerticalLayout { alignment: center; LabeledToggle { label: GuiI18n.text("gui-server-settings-advanced"); checked: root.show-advanced; sets-its-own-position: false; toggled(value) => { root.advanced(value); } } }
    }
    ScrollView {
        vertical-stretch: 1;
        viewport-width: self.visible-width;
        VerticalLayout { alignment: start; spacing: 14px; padding-right: 12px; padding-bottom: 12px;
            for group in root.groups : ServerPropertyGroupCard {
                group: group;
                edited(key, value) => { root.edit(key, value); }
                chosen(key, index) => { root.choose(key, index); }
                reset(key) => { root.reset(key); }
            }
        }
    }
    Divider { }
    HorizontalLayout { spacing: 10px; vertical-stretch: 0;
        BodyText { text: root.edits > 0 ? GuiI18n.count("gui-property-unsaved-count", root.edits) : GuiI18n.text("gui-property-no-unsaved"); color: root.edits > 0 ? Theme.accent : Theme.text-muted; vertical-alignment: center; horizontal-stretch: 1; }
        AppButton { text: GuiI18n.text("gui-discard-changes"); enabled: root.edits > 0; hint: GuiI18n.text("gui-hint-no-unsaved-changes"); clicked => { root.discard(); } }
        AppButton { text: GuiI18n.text("gui-save-changes"); tone: "primary"; enabled: root.edits > 0 && !root.invalid; hint: root.invalid ? GuiI18n.text("gui-hint-fix-property-values") : GuiI18n.text("gui-hint-no-unsaved-changes"); clicked => { root.save(); } }
    }
}
