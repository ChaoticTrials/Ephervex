// Application settings panels: provider overrides and disk usage.

import { AppButton, BusySpinner, Pill, TextField } from "../components/controls.slint";
import { BodyText, Divider, Heading, SectionTitle } from "../components/text.slint";
import { GuiI18n } from "../globals.slint";
import { DiskUsageRow, StorageGroupRow } from "../models.slint";
import { Theme } from "../theme.slint";

// One setting that ships with a default somebody may replace: what they
// typed, the default that stands while they have not, and a badge naming
// which of the two is in force.
export component OverrideCard inherits Rectangle {
    in property <string> title;
    in property <string> placeholder;
    in property <string> effective;
    in property <bool> custom;
    in-out property <string> value;
    // A save of this value is under way, so a reset would queue a second one.
    in property <bool> saving;
    callback reset();
    min-height: card.preferred-height;
    vertical-stretch: 1;
    border-radius: Theme.card-radius;
    border-width: Theme.strong-border-width;
    border-color: Theme.border-strong;
    background: Theme.surface;
    card := VerticalLayout {
        padding: 16px;
        spacing: 8px;
        HorizontalLayout { Heading { text: root.title; font-size: Theme.row-heading-size; } Rectangle { horizontal-stretch: 1; } Pill { text: root.custom ? GuiI18n.text("gui-override") : GuiI18n.text("gui-default"); tone-color: root.custom ? Theme.accent : Theme.text-secondary; } }
        HorizontalLayout { spacing: 8px; TextField { text <=> root.value; placeholder: root.placeholder; horizontal-stretch: 1; } if root.custom : AppButton { text: GuiI18n.text("gui-reset-default"); enabled: !root.saving; hint: GuiI18n.text("gui-save-in-progress-hint"); clicked => { root.reset(); } } }
        BodyText { text: GuiI18n.value(root.custom ? "gui-effective-value" : "gui-effective-default", root.effective); color: Theme.text-muted; wrap: word-wrap; }
    }
}

// How much space Ephervex's own directories hold. Global rather than per
// host: it measures the launcher's roots, not one workspace.
export component DiskUsagePanel inherits VerticalLayout {
    // "idle", "measuring", or "measured".
    in property <string> state;
    in property <string> progress;
    in property <string> total;
    in property <string> measured-at;
    in property <[DiskUsageRow]> retention;
    in property <[DiskUsageRow]> categories;
    in property <bool> incomplete;
    in property <string> incomplete-text;
    in property <[string]> unreadable;
    // The totals above no longer describe the disk, because maintenance
    // changed it since they were measured.
    in property <bool> stale;
    // What maintenance is doing: "", "inspect", "verify", "recover", "plan", or
    // "clean".
    in property <string> maintenance-busy;
    in property <string> maintenance-progress;
    in property <bool> maintenance-inspected;
    in property <string> maintenance-headline;
    in property <string> maintenance-hosts;
    in property <bool> maintenance-incomplete;
    in property <[StorageGroupRow]> maintenance-groups;
    in property <bool> maintenance-checked;
    in property <string> maintenance-integrity;
    in property <[string]> maintenance-faults;
    in property <[string]> maintenance-unchecked;
    in property <bool> maintenance-can-recover;
    // What the last recovery or cleanup did, one fact a line.
    in property <[string]> maintenance-result;
    callback refresh();
    callback stop();
    callback open-location(string, int);
    callback inspect();
    callback verify();
    callback recover();
    callback review();
    callback stop-maintenance();
    // The same four tokens, in the same order, on the stacked bar and in
    // the legend beside it, which also names each part in words.
    function retention-color(id: string) -> color {
        return id == "persistent" ? Theme.accent
            : id == "temporary" ? Theme.warning
            : id == "regenerable" ? Theme.success
            : Theme.danger;
    }
    spacing: 14px;
    HorizontalLayout {
        spacing: 10px;
        SectionTitle { title: GuiI18n.text("gui-disk-usage-title"); detail: GuiI18n.text("gui-disk-usage-detail"); horizontal-stretch: 1; }
        if root.state == "measuring" : VerticalLayout { alignment: center; AppButton { text: GuiI18n.text("gui-disk-usage-stop"); clicked => { root.stop(); } } }
        VerticalLayout { alignment: center; AppButton { text: root.state == "idle" ? GuiI18n.text("gui-disk-usage-measure") : GuiI18n.text("gui-disk-usage-refresh"); tone: "primary"; enabled: root.state != "measuring"; hint: GuiI18n.text("gui-hint-measure-running"); clicked => { root.refresh(); } } }
    }
    BodyText { text: GuiI18n.text("gui-disk-usage-metric"); color: Theme.text-secondary; wrap: word-wrap; }
    if root.state == "measuring" : HorizontalLayout {
        spacing: 8px;
        BusySpinner { width: 16px; height: 16px; }
        BodyText { text: root.progress != "" ? root.progress : GuiI18n.text("gui-disk-usage-measuring"); horizontal-stretch: 1; wrap: word-wrap; }
    }
    if root.state == "idle" : BodyText { text: root.stale ? GuiI18n.text("gui-disk-usage-stale") : GuiI18n.text("gui-disk-usage-idle"); color: root.stale ? Theme.warning : Theme.text-muted; wrap: word-wrap; }
    if root.state == "measured" : VerticalLayout {
        spacing: 14px;
        HorizontalLayout {
            spacing: 10px;
            Heading { text: GuiI18n.value("gui-disk-usage-total", root.total); horizontal-stretch: 1; }
            BodyText { text: root.measured-at; color: Theme.text-muted; vertical-alignment: center; }
        }
        if root.incomplete : Rectangle {
            border-radius: Theme.card-radius;
            border-width: Theme.strong-border-width;
            border-color: Theme.warning;
            background: Theme.surface;
            height: incomplete-body.preferred-height;
            incomplete-body := VerticalLayout {
                padding: 12px;
                spacing: 4px;
                BodyText { text: root.incomplete-text; color: Theme.warning; wrap: word-wrap; }
                for path in root.unreadable : BodyText { text: path; color: Theme.text-secondary; font-size: Theme.caption-size; wrap: word-wrap; }
            }
        }
        // The whole measurement split by whether it could be recreated.
        Rectangle {
            height: 14px;
            border-radius: 4px;
            clip: true;
            background: Theme.border;
            accessible-role: text;
            accessible-label: GuiI18n.text("gui-disk-usage-retention-bar");
            HorizontalLayout {
                for part in root.retention : Rectangle {
                    width: parent.width * part.fraction;
                    background: root.retention-color(part.id);
                }
                Rectangle { horizontal-stretch: 1; }
            }
        }
        for part in root.retention : HorizontalLayout {
            spacing: 10px;
            VerticalLayout { alignment: center; Rectangle { width: 12px; height: 12px; border-radius: 3px; background: root.retention-color(part.id); } }
            VerticalLayout {
                horizontal-stretch: 1;
                BodyText { text: part.label; }
                BodyText { text: part.detail; color: Theme.text-muted; font-size: Theme.caption-size; wrap: word-wrap; }
            }
            BodyText { text: part.size; vertical-alignment: center; }
        }
        Divider { }
        for category in root.categories : Rectangle {
            border-radius: Theme.card-radius;
            border-width: Theme.strong-border-width;
            border-color: Theme.border-strong;
            background: Theme.surface;
            height: category-body.preferred-height;
            category-body := VerticalLayout {
                padding: 12px;
                spacing: 6px;
                HorizontalLayout {
                    spacing: 10px;
                    Heading { text: category.label; font-size: Theme.row-heading-size; horizontal-stretch: 1; }
                    BodyText { text: category.size; vertical-alignment: center; }
                }
                Rectangle {
                    height: 6px;
                    border-radius: 3px;
                    background: Theme.border;
                    Rectangle { x: 0px; width: parent.width * category.fraction; height: parent.height; border-radius: 3px; background: Theme.accent; }
                }
                BodyText { text: category.detail; color: Theme.text-secondary; wrap: word-wrap; }
                for location[index] in category.locations : HorizontalLayout {
                    spacing: 8px;
                    BodyText { text: location; color: Theme.text-muted; font-size: Theme.caption-size; horizontal-stretch: 1; overflow: elide; vertical-alignment: center; }
                    AppButton { text: GuiI18n.text("gui-open-folder"); accessible-name: GuiI18n.value("gui-disk-usage-open", location); clicked => { root.open-location(category.id, index); } }
                }
            }
        }
    }
    // Maintenance of the shared, regenerable stores. Reachable whether or not a
    // measurement exists: it reads the stores and the hosts, not the totals.
    Divider { }
    SectionTitle { title: GuiI18n.text("gui-storage-maintenance-title"); detail: GuiI18n.text("gui-storage-maintenance-detail"); }
    HorizontalLayout {
        spacing: 10px;
        AppButton { text: root.maintenance-inspected ? GuiI18n.text("gui-storage-inspect-again") : GuiI18n.text("gui-storage-inspect"); enabled: root.maintenance-busy == ""; hint: GuiI18n.text("gui-storage-busy-hint"); clicked => { root.inspect(); } }
        AppButton { text: GuiI18n.text("gui-storage-verify"); enabled: root.maintenance-busy == ""; hint: GuiI18n.text("gui-storage-busy-hint"); clicked => { root.verify(); } }
        Rectangle { horizontal-stretch: 1; }
    }
    HorizontalLayout {
        spacing: 10px;
        AppButton { text: GuiI18n.text("gui-storage-recover"); enabled: root.maintenance-busy == "" && root.maintenance-can-recover; hint: root.maintenance-busy != "" ? GuiI18n.text("gui-storage-busy-hint") : GuiI18n.text("gui-storage-recover-hint"); clicked => { root.recover(); } }
        AppButton { text: GuiI18n.text("gui-storage-preview-cleanup"); tone: "primary"; enabled: root.maintenance-busy == ""; hint: GuiI18n.text("gui-storage-busy-hint"); clicked => { root.review(); } }
        Rectangle { horizontal-stretch: 1; }
    }
    if root.maintenance-busy != "" : HorizontalLayout {
        spacing: 8px;
        BusySpinner { width: 16px; height: 16px; }
        BodyText { text: root.maintenance-progress != "" ? root.maintenance-progress : GuiI18n.text("gui-storage-working"); horizontal-stretch: 1; wrap: word-wrap; }
        AppButton { text: GuiI18n.text("gui-storage-stop"); clicked => { root.stop-maintenance(); } }
    }
    if root.maintenance-result.length > 0 : Rectangle {
        border-radius: Theme.card-radius;
        border-width: Theme.strong-border-width;
        border-color: Theme.border-strong;
        background: Theme.surface;
        height: result-body.preferred-height;
        result-body := VerticalLayout {
            padding: 12px;
            spacing: 4px;
            for line in root.maintenance-result : BodyText { text: line; wrap: word-wrap; }
        }
    }
    if !root.maintenance-inspected && !root.maintenance-checked && root.maintenance-busy == "" : BodyText { text: GuiI18n.text("gui-storage-idle"); color: Theme.text-muted; wrap: word-wrap; }
    if root.maintenance-inspected : VerticalLayout {
        spacing: 10px;
        Heading { text: root.maintenance-headline; }
        BodyText { text: root.maintenance-hosts; color: Theme.text-muted; wrap: word-wrap; }
        if root.maintenance-incomplete : BodyText { text: GuiI18n.text("gui-storage-incomplete"); color: Theme.warning; wrap: word-wrap; }
        for group in root.maintenance-groups : Rectangle {
            border-radius: Theme.card-radius;
            border-width: Theme.strong-border-width;
            border-color: Theme.border-strong;
            background: Theme.surface;
            height: group-body.preferred-height;
            group-body := VerticalLayout {
                padding: 12px;
                spacing: 4px;
                HorizontalLayout {
                    spacing: 10px;
                    Heading { text: group.label; font-size: Theme.row-heading-size; horizontal-stretch: 1; }
                    BodyText { text: group.size; vertical-alignment: center; }
                }
                BodyText { text: group.detail; color: Theme.text-muted; font-size: Theme.caption-size; wrap: word-wrap; }
                for line in group.lines : BodyText { text: line; color: Theme.text-secondary; wrap: word-wrap; }
            }
        }
    }
    if root.maintenance-checked : VerticalLayout {
        spacing: 6px;
        Heading { text: root.maintenance-integrity; font-size: Theme.row-heading-size; wrap: word-wrap; }
        for fault in root.maintenance-faults : BodyText { text: fault; color: Theme.warning; font-size: Theme.caption-size; wrap: word-wrap; }
        for note in root.maintenance-unchecked : BodyText { text: note; color: Theme.text-muted; font-size: Theme.caption-size; wrap: word-wrap; }
    }

}
