// Text primitives, the hover card every surface writes with, and the hover
// notes that show it.

import { ScrollView } from "std-widgets.slint";
import { ContextTouchArea, PopupMenu } from "menus.slint";
import { GuiI18n } from "../globals.slint";
import { Theme } from "../theme.slint";

export component BodyText inherits Text {
    color: Theme.text-secondary;
    font-size: Theme.body-size;
    vertical-alignment: center;
    vertical-stretch: 0;
}

export component Heading inherits Text {
    color: Theme.text;
    font-size: Theme.heading-size;
    font-weight: 600;
    vertical-alignment: center;
    horizontal-stretch: 0;
    vertical-stretch: 0;
}

// A short heading in the display face. Only for a few words, never for body
// text, numbers in a table, or anything long enough to be read at length.
export component DisplayHeading inherits Text {
    color: Theme.text;
    font-family: Theme.heading-family;
    font-size: Theme.heading-size;
    font-weight: 600;
    vertical-alignment: center;
    horizontal-stretch: 0;
    vertical-stretch: 0;
}

export component Eyebrow inherits Text {
    color: Theme.text-muted;
    font-size: Theme.caption-size;
    font-weight: 600;
    letter-spacing: 0.7px;
    vertical-stretch: 0;
}

export component PageIntro inherits VerticalLayout {
    in property <string> title;
    in property <string> subtitle;
    spacing: 5px;
    horizontal-stretch: 1;
    DisplayHeading { text: root.title; font-size: Theme.page-title-size; }
    if root.subtitle != "" : BodyText {
        text: root.subtitle;
        color: Theme.text-secondary;
        wrap: word-wrap;
    }
}

export component SectionTitle inherits VerticalLayout {
    in property <string> title;
    in property <string> detail;
    spacing: 4px;
    DisplayHeading { text: root.title; font-size: Theme.section-size; }
    if root.detail != "" : BodyText {
        text: root.detail;
        color: Theme.text-muted;
        wrap: word-wrap;
    }
}

// A row of controls sitting side by side.
//
// A layout with no spacing puts two buttons edge to edge, which reads as one
// control. Every such row goes through this so the gap cannot be forgotten
// one row at a time.
export component ActionRow inherits HorizontalLayout {
    spacing: 8px;
}

export component Divider inherits Rectangle {
    height: 1px;
    vertical-stretch: 0;
    background: Theme.border;
}

// What a control has to say on hover: a disabled control's reason, or a
// caption or title that did not fit and could not show the rest of itself.
// Shown by `HoverNoteLayer` above the whole window, or in place by a row
// that has the room.
export component TooltipCard inherits Rectangle {
    in property <string> text;
    // The widest the card grows before its text wraps.
    in property <length> widest: 320px;
    border-radius: 6px;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.overlay;
    drop-shadow-color: Theme.shadow;
    drop-shadow-blur: 10px;
    drop-shadow-offset-y: 2px;
    width: min(root.widest, note.preferred-width + 20px);
    height: note.preferred-height + 14px;
    note := Text {
        x: 10px;
        y: 7px;
        width: parent.width - 20px;
        text: root.text;
        color: Theme.text-secondary;
        font-size: Theme.caption-size;
        wrap: word-wrap;
    }
}

// The note currently on screen, if any. One at a time: `HoverNote` fills it in
// and `HoverNoteLayer` draws it.
export global HoverNotes {
    in-out property <string> text;
    // The pointer when the note opened, in window coordinates.
    in-out property <length> pointer-x;
    in-out property <length> pointer-y;
    in-out property <bool> open;
    // Set by the note's owner while it lives and cleared by the layer's check.
    // An owner that is destroyed while its note is open (its row was
    // rebuilt) can no longer close it, so the layer closes it when the
    // owner stops answering.
    in-out property <bool> owner-alive;
    public function show(note: string, x: length, y: length) {
        HoverNotes.text = note;
        HoverNotes.pointer-x = x;
        HoverNotes.pointer-y = y;
        HoverNotes.owner-alive = true;
        HoverNotes.open = true;
    }
    public function hide() {
        HoverNotes.open = false;
    }
}

// Opens a note on hover. Placed inside a control that has a `TouchArea`, which
// passes along its hover state and pointer, so the note follows the control
// without the control owning any placement.
//
// Not the built-in `Tooltip`, which opens to the right of the pointer and is
// never moved back inside the window.
export component HoverNote inherits Rectangle {
    in property <string> text;
    in property <bool> hovered;
    // The pointer, relative to this element, which sits on the control's own
    // touch area.
    in property <length> pointer-x;
    in property <length> pointer-y;
    private property <bool> showing;
    private property <bool> wanted: root.hovered && root.text != "";
    changed wanted => {
        if !root.wanted && root.showing {
            root.showing = false;
            HoverNotes.hide();
        }
    }
    changed text => {
        if root.showing {
            HoverNotes.text = root.text;
        }
    }
    Timer {
        running: root.wanted && !root.showing;
        interval: 500ms;
        triggered => {
            root.showing = true;
            HoverNotes.show(root.text, root.absolute-position.x + root.pointer-x, root.absolute-position.y + root.pointer-y);
        }
    }
    Timer {
        running: root.showing;
        interval: 200ms;
        triggered => { HoverNotes.owner-alive = true; }
    }
}

// Draws the open note over the whole window, kept inside it. Goes last in a
// window so nothing is painted over it, and takes no input, so the controls
// below stay hoverable.
export component HoverNoteLayer inherits Rectangle {
    // From the window's edge a note keeps clear.
    private property <length> edge: 8px;
    // Below and right of the pointer, clear of the cursor image.
    private property <length> reach-x: 12px;
    private property <length> reach-y: 18px;
    Timer {
        running: HoverNotes.open;
        interval: 450ms;
        triggered => {
            if HoverNotes.owner-alive {
                HoverNotes.owner-alive = false;
            } else {
                HoverNotes.hide();
            }
        }
    }
    if HoverNotes.open : TooltipCard {
        text: HoverNotes.text;
        // Moved left when the room to the right is short, and above the
        // pointer when the room below is.
        x: max(root.edge, min(HoverNotes.pointer-x + root.reach-x, root.width - self.width - root.edge));
        y: HoverNotes.pointer-y + root.reach-y + self.height + root.edge <= root.height
            ? HoverNotes.pointer-y + root.reach-y
            : max(root.edge, HoverNotes.pointer-y - self.height - root.edge);
    }
}

// A heading that says the whole thing on hover when it had to be cut short.
//
// It owns a touch area for the press, and hands it back out again:
// without that, the strip of a card under its own title would stop
// selecting the card.
export component ElidedHeading inherits Rectangle {
    in property <string> text;
    in property <length> font-size: Theme.heading-size;
    // The width the whole text needs, for a row that wants the title to hug it.
    out property <length> text-width: title.preferred-width;
    callback clicked();
    callback double-clicked();
    // A press of the secondary button over the title, in window coordinates.
    callback context-requested(x: length, y: length);
    horizontal-stretch: 1;
    vertical-stretch: 0;
    height: title.preferred-height;
    title := Text {
        width: parent.width;
        text: root.text;
        color: Theme.text;
        font-size: root.font-size;
        font-weight: 600;
        overflow: elide;
        vertical-alignment: center;
    }
    area := ContextTouchArea {
        clicked => { root.clicked(); }
        double-clicked => { root.double-clicked(); }
        context-requested(x, y) => { root.context-requested(x, y); }
    }
    HoverNote {
        text: title.preferred-width > title.width ? root.text : "";
        hovered: area.has-hover;
        pointer-x: area.mouse-x;
        pointer-y: area.mouse-y;
    }
}

// The name of a fact in a row of name and value.
export component FactLabel inherits BodyText {
    color: Theme.text-muted;
    width: 105px;
}

export component FieldLabel inherits Text {
    color: Theme.text-secondary;
    font-size: Theme.label-size;
}

export component SelectableText inherits Rectangle {
    in property <string> text;
    in property <TextWrap> wrap: no-wrap;
    in property <string> font-family: Theme.mono-family;
    in property <length> font-size: Theme.label-size;
    // Scrolls its text, so it fills its room instead of growing with the text.
    vertical-stretch: 1;
    background: Theme.well;
    forward-focus: selectable-input;
    accessible-role: text-input;
    accessible-read-only: true;
    accessible-value: text;
    menu := PopupMenu {
        entries: [
            { id: "copy", label: GuiI18n.text("gui-copy"), disabled: root.text == "" },
            { id: "select-all", label: GuiI18n.text("gui-select-all"), disabled: root.text == "" },
        ];
        activated(id) => {
            if (id == "copy") {
                selectable-input.copy();
            } else {
                selectable-input.select-all();
            }
        }
    }
    ContextTouchArea {
        context-requested(x, y) => { menu.show-at-window(x, y); }
        FocusScope {
            // Only here to hear the menu key from the text inside. Taking
            // focus on a press would also take the press from the area
            // around it, and a Tab stop would be one the user cannot see.
            focus-on-click: false;
            focus-on-tab-navigation: false;
            key-pressed(event) => {
                if (event.text == Key.Menu) {
                    menu.show({ x: 0px, y: 0px });
                    return accept;
                }
                return reject;
            }
            selectable-scroll := ScrollView {
                viewport-width: root.wrap == TextWrap.no-wrap ? max(self.visible-width, selectable-input.preferred-width + 16px) : self.visible-width;
                viewport-height: max(self.visible-height, selectable-input.preferred-height + 16px);
                selectable-input := TextInput {
                    x: 8px; y: 8px;
                    width: root.wrap == TextWrap.no-wrap ? max(selectable-scroll.visible-width - 16px, self.preferred-width) : selectable-scroll.visible-width - 16px;
                    height: max(selectable-scroll.visible-height - 16px, self.preferred-height);
                    text: root.text;
                    color: Theme.text-secondary;
                    selection-background-color: Theme.accent;
                    selection-foreground-color: Theme.background;
                    read-only: true;
                    single-line: false;
                    wrap: root.wrap;
                    font-family: root.font-family;
                    font-size: root.font-size;
                    page-height: selectable-scroll.visible-height;
                }
            }
        }
    }
}
