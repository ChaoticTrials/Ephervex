// Buttons, fields, toggles, pills, navigation items, and the small panels built from them.

import { ScrollView } from "std-widgets.slint";
import { ContextTouchArea, PopupMenu } from "menus.slint";
import { ButtonPlate, Outlined, Plate } from "surface.slint";
import { BodyText, DisplayHeading, Heading, HoverNote } from "text.slint";
import { GuiI18n } from "../globals.slint";
import { MenuRow } from "../models.slint";
import { Theme } from "../theme.slint";

// One setting: what it is on the left, the control that changes it on the
// right, in a box of its own.
//
// The control is whatever the caller puts inside, so a dropdown and a
// switch produce the same card rather than two shapes that happen to look
// alike. Its content sets its minimum, because the description wraps to a
// different number of lines at every text scale, and it fills its row from
// there so two cards side by side end level.
export component SettingCard inherits Plate {
    in property <string> title;
    in property <string> detail;
    // Something about the setting's inputs the user should fix, if any.
    in property <string> note;
    min-height: card.preferred-height;
    vertical-stretch: 1;
    card := HorizontalLayout {
        padding: 16px;
        spacing: 20px;
        cross-axis-alignment: center;
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 5px;
            Heading { text: root.title; font-size: Theme.row-heading-size; }
            if root.detail != "" : BodyText { text: root.detail; wrap: word-wrap; }
            if root.note != "" : BodyText { text: root.note; wrap: word-wrap; color: Theme.warning; }
        }
        @children
    }
}

// Settings that belong together, in one plate with a hairline between rows.
export component SettingsGroup inherits Plate {
    height: body.preferred-height + 2 * root.outline-width;
    radius: Theme.card-radius;
    body := VerticalLayout {
        padding: root.outline-width;
        spacing: 0px;
        @children
    }
}

// One setting in a group: what it is on the left, how to change it on the
// right. The rule above it is drawn for every row but the first.
export component SettingRow inherits Rectangle {
    in property <string> title;
    in property <string> detail;
    // Something about the setting's inputs the user should fix, if any.
    in property <string> note;
    // Sets the description in the monospace face, for a path.
    in property <bool> detail-mono;
    // The width left for the control beside the text.
    out property <length> control-room: root.width - 2 * 18px - 20px - 240px * Theme.text-scale;
    // Whether the control sits under the text because it does not fit beside it.
    private property <bool> stacked: root.control-room < controls.preferred-width;
    // What checking the setting found, colored by whether it is good news.
    in property <string> verdict;
    in property <bool> verdict-ok;
    // A line of the row's own text that does something when pressed, such as
    // opening the list of problems the setting has.
    in property <string> link;
    callback link-clicked();
    min-height: card.preferred-height;
    preferred-height: card.preferred-height;
    if root.y > 0px : Rectangle { y: 0px; height: 1px; background: Theme.border; }
    card := GridLayout {
        padding-left: 18px;
        padding-right: 18px;
        padding-top: 14px;
        padding-bottom: 14px;
        spacing-horizontal: root.stacked ? 0px : 20px;
        spacing-vertical: 10px;
        VerticalLayout {
            col: 0;
            row: 0;
            alignment: center;
            horizontal-stretch: 1;
            spacing: 4px;
            Heading { text: root.title; font-size: Theme.row-heading-size; }
            if root.detail != "" : BodyText { text: root.detail; wrap: word-wrap; font-size: Theme.label-size; font-family: root.detail-mono ? Theme.mono-family : Theme.body-family; }
            if root.note != "" : BodyText { text: root.note; wrap: word-wrap; color: Theme.warning; font-size: Theme.label-size; }
            if root.verdict != "" : BodyText { text: root.verdict; wrap: word-wrap; color: root.verdict-ok ? Theme.success : Theme.danger; font-size: Theme.label-size; font-weight: 600; }
            if root.link != "" : Rectangle {
                height: link-label.preferred-height;
                accessible-role: button;
                accessible-label: root.link;
                accessible-action-default => { root.link-clicked(); }
                HorizontalLayout { alignment: start;
                    Rectangle {
                        width: link-label.preferred-width;
                        link-label := Text { text: root.link; color: Theme.accent; font-size: Theme.label-size; font-weight: 700; }
                        if link-keys.has-focus : Rectangle { y: parent.height - 2px; height: 2px; background: Theme.accent; }
                        link-keys := FocusScope {
                            key-pressed(event) => {
                                if (event.text == " " || event.text == Key.Return) {
                                    if (!event.repeat) { root.link-clicked(); }
                                    return accept;
                                }
                                return reject;
                            }
                        }
                        TouchArea { mouse-cursor: pointer; clicked => { root.link-clicked(); } }
                    }
                }
            }
        }
        controls := VerticalLayout {
            col: root.stacked ? 0 : 1;
            row: root.stacked ? 1 : 0;
            alignment: center;
            HorizontalLayout { @children }
        }
    }
}

// A focus stop with nothing to see or press, standing at the end of a region
// that Tab has to stay inside.
//
// Tab walks the window in tree order and knows nothing about what is drawn
// over what, so a dialog does not keep it from reaching the page behind.
// Edges placed around the dialog catch the walk where it would leave and
// `reached` sends it back in.
export component FocusEdge inherits FocusScope {
    in property <bool> active;
    callback reached();
    enabled: root.active;
    width: 0px;
    height: 0px;
    changed has-focus => {
        if (root.has-focus) {
            root.reached();
        }
    }
}

// The outline drawn around a control that has keyboard focus, outside the
// control and clear of its own edge, in the accent color so it stands apart
// from the ink outline every control has. Sized to the control it is placed in.
export component FocusRing inherits Rectangle {
    in property <length> ring-radius: 6px;
    // The size of the control the ring surrounds.
    in property <length> target-width;
    in property <length> target-height;
    x: -(Theme.focus-ring-offset + Theme.focus-ring-width);
    y: -(Theme.focus-ring-offset + Theme.focus-ring-width);
    width: root.target-width + 2 * (Theme.focus-ring-offset + Theme.focus-ring-width);
    height: root.target-height + 2 * (Theme.focus-ring-offset + Theme.focus-ring-width);
    border-radius: root.ring-radius + Theme.focus-ring-offset + Theme.focus-ring-width;
    border-width: Theme.focus-ring-width;
    border-color: Theme.accent;
}

// Keyboard focus for a control that the component around it draws.
//
// Laid over the control and under its `TouchArea`, so a click is still the
// pointer's and never moves focus off whatever the user was typing into. Tab
// reaches it, Enter and Space activate it, and a disabled one is skipped
// rather than focusable and inert. Every other key is left to bubble, so
// shortcuts held by a scope further out keep working while a button is
// focused.
export component KeyboardFocus inherits FocusScope {
    in property <length> ring-radius: 6px;
    callback activated();
    key-pressed(event) => {
        if (event.text == " " || event.text == Key.Return) {
            // A held key is swallowed, not repeated: one press is one action.
            // A control keeps focus when it turns disabled, so the flag is
            // read again here rather than trusted from when focus arrived.
            if (!event.repeat && root.enabled) {
                root.activated();
            }
            return accept;
        }
        return reject;
    }
    if root.has-focus && root.enabled : ring := FocusRing { target-width: root.width; target-height: root.height; ring-radius: root.ring-radius; }
}

export component AppButton inherits Rectangle {
    in property <string> text;
    // Why this button cannot be pressed, shown on hover while it is
    // disabled.
    //
    // A disabled control that says nothing is a question the user cannot
    // answer: the reason is always known here and is almost never guessable
    // from the screen. Only shown while disabled, because a button that
    // works needs no explanation.
    in property <string> hint;
    // What assistive technology hears, when the visible label is too short
    // to be unambiguous on its own. Two "Browse..." buttons in one dialog
    // read identically otherwise.
    in property <string> accessible-name: root.text;
    // How the button is filled: secondary, primary, danger, success, info or lavender.
    in property <string> tone: "secondary";
    // A glyph before the caption, drawn in the caption's color.
    in property <image> icon;
    // The shorter button, for a row of small controls.
    in property <bool> compact: false;
    in property <bool> enabled: true;
    callback clicked();
    // A press of the secondary button over the control, in window coordinates,
    // for a card that offers its menu wherever it is pressed.
    callback context-requested(x: length, y: length);
    // Why it cannot be pressed, or the whole caption when the button was
    // given less room than the caption needed. A button that works and
    // shows its label has nothing to add.
    private property <string> hover-note: !root.enabled && root.hint != ""
        ? root.hint
        : label.preferred-width > label.width ? root.text : "";
    private property <bool> pointed: area.has-hover && root.enabled;
    // The fill and the caption drawn on it come from one mapping, so a tone
    // that is not named here is the secondary look in both.
    private property <color> face-fill: root.tone == "primary" ? (root.pointed ? Theme.primary-fill-hover : Theme.primary-fill)
        : root.tone == "danger" ? (root.pointed ? Theme.danger-fill-hover : Theme.danger-fill)
        : root.tone == "success" ? Theme.state-running
        : root.tone == "info" ? Theme.state-stopped
        : root.tone == "lavender" ? Theme.state-building
        : Theme.surface;
    private property <color> caption: root.tone == "primary" ? Theme.on-primary
        : root.tone == "danger" ? Theme.on-danger
        : root.tone == "success" || root.tone == "info" || root.tone == "lavender" ? Theme.on-accent
        : Theme.text;
    // The room the glyph takes before the caption.
    private property <length> icon-extent: root.icon.width > 0 ? Theme.button-icon-size + 6px : 0px;
    // The caption's width, held to what is left of the button.
    private property <length> label-used: min(label.preferred-width, root.width - 28px - root.icon-extent);
    private property <length> content-start: (root.width - root.icon-extent - root.label-used) / 2;
    // The width the caption needs, which buttons that belong together can be
    // set to the largest of, whatever language their captions are in.
    out property <length> natural-width: max(88px, label.preferred-width + 28px + root.icon-extent);
    min-width: root.natural-width;
    height: root.compact ? Theme.button-height-small : Theme.button-height;
    horizontal-stretch: 0;
    accessible-role: button;
    accessible-label: root.accessible-name;
    accessible-enabled: enabled;
    accessible-description: !root.enabled ? root.hint : "";
    accessible-action-default => { if root.enabled { root.clicked(); } }
    ButtonPlate {
        width: root.width;
        height: root.height;
        live: root.enabled;
        hovered: area.has-hover;
        pressed: area.pressed;
        radius: root.compact ? Theme.small-radius : Theme.button-radius;
        rest-lift: root.compact ? Theme.shadow-offset-small : Theme.shadow-offset-card;
        fill: root.face-fill;
        if root.icon.width > 0 : Image {
            x: root.content-start;
            y: (parent.height - self.height) / 2;
            width: Theme.button-icon-size;
            height: Theme.button-icon-size;
            source: root.icon;
            image-fit: contain;
            colorize: root.caption;
            opacity: root.enabled ? 1 : Theme.disabled-opacity;
        }
        // Held to the button's own width and elided there. `min-width` asks
        // for room for the whole caption, but a layout that has none gives
        // less, and a Rectangle does not clip what overflows it. The full text
        // stays in `accessible-name`.
        label := Text {
            x: root.icon.width > 0 ? root.content-start + root.icon-extent : 14px;
            width: root.icon.width > 0 ? root.label-used : root.width - 28px;
            overflow: elide;
            text: root.text;
            color: root.caption;
            font-size: root.compact ? Theme.label-size : Theme.body-size;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
            opacity: root.enabled ? 1 : Theme.disabled-opacity;
        }
    }
    KeyboardFocus { width: root.width; height: root.height; enabled: root.enabled; ring-radius: Theme.button-radius; activated => { root.clicked(); } }
    // Always enabled, so a disabled button still reports hover and can
    // explain itself. The press is gated on `enabled` instead.
    area := ContextTouchArea {
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.not-allowed;
        clicked => { if root.enabled { root.clicked(); } }
        context-requested(x, y) => { root.context-requested(x, y); }
    }
    HoverNote { text: root.hover-note; hovered: area.has-hover; pointer-x: area.mouse-x; pointer-y: area.mouse-y; }
}

// A star that says whether one Minecraft release is pinned, and toggles it.
//
// Filled rather than swapped for a second glyph when it is on: an outline
// and a fill of the same shape read as one control in two states, where two
// shapes read as two controls.
export component FavoriteToggle inherits Rectangle {
    in property <bool> favorite;
    // What the star is for. A Minecraft release when `version` is set, and
    // otherwise the host named by `host-name`.
    in property <string> version;
    in property <string> host-name;
    in property <length> size: Theme.control-height;
    in property <bool> enabled: true;
    // Drawn without a plate behind it, as on a list card.
    in property <bool> flat: false;
    // Why the star cannot be pressed, shown on hover while it is disabled.
    in property <string> hint;
    callback toggled();
    // A press of the secondary button over the control, in window coordinates,
    // for a card that offers its menu wherever it is pressed.
    callback context-requested(x: length, y: length);
    // The star has no caption, so hover says what pressing it does, or why
    // it cannot be pressed.
    private property <string> hover-note: !root.enabled && root.hint != "" ? root.hint : root.accessible-label;
    width: root.size;
    height: root.size;
    accessible-role: button;
    accessible-label: root.host-name != "" ? (root.favorite ? GuiI18n.value("gui-unfavorite-host", root.host-name) : GuiI18n.value("gui-favorite-host", root.host-name)) : root.favorite ? GuiI18n.value("gui-unfavorite-version", root.version) : GuiI18n.value("gui-favorite-version", root.version);
    accessible-enabled: root.enabled;
    accessible-checkable: true;
    accessible-checked: root.favorite;
    accessible-description: !root.enabled ? root.hint : "";
    accessible-action-default => { if root.enabled { root.toggled(); } }
    // The star that is on is `warning`, darker than a pale gold so it stays
    // readable on the note fill. A flat star is the glyph alone.
    if !root.flat : Plate {
        width: root.width;
        height: root.height;
        lift: 0px;
        radius: Theme.small-radius;
        fill: root.favorite ? Theme.note-fill : Theme.surface;
        opacity: root.enabled ? 1 : Theme.disabled-opacity;
    }
    Image {
        x: root.size * 2 / 9; y: root.size * 2 / 9; width: parent.width - root.size * 4 / 9; height: parent.height - root.size * 4 / 9;
        source: root.favorite ? @image-url("../../../../assets/icons/favorite-filled.svg") : @image-url("../../../../assets/icons/favorite.svg");
        image-fit: contain;
        colorize: root.favorite ? Theme.warning : Theme.text-muted;
        opacity: root.enabled ? 1 : Theme.disabled-opacity;
    }
    KeyboardFocus { width: root.width; height: root.height; enabled: root.enabled; ring-radius: Theme.small-radius; activated => { root.toggled(); } }
    // Always enabled, so a disabled star still reports hover and can explain
    // itself. The press is gated on `enabled` instead.
    area := ContextTouchArea {
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.not-allowed;
        clicked => { if root.enabled { root.toggled(); } }
        context-requested(x, y) => { root.context-requested(x, y); }
    }
    HoverNote { text: root.hover-note; hovered: area.has-hover; pointer-x: area.mouse-x; pointer-y: area.mouse-y; }
}

export component IconButton inherits Rectangle {
    in property <image> icon;
    in property <string> accessible-name;
    // What hover says the glyph does. The accessible name unless that has to
    // carry context the eye already has, such as which pane it belongs to.
    in property <string> tooltip: root.accessible-name;
    in property <bool> enabled: true;
    // Drawn in the main action's color, for a button that stands for a state
    // that is on.
    in property <bool> active: false;
    // A count over the button's top right corner, when it is above zero.
    in property <int> badge: 0;
    // The hard shadow under the button; flat unless the caller leaves room for it.
    in property <length> lift: 0px;
    // The glyph's size, centered in the button; zero fills the button less an
    // 8px margin.
    in property <length> glyph-size: 0px;
    // Why this button cannot be pressed, shown on hover while it is
    // disabled.
    in property <string> hint;
    callback clicked();
    // A press of the secondary button over the control, in window coordinates,
    // for a card that offers its menu wherever it is pressed.
    callback context-requested(x: length, y: length);
    // A glyph alone does not say what it does, so hover names it, or gives
    // the reason while it is disabled.
    private property <string> hover-note: !root.enabled && root.hint != "" ? root.hint : root.tooltip;
    width: Theme.control-height;
    height: Theme.control-height;
    accessible-role: button;
    accessible-label: accessible-name;
    accessible-description: !root.enabled ? root.hint : "";
    accessible-enabled: enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    // Filled with the main action's color under the pointer.
    Plate {
        width: root.width;
        height: root.height;
        lift: root.lift;
        radius: Theme.small-radius;
        fill: (area.has-hover && root.enabled) || root.active ? Theme.accent-primary : Theme.surface;
        opacity: root.enabled ? 1 : Theme.disabled-opacity;
        Image { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; width: root.glyph-size > 0px ? root.glyph-size : parent.width - 16px; height: root.glyph-size > 0px ? root.glyph-size : parent.height - 16px; source: root.icon; image-fit: contain; colorize: (area.has-hover && root.enabled) || root.active ? Theme.on-accent : Theme.text; }
    }
    if root.badge > 0 : Rectangle {
        x: root.width - self.width + Theme.corner-badge-overhang;
        y: -Theme.corner-badge-overhang;
        width: max(Theme.corner-badge-size, count-text.preferred-width + 10px);
        height: Theme.corner-badge-size;
        border-radius: self.height / 2;
        border-width: Theme.chip-border-width;
        border-color: Theme.border-strong;
        background: Theme.border-strong;
        count-text := Text {
            text: "\{root.badge}";
            color: Theme.surface;
            font-family: Theme.heading-family;
            font-size: Theme.label-size;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    KeyboardFocus { width: root.width; height: root.height; enabled: root.enabled; ring-radius: Theme.small-radius; activated => { root.clicked(); } }
    // Always enabled, so a disabled button still reports hover and can
    // explain itself. The press is gated on `enabled` instead.
    area := ContextTouchArea {
        mouse-cursor: root.enabled ? MouseCursor.default : MouseCursor.not-allowed;
        clicked => { if root.enabled { root.clicked(); } }
        context-requested(x, y) => { root.context-requested(x, y); }
    }
    HoverNote { text: root.hover-note; hovered: area.has-hover; pointer-x: area.mouse-x; pointer-y: area.mouse-y; }
}

export component TextField inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <string> placeholder;
    in property <string> accessible-name: placeholder;
    in property <bool> enabled: true;
    in property <bool> invalid: false;
    in property <InputType> input-type: InputType.text;
    // A glyph before the text, such as the magnifier of a search field.
    in property <image> icon;
    // The hard shadow the field keeps while it is not focused.
    in property <length> rest-lift: 0px;
    // Takes the keyboard focus when the field appears, for one that opens
    // on a press to be typed in.
    in property <bool> focus-when-shown: false;
    // What the field is for, shown on hover where the label is not drawn.
    in property <string> note;
    callback accepted();
    callback edited(string);
    callback focus-lost();
    // Where the text starts, past the glyph when there is one.
    private property <length> text-left: root.icon.width > 0 ? 11px + Theme.button-icon-size + 7px : 11px;
    height: Theme.control-height;
    min-width: 120px;
    accessible-role: text-input;
    accessible-label: accessible-name;
    accessible-enabled: enabled;
    accessible-value: input.text;
    accessible-action-set-value(value) => {
        input.text = value;
        root.edited(value);
    }
    init => {
        if root.focus-when-shown { input.focus(); }
    }
    // The shadow grows while the field has focus, which is how focus shows.
    Plate {
        width: root.width;
        height: root.height;
        radius: Theme.small-radius;
        lift: input.has-focus ? Theme.shadow-offset-small + (root.rest-lift > 0px ? 1px : 0px) : root.rest-lift;
        outline: root.invalid ? Theme.danger : Theme.border-strong;
        fill: root.enabled ? Theme.field : Theme.well;
        animate lift { duration: 80ms; }
    }
    // The input does not scroll itself, so a value longer than the field is
    // clipped here and the viewport follows the caret.
    if root.icon.width > 0 : Image {
        x: 11px;
        y: (parent.height - self.height) / 2;
        width: Theme.button-icon-size;
        height: Theme.button-icon-size;
        source: root.icon;
        image-fit: contain;
        colorize: Theme.text-muted;
    }
    // Over the whole field, text included: the touch area is the input's
    // ancestor, so it sees the pointer before the input takes it.
    note-area := TouchArea {
        scroller := Flickable {
            x: root.text-left; width: parent.width - root.text-left - 11px; height: parent.height;
            interactive: false;
            viewport-width: max(self.width, input.preferred-width + 2px);
            input := TextInput {
                x: 0; width: max(scroller.width, self.preferred-width + 2px); height: scroller.height;
                color: root.enabled ? Theme.text : Theme.text-muted;
                font-size: Theme.body-size;
                enabled: root.enabled;
                input-type: root.input-type;
                single-line: true;
                vertical-alignment: center;
                accepted => { root.accepted(); }
                edited => { root.edited(self.text); }
                cursor-position-changed(position) => {
                    if (position.x + scroller.viewport-x < 0px) {
                        scroller.viewport-x = -position.x;
                    } else if (position.x + scroller.viewport-x > scroller.width - 2px) {
                        scroller.viewport-x = scroller.width - 2px - position.x;
                    }
                }
                // A field whose value is part of a larger draft has to be able to
                // say "I am done" without the user pressing Enter.
                changed has-focus => { if (!self.has-focus) { root.focus-lost(); } }
            }
        }
    }
    HoverNote { text: root.note; hovered: note-area.has-hover; pointer-x: note-area.mouse-x; pointer-y: note-area.mouse-y; }
    if root.text == "" : Text {
        x: root.text-left; width: parent.width - root.text-left - 11px; height: parent.height;
        text: root.placeholder;
        color: Theme.text-muted;
        font-size: Theme.body-size;
        overflow: elide;
        vertical-alignment: center;
    }
}

// A text box for many lines, such as a list of raw settings. The text wraps at
// the box's width, scrolls inside it, and the view follows the caret.
export component MultilineField inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <string> placeholder;
    in property <string> accessible-name: placeholder;
    in property <bool> enabled: true;
    callback edited(string);
    min-height: 4 * Theme.control-height;
    border-radius: 6px;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.border;
    background: Theme.field;
    accessible-role: text-input;
    accessible-label: accessible-name;
    accessible-enabled: enabled;
    scroller := ScrollView {
        x: 6px; y: 6px; width: parent.width - 12px; height: parent.height - 12px;
        viewport-width: self.visible-width;
        viewport-height: max(self.visible-height, input.preferred-height + 2px);
        input := TextInput {
            x: 5px; y: 0px;
            width: scroller.visible-width - 10px;
            height: max(scroller.visible-height, self.preferred-height);
            color: root.enabled ? Theme.text : Theme.text-muted;
            font-family: Theme.mono-family;
            font-size: Theme.body-size;
            enabled: root.enabled;
            single-line: false;
            wrap: char-wrap;
            edited => { root.edited(self.text); }
            cursor-position-changed(position) => {
                if (position.y + scroller.viewport-y < 0px) {
                    scroller.viewport-y = -position.y;
                } else if (position.y + Theme.body-size * 1.6 + scroller.viewport-y > scroller.visible-height) {
                    scroller.viewport-y = scroller.visible-height - position.y - Theme.body-size * 1.6;
                }
            }
        }
    }
    if root.text == "" : Text {
        x: 11px; y: 6px; width: parent.width - 22px;
        text: root.placeholder;
        color: Theme.text-muted;
        font-family: Theme.mono-family;
        font-size: Theme.body-size;
        wrap: char-wrap;
    }
}

export component FilterChip inherits Rectangle {
    in property <string> text;
    in property <string> accessible-name: text;
    in property <bool> selected;
    callback clicked();
    height: Theme.control-height;
    width: label.preferred-width + 24px;
    horizontal-stretch: 0;
    accessible-role: checkbox;
    accessible-label: accessible-name;
    accessible-checked: selected;
    accessible-action-default => { root.clicked(); }
    Plate {
        width: root.width;
        height: root.height;
        radius: Theme.small-radius;
        lift: root.selected ? Theme.shadow-offset-small : 0px;
        fill: root.selected ? Theme.selection-strong : area.has-hover ? Theme.elevated : Theme.surface;
        animate lift { duration: 80ms; }
        label := Text {
            text: root.text;
            color: Theme.text;
            font-size: Theme.label-size;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    KeyboardFocus { width: root.width; height: root.height; ring-radius: Theme.small-radius; activated => { root.clicked(); } }
    area := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

export component Toggle inherits Rectangle {
    in-out property <bool> checked;
    in property <bool> enabled: true;
    in property <string> accessible-name;
    // Whether clicking this switch *is* the change, or only asks for it.
    //
    // A settings switch decides its own position: the click is the change.
    // A switch that asks does not, and must not, because what it asked for
    // may be refused, or may happen to several rows at once. Its position
    // has to come from what actually happened.
    //
    // This is not a preference. Assigning to `checked` here replaces the
    // binding the caller gave it, permanently, for that one element - and a
    // repeater reuses elements, so the row would go on reporting a click
    // from minutes ago no matter what the list said.
    in property <bool> sets-its-own-position: true;
    callback toggled(bool);
    private property <float> visible-strength: root.enabled ? 1 : Theme.disabled-opacity;
    width: 42px;
    height: 24px;
    horizontal-stretch: 0;
    accessible-role: checkbox;
    accessible-checked: checked;
    accessible-enabled: enabled;
    accessible-label: accessible-name;
    accessible-action-default => { if root.enabled { root.request(); } }
    // Disabled colors mix toward the card color, not `opacity`, which renderers
    // apply per piece or per group.
    Outlined {
        radius: root.height / 2;
        snap-size: true;
        fill: (root.checked ? Theme.toggle-on : Theme.bar).mix(Theme.surface, root.visible-strength);
        outline: Theme.border-strong.mix(Theme.surface, root.visible-strength);
        Outlined {
            x: root.checked ? root.width - self.width - 4px : 4px;
            y: (root.height - self.height) / 2;
            width: 16px; height: 16px;
            radius: 8px;
            snap-size: true;
            fill: Theme.toggle-knob.mix(Theme.surface, root.visible-strength);
            outline: Theme.border-strong.mix(Theme.surface, root.visible-strength);
            animate x { duration: 100ms; }
        }
    }
    KeyboardFocus { width: root.width; height: root.height; ring-radius: root.height / 2; enabled: root.enabled; activated => { root.request(); } }
    TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.not-allowed;
        clicked => { root.request(); }
    }
    function request() {
        if root.sets-its-own-position {
            root.checked = !root.checked;
            root.toggled(root.checked);
        } else {
            root.toggled(!root.checked);
        }
    }
}

// A ring with an arc that turns while something the user is waiting on is in
// progress. The shipped spinner takes its color from the system accent, which
// no palette can set, so the one every screen shows is drawn here. Only an
// image or text can be rotated, so the arc's end points are moved instead.
export component BusySpinner inherits Rectangle {
    accessible-role: progress-indicator;
    private property <length> stroke: max(2px, root.width / 8);
    private property <angle> head: 360deg * Math.mod(animation-tick() / 1s, 1);
    private property <angle> tail: root.head + 100deg;
    Rectangle {
        border-radius: root.width / 2;
        border-width: root.stroke;
        border-color: Theme.border;
    }
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 100;
        viewbox-height: 100;
        commands: "M \{50 + 42 * Math.cos(root.head)} \{50 + 42 * Math.sin(root.head)} A 42 42 0 0 1 \{50 + 42 * Math.cos(root.tail)} \{50 + 42 * Math.sin(root.tail)}";
        stroke: Theme.accent;
        stroke-width: root.stroke;
        stroke-line-cap: round;
    }
}

// A horizontal slider whose track, fill and handle are palette colors. The
// shipped slider takes its fill from the system accent, which no palette can
// set.
//
// `value` is only ever read. A drag is held here and handed back through
// `released` when the pointer lets go, because the row a slider sits in
// re-renders whenever its value changes, and a control that took the
// caller's binding over mid-drag would lose it.
export component ValueSlider inherits Rectangle {
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    in property <float> step: 1;
    in property <float> value;
    in property <bool> enabled: true;
    callback released(float);
    private property <length> handle-size: 20px;
    private property <length> travel: root.width - root.handle-size;
    private property <float> visible-strength: root.enabled ? 1 : Theme.disabled-opacity;
    private property <bool> dragging;
    private property <float> drag-value;
    // Where on the handle a drag took hold, so grabbing it does not move it.
    private property <length> grab-offset;
    // A keyboard change, shown until the caller reports a value of its own.
    private property <bool> nudged;
    private property <float> nudged-value;
    private property <float> shown: root.dragging ? root.drag-value : root.nudged ? root.nudged-value : root.value;
    private property <float> fraction: root.maximum > root.minimum
        ? Math.clamp((root.shown - root.minimum) / (root.maximum - root.minimum), 0, 1)
        : 0;
    min-width: 80px;
    height: Theme.control-height;
    horizontal-stretch: 0;
    accessible-role: slider;
    accessible-enabled: root.enabled;
    accessible-value: "\{root.shown}";
    accessible-value-minimum: root.minimum;
    accessible-value-maximum: root.maximum;
    accessible-value-step: root.step;
    accessible-action-increment => { root.nudge(root.shown + root.step); }
    accessible-action-decrement => { root.nudge(root.shown - root.step); }
    accessible-action-set-value(value) => { root.nudge(root.snapped(value.to-float())); }
    changed value => { root.nudged = false; }

    // The value under a pointer position, held to the range and snapped to
    // the step.
    function value-at(position: length) -> float {
        let ratio = root.travel > 0px
            ? Math.clamp((position - root.handle-size / 2) / root.travel, 0, 1)
            : 0;
        return root.snapped(root.minimum + ratio * (root.maximum - root.minimum));
    }
    // A value held to the range and moved to the nearest step, so the handle
    // never rests between the values the caller stores.
    function snapped(raw: float) -> float {
        if (root.step <= 0) {
            return raw;
        }
        return Math.clamp(root.minimum + Math.round((raw - root.minimum) / root.step) * root.step, root.minimum, root.maximum);
    }
    function nudge(target: float) {
        if (!root.enabled) {
            return;
        }
        root.nudged-value = Math.clamp(target, root.minimum, root.maximum);
        root.nudged = true;
        root.released(root.nudged-value);
    }

    Outlined {
        x: root.handle-size / 2;
        width: root.width - root.handle-size;
        y: (root.height - self.height) / 2;
        height: 10px;
        radius: self.height / 2;
        snap-size: true;
        progress: root.fraction;
        fill: Theme.surface;
        progress-fill: Theme.accent-primary.mix(Theme.surface, root.visible-strength);
        outline: Theme.border-strong.mix(Theme.surface, root.visible-strength);
    }
    handle := Outlined {
        x: root.fraction * root.travel;
        y: (root.height - self.height) / 2;
        width: root.handle-size;
        height: root.handle-size;
        radius: root.handle-size / 2;
        snap-size: true;
        fill: Theme.surface;
        outline: Theme.border-strong.mix(Theme.surface, root.visible-strength);
        if keys.has-focus && root.enabled : FocusRing { target-width: handle.width; target-height: handle.height; ring-radius: root.handle-size / 2; }
    }
    keys := FocusScope {
        enabled: root.enabled;
        changed has-focus => { if (!self.has-focus) { root.nudged = false; } }
        key-pressed(event) => {
            let page = root.step * 10;
            if (event.text == Key.LeftArrow || event.text == Key.DownArrow) {
                root.nudge(root.shown - root.step);
            } else if (event.text == Key.RightArrow || event.text == Key.UpArrow) {
                root.nudge(root.shown + root.step);
            } else if (event.text == Key.PageDown) {
                root.nudge(root.shown - page);
            } else if (event.text == Key.PageUp) {
                root.nudge(root.shown + page);
            } else if (event.text == Key.Home) {
                root.nudge(root.minimum);
            } else if (event.text == Key.End) {
                root.nudge(root.maximum);
            } else {
                return reject;
            }
            return accept;
        }
        TouchArea {
            enabled: root.enabled;
            mouse-cursor: MouseCursor.pointer;
            pointer-event(event) => {
                if (event.kind == PointerEventKind.cancel) {
                    root.dragging = false;
                    return;
                }
                if (event.button != PointerEventButton.left) {
                    return;
                }
                if (event.kind == PointerEventKind.down) {
                    keys.focus();
                    let center = root.fraction * root.travel + root.handle-size / 2;
                    root.grab-offset = Math.abs(self.mouse-x - center) <= root.handle-size / 2 ? self.mouse-x - center : 0px;
                    root.drag-value = root.value-at(self.mouse-x - root.grab-offset);
                    root.dragging = true;
                } else if (event.kind == PointerEventKind.up && root.dragging) {
                    root.dragging = false;
                    root.released(root.drag-value);
                }
            }
            moved => {
                if (root.dragging) {
                    root.drag-value = root.value-at(self.mouse-x - root.grab-offset);
                }
            }
        }
    }
}

export component LabeledToggle inherits Rectangle {
    in property <string> label;
    in-out property <bool> checked;
    in property <bool> enabled: true;
    // See `Toggle`: false when the position has to come from what happened.
    in property <bool> sets-its-own-position: true;
    callback toggled(bool);
    width: 210px;
    height: 32px;
    horizontal-stretch: 0;
    HorizontalLayout { spacing: 10px;
        BodyText { text: root.label; color: root.enabled ? Theme.text-secondary : Theme.text-muted; }
        Rectangle { horizontal-stretch: 1; }
        Toggle { accessible-name: root.label; checked <=> root.checked; enabled: root.enabled; sets-its-own-position: root.sets-its-own-position; toggled(value) => { root.toggled(value); } }
    }
}

// An explicit choice a primary action waits for. The switch comes first
// and the label wraps, so a long label can never push the switch out of a
// narrow column; the label is part of the target, as a checkbox's is.
export component AcknowledgementToggle inherits Rectangle {
    in property <string> label;
    // What is recorded. Pressing asks for the opposite through `toggled`.
    in property <bool> checked;
    in property <bool> enabled: true;
    callback toggled(bool);
    height: row.preferred-height;
    row := HorizontalLayout {
        spacing: 10px;
        VerticalLayout { alignment: start; Toggle { accessible-name: root.label; checked: root.checked; enabled: root.enabled; sets-its-own-position: false; toggled(value) => { root.toggled(value); } } }
        BodyText {
            text: root.label;
            color: root.enabled ? Theme.text : Theme.text-muted;
            horizontal-stretch: 1;
            vertical-alignment: top;
            wrap: word-wrap;
            TouchArea { mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.not-allowed; clicked => { if root.enabled { root.toggled(!root.checked); } } }
        }
    }
}

// A one-line switch with its label beside it, both centered on one row.
// Pressing either asks for the opposite through `toggled`.
export component InlineToggle inherits Rectangle {
    in property <string> label;
    in property <bool> checked;
    in property <bool> enabled: true;
    callback toggled(bool);
    height: row.preferred-height;
    horizontal-stretch: 0;
    row := HorizontalLayout {
        spacing: 10px;
        alignment: start;
        VerticalLayout { alignment: center; Toggle { accessible-name: root.label; checked: root.checked; enabled: root.enabled; sets-its-own-position: false; toggled(value) => { root.toggled(value); } } }
        BodyText {
            text: root.label;
            color: root.enabled ? Theme.text : Theme.text-muted;
            vertical-alignment: center;
            TouchArea { mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.not-allowed; clicked => { if root.enabled { root.toggled(!root.checked); } } }
        }
    }
}

// Launching as somebody other than the default account.
//
// Beside Launch rather than replacing it: the common case is one account,
// and a launcher that made everyone choose every time would be worse for
// it. Choosing here applies to one launch and never changes the default,
// which is what makes it safe to use for a quick second client.
export component LaunchAsButton inherits Rectangle {
    // One row per account a launch can be made as, its id the account's.
    in property <[MenuRow]> account-entries;
    in property <bool> enabled: true;
    // Whether the instance is already running, so a launch from here is a
    // second client rather than the first.
    in property <bool> alongside;
    // Why launching cannot be started from here, shown on hover while the
    // button is disabled.
    in property <string> hint;
    // The account, and whether this is a second client alongside another.
    callback launch-as(string, bool);
    callback add-account();
    // Sized the way `AppButton` is, so a row that pairs the two splits
    // evenly instead of letting the other one absorb the slack.
    min-width: max(88px, content.preferred-width);
    height: Theme.button-height;
    horizontal-stretch: 0;
    accessible-role: button;
    accessible-label: GuiI18n.text("gui-launch-as");
    accessible-enabled: enabled;
    accessible-description: !root.enabled ? root.hint : "";
    accessible-action-default => { if root.enabled { menu.show({ x: 0, y: root.height }); } }
    menu := PopupMenu {
        choices: root.account-entries;
        entries: [
            { separator: true, hidden: root.account-entries.length == 0 },
            { id: "add-account", label: GuiI18n.text("gui-add-account") },
        ];
        chosen(id) => { root.launch-as(id, root.alongside); }
        activated => { root.add-account(); }
    }
    ButtonPlate {
        width: root.width;
        height: root.height;
        live: root.enabled;
        hovered: area.has-hover;
        pressed: area.pressed;
        content := HorizontalLayout {
            padding-left: 14px; padding-right: 14px; spacing: 5px; alignment: center;
            Text {
                text: GuiI18n.text("gui-launch-as");
                color: Theme.text;
                font-size: Theme.body-size;
                font-weight: 700;
                vertical-alignment: center;
                opacity: root.enabled ? 1 : Theme.disabled-opacity;
            }
            Text {
                text: "\u{25be}";
                color: Theme.text;
                font-size: Theme.label-size;
                vertical-alignment: center;
                opacity: root.enabled ? 1 : Theme.disabled-opacity;
            }
        }
    }
    KeyboardFocus { width: root.width; height: root.height; enabled: root.enabled; ring-radius: Theme.button-radius; activated => { menu.show({ x: 0, y: root.height }); } }
    // Declared after the menu area, so a press opens the menu rather than
    // being swallowed by the area that hosts it.
    area := TouchArea {
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.not-allowed;
        clicked => { if root.enabled { menu.show({ x: 0, y: root.height }); } }
    }
    HoverNote { text: !root.enabled ? root.hint : ""; hovered: area.has-hover; pointer-x: area.mouse-x; pointer-y: area.mouse-y; }
}

// A short label in a bordered tag. The tone colors its text, which is read on
// `surface` unless `fill` is given.
export component Pill inherits Rectangle {
    in property <string> text;
    in property <color> tone-color: Theme.text-secondary;
    // The fill, when it is not the tone's own tint, and the text on it.
    in property <brush> fill: Theme.surface;
    in property <color> caption: root.tone-color;
    // A pill normally hugs its label. Where one stands in for a control it
    // takes that control's size instead, so a column of rows does not jump
    // between the two. An explicit width on the instance cannot do this:
    // the width here is a binding on the same element and a laid-out child
    // with a bound width is fixed at it.
    in property <length> min-content-width: 0px;
    in property <length> content-height: 24px;
    // The widest a pill grows; a longer label is elided.
    in property <length> max-content-width: 10000px;
    height: root.content-height;
    width: min(root.max-content-width, max(root.min-content-width, label.preferred-width + 18px));
    horizontal-stretch: 0;
    accessible-role: AccessibleRole.text;
    accessible-label: root.text;
    border-radius: Theme.chip-radius;
    border-width: Theme.chip-border-width;
    border-color: Theme.border-strong;
    background: root.fill;
    label := Text {
        x: 9px;
        width: root.width - 18px;
        text: root.text;
        color: root.caption;
        font-size: Theme.caption-size;
        font-weight: 700;
        overflow: elide;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// A small tag in the fixed-width family, for versions and other values read
// letter by letter. `tone` is neutral, primary, server, running, building,
// attention, danger, or a loader: forge, neoforge, or vanilla.
export component Chip inherits Rectangle {
    in property <string> text;
    in property <string> tone: "neutral";
    // The width the whole text needs. A chip given less elides its text.
    out property <length> natural-width: label.preferred-width + 14px;
    // A press of the chip, passed on while it is cut short, because its hover
    // area then sits over whatever the chip is drawn on.
    callback pressed();
    callback context-requested(x: length, y: length);
    height: Theme.chip-height;
    width: root.natural-width;
    horizontal-stretch: 0;
    accessible-role: AccessibleRole.text;
    accessible-label: root.text;
    border-radius: Theme.chip-radius;
    border-width: Theme.chip-border-width;
    border-color: Theme.border-strong;
    background: root.tone == "server" ? Theme.state-server
        : root.tone == "running" ? Theme.state-running
        : root.tone == "building" ? Theme.state-building
        : root.tone == "attention" ? Theme.state-attention
        : root.tone == "primary" ? Theme.accent-primary
        : root.tone == "danger" ? Theme.danger-fill
        : root.tone == "forge" ? Theme.chip-forge
        : root.tone == "neoforge" ? Theme.chip-neoforge
        : root.tone == "vanilla" ? Theme.chip-vanilla
        : Theme.surface;
    label := Text {
        x: 7px;
        width: root.width - 14px;
        text: root.text;
        color: root.tone == "server" || root.tone == "running" || root.tone == "building" || root.tone == "attention" || root.tone == "primary" ? Theme.on-accent : root.tone == "danger" ? Theme.on-danger : Theme.text;
        font-family: Theme.mono-family;
        font-size: Theme.caption-size;
        font-weight: 600;
        overflow: elide;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    // A chip that is cut says its whole text on hover.
    if label.preferred-width > label.width : Rectangle {
        area := ContextTouchArea {
            clicked => { root.pressed(); }
            context-requested(x, y) => { root.context-requested(x, y); }
        }
        HoverNote { text: root.text; hovered: area.has-hover; pointer-x: area.mouse-x; pointer-y: area.mouse-y; }
    }
}

// The tone of a host's lifecycle state, the same wherever the host is
// drawn. A settled state takes `rest`.
export global StateTone {
    pure public function of-or(state-kind: string, rest: color) -> color {
        if (state-kind == "running") {
            return Theme.success;
        }
        if (state-kind == "failed") {
            return Theme.danger;
        }
        if (state-kind == "starting" || state-kind == "stopping" || state-kind == "restarting"
            || state-kind == "orphaned" || state-kind == "unknown" || state-kind == "needs-recovery") {
            return Theme.warning;
        }
        return rest;
    }
    pure public function of(state-kind: string) -> color {
        return of-or(state-kind, Theme.text-secondary);
    }
    // The fill of the tag that names the state: running, in progress, needing
    // attention, or settled.
    pure public function fill-of(state-kind: string) -> color {
        if (state-kind == "running") {
            return Theme.state-running;
        }
        if (state-kind == "starting" || state-kind == "stopping" || state-kind == "restarting") {
            return Theme.state-building;
        }
        if (state-kind == "failed" || state-kind == "orphaned" || state-kind == "unknown" || state-kind == "needs-recovery") {
            return Theme.state-attention;
        }
        return Theme.surface;
    }
}

// A host's lifecycle state. A restart under way reads as Restarting
// whatever the state beneath it says.
export component StatePill inherits Pill {
    in property <string> state;
    in property <string> state-kind;
    in property <bool> restarting;
    text: root.restarting ? GuiI18n.text("gui-state-restarting") : root.state;
    tone-color: StateTone.of(root.restarting ? "restarting" : root.state-kind);
    fill: StateTone.fill-of(root.restarting ? "restarting" : root.state-kind);
    caption: StateTone.fill-of(root.restarting ? "restarting" : root.state-kind) == Theme.surface ? Theme.text-secondary : Theme.on-accent;
}

// A pill that can be pressed: a short status a person can act on. It reaches
// the keyboard like a button, and says on hover what the short text leaves
// out.
export component PillButton inherits Rectangle {
    in property <string> text;
    in property <color> tone-color: Theme.text-secondary;
    // Shown on hover: what the pill stands for in full.
    in property <string> note;
    in property <string> accessible-name: root.text;
    callback clicked();
    height: 24px;
    width: label.preferred-width + 18px;
    horizontal-stretch: 0;
    border-radius: Theme.chip-radius;
    border-width: Theme.chip-border-width;
    border-color: Theme.border-strong;
    background: area.has-hover ? Theme.selection : Theme.surface;
    accessible-role: button;
    accessible-label: root.accessible-name;
    accessible-action-default => { root.clicked(); }
    label := Text {
        text: root.text;
        color: root.tone-color;
        font-size: Theme.caption-size;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    KeyboardFocus { width: root.width; height: root.height; ring-radius: Theme.chip-radius; activated => { root.clicked(); } }
    area := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
    HoverNote { text: root.note; hovered: area.has-hover; pointer-x: area.mouse-x; pointer-y: area.mouse-y; }
}

export component SettingsNavItem inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> selected;
    callback clicked();
    height: 44px;
    accessible-role: button;
    accessible-label: label;
    accessible-action-default => { root.clicked(); }
    Plate {
        width: root.width;
        height: root.height;
        radius: Theme.small-radius;
        lift: root.selected ? Theme.shadow-offset-small : 0px;
        outline: root.selected ? Theme.border-strong : transparent;
        fill: root.selected ? Theme.accent-primary : area.has-hover ? Theme.elevated : transparent;
    }
    if root.icon.width > 0 : Image {
        x: 14px;
        y: (parent.height - self.height) / 2;
        width: 18px;
        height: 18px;
        source: root.icon;
        image-fit: contain;
        colorize: root.selected ? Theme.on-accent : Theme.text;
    }
    Text {
        x: root.icon.width > 0 ? 42px : 16px;
        width: parent.width - self.x - 10px;
        height: parent.height;
        text: root.label;
        color: root.selected ? Theme.on-accent : Theme.text;
        font-size: Theme.body-size;
        font-weight: 700;
        vertical-alignment: center;
        overflow: elide;
    }
    KeyboardFocus { width: root.width; height: root.height; ring-radius: Theme.small-radius; activated => { root.clicked(); } }
    area := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// A layout at the root rather than a rectangle holding one.
//
// A layout fills the cross axis of the layout it sits in; a plain rectangle
// takes the size of its own content. This is a tab body and a panel body,
// so it has to fill: as a rectangle it turned a whole tab into a narrow
// column of centred lines while every other tab, all of them layouts,
// spanned the window.
export component EmptyState inherits VerticalLayout {
    in property <string> title;
    in property <string> message;
    // What is missing, said in a glyph as well as in the heading. The
    // neutral environment mark stands for a list this application has
    // nothing better to show, so a caller only names an icon when the
    // absent thing has one of its own.
    in property <image> icon: @image-url("../../../../assets/icons/environment-generic.svg");
    callback primary();
    callback secondary();
    in property <string> primary-text;
    in property <string> secondary-text;
    // One button over the other, for a column too narrow to hold both.
    in property <bool> stack-buttons: false;
    alignment: center;
    spacing: 10px;
    padding: 32px;
    // Centred as a block and kept to a readable measure, rather than one
    // sentence stretched across a whole window.
    HorizontalLayout {
        alignment: center;
        VerticalLayout {
        max-width: 560px;
        alignment: center; spacing: 10px;
        HorizontalLayout { alignment: center; Image { source: root.icon; width: 64px; height: 64px; image-fit: contain; colorize: Theme.text-muted; } }
        DisplayHeading { text: root.title; horizontal-alignment: center; }
        BodyText { text: root.message; horizontal-alignment: center; wrap: word-wrap; }
        Rectangle { height: 5px; }
        if !root.stack-buttons : HorizontalLayout {
            alignment: center; spacing: 8px;
            if root.secondary-text != "" : AppButton { text: root.secondary-text; clicked => { root.secondary(); } }
            if root.primary-text != "" : AppButton { text: root.primary-text; tone: "primary"; clicked => { root.primary(); } }
        }
        if root.stack-buttons : VerticalLayout {
            spacing: 10px;
            if root.primary-text != "" : HorizontalLayout { alignment: center; AppButton { text: root.primary-text; tone: "primary"; clicked => { root.primary(); } } }
            if root.secondary-text != "" : HorizontalLayout { alignment: center; AppButton { text: root.secondary-text; clicked => { root.secondary(); } } }
        }
        }
    }
}

// A list that has not arrived yet, in the space the list will take. The
// spinner is a fixed size, which a vertical layout leaves at its left edge,
// so it is centered by a row of its own.
export component LoadingState inherits VerticalLayout {
    in property <string> text;
    alignment: center;
    spacing: 10px;
    HorizontalLayout { alignment: center; BusySpinner { width: 38px; height: 38px; } }
    BodyText { text: root.text; horizontal-alignment: center; }
}

export component ToastPanel inherits Plate {
    in property <string> message;
    in property <bool> error;
    in property <int> repeats;
    callback dismiss();
    // As wide as its line, up to a limit, and taller as the line wraps.
    width: min(560px, max(280px, probe.preferred-width + 110px + (root.repeats > 1 ? 44px : 0px)));
    height: max(48px, toast-message.preferred-height + 24px);
    horizontal-stretch: 0;
    radius: Theme.button-radius;
    fill: root.error ? Theme.danger-fill : Theme.state-running;
    accessible-role: text;
    accessible-label: (root.error ? GuiI18n.text("gui-notification-error") : GuiI18n.text("gui-notification-complete")) + ": " + root.message;
    // Measures the message on one line; never drawn.
    probe := Text { visible: false; text: root.message; font-size: Theme.body-size; font-weight: 600; }
    HorizontalLayout { padding-left: 14px; padding-right: 8px; padding-top: 8px; padding-bottom: 8px; spacing: 10px; cross-axis-alignment: center;
        Image {
            source: root.error ? @image-url("../../../../assets/icons/alert.svg") : @image-url("../../../../assets/icons/check.svg");
            width: 20px;
            height: 20px;
            image-fit: contain;
            colorize: root.error ? Theme.on-danger : Theme.on-accent;
        }
        toast-message := BodyText { horizontal-stretch: 1; text: root.message; color: root.error ? Theme.on-danger : Theme.on-accent; font-weight: 600; wrap: word-wrap; }
        if root.repeats > 1 : Pill { text: GuiI18n.count("gui-notification-repeat", root.repeats); tone-color: Theme.text; fill: Theme.surface; content-height: 18px; }
        IconButton { icon: @image-url("../../../../assets/icons/close.svg"); accessible-name: GuiI18n.text("gui-dismiss-notification"); width: 28px; height: 28px; clicked => { root.dismiss(); } }
    }
}

// Mutually exclusive choices drawn as one joined bar, the chosen one filled.
export component SegmentedChoice inherits Rectangle {
    in property <[string]> options;
    in property <int> current;
    // The chosen option by its text, for a list whose position the caller does
    // not know; used when it is not empty.
    in property <string> current-value;
    in property <string> accessible-name;
    // The width the bar needs.
    out property <length> natural-width: bar.preferred-width;
    callback selected(int);
    // The text of the option pressed.
    callback chosen(string);
    // The bar pads itself by the outline, so its own width is the whole.
    width: bar.preferred-width;
    height: Theme.control-height;
    horizontal-stretch: 0;
    accessible-role: groupbox;
    accessible-label: root.accessible-name;
    Rectangle {
        border-radius: Theme.small-radius;
        border-width: Theme.strong-border-width;
        border-color: Theme.border-strong;
        background: Theme.surface;
        clip: true;
        bar := HorizontalLayout {
            padding: Theme.strong-border-width;
            for option[index] in root.options : Rectangle {
                width: label.preferred-width + 32px;
                property <bool> on: root.current-value != "" ? option == root.current-value : index == root.current;
                background: self.on ? Theme.accent-primary : area.has-hover ? Theme.elevated : transparent;
                accessible-role: button;
                accessible-label: option;
                accessible-checkable: true;
                accessible-checked: self.on;
                accessible-action-default => { root.selected(index); root.chosen(option); }
                if index > 0 : Rectangle { x: 0px; width: Theme.strong-border-width; background: Theme.border-strong; }
                label := Text {
                    text: option;
                    color: parent.on ? Theme.on-accent : Theme.text;
                    font-size: Theme.label-size;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                KeyboardFocus { width: parent.width; height: parent.height; ring-radius: Theme.small-radius; activated => { root.selected(index); root.chosen(option); } }
                area := TouchArea { mouse-cursor: pointer; clicked => { root.selected(index); root.chosen(option); } }
            }
        }
    }
}

// One interface theme offered as a card, the chosen one filled.
export component ThemeCard inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    in property <bool> enabled: true;
    // Why the card cannot be chosen, shown on hover while it is disabled.
    in property <string> hint;
    callback clicked();
    width: max(110px, name.preferred-width + 64px);
    height: 52px;
    horizontal-stretch: 0;
    accessible-role: button;
    accessible-label: label;
    accessible-checkable: true;
    accessible-checked: selected;
    accessible-enabled: root.enabled;
    accessible-description: !root.enabled ? root.hint : "";
    accessible-action-default => { if root.enabled { root.clicked(); } }
    opacity: root.enabled ? 1 : Theme.disabled-opacity;
    Plate {
        width: root.width;
        height: root.height;
        radius: Theme.small-radius;
        lift: root.selected ? Theme.shadow-offset-small : 0px;
        fill: root.selected ? Theme.accent-primary : area.has-hover ? Theme.elevated : Theme.surface;
    }
    // The theme's own colors are not known here, so the swatch only shows
    // that a theme is chosen.
    Rectangle {
        x: 14px;
        y: (parent.height - self.height) / 2;
        width: 24px;
        height: 24px;
        border-radius: Theme.chip-radius;
        border-width: Theme.chip-border-width;
        border-color: Theme.border-strong;
        background: root.selected ? Theme.surface : Theme.background;
    }
    name := Text {
        x: 50px;
        width: parent.width - 60px;
        height: parent.height;
        text: root.label;
        color: root.selected ? Theme.on-accent : Theme.text;
        font-size: Theme.body-size;
        font-weight: 700;
        vertical-alignment: center;
        overflow: elide;
    }
    KeyboardFocus { width: root.width; height: root.height; enabled: root.enabled; ring-radius: Theme.small-radius; activated => { root.clicked(); } }
    area := TouchArea {
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.not-allowed;
        clicked => { if root.enabled { root.clicked(); } }
    }
    HoverNote { text: !root.enabled ? root.hint : ""; hovered: area.has-hover; pointer-x: area.mouse-x; pointer-y: area.mouse-y; }
}

// A pinned Minecraft release, with the way to unpin it.
export component FavoriteChip inherits Rectangle {
    in property <string> version;
    callback remove();
    width: row.preferred-width;
    height: 34px;
    horizontal-stretch: 0;
    border-radius: Theme.chip-radius;
    border-width: Theme.chip-border-width;
    border-color: Theme.border-strong;
    background: Theme.note-fill;
    row := HorizontalLayout {
        padding-left: 12px;
        padding-right: 4px;
        spacing: 8px;
        VerticalLayout { alignment: center; Image { source: @image-url("../../../../assets/icons/favorite-filled.svg"); width: 15px; height: 15px; image-fit: contain; colorize: Theme.warning; } }
        BodyText { text: root.version; color: Theme.text; font-family: Theme.mono-family; font-weight: 700; vertical-alignment: center; }
        VerticalLayout { alignment: center; IconButton { icon: @image-url("../../../../assets/icons/close.svg"); accessible-name: GuiI18n.value("gui-unfavorite-version", root.version); width: 26px; height: 26px; clicked => { root.remove(); } } }
    }
}

// The bar under a page of edits that are saved together: what is pending on
// the left, Discard and Save on the right. It takes the primary fill while
// something is unsaved.
export component DraftBar inherits Rectangle {
    in property <string> message;
    in property <bool> dirty;
    in property <bool> can-save;
    in property <string> discard-hint;
    in property <string> save-hint;
    callback discard();
    callback save();
    min-height: bar.preferred-height;
    preferred-height: bar.preferred-height;
    vertical-stretch: 0;
    border-radius: Theme.card-radius;
    border-width: root.dirty ? Theme.strong-border-width : 0px;
    border-color: Theme.border-strong;
    background: root.dirty ? Theme.primary-fill : transparent;
    if !root.dirty : Rectangle { y: 0px; height: 1px; background: Theme.border; }
    bar := HorizontalLayout {
        padding-left: root.dirty ? 18px : 0px;
        // The buttons' shadows fall to the right, so the bar leaves them room.
        padding-right: root.dirty ? 18px : Theme.shadow-room;
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 10px;
        Text {
            text: root.message;
            color: root.dirty ? Theme.on-primary : Theme.text-muted;
            font-size: Theme.body-size;
            font-weight: root.dirty ? 600 : 400;
            vertical-alignment: center;
            horizontal-stretch: 1;
            wrap: word-wrap;
        }
        VerticalLayout { alignment: center; AppButton { text: GuiI18n.text("gui-discard-changes"); enabled: root.dirty; hint: root.discard-hint; clicked => { root.discard(); } } }
        VerticalLayout { alignment: center; AppButton { text: GuiI18n.text("gui-save-changes"); tone: root.dirty ? "secondary" : "primary"; enabled: root.can-save; hint: root.save-hint; clicked => { root.save(); } } }
    }
}

// A setting in a group whose control is wide and sits under its description.
export component SettingBlock inherits Rectangle {
    in property <string> title;
    in property <string> detail;
    // A short state shown beside the title, such as whether a key is set.
    in property <string> badge;
    in property <color> badge-tone: Theme.accent;
    min-height: card.preferred-height;
    preferred-height: card.preferred-height;
    if root.y > 0px : Rectangle { y: 0px; height: 1px; background: Theme.border; }
    card := VerticalLayout {
        padding-left: 18px;
        padding-right: 18px;
        padding-top: 14px;
        padding-bottom: 14px;
        spacing: 10px;
        VerticalLayout {
            spacing: 4px;
            HorizontalLayout {
                spacing: 10px;
                alignment: start;
                Heading { text: root.title; font-size: Theme.row-heading-size; horizontal-stretch: 0; }
                if root.badge != "" : VerticalLayout { alignment: center; Pill { text: root.badge; tone-color: root.badge-tone; } }
            }
            if root.detail != "" : BodyText { text: root.detail; wrap: word-wrap; font-size: Theme.label-size; }
        }
        @children
    }
}

// A box that is ticked or not, with its label, and a note at the right.
export component CheckRow inherits Rectangle {
    in property <string> label;
    in property <string> note;
    in property <bool> checked;
    in property <bool> enabled: true;
    callback toggled(bool);
    height: Theme.control-height + 4px;
    accessible-role: checkbox;
    accessible-label: root.label;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.toggled(!root.checked); } }
    Plate {
        width: root.width;
        height: root.height;
        lift: 0px;
        radius: Theme.small-radius;
        fill: Theme.field;
    }
    KeyboardFocus { width: root.width; height: root.height; enabled: root.enabled; ring-radius: Theme.small-radius; activated => { root.toggled(!root.checked); } }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 18px;
                height: 18px;
                border-radius: 4px;
                border-width: Theme.strong-border-width;
                border-color: Theme.border-strong;
                background: root.checked ? Theme.text : Theme.field;
                if root.checked : Image {
                    width: 12px;
                    height: 12px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    source: @image-url("../../../../assets/icons/check.svg");
                    colorize: Theme.surface;
                }
            }
        }
        BodyText { text: root.label; color: Theme.text; font-weight: 700; vertical-alignment: center; overflow: elide; }
        Rectangle { horizontal-stretch: 1; }
        BodyText { text: root.note; color: Theme.text-muted; font-size: Theme.label-size; vertical-alignment: center; overflow: elide; }
    }
    TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.toggled(!root.checked); }
    }
}

// What a field is, and a note about it at the right of the same line.
export component FieldCaption inherits HorizontalLayout {
    in property <string> label;
    in property <string> note;
    spacing: 8px;
    Text { text: root.label; color: Theme.text; font-size: Theme.label-size; font-weight: 700; vertical-alignment: bottom; }
    Rectangle { horizontal-stretch: 1; }
    Text { text: root.note; color: Theme.text-muted; font-size: Theme.caption-size; vertical-alignment: bottom; overflow: elide; }
}

// A line of context at the foot of a form: what the choices above come to.
export component InfoBanner inherits Rectangle {
    in property <string> text;
    height: row.preferred-height;
    accessible-role: AccessibleRole.text;
    accessible-label: root.text;
    Plate {
        width: root.width;
        height: root.height;
        lift: 0px;
        radius: Theme.card-radius;
        fill: Theme.selection-card;
    }
    row := HorizontalLayout {
        padding: 12px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Image { source: @image-url("../../../../assets/icons/settings-about.svg"); width: 16px; height: 16px; colorize: Theme.text-secondary; }
        }
        BodyText { text: root.text; color: Theme.text; wrap: word-wrap; horizontal-stretch: 1; vertical-alignment: center; }
    }
}

