// The Mods surface: mod cards, dependency impact and relation lists, and linked targets.

import { ScrollView } from "std-widgets.slint";
import { ModArtwork } from "../components/artwork.slint";
import { AppButton, EmptyState, IconButton, Pill, TextField, Toggle } from "../components/controls.slint";
import { BodyText, Heading } from "../components/text.slint";
import { GuiI18n } from "../globals.slint";
import { HostView, ImpactRow, LinkedTargetRow, ModRow, RelationRow } from "../models.slint";
import { Theme } from "../theme.slint";

// A boxed list of mods a dependency question named.
//
// Bounded and scrollable: a library in a two hundred mod pack names a lot
// of dependents, and a dialog that grew past the window would put its own
// buttons out of reach.
export component ImpactList inherits Rectangle {
    in property <[ImpactRow]> rows;
    vertical-stretch: 1;
    max-height: root.rows.length * 22px + 18px;
    border-radius: Theme.card-radius;
    border-width: Theme.strong-border-width;
    border-color: Theme.border-strong;
    background: Theme.background;
    ScrollView {
        viewport-width: self.width;
        VerticalLayout { alignment: start; padding: 9px; spacing: 3px;
            for entry in root.rows : Text {
                // A chain through other mods is worth saying, because it
                // explains why a mod nothing obviously touches is listed.
                text: entry.distance > 1 ? GuiI18n.values("gui-mod-impact-through", entry.name, entry.distance) : entry.name;
                color: Theme.text-secondary;
                font-size: Theme.label-size;
                height: 19px;
                overflow: elide;
            }
        }
    }
}

// The recorded relations of one mod, in one direction.
//
// Fixed height rather than sized to its contents: the two sit side by side
// on a mod's page, and a box that grew with its list would leave the pair
// uneven and push the version list around as different mods are opened.
export component RelationList inherits Rectangle {
    in property <[RelationRow]> rows;
    // What to show in place of an empty list.
    in property <string> note;
    // Tall enough for two rows carrying a project id under the name, which
    // is the taller of the two shapes a row takes.
    height: 96px * Theme.text-scale;
    border-radius: Theme.card-radius;
    border-width: Theme.strong-border-width;
    border-color: Theme.border-strong;
    background: Theme.background;
    ScrollView {
        viewport-width: self.width;
        VerticalLayout { alignment: start; padding: 9px; spacing: 3px;
            if root.rows.length == 0 : BodyText {
                text: root.note;
                color: Theme.text-muted;
                wrap: word-wrap;
            }
            for entry in root.rows : HorizontalLayout {
                spacing: 6px;
                height: entry.detail == "" ? 19px : 32px;
                // The name a reader reads, with the id it resolves against
                // under it rather than beside it: the id is what to quote
                // in a bug report and never what to scan the list by.
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    Text {
                        text: entry.name;
                        color: Theme.text-secondary;
                        font-size: Theme.label-size;
                        overflow: elide;
                    }
                    if entry.detail != "" : Text {
                        text: entry.detail;
                        color: Theme.text-muted;
                        font-size: Theme.caption-size;
                        overflow: elide;
                    }
                }
                // What the relation said, and how the jar stands, in that
                // order: the kind is the durable fact, the state changes
                // with every toggle.
                Text {
                    text: entry.kind;
                    color: Theme.text-muted;
                    font-size: Theme.caption-size;
                    vertical-alignment: center;
                }
                if entry.state != "" : Text {
                    text: entry.state;
                    color: entry.attention ? Theme.warning : Theme.text-muted;
                    font-size: Theme.caption-size;
                    vertical-alignment: center;
                }
            }
        }
    }
}

export component LinkedTargetsPanel inherits Rectangle {
    in property <[LinkedTargetRow]> rows;
    // Result lists are read-only; a confirmation's are not.
    in property <bool> selectable: false;
    callback toggled(int);
    border-radius: Theme.card-radius;
    border-width: Theme.strong-border-width;
    border-color: Theme.border-strong;
    background: Theme.background;
    // Room for the first rows whatever the dialog around it works out, so
    // a confirmation offering one server never hands it a scroll bar for a
    // single line.
    min-height: min(root.rows.length, 2) * 68px + 14px;
    ScrollView {
        viewport-width: self.width;
        VerticalLayout { alignment: start; padding: 8px; spacing: 6px;
            for row[index] in root.rows : Rectangle {
                height: 62px;
                border-radius: Theme.small-radius;
                border-width: row.selected ? Theme.selection-outline-width : Theme.strong-border-width;
                border-color: row.selected ? Theme.accent : Theme.border-strong.with-alpha(0.6);
                background: row.actionable || !root.selectable ? Theme.surface : Theme.surface.with-alpha(0.45);
                // Under the row's content, so a click on the switch reaches
                // the switch and a click anywhere else still selects.
                TouchArea { enabled: root.selectable && row.actionable; mouse-cursor: pointer; clicked => { root.toggled(index); } }
                HorizontalLayout { padding-left: 10px; padding-right: 10px; spacing: 10px;
                    // A switch, because the state column says what the
                    // operation would do to this server rather than whether
                    // it was chosen, and a border weight is no answer to
                    // "is this one selected".
                    if root.selectable : VerticalLayout { alignment: center; Toggle { checked: row.selected; sets-its-own-position: false; enabled: row.actionable; accessible-name: row.name; toggled => { root.toggled(index); } } }
                    // The explanation gets the full row width: a refusal is a
                    // sentence, and eliding it to a column loses the reason.
                    VerticalLayout { alignment: center; spacing: 1px; horizontal-stretch: 1;
                        HorizontalLayout { spacing: 8px;
                            Text { text: row.name; color: row.actionable || !root.selectable ? Theme.text : Theme.text-secondary; font-size: Theme.label-size; font-weight: 600; overflow: elide; horizontal-stretch: 1; }
                            Text { text: row.detail; color: Theme.text-muted; font-size: Theme.caption-size; vertical-alignment: center; overflow: elide; horizontal-stretch: 0; }
                        }
                        Text { text: row.explanation; color: Theme.text-muted; font-size: Theme.caption-size; overflow: elide; }
                    }
                    VerticalLayout { alignment: center; max-width: 150px;
                        // Muted while the row is off: what it would do is
                        // still worth reading, but it is not what is about
                        // to happen.
                        if !row.blocked : Text { text: row.state; color: root.selectable && row.actionable && !row.selected ? Theme.text-muted : row.tone == "ok" ? Theme.success : row.tone == "error" ? Theme.danger : Theme.text-secondary; font-size: Theme.label-size; horizontal-alignment: right; overflow: elide; }
                        if row.blocked : HorizontalLayout { Rectangle { horizontal-stretch: 1; } Pill { text: row.state; tone-color: row.tone == "error" ? Theme.danger : Theme.warning; } }
                    }
                }
            }
        }
    }
}

// One row of the Managed Mods list: the mod, what is worth saying about it,
// its version, whose it is, and the two things done to it often.
//
// The provenance chip is the one badge. Everything else that distinguishes a
// row, such as an unknown version, a missing file or a crash that points at
// it, is said in the place it belongs rather than added as another chip.
export component ModCard inherits Rectangle {
    in property <ModRow> item;
    // Whether this list lets a mod be turned off in place.
    in property <bool> togglable;
    // Whether this host's mods are the user's, rather than a record of
    // what a pack shipped. When they are, the bin takes a mod out of the
    // instance for good; when they are not, it puts the jar aside so it
    // can come back, which is how a crash gets bisected.
    in property <bool> mods-are-the-users;
    // Whether the bin takes this mod out of the host rather than only off
    // disk. A mod whose release is not the user's to end - a library
    // something else needs - keeps the reversible bin whatever the host
    // says.
    property <bool> bin-removes: root.item.can-remove && root.mods-are-the-users;
    callback manage(string);
    callback toggle(string, bool);
    callback delete-file(string, string);
    callback restore-file(string);
    // A narrow pane drops the version and the chips as columns: the version
    // joins the line under the name, so the switch and the bin stay in reach.
    // Decided by the pane, not by this row's own width, which the columns
    // themselves would then feed back into.
    in property <bool> compact;
    height: 62px;
    background: root.item.suspect-confidence == "high" ? Theme.danger.with-alpha(0.12) : root.item.suspect-confidence != "" ? Theme.warning.with-alpha(0.12) : touch.has-hover && root.item.can-manage ? Theme.elevated : transparent;
    touch := TouchArea {
        enabled: root.item.can-manage;
        mouse-cursor: pointer;
        clicked => { root.manage(root.item.logical-path); }
    }
    HorizontalLayout {
        padding-left: 14px; padding-right: 14px; spacing: 12px;
        VerticalLayout { alignment: center; ModArtwork { icon: root.item.icon; origin-kind: root.item.origin-kind; } }
        VerticalLayout {
            alignment: center; spacing: 2px; horizontal-stretch: 1;
            // Text takes no more than it needs, so without this the free
            // width would go to the columns beside it.
            max-width: 10000px;
            Text {
                text: root.item.title;
                color: root.item.enabled ? Theme.text : Theme.text-muted;
                font-size: Theme.row-heading-size;
                font-weight: 600;
                overflow: elide;
            }
            Text {
                // What the crash says outranks the descriptive line: a
                // reader looking at a crashed server is looking for this.
                text: (root.compact && root.item.version != "" ? root.item.version + " | " : "") + (root.item.suspect-reason != "" ? root.item.suspect-reason : root.item.deleted ? GuiI18n.text("gui-mod-file-deleted") : !root.item.enabled ? GuiI18n.text("gui-mod-disabled") : root.item.compatibility);
                color: root.item.suspect-confidence == "high" ? Theme.danger : root.item.suspect-confidence != "" ? Theme.warning : Theme.text-muted;
                font-size: Theme.caption-size;
                overflow: elide;
            }
        }
        if !root.compact : Rectangle {
            min-width: 130px * Theme.text-scale;
            max-width: 130px * Theme.text-scale;
            horizontal-stretch: 0;
            Text {
                width: parent.width;
                height: parent.height;
                text: root.item.version;
                color: root.item.version-known ? Theme.text-secondary : Theme.text-muted;
                font-family: Theme.mono-family;
                font-size: Theme.label-size;
                horizontal-alignment: right;
                vertical-alignment: center;
                overflow: elide;
            }
        }
        if !root.compact : Rectangle {
            min-width: 230px * Theme.text-scale;
            max-width: 230px * Theme.text-scale;
            horizontal-stretch: 0;
            HorizontalLayout {
                spacing: 6px;
                alignment: end;
                VerticalLayout {
                    alignment: center;
                    Pill { text: root.item.origin; tone-color: root.item.origin-kind == "pack" ? Theme.accent-secondary : root.item.origin-kind == "dependency" ? Theme.text-muted : root.item.origin-kind == "hand-placed" ? Theme.warning : Theme.accent; }
                }
                // Which catalog the mod came from, in that catalog's own
                // color. Absent for an entry with no catalog identity.
                if root.item.provider-kind != "" : VerticalLayout {
                    alignment: center;
                    Pill { text: root.item.provider; tone-color: root.item.provider-kind == "curseforge" ? Theme.curseforge : Theme.modrinth; }
                }
            }
        }
        // Declared after the card's own touch area so they take their own
        // clicks instead of opening the mod manager behind them.
        if root.togglable || root.item.can-delete-file || root.item.can-remove : HorizontalLayout {
            alignment: end;
            horizontal-stretch: 0;
            spacing: 8px;
            // Nothing to turn on or throw away while the jar is gone.
            // The one thing left is putting it back.
            if root.item.deleted : VerticalLayout { alignment: center; padding-right: Theme.shadow-room; AppButton { text: GuiI18n.text("gui-restore-mod"); compact: true; clicked => { root.restore-file(root.item.logical-path); } } }
            if !root.item.deleted && root.togglable : VerticalLayout { alignment: center; Toggle { checked: root.item.enabled; sets-its-own-position: false; accessible-name: GuiI18n.value("gui-mod-loads", root.item.title); toggled(on) => { root.toggle(root.item.logical-path, on); } } }
            if !root.item.deleted && (root.item.can-delete-file || root.item.can-remove) : VerticalLayout {
                alignment: center;
                IconButton {
                    icon: @image-url("../../../../assets/icons/trash.svg");
                    accessible-name: GuiI18n.value(root.item.can-delete-file && !root.bin-removes ? "gui-delete-mod" : "gui-remove-mod", root.item.title);
                    clicked => { root.delete-file(root.item.logical-path, root.item.title); }
                }
            }
        }
    }
}

// A host's installed mods: a filter, the way to add more, and one list with a
// row for each. One panel for a client and a server, so the two cannot drift
// apart. Anything a host adds above the list goes in as children.
export component ManagedModsPanel inherits Rectangle {
    in property <HostView> host;
    // What an empty list says when no filter hides anything.
    in property <string> empty-detail;
    in property <bool> mods-are-the-users;
    // Whether the catalogs can be searched for this host.
    in property <bool> can-add: true;
    // Whether the pane is too narrow for the version and chip columns.
    in property <bool> compact;
    callback filter(string);
    callback add-mods();
    callback add-jars();
    callback refresh();
    callback manage(string);
    callback toggle(string, bool);
    callback restore-file(string);
    // The row, its path, and its title, for the confirmation the bin opens.
    callback delete-file(ModRow, string, string);
    VerticalLayout {
        spacing: 12px;
        alignment: start;
        HorizontalLayout {
            spacing: 10px;
            padding-right: Theme.shadow-room;
            padding-bottom: Theme.shadow-room;
            TextField {
                property <string> host-query: root.host.mods-query;
                changed host-query => { self.text = self.host-query; }
                init => { self.text = self.host-query; }
                placeholder: GuiI18n.text("gui-filter-mods");
                accessible-label: GuiI18n.text("gui-filter-mods");
                input-type: InputType.search;
                horizontal-stretch: 1;
                edited(text) => { root.filter(text); }
            }
            AppButton { text: GuiI18n.text("gui-add-local-mods"); clicked => { root.add-jars(); } }
            IconButton { icon: @image-url("../../../../assets/icons/refresh.svg"); accessible-name: GuiI18n.text("gui-refresh-mod-details"); lift: Theme.shadow-offset-card; clicked => { root.refresh(); } }
            if root.can-add : AppButton { text: GuiI18n.text("gui-add-mods"); tone: "primary"; icon: @image-url("../../../../assets/icons/add.svg"); clicked => { root.add-mods(); } }
        }
        @children
        if root.host.mods-notice != "" : BodyText { text: root.host.mods-notice; color: Theme.text-muted; font-size: Theme.caption-size; wrap: word-wrap; }
        if root.host.mods.length == 0 : EmptyState {
            icon: @image-url("../../../../assets/icons/semantic-mod.svg");
            title: root.host.mods-query != "" ? GuiI18n.text("gui-no-mods-match-title") : GuiI18n.text("gui-no-managed-mods");
            message: root.host.mods-query != "" ? GuiI18n.value("gui-no-mods-match", root.host.mods-query) : root.empty-detail;
        }
        if root.host.mods.length > 0 : Rectangle {
            // As tall as its rows, and shorter than that when the page is.
            preferred-height: list.preferred-height + 2 * Theme.strong-border-width;
            vertical-stretch: 0;
            min-height: 120px;
            border-radius: Theme.card-radius;
            border-width: Theme.strong-border-width;
            border-color: Theme.border-strong;
            background: Theme.surface;
            clip: true;
            ScrollView {
                viewport-width: self.width;
                list := VerticalLayout {
                    for mod[index] in root.host.mods : VerticalLayout {
                        if index > 0 : Rectangle { height: Theme.chip-border-width; background: Theme.border-strong.with-alpha(0.25); }
                        ModCard {
                            item: mod;
                            compact: root.compact;
                            togglable: true;
                            mods-are-the-users: root.mods-are-the-users;
                            manage(path) => { root.manage(path); }
                            toggle(path, on) => { root.toggle(path, on); }
                            restore-file(path) => { root.restore-file(path); }
                            delete-file(path, title) => { root.delete-file(mod, path, title); }
                        }
                    }
                }
            }
        }
        if root.host.mods.length > 0 : BodyText {
            text: GuiI18n.count("gui-mods-shown", root.host.mods.length);
            color: Theme.text-muted;
            font-size: Theme.caption-size;
        }
    }
}
