// The Diagnostics surface: whether a host is configured correctly, what a
// failed run points at, the fixes it can preview, and what to attach to a
// bug report.

import { ScrollView } from "std-widgets.slint";
import { AppButton, BusySpinner, Pill, Toggle } from "../components/controls.slint";
import { JavaChoiceItem } from "java-choice.slint";
import { BodyText, DisplayHeading, Divider, Heading, SectionTitle } from "../components/text.slint";
import { GuiI18n } from "../globals.slint";
import { BundlePartRow, DiagnosticCheckRow, DiagnosticFindingRow, FixChangeRow, HostView } from "../models.slint";
import { Theme } from "../theme.slint";

// The choice of what goes into one local diagnostic archive. Every row is
// one the core planner offered; nothing else can be added here.
export component DiagnosticBundlePanel inherits VerticalLayout {
    in property <[BundlePartRow]> parts;
    in property <string> selection;
    in property <int> selected-count;
    in property <bool> exporting;
    in property <string> result;
    in property <string> result-path;
    in property <string> error;
    // What stands in for the list while the planner offers nothing.
    in property <string> empty-text: GuiI18n.text("gui-bundle-empty");
    callback toggle(string, bool);
    callback select-all(bool);
    callback export();
    callback open-folder();
    spacing: 8px;
    BodyText { text: GuiI18n.text("gui-bundle-detail"); color: Theme.text-muted; wrap: word-wrap; }
    BodyText { text: GuiI18n.text("gui-bundle-privacy"); color: Theme.text-secondary; wrap: word-wrap; }
    if root.parts.length == 0 : BodyText { text: root.empty-text; color: Theme.text-muted; wrap: word-wrap; }
    if root.parts.length > 0 : BodyText { text: root.selection; color: Theme.text-secondary; wrap: word-wrap; }
    if root.parts.length > 0 : HorizontalLayout {
        spacing: 8px;
        alignment: start;
        AppButton { text: GuiI18n.text("gui-bundle-select-all"); enabled: !root.exporting; hint: GuiI18n.text("gui-hint-export-running"); clicked => { root.select-all(true); } }
        AppButton { text: GuiI18n.text("gui-bundle-select-none"); enabled: !root.exporting; hint: GuiI18n.text("gui-hint-export-running"); clicked => { root.select-all(false); } }
    }
    if root.parts.length > 0 : Rectangle {
        border-radius: Theme.card-radius;
        border-width: Theme.strong-border-width;
        border-color: Theme.border-strong;
        background: Theme.background;
        height: min(300px, part-list.preferred-height + 2px);
        ScrollView {
            content-width: self.width;
            part-list := VerticalLayout {
                padding: 8px;
                spacing: 6px;
                alignment: start;
                for part in root.parts : HorizontalLayout {
                    spacing: 10px;
                    VerticalLayout { alignment: center; Toggle { accessible-name: part.name; checked: part.selected; sets-its-own-position: false; enabled: !root.exporting; toggled(value) => { root.toggle(part.name, value); } } }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        BodyText { text: part.name; wrap: word-wrap; }
                        BodyText { text: part.kind; color: Theme.text-muted; font-size: Theme.caption-size; }
                    }
                    BodyText { text: part.size; color: Theme.text-secondary; vertical-alignment: center; }
                }
            }
        }
    }
    if root.parts.length > 0 && root.selected-count == 0 : BodyText { text: GuiI18n.text("gui-bundle-choose-one"); color: Theme.warning; wrap: word-wrap; }
    if root.error != "" : BodyText { text: root.error; color: Theme.danger; wrap: word-wrap; }
    if root.result != "" : BodyText { text: root.result; wrap: word-wrap; }
    if root.parts.length > 0 || root.result-path != "" : HorizontalLayout {
        spacing: 8px;
        if root.exporting : VerticalLayout { alignment: center; BusySpinner { width: 16px; height: 16px; } }
        Rectangle { horizontal-stretch: 1; }
        if root.result-path != "" : AppButton { text: GuiI18n.text("gui-bundle-show-folder"); clicked => { root.open-folder(); } }
        if root.parts.length > 0 : AppButton { text: GuiI18n.text("gui-bundle-export"); tone: "primary"; enabled: root.selected-count > 0 && !root.exporting; hint: root.exporting ? GuiI18n.text("gui-hint-export-running") : GuiI18n.text("gui-hint-select-export-item"); clicked => { root.export(); } }
    }
}

component CheckRow inherits Rectangle {
    in property <DiagnosticCheckRow> check;
    height: row.preferred-height;
    row := VerticalLayout {
        spacing: 2px;
        HorizontalLayout {
            spacing: 10px;
            BodyText { text: root.check.label; color: Theme.text; font-weight: 600; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
            Pill {
                text: root.check.state-label;
                content-height: 22px;
                fill: root.check.state == "problem" ? Theme.danger-fill : root.check.state == "ok" ? Theme.state-running : root.check.state == "customized" ? Theme.state-building : Theme.surface;
                caption: root.check.state == "problem" ? Theme.on-danger : root.check.state == "ok" || root.check.state == "customized" ? Theme.on-accent : Theme.text-secondary;
                tone-color: Theme.border-strong;
            }
        }
        if root.check.value != "" : BodyText { text: root.check.value; color: Theme.text-muted; font-size: Theme.caption-size; wrap: word-wrap; }
    }
}

component ChangeRow inherits Rectangle {
    in property <FixChangeRow> change;
    height: row.preferred-height;
    row := VerticalLayout {
        spacing: 2px;
        HorizontalLayout {
            spacing: 10px;
            Pill { text: root.change.action; min-content-width: 112px; tone-color: Theme.accent; }
            BodyText { text: root.change.name; color: Theme.text; wrap: word-wrap; horizontal-stretch: 1; }
        }
        if root.change.detail != "" : BodyText { text: root.change.detail; color: Theme.text-muted; font-size: Theme.caption-size; wrap: word-wrap; }
    }
}

// One finding. The tag says in words whether it is the likely cause, a
// problem or a customization, so the fill is never the only signal.
component FindingCard inherits Rectangle {
    in property <DiagnosticFindingRow> item;
    // The finding a failed run most likely comes from, which is called out.
    in property <bool> likely;
    // Whether an action that changes the host can start now.
    in property <bool> can-act;
    // Why the actions wait, shown while `can-act` is false.
    in property <string> blocked-reason;
    callback review-fix(string);
    callback open-route(string);
    callback install(string, string);
    property <string> tag: root.likely ? GuiI18n.text("gui-diagnosis-badge-likely-cause") : root.item.problem ? GuiI18n.text("gui-diagnosis-badge-problem") : GuiI18n.text("gui-diagnosis-badge-customized");
    border-radius: Theme.card-radius;
    border-width: Theme.strong-border-width;
    border-color: Theme.border-strong;
    background: root.likely ? Theme.note-fill : Theme.surface;
    height: card.preferred-height;
    accessible-role: groupbox;
    accessible-label: root.tag + ": " + root.item.title;
    card := VerticalLayout {
        padding: 14px;
        spacing: 8px;
        HorizontalLayout {
            spacing: 8px;
            VerticalLayout {
                alignment: start;
                Pill {
                    text: root.tag;
                    content-height: 22px;
                    fill: root.likely ? Theme.primary-fill : root.item.problem ? Theme.danger-fill : Theme.state-building;
                    caption: root.likely ? Theme.on-primary : root.item.problem ? Theme.on-danger : Theme.on-accent;
                    tone-color: Theme.border-strong;
                }
            }
            Heading { text: root.item.title; font-size: Theme.row-heading-size; wrap: word-wrap; horizontal-stretch: 1; }
        }
        if root.item.detail != "" : BodyText { text: root.item.detail; color: Theme.text-secondary; wrap: word-wrap; }
        // Why a dependency is needed, outermost first, ending in the one
        // that is not met. One step to a line, each set in from the one above.
        if root.item.chain.length > 0 : VerticalLayout {
            spacing: 4px;
            for step[index] in root.item.chain : HorizontalLayout {
                spacing: 6px;
                padding-left: index * 14px;
                alignment: start;
                if index > 0 : VerticalLayout { alignment: center; Text { text: ">"; color: Theme.text-muted; font-size: Theme.label-size; font-weight: 700; } }
                Pill {
                    text: step;
                    content-height: 24px;
                    max-content-width: max(80px, root.width - 28px - index * 14px - 20px);
                    fill: index == root.item.chain.length - 1 ? Theme.danger-soft : Theme.surface;
                    caption: Theme.text;
                    tone-color: Theme.border-strong;
                }
            }
        }
        if root.item.files.length > 0 : VerticalLayout {
            spacing: 2px;
            for file in root.item.files : BodyText { text: file; color: Theme.text-muted; font-size: Theme.caption-size; wrap: word-wrap; }
            if root.item.more-files != "" : BodyText { text: root.item.more-files; color: Theme.text-muted; font-size: Theme.caption-size; }
        }
        if root.item.fix-label != "" || root.item.install-label != "" || root.item.route != "" : HorizontalLayout {
            spacing: 8px;
            alignment: start;
            padding-right: Theme.shadow-room;
            padding-bottom: Theme.shadow-room;
            if root.item.fix-label != "" : AppButton {
                text: root.item.fix-label;
                accessible-name: root.item.fix-label + ": " + root.item.title;
                tone: root.item.problem ? "primary" : "secondary";
                enabled: root.can-act; hint: root.blocked-reason;
                clicked => { root.review-fix(root.item.key); }
            }
            if root.item.install-label != "" : AppButton {
                text: root.item.install-label;
                accessible-name: root.item.install-label + ": " + root.item.title;
                tone: "primary";
                enabled: root.can-act; hint: root.blocked-reason;
                clicked => { root.install(root.item.install-provider, root.item.install-project); }
            }
            if root.item.route != "" : AppButton { text: root.item.route-label; clicked => { root.open-route(root.item.route); } }
        }
    }
}

component CheckList inherits Rectangle {
    in property <[DiagnosticCheckRow]> checks;
    border-radius: Theme.card-radius;
    border-width: Theme.strong-border-width;
    border-color: Theme.border-strong;
    background: Theme.surface;
    height: rows.preferred-height;
    rows := VerticalLayout {
        padding: 12px;
        spacing: 8px;
        for check in root.checks : CheckRow { check: check; }
    }
}

// The change a fix would make, shown before anything changes. This is the
// confirmation: Apply does it, and nothing asks again.
// The review of one previewed change, shared by every surface that proposes
// one, so a change is always read and applied the same way.
export component FixPanel inherits Rectangle {
    in property <HostView> host;
    in property <bool> can-apply;
    // Why nothing can be applied while `can-apply` is false.
    in property <string> blocked-reason;
    callback cancel();
    callback apply();
    border-radius: Theme.card-radius;
    border-width: Theme.strong-border-width;
    border-color: Theme.accent;
    background: Theme.elevated;
    height: panel.preferred-height;
    accessible-role: groupbox;
    accessible-label: GuiI18n.text("gui-fix-title");
    panel := VerticalLayout {
        padding: 14px;
        spacing: 8px;
        Heading { text: GuiI18n.text("gui-fix-title"); font-size: Theme.row-heading-size; }
        BodyText { text: root.host.fix-title; color: Theme.text-secondary; wrap: word-wrap; }
        if root.host.fix-state == "loading" : HorizontalLayout {
            spacing: 8px;
            VerticalLayout { alignment: center; BusySpinner { width: 16px; height: 16px; } }
            BodyText { text: GuiI18n.text("gui-fix-loading"); horizontal-stretch: 1; wrap: word-wrap; }
        }
        if root.host.fix-state == "failed" : BodyText { text: root.host.fix-error; color: Theme.danger; wrap: word-wrap; }
        if root.host.fix-state == "ready" || root.host.fix-state == "applying" : VerticalLayout {
            spacing: 6px;
            for change in root.host.fix-changes : ChangeRow { change: change; }
            for note in root.host.fix-notes : BodyText { text: note; wrap: word-wrap; }
            if root.host.fix-blocked != "" : BodyText { text: root.host.fix-blocked; color: Theme.warning; wrap: word-wrap; }
        }
        HorizontalLayout {
            spacing: 8px;
            if root.host.fix-state == "applying" : VerticalLayout { alignment: center; BusySpinner { width: 16px; height: 16px; } }
            if root.host.fix-state == "applying" : BodyText { text: GuiI18n.text("gui-fix-applying"); vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; }
            AppButton { text: GuiI18n.text("gui-fix-cancel"); enabled: root.host.fix-state != "applying"; hint: GuiI18n.text("gui-hint-fix-applying"); clicked => { root.cancel(); } }
            AppButton {
                text: GuiI18n.text("gui-fix-apply");
                tone: "primary";
                enabled: root.can-apply && root.host.fix-state == "ready" && root.host.fix-blocked == "" && root.host.fix-changes.length > 0; hint: root.host.fix-state == "applying" ? GuiI18n.text("gui-hint-fix-applying") : root.host.fix-blocked != "" ? root.host.fix-blocked : !root.can-apply ? root.blocked-reason : GuiI18n.text("gui-hint-nothing-to-apply");
                clicked => { root.apply(); }
            }
        }
    }
}

// Beside a host whose run just failed: what failed, what a quick diagnosis
// thinks caused it, and where to look next. A server start refused for
// missing EULA consent never ran, so it offers the EULA review instead. It
// never opens anything by itself. A failure that points at a damaged stored
// file also offers to verify the host's files.
export component RunFailureNotice inherits Rectangle {
    in property <HostView> host;
    callback open-diagnostics();
    callback open-crash-report();
    callback open-log();
    callback review-eula();
    callback verify-host();
    callback dismiss();
    // The extra button needs more room before the row stacks.
    property <bool> narrow: self.width < (root.host.run-verify-suggested ? 680px : 560px);
    property <string> diagnostics-tone: root.host.run-verify-suggested ? "default" : "primary";
    property <color> tone: root.host.run-eula-refused ? Theme.warning : Theme.danger;
    height: content.preferred-height;
    border-radius: Theme.card-radius;
    border-width: Theme.strong-border-width;
    border-color: root.tone.with-alpha(0.6);
    background: root.tone.with-alpha(0.08);
    accessible-role: groupbox;
    accessible-label: root.host.run-failure-title;
    content := VerticalLayout {
        padding: 12px;
        spacing: 6px;
        Text { text: root.host.run-failure-title; color: root.tone; font-size: Theme.row-heading-size; font-weight: 600; wrap: word-wrap; }
        BodyText { text: root.host.run-failure; wrap: word-wrap; }
        if root.host.run-likely-cause != "" : BodyText { text: root.host.run-likely-cause; color: Theme.text; wrap: word-wrap; }
        if root.host.run-eula-refused : HorizontalLayout {
            spacing: 8px;
            alignment: start;
            AppButton { text: GuiI18n.text("gui-diagnosis-open-eula"); tone: "primary"; clicked => { root.review-eula(); } }
            AppButton { text: GuiI18n.text("gui-run-dismiss"); clicked => { root.dismiss(); } }
        }
        if !root.host.run-eula-refused && !root.narrow : HorizontalLayout {
            spacing: 8px;
            alignment: start;
            if root.host.run-verify-suggested : AppButton { text: GuiI18n.text("gui-run-verify-host"); tone: "primary"; clicked => { root.verify-host(); } }
            AppButton { text: GuiI18n.text("gui-run-open-diagnostics"); tone: root.diagnostics-tone; clicked => { root.open-diagnostics(); } }
            if root.host.run-crash-report != "" : AppButton { text: GuiI18n.text("gui-diagnosis-open-crash-report"); clicked => { root.open-crash-report(); } }
            AppButton { text: GuiI18n.text("gui-diagnosis-open-log"); clicked => { root.open-log(); } }
            AppButton { text: GuiI18n.text("gui-run-dismiss"); clicked => { root.dismiss(); } }
        }
        if !root.host.run-eula-refused && root.narrow : VerticalLayout {
            spacing: 8px;
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                if root.host.run-verify-suggested : AppButton { text: GuiI18n.text("gui-run-verify-host"); tone: "primary"; clicked => { root.verify-host(); } }
                AppButton { text: GuiI18n.text("gui-run-open-diagnostics"); tone: root.diagnostics-tone; clicked => { root.open-diagnostics(); } }
                AppButton { text: GuiI18n.text("gui-run-dismiss"); clicked => { root.dismiss(); } }
            }
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                if root.host.run-crash-report != "" : AppButton { text: GuiI18n.text("gui-diagnosis-open-crash-report"); clicked => { root.open-crash-report(); } }
                AppButton { text: GuiI18n.text("gui-diagnosis-open-log"); clicked => { root.open-log(); } }
            }
        }
    }
}

// A table of what differs from the default and still works: the setting on
// the left, its value on the right.
component CustomizedTable inherits Rectangle {
    in property <[DiagnosticFindingRow]> items;
    in property <bool> can-act;
    in property <string> blocked-reason;
    callback review-fix(string);
    callback open-route(string);
    border-radius: Theme.card-radius;
    border-width: Theme.strong-border-width;
    border-color: Theme.border-strong;
    background: Theme.surface;
    height: rows.preferred-height;
    rows := VerticalLayout {
        padding: 12px;
        spacing: 8px;
        for item in root.items : Rectangle {
            height: entry.preferred-height;
            accessible-role: groupbox;
            accessible-label: GuiI18n.text("gui-diagnosis-badge-customized") + ": " + item.title;
            entry := VerticalLayout {
                spacing: 4px;
                HorizontalLayout {
                    spacing: 12px;
                    BodyText { text: item.title; color: Theme.text; font-weight: 600; wrap: word-wrap; horizontal-stretch: 1; }
                    BodyText { text: item.detail; color: Theme.text-secondary; font-family: Theme.mono-family; font-size: Theme.caption-size; horizontal-alignment: right; wrap: word-wrap; horizontal-stretch: 1; }
                }
                if item.files.length > 0 : VerticalLayout {
                    spacing: 2px;
                    for file in item.files : BodyText { text: file; color: Theme.text-muted; font-size: Theme.caption-size; wrap: word-wrap; }
                    if item.more-files != "" : BodyText { text: item.more-files; color: Theme.text-muted; font-size: Theme.caption-size; }
                }
                if item.fix-label != "" || item.route != "" : HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    padding-right: Theme.shadow-room;
                    padding-bottom: Theme.shadow-room;
                    if item.route != "" : AppButton { text: item.route-label; compact: true; clicked => { root.open-route(item.route); } }
                    if item.fix-label != "" : AppButton {
                        text: item.fix-label;
                        accessible-name: item.fix-label + ": " + item.title;
                        compact: true;
                        enabled: root.can-act; hint: root.blocked-reason;
                        clicked => { root.review-fix(item.key); }
                    }
                }
            }
        }
    }
}

// Diagnostics for one host. The state belongs to the controller and is the
// same in every pane on the host; which sections are expanded is this
// pane's own.
export component DiagnosticsSurface inherits Rectangle {
    in property <HostView> host;
    // A change is rewriting this host, such as a fix this started.
    in property <bool> busy;
    callback diagnose();
    callback stop();
    callback review-fix(string);
    callback cancel-fix();
    callback apply-fix();
    callback open-route(string);
    callback install-mod(string, string);
    callback choose-java(string);
    // Asks for the runtimes this host could use, which the Java section lists.
    callback load-java();
    callback copy-report();
    callback open-logs();
    callback toggle-bundle-part(string, bool);
    callback select-all-bundle-parts(bool);
    callback export-bundle();
    callback open-bundle-folder();
    property <string> state: root.host.diagnosis-state == "" ? "unchecked" : root.host.diagnosis-state;
    property <bool> working: root.state == "working" || root.busy;
    // Another change to the host and a diagnosis hold the actions alike, and
    // only one of them is a diagnosis.
    property <string> blocked-reason: root.state == "working" ? GuiI18n.text("gui-hint-diagnosis-running") : root.busy ? GuiI18n.text("gui-hint-busy") : GuiI18n.text("gui-hint-fix-applying");
    property <bool> after-failure: root.host.diagnosis-failure != "";
    property <bool> has-result: root.host.diagnosis-summary != "";
    property <bool> show-other: false;
    property <bool> show-bundle: false;
    property <string> host-id: root.host.id;
    changed host-id => { root.load-java(); }
    init => { root.load-java(); }
    ScrollView {
        content-width: self.width;
        body := VerticalLayout {
            // Two columns when the page can hold both: what is wrong on the
            // left, what it is made of on the right.
            property <bool> wide: self.width >= 900px;
            alignment: start;
            width: min(parent.width, 1180px);
            padding-left: Theme.lift-room; padding-top: Theme.lift-room; padding-right: Theme.shadow-room;
            padding-bottom: Theme.shadow-room;
            spacing: 14px;
            if root.after-failure : BodyText { text: GuiI18n.value("gui-diagnosis-failure-context", root.host.diagnosis-failure); color: Theme.danger; wrap: word-wrap; }
            // The overall state first, in words and not only in color.
            status := Rectangle {
                property <color> tone: root.state == "failed" ? Theme.danger-soft
                    : root.state == "result" && root.host.diagnosis-healthy ? Theme.ok-soft
                    : root.state == "result" ? Theme.danger-soft
                    : Theme.surface;
                border-radius: Theme.card-radius;
                border-width: Theme.strong-border-width;
                border-color: Theme.border-strong;
                background: self.tone;
                height: outcome.preferred-height;
                outcome := HorizontalLayout {
                    padding: 14px;
                    spacing: 14px;
                    VerticalLayout {
                        alignment: start;
                        Rectangle {
                            width: 36px;
                            height: 36px;
                            border-radius: Theme.small-radius;
                            border-width: Theme.strong-border-width;
                            border-color: Theme.border-strong;
                            background: Theme.surface;
                            if root.working : BusySpinner { width: 18px; height: 18px; }
                            if !root.working : Image {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                width: 20px;
                                height: 20px;
                                source: root.state == "result" && root.host.diagnosis-healthy ? @image-url("../../../../assets/icons/check.svg") : @image-url("../../../../assets/icons/alert.svg");
                                image-fit: contain;
                                colorize: Theme.text;
                                accessible-role: AccessibleRole.none;
                            }
                        }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 4px;
                        if root.state == "unchecked" : DisplayHeading { text: GuiI18n.text("gui-diagnosis-unchecked-title"); font-size: Theme.item-title-size; wrap: word-wrap; }
                        if root.state == "unchecked" : BodyText { text: GuiI18n.text("gui-diagnosis-unchecked"); wrap: word-wrap; }
                        if root.state == "working" : BodyText { text: root.host.diagnosis-progress != "" ? root.host.diagnosis-progress : GuiI18n.text("gui-diagnosis-working"); wrap: word-wrap; }
                        if root.state == "failed" : DisplayHeading { text: GuiI18n.text("gui-diagnosis-failed"); font-size: Theme.item-title-size; wrap: word-wrap; }
                        if root.state == "failed" || root.state == "canceled" : BodyText { text: root.host.diagnosis-error; wrap: word-wrap; }
                        // A result stays readable under a run or a failure that
                        // came after it, set apart so it cannot be mistaken for
                        // the newest answer.
                        if root.has-result && root.state != "unchecked" : VerticalLayout {
                            spacing: 4px;
                            if root.state != "result" : Divider { }
                            DisplayHeading { text: root.host.diagnosis-summary; font-size: Theme.item-title-size; color: root.state == "result" ? Theme.text : Theme.text-secondary; wrap: word-wrap; }
                            BodyText { text: root.host.diagnosis-detail; color: Theme.text-secondary; wrap: word-wrap; }
                            if root.host.diagnosis-stale : BodyText { text: GuiI18n.text("gui-diagnosis-stale"); color: Theme.text-secondary; wrap: word-wrap; }
                        }
                    }
                    VerticalLayout {
                        alignment: start;
                        horizontal-stretch: 0;
                        padding-right: Theme.shadow-room;
                        padding-bottom: Theme.shadow-room;
                        spacing: 8px;
                        AppButton { text: root.has-result ? GuiI18n.text("gui-diagnosis-diagnose-again") : GuiI18n.text("gui-diagnosis-diagnose"); icon: @image-url("../../../../assets/icons/refresh.svg"); tone: root.has-result ? "default" : "primary"; enabled: !root.working; hint: root.blocked-reason; clicked => { root.diagnose(); } }
                        if root.working && root.state == "working" : AppButton { text: GuiI18n.text("gui-diagnosis-stop"); clicked => { root.stop(); } }
                    }
                }
            }
            if root.host.fix-state != "" : FixPanel {
                host: root.host;
                can-apply: !root.working;
                blocked-reason: root.blocked-reason;
                cancel => { root.cancel-fix(); }
                apply => { root.apply-fix(); }
            }
            if root.host.fix-result != "" : Rectangle {
                border-radius: Theme.card-radius;
                border-width: Theme.strong-border-width;
                border-color: root.host.fix-result-failed ? Theme.danger : Theme.border-strong;
                background: Theme.surface;
                height: fixed.preferred-height;
                fixed := VerticalLayout {
                    padding: 12px;
                    spacing: 4px;
                    BodyText { text: root.host.fix-result; color: Theme.text; wrap: word-wrap; }
                    for line in root.host.fix-result-lines : BodyText { text: line; color: Theme.text-secondary; font-size: Theme.caption-size; wrap: word-wrap; }
                }
            }
            // The columns are placed by hand: the right one moves under the
            // left when the page is too narrow for both, and one layout cannot
            // be a row and a column at once.
            Rectangle {
                property <length> gap: 16px;
                // The problems have a column of their own only when there are some.
                property <bool> has-left: root.has-result && root.host.diagnosis-problems.length > 0;
                property <length> left-width: !body.wide ? self.width : self.has-left ? (self.width - self.gap) * 0.45 : 0px;
                property <length> right-x: body.wide && self.has-left ? self.left-width + self.gap : 0px;
                height: body.wide ? max(left.preferred-height, right.preferred-height) : left.preferred-height + (left.preferred-height > 0px ? self.gap : 0px) + right.preferred-height;
                left := VerticalLayout {
                    x: 0px;
                    y: 0px;
                    width: parent.left-width;
                    spacing: 10px;
                    alignment: start;
                    if root.has-result : VerticalLayout {
                        spacing: 10px;
                        for item[index] in root.host.diagnosis-problems : FindingCard {
                            item: item;
                            likely: root.after-failure && index == 0;
                            can-act: !root.working && root.host.fix-state != "applying"; blocked-reason: root.blocked-reason;
                            review-fix(key) => { root.review-fix(key); }
                            open-route(route) => { root.open-route(route); }
                            install(provider, project) => { root.install-mod(provider, project); }
                        }
                    }
                }
                right := VerticalLayout {
                    x: parent.right-x;
                    y: body.wide ? 0px : left.preferred-height + (left.preferred-height > 0px ? parent.gap : 0px);
                    width: parent.width - parent.right-x;
                    spacing: 10px;
                    alignment: start;
                    if root.host.java-choices.length > 0 || root.host.java-error != "" : VerticalLayout {
                        spacing: 8px;
                        HorizontalLayout {
                            spacing: 10px;
                            DisplayHeading { text: GuiI18n.text("gui-java-section"); font-size: Theme.item-title-size; vertical-alignment: bottom; }
                            BodyText { text: root.host.java-expected; color: Theme.text-muted; font-size: Theme.caption-size; vertical-alignment: bottom; overflow: elide; horizontal-stretch: 1; }
                        }
                        if root.host.java-error != "" : BodyText { text: root.host.java-error; color: Theme.danger; wrap: word-wrap; }
                        for choice in root.host.java-choices : JavaChoiceItem {
                            choice: choice;
                            enabled: !root.working && root.host.fix-state != "applying";
                            hint: root.host.fix-state == "applying" ? GuiI18n.text("gui-hint-fix-applying") : root.blocked-reason;
                            chosen => { root.choose-java(choice.key); }
                        }
                    }
                    // A customization is not a problem, and after a failed run it
                    // is not what the user came for, so there it starts folded away.
                    if root.has-result && root.host.diagnosis-customized.length > 0 : VerticalLayout {
                        spacing: 8px;
                        HorizontalLayout {
                            spacing: 10px;
                            DisplayHeading { text: GuiI18n.text("gui-diagnosis-customized-title"); font-size: Theme.item-title-size; vertical-alignment: bottom; }
                            BodyText { text: GuiI18n.text("gui-diagnosis-customized-detail"); color: Theme.text-muted; font-size: Theme.caption-size; vertical-alignment: bottom; overflow: elide; horizontal-stretch: 1; }
                            if root.after-failure : AppButton {
                                text: root.show-other ? GuiI18n.text("gui-diagnosis-hide") : GuiI18n.text("gui-diagnosis-show");
                                accessible-name: (root.show-other ? GuiI18n.text("gui-diagnosis-hide") : GuiI18n.text("gui-diagnosis-show")) + ": " + GuiI18n.count("gui-diagnosis-other-findings", root.host.diagnosis-customized.length);
                                compact: true;
                                clicked => { root.show-other = !root.show-other; }
                            }
                        }
                        if !root.after-failure || root.show-other : CustomizedTable {
                            items: root.host.diagnosis-customized;
                            can-act: !root.working && root.host.fix-state != "applying"; blocked-reason: root.blocked-reason;
                            review-fix(key) => { root.review-fix(key); }
                            open-route(route) => { root.open-route(route); }
                        }
                    }
                    if root.has-result && root.host.diagnosis-checks.length > 0 : VerticalLayout {
                        spacing: 8px;
                        DisplayHeading { text: GuiI18n.text("gui-diagnosis-checked-title"); font-size: Theme.item-title-size; }
                        CheckList { checks: root.host.diagnosis-checks; }
                    }
                }
            }
            Divider { }
            SectionTitle { title: GuiI18n.text("gui-diagnosis-support-title"); detail: GuiI18n.text("gui-diagnosis-support-detail"); }
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                AppButton { text: GuiI18n.text("gui-diagnosis-copy-report"); enabled: root.has-result; hint: GuiI18n.text("gui-diagnosis-copy-report-hint"); clicked => { root.copy-report(); } }
                AppButton { text: GuiI18n.text("gui-integrity-open-logs"); clicked => { root.open-logs(); } }
            }
            HorizontalLayout {
                alignment: start;
                AppButton { text: root.show-bundle ? GuiI18n.text("gui-diagnosis-bundle-hide") : GuiI18n.text("gui-diagnosis-bundle-show"); clicked => { root.show-bundle = !root.show-bundle; } }
            }
            if root.show-bundle : DiagnosticBundlePanel {
                parts: root.host.bundle-parts;
                selection: root.host.bundle-selection;
                selected-count: root.host.bundle-selected-count;
                exporting: root.host.bundle-exporting;
                result: root.host.bundle-result;
                result-path: root.host.bundle-result-path;
                error: root.host.bundle-error;
                toggle(name, value) => { root.toggle-bundle-part(name, value); }
                select-all(value) => { root.select-all-bundle-parts(value); }
                export => { root.export-bundle(); }
                open-folder => { root.open-bundle-folder(); }
            }
        }
    }
}
