// A host's own settings forms: runtime options and server properties.

import { ScrollView } from "std-widgets.slint";
import { ChoiceBox } from "../components/selection.slint";
import { AppButton, BusySpinner, LabeledToggle, Pill, TextField, Toggle } from "../components/controls.slint";
import {
    ActionRow,
    BodyText,
    Divider,
    FieldLabel,
    Heading,
    SectionTitle
} from "../components/text.slint";
import { GuiI18n, PropertyRules, ServerHints } from "../globals.slint";
import { HostView, JavaChoiceRow, ServerPropertyGroup, ServerPropertyRow } from "../models.slint";
import { Theme } from "../theme.slint";
import { FixPanel } from "diagnostics.slint";

// One runtime a host could use, with whether it is the one in use and, when
// the host refuses it, why.
component JavaChoiceItem inherits Rectangle {
    in property <JavaChoiceRow> choice;
    in property <bool> enabled;
    // Why choosing waits while `enabled` is false.
    in property <string> hint;
    callback chosen();
    border-radius: 6px;
    border-width: 1px;
    border-color: root.choice.current ? Theme.accent : Theme.border;
    background: root.choice.current ? Theme.selection-card : Theme.surface;
    height: row.preferred-height;
    accessible-role: AccessibleRole.groupbox;
    accessible-label: root.choice.title;
    row := HorizontalLayout {
        padding: 10px;
        spacing: 10px;
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 2px;
            BodyText { text: root.choice.title; color: root.choice.compatible ? Theme.text : Theme.text-muted; wrap: word-wrap; }
            if root.choice.detail != "" : BodyText { text: root.choice.detail; color: Theme.text-muted; font-size: Theme.caption-size; wrap: word-wrap; }
            if root.choice.reason != "" : BodyText { text: root.choice.reason; color: Theme.warning; font-size: Theme.caption-size; wrap: word-wrap; }
        }
        VerticalLayout {
            alignment: center;
            if root.choice.current : Pill { text: GuiI18n.text("gui-java-choice-current"); tone-color: Theme.accent; }
            if !root.choice.current : AppButton {
                text: GuiI18n.text("gui-java-choice-use");
                accessible-name: GuiI18n.value("gui-java-choice-use-named", root.choice.title);
                enabled: root.enabled && root.choice.compatible;
                hint: !root.choice.compatible ? root.choice.reason : root.hint;
                clicked => { root.chosen(); }
            }
        }
    }
}

// One labeled line of the status card.
component JavaFact inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    spacing: 10px;
    FieldLabel { text: root.label; width: 110px; vertical-alignment: top; }
    BodyText { text: root.value; color: Theme.text-secondary; wrap: word-wrap; horizontal-stretch: 1; }
}

// A host's Java: what it runs, what its Minecraft and loader expect, and the
// runtimes it can switch to. Choosing one opens the same review a Diagnostics
// fix does, and nothing changes until it is applied there.
export component JavaRuntimeSection inherits VerticalLayout {
    in property <HostView> host;
    // Whether a change can be chosen now, and why it waits otherwise.
    in property <bool> can-change: true;
    in property <string> change-hint;
    callback load();
    callback choose(string);
    callback check-path(string);
    callback install();
    callback cancel-fix();
    callback apply-fix();
    property <string> host-id: root.host.id;
    property <color> tone: root.host.java-tone == "healthy" ? Theme.success : root.host.java-tone == "customized" ? Theme.accent-secondary : root.host.java-tone == "problem" ? Theme.warning : Theme.text-secondary;
    changed host-id => { root.load(); }
    init => { root.load(); }
    spacing: 10px;
    SectionTitle { title: GuiI18n.text("gui-java-section"); detail: GuiI18n.text("gui-java-section-detail"); }
    if root.host.java-error != "" : BodyText { text: root.host.java-error; color: Theme.danger; wrap: word-wrap; }
    if root.host.java-tone == "" && root.host.java-error == "" : HorizontalLayout {
        spacing: 8px;
        VerticalLayout { alignment: center; BusySpinner { width: 16px; height: 16px; } }
        BodyText { text: GuiI18n.text("gui-java-loading"); horizontal-stretch: 1; }
    }
    if root.host.java-tone != "" : Rectangle {
        border-radius: 8px;
        border-width: 1px;
        border-color: root.tone.with-alpha(0.55);
        background: Theme.surface;
        height: card.preferred-height;
        accessible-role: AccessibleRole.groupbox;
        accessible-label: GuiI18n.text("gui-java-section");
        card := VerticalLayout {
            padding: 12px;
            spacing: 6px;
            HorizontalLayout {
                spacing: 10px;
                Pill { text: root.host.java-tone-label; tone-color: root.tone; }
                BodyText { text: root.host.java-runtime; color: Theme.text; wrap: word-wrap; horizontal-stretch: 1; }
            }
            if root.host.java-path != "" : JavaFact { label: GuiI18n.text("gui-java-fact-path"); value: root.host.java-path; }
            if root.host.java-origin != "" : JavaFact { label: GuiI18n.text("gui-java-fact-chosen"); value: root.host.java-origin; }
            JavaFact { label: GuiI18n.text("gui-java-fact-expected"); value: root.host.java-expected; }
            if root.host.java-problem != "" : BodyText { text: root.host.java-problem; color: Theme.warning; wrap: word-wrap; }
            if root.host.java-install != "" : HorizontalLayout {
                spacing: 8px;
                AppButton {
                    text: root.host.java-install;
                    enabled: !root.host.java-installing;
                    hint: GuiI18n.text("gui-java-installing");
                    clicked => { root.install(); }
                }
                if root.host.java-installing : VerticalLayout { alignment: center; BusySpinner { width: 16px; height: 16px; } }
                BodyText { text: GuiI18n.text("gui-java-install-detail"); color: Theme.text-muted; font-size: Theme.caption-size; wrap: word-wrap; vertical-alignment: center; horizontal-stretch: 1; }
            }
        }
    }
    if root.host.fix-state != "" : FixPanel {
        host: root.host;
        can-apply: root.can-change;
        blocked-reason: root.change-hint;
        cancel => { root.cancel-fix(); }
        apply => { root.apply-fix(); }
    }
    Heading { text: GuiI18n.text("gui-java-choices"); font-size: Theme.row-heading-size; }
    BodyText { text: GuiI18n.text("gui-java-choices-detail"); color: Theme.text-muted; wrap: word-wrap; }
    for choice in root.host.java-choices : JavaChoiceItem {
        choice: choice;
        enabled: root.can-change && root.host.fix-state != "applying";
        hint: root.host.fix-state == "applying" ? GuiI18n.text("gui-hint-fix-applying") : root.change-hint;
        chosen => { root.choose(choice.key); }
    }
    FieldLabel { text: GuiI18n.text("gui-java-custom-path"); }
    HorizontalLayout {
        spacing: 8px;
        path-field := TextField {
            placeholder: GuiI18n.text("gui-java-custom-path-placeholder");
            accessible-name: GuiI18n.text("gui-java-custom-path");
            accepted => { root.check-path(path-field.text); }
        }
        AppButton {
            text: GuiI18n.text("gui-java-custom-check");
            enabled: !root.host.java-custom-checking && path-field.text != "";
            hint: root.host.java-custom-checking ? GuiI18n.text("gui-java-custom-checking") : GuiI18n.text("gui-java-custom-path-empty");
            clicked => { root.check-path(path-field.text); }
        }
    }
    if root.host.java-custom-checking : HorizontalLayout {
        spacing: 8px;
        VerticalLayout { alignment: center; BusySpinner { width: 16px; height: 16px; } }
        BodyText { text: GuiI18n.text("gui-java-custom-checking"); horizontal-stretch: 1; }
    }
    if root.host.java-custom-error != "" : BodyText { text: root.host.java-custom-error; color: Theme.danger; wrap: word-wrap; }
    for choice in root.host.java-custom : JavaChoiceItem {
        choice: choice;
        enabled: root.can-change && root.host.fix-state != "applying";
        hint: root.host.fix-state == "applying" ? GuiI18n.text("gui-hint-fix-applying") : root.change-hint;
        chosen => { root.choose(choice.key); }
    }
}

// A client's or a server's own runtime settings, edited here and saved
// together. The fields start from what is stored and start over whenever it
// is read again or the pane shows another host.
export component HostRuntimeForm inherits ScrollView {
    in property <HostView> host;
    in property <string> error;
    // (minimum memory, maximum memory, arguments)
    callback save(string, string, string);
    callback load-java();
    callback choose-java(string);
    callback check-java-path(string);
    callback install-java();
    callback cancel-fix();
    callback apply-fix();
    in property <bool> busy;
    callback clear();
    callback allow-pack-mod-changes(bool);
    callback open-global-defaults();
    property <bool> for-client: root.host.kind == "client";
    property <int> revision: root.host.runtime-revision;
    property <string> host-id: root.host.id;
    changed revision => { root.reset(); }
    changed host-id => { root.reset(); }
    init => { root.reset(); }
    function reset() {
        min-field.text = root.host.runtime-memory-min;
        max-field.text = root.host.runtime-memory-max;
        args-field.text = root.host.runtime-jvm-args;
    }
    viewport-width: self.width;
    VerticalLayout { alignment: start; width: min(parent.width, 720px); spacing: 12px; padding-left: Theme.lift-room; padding-top: Theme.lift-room; padding-right: Theme.shadow-room; padding-bottom: Theme.shadow-room;
        SectionTitle { title: GuiI18n.text("gui-instance-runtime"); detail: root.for-client ? GuiI18n.text("gui-instance-runtime-detail") : GuiI18n.text("gui-server-runtime-detail"); }
        BodyText { text: root.host.runtime-global; color: Theme.text-muted; wrap: word-wrap; }
        HorizontalLayout { spacing: 12px;
            VerticalLayout { spacing: 4px; FieldLabel { text: GuiI18n.text("gui-java-memory-min"); } min-field := TextField { placeholder: GuiI18n.text("gui-instance-runtime-inherited"); accessible-name: GuiI18n.text("gui-java-memory-min"); input-type: InputType.number; width: 190px; } }
            VerticalLayout { spacing: 4px; FieldLabel { text: GuiI18n.text("gui-java-memory-max"); } max-field := TextField { placeholder: GuiI18n.text("gui-instance-runtime-inherited"); accessible-name: GuiI18n.text("gui-java-memory-max"); input-type: InputType.number; width: 190px; } }
            Rectangle { horizontal-stretch: 1; }
        }
        Text { text: GuiI18n.text("gui-instance-jvm-args"); color: Theme.text-secondary; font-size: Theme.label-size; }
        args-field := TextField { placeholder: GuiI18n.text("gui-instance-jvm-args-placeholder"); accessible-name: GuiI18n.text("gui-instance-jvm-args"); }
        if root.error != "" : BodyText { text: root.error; color: Theme.danger; wrap: word-wrap; }
        HorizontalLayout { spacing: 8px;
            if root.host.runtime-pinned : AppButton { text: GuiI18n.text("gui-instance-runtime-clear"); clicked => { root.clear(); } }
            Rectangle { horizontal-stretch: 1; }
            AppButton { text: GuiI18n.text("gui-instance-runtime-save"); tone: "primary"; clicked => { root.save(min-field.text, max-field.text, args-field.text); } }
        }
        Divider { }
        SectionTitle { title: GuiI18n.text("gui-allow-pack-mod-changes"); detail: root.for-client ? GuiI18n.text("gui-allow-pack-mod-changes-detail") : GuiI18n.text("gui-allow-pack-mod-changes-server-detail"); }
        // Its position is what the host records, read back after the change.
        LabeledToggle { width: min(parent.width, 520px); label: root.for-client ? GuiI18n.text("gui-allow-pack-mod-changes-toggle") : GuiI18n.text("gui-allow-pack-mod-changes-server-toggle"); checked: root.host.allow-pack-mod-changes; enabled: !root.host.pack-mod-changes-fixed; sets-its-own-position: false; toggled(value) => { root.allow-pack-mod-changes(value); } }
        Divider { }
        JavaRuntimeSection {
            host: root.host;
            can-change: !root.busy;
            change-hint: GuiI18n.text("gui-hint-busy");
            load => { root.load-java(); }
            choose(key) => { root.choose-java(key); }
            check-path(path) => { root.check-java-path(path); }
            install => { root.install-java(); }
            cancel-fix => { root.cancel-fix(); }
            apply-fix => { root.apply-fix(); }
        }
        if root.for-client : Divider { }
        if root.for-client : SectionTitle { title: GuiI18n.text("gui-instance-settings-unavailable"); detail: GuiI18n.text("gui-instance-settings-unavailable-detail"); }
        if root.for-client : HorizontalLayout { AppButton { text: GuiI18n.text("gui-open-global-defaults"); clicked => { root.open-global-defaults(); } } Rectangle { horizontal-stretch: 1; } }
    }
}

// One server.properties key: what it does, its value, and whether the
// running server still has to read it.
export component ServerPropertyRowView inherits Rectangle {
    in property <ServerPropertyRow> item;
    // Whether the server still runs the process that predates the save.
    in property <bool> restart-pending;
    // Draws the line that separates it from the row above.
    in property <bool> separated;
    callback edited(string);
    callback chosen(int);
    callback reset();
    // Left to itself, the row measures its wrapped lines unwrapped.
    height: body.preferred-height;
    accessible-role: AccessibleRole.groupbox;
    accessible-label: root.item.label;
    if root.separated : Rectangle { x: 0px; y: 0px; width: parent.width; height: 1px; background: Theme.border; }
    body := HorizontalLayout {
        padding-top: 12px;
        padding-bottom: 12px;
        padding-left: 16px;
        padding-right: 16px;
        spacing: 24px;
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 3px;
            HorizontalLayout {
                spacing: 8px;
                BodyText { text: root.item.label; color: Theme.text; vertical-alignment: center; horizontal-stretch: 0; }
                if root.item.changed : VerticalLayout { alignment: center; Pill { text: GuiI18n.text("gui-property-changed"); tone-color: Theme.accent; content-height: 20px; } }
                if root.item.awaiting-restart && root.restart-pending : VerticalLayout { alignment: center; Pill { text: GuiI18n.text("gui-property-restart"); tone-color: Theme.warning; content-height: 20px; } }
                Rectangle { horizontal-stretch: 1; }
            }
            BodyText { text: root.item.detail; color: Theme.text-muted; font-size: Theme.caption-size; wrap: word-wrap; }
            if root.item.note != "" : BodyText { text: root.item.note; color: Theme.text-muted; font-size: Theme.caption-size; wrap: word-wrap; }
            if root.item.error != "" : BodyText { text: root.item.error; color: Theme.danger; font-size: Theme.caption-size; wrap: word-wrap; }
        }
        if root.item.can-reset : VerticalLayout {
            alignment: center;
            AppButton { text: GuiI18n.text("gui-property-reset"); accessible-name: GuiI18n.value("gui-property-reset-named", root.item.label); clicked => { root.reset(); } }
        }
        VerticalLayout {
            alignment: center;
            width: 240px;
            if root.item.kind == "toggle" : HorizontalLayout {
                alignment: end;
                Toggle { accessible-name: root.item.label; checked: root.item.checked; sets-its-own-position: false; toggled(value) => { root.edited(value ? "true" : "false"); } }
            }
            if root.item.kind == "choice" : ChoiceBox {
                accessible-label: root.item.label;
                model: root.item.choices;
                current-index: root.item.choice-index;
                selected(value) => { root.chosen(self.current-index); }
            }
            if root.item.kind == "integer" || root.item.kind == "text" : TextField {
                accessible-name: root.item.label;
                text: root.item.text;
                placeholder: root.item.placeholder;
                invalid: root.item.error != "";
                edited(value) => { root.edited(value); }
            }
        }
    }
}

// One group of server.properties settings as a card: its heading, then its
// rows. A server's Properties and the defaults in Settings both use it.
export component ServerPropertyGroupCard inherits Rectangle {
    in property <ServerPropertyGroup> group;
    in property <bool> restart-pending;
    callback edited(string, string);
    callback chosen(string, int);
    callback reset(string);
    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.surface;
    // Left to itself, the card measures its wrapped lines unwrapped.
    height: card.preferred-height;
    accessible-role: AccessibleRole.groupbox;
    accessible-label: root.group.heading;
    card := VerticalLayout {
        padding-top: 12px;
        padding-bottom: 4px;
        HorizontalLayout { padding-left: 16px; padding-right: 16px; padding-bottom: 4px; Heading { text: root.group.heading; font-size: Theme.row-heading-size; } }
        for row[index] in root.group.rows : ServerPropertyRowView {
            item: row;
            separated: index > 0;
            restart-pending: root.restart-pending;
            edited(value) => { root.edited(row.key, value); }
            chosen(position) => { root.chosen(row.key, position); }
            reset => { root.reset(row.key); }
        }
    }
}

// A server's properties, edited here and saved together. The network fields
// start from what is stored and start over when it is read again or the pane
// shows another host; the other settings are rows the controller keeps,
// edits included.
export component ServerPropertiesForm inherits VerticalLayout {
    in property <HostView> host;
    in property <bool> eula-accepted;
    in property <string> eula-status;
    // (server, online mode, access, address, port)
    callback save(string, bool, string, string, string);
    callback edit(string, string, string);
    callback choose(string, string, int);
    callback show-advanced(string, bool);
    callback discard(string);
    callback review-eula();
    property <string> access;
    property <bool> online-mode;
    property <string> port-error: PropertyRules.port-error(port-field.text);
    property <string> address-error: PropertyRules.address-error(address-field.text, root.access == "Custom");
    property <int> revision: root.host.properties-revision;
    property <string> host-id: root.host.id;
    // The process keeps the network settings it started with, so they wait
    // for a stop; everything else is saved for its restart.
    property <string> state-kind: root.host.server.state-kind;
    property <bool> running: root.state-kind == "running";
    // Apart, because one expression calling both moves the state twice in
    // the generated code.
    property <bool> state-allows-save: ServerHints.can-save(root.state-kind);
    property <string> state-save-hint: ServerHints.save(root.state-kind);
    property <bool> restarting: root.host.server.restart-stage != "";
    property <bool> network-valid: root.port-error == "" && root.address-error == "";
    // The network fields differ from what is stored.
    property <bool> network-edited: root.access != root.host.property-access
        || root.online-mode != root.host.property-online-mode
        || port-field.text != root.host.property-port
        || (root.access == "Custom" && address-field.text != root.host.property-address);
    property <int> unsaved: root.host.property-edits + (root.network-edited ? 1 : 0);
    changed revision => { root.reset-network(); }
    changed host-id => { root.reset-network(); }
    // A network edit left unsaved cannot be saved or undone in disabled fields.
    changed running => { if root.running { root.reset-network(); } }
    init => { root.reset-network(); }
    function reset-network() {
        root.access = root.host.property-access;
        root.online-mode = root.host.property-online-mode;
        port-field.text = root.host.property-port;
        address-field.text = root.host.property-address;
        access-box.current-index = root.access == "LAN" ? 1 : root.access == "Custom" ? 2 : 0;
    }
    spacing: 0px;
    ScrollView {
        vertical-stretch: 1;
        viewport-width: self.visible-width;
        VerticalLayout { alignment: start; width: min(parent.width, 1100px); spacing: 14px; padding-right: 12px; padding-bottom: 12px;
            if root.running && !root.host.server.restart-required : BodyText { text: GuiI18n.text("gui-server-properties-running"); color: Theme.text-secondary; wrap: word-wrap; }
            if root.host.server.restart-required : HorizontalLayout { alignment: start; Pill { text: GuiI18n.text("gui-server-restart-required"); tone-color: Theme.warning; } }
            if root.host.server.restart-required : BodyText { text: GuiI18n.text("gui-server-restart-required-detail"); color: Theme.warning; wrap: word-wrap; }
            Rectangle { border-radius: 8px; border-width: 1px; border-color: Theme.border; background: Theme.surface;
                // Left to itself, the card measures its wrapped lines unwrapped.
                height: network-card.preferred-height;
                network-card := VerticalLayout { padding: 16px; spacing: 10px;
            Heading { text: GuiI18n.text("gui-network"); font-size: Theme.row-heading-size; } BodyText { text: root.running ? GuiI18n.text("gui-network-detail-running") : GuiI18n.text("gui-network-detail"); color: Theme.text-muted; wrap: word-wrap; }
            HorizontalLayout { spacing: 12px; VerticalLayout { FieldLabel { text: GuiI18n.text("gui-access"); } access-box := ChoiceBox { enabled: !root.running; model: [GuiI18n.text("gui-access-localhost"), GuiI18n.text("gui-access-lan"), GuiI18n.text("gui-access-custom")]; selected(value) => { root.access = value == GuiI18n.text("gui-access-lan") ? "LAN" : value == GuiI18n.text("gui-access-custom") ? "Custom" : "Localhost"; } width: 190px; } Rectangle { height: 14px; } } VerticalLayout { FieldLabel { text: GuiI18n.text("gui-port"); } port-field := TextField { placeholder: "25565"; enabled: !root.running; input-type: InputType.number; invalid: root.port-error != ""; width: 150px; } Rectangle { height: 14px; Text { text: root.port-error; visible: root.port-error != ""; color: Theme.danger; font-size: Theme.caption-size; } } } VerticalLayout { horizontal-stretch: 1; FieldLabel { text: GuiI18n.text("gui-custom-bind-address"); } address-field := TextField { placeholder: "127.0.0.1 or ::1"; enabled: root.access == "Custom" && !root.running; invalid: root.address-error != ""; } Rectangle { height: 14px; Text { text: root.address-error; visible: root.address-error != ""; color: Theme.danger; font-size: Theme.caption-size; } } } }
            Rectangle { height: 32px; HorizontalLayout { spacing: 10px; LabeledToggle { label: GuiI18n.text("gui-online-mode"); enabled: !root.running; checked <=> root.online-mode; } BodyText { visible: !root.online-mode && root.access != "Localhost"; text: GuiI18n.text("gui-network-warning"); color: Theme.warning; } } }
                }
            }
            Rectangle { height: eula-card.preferred-height; border-radius: 8px; border-width: 1px; border-color: root.eula-accepted ? Theme.success : Theme.warning; background: Theme.surface;
                eula-card := HorizontalLayout { padding: 14px; spacing: 14px;
                    VerticalLayout { horizontal-stretch: 1; spacing: 2px; Heading { text: GuiI18n.text("gui-server-eula"); font-size: Theme.row-heading-size; } BodyText { text: root.eula-status; wrap: word-wrap; } }
                    VerticalLayout { alignment: center; AppButton { text: root.eula-accepted ? GuiI18n.text("gui-eula-review") : GuiI18n.text("gui-eula-review-accept"); clicked => { root.review-eula(); } } }
                }
            }
            HorizontalLayout { spacing: 12px; padding-top: 8px;
                VerticalLayout { horizontal-stretch: 1; spacing: 2px; Heading { text: GuiI18n.text("gui-server-settings"); } BodyText { text: GuiI18n.text("gui-server-settings-detail"); color: Theme.text-muted; wrap: word-wrap; } }
                VerticalLayout { alignment: center; LabeledToggle { label: GuiI18n.text("gui-server-settings-advanced"); checked: root.host.property-show-advanced; sets-its-own-position: false; toggled(value) => { root.show-advanced(root.host.id, value); } } }
            }
            for group in root.host.property-groups : ServerPropertyGroupCard {
                group: group;
                restart-pending: root.host.server.restart-required;
                edited(key, value) => { root.edit(root.host.id, key, value); }
                chosen(key, index) => { root.choose(root.host.id, key, index); }
            }
        }
    }
    Divider { }
    ActionRow {
        padding-top: 10px;
        BodyText { text: root.unsaved > 0 ? GuiI18n.count("gui-property-unsaved-count", root.unsaved) : GuiI18n.text("gui-property-no-unsaved"); color: root.unsaved > 0 ? Theme.accent : Theme.text-muted; vertical-alignment: center; }
        Rectangle { horizontal-stretch: 1; }
        AppButton { text: GuiI18n.text("gui-discard-changes"); enabled: root.unsaved > 0; hint: GuiI18n.text("gui-hint-no-unsaved-changes"); clicked => { root.discard(root.host.id); root.reset-network(); } }
        AppButton { text: GuiI18n.text("gui-save-changes"); tone: "primary"; enabled: root.state-allows-save && !root.restarting && !root.host.property-edits-invalid && root.network-valid; hint: root.restarting ? GuiI18n.text("gui-hint-save-server-restarting") : !root.state-allows-save ? root.state-save-hint : GuiI18n.text("gui-hint-fix-property-values"); clicked => { root.save(root.host.id, root.online-mode, root.access, address-field.text, port-field.text); } }
    }
}
