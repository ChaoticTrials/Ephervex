// The logo and wordmark above the list, and the refresh button.

import { IconButton } from "../components/controls.slint";
import { DisplayHeading } from "../components/text.slint";
import { GuiI18n } from "../globals.slint";
import { Theme } from "../theme.slint";

export component BrandBar inherits HorizontalLayout {
    in property <image> logo;
    callback refresh();
    spacing: 12px;
    // No `alignment`: under anything but the default every cell is given its
    // preferred size, which would collapse the stretch cell below.
    cross-axis-alignment: center;
    Image { source: root.logo; width: 40px; height: 40px; image-fit: contain; accessible-label: GuiI18n.text("gui-logo-accessible"); }
    DisplayHeading {
        text: "Ephervex".to-uppercase();
        font-size: Theme.brand-size;
        letter-spacing: 1px;
    }
    Rectangle { horizontal-stretch: 1; }
    // The hard shadow of the button falls outside it.
    IconButton {
        icon: @image-url("../../../../assets/icons/refresh.svg");
        accessible-name: GuiI18n.text("gui-refresh");
        clicked => { root.refresh(); }
    }
    Rectangle { width: Theme.shadow-room; }
}
