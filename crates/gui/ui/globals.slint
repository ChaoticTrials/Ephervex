// Globals whose answers come from the Rust side: localized text and validation rules.

export global GuiI18n {
    pure callback text(string) -> string;
    pure callback count(string, int) -> string;
    pure callback value(string, string) -> string;
    pure callback values(string, string, string) -> string;
}

// The images hosts show as icons. A row names one by its position here
// (`icon-slot`), because an image inside a row would never compare equal to
// itself and every refresh would rewrite every row.
export global HostIcons {
    in-out property <[image]> images;
}

// Whether a server property value is acceptable, answered by the same
// checks saving applies. Empty when it is; otherwise what is wrong.
export global PropertyRules {
    pure callback port-error(string) -> string;
    // (address, whether a custom address is in use)
    pure callback address-error(string, bool) -> string;
    // (value, whether the file holds no maximum)
    pure callback players-error(string, bool) -> string;
    // (comma-separated keys the file does not hold, property key)
    pure callback is-unset(string, string) -> bool;
    // The keys given, less the one the user has just set.
    pure callback without-unset(string, string) -> string;
    // (property key, stored value, whether the file holds no such key): the
    // entries a choice control lists, and which of them shows the stored value
    pure callback choice-model(string, string, bool) -> [string];
    pure callback choice-index(string, string, bool) -> int;
    // (property key, stored value, entry picked, whether the file holds no
    // such key): the value to save, empty to leave the key out
    pure callback choice-value(string, string, string, bool) -> string;
}

// The name a server takes when nobody types one, derived by the same rules
// creation applies so accepting the suggestion never fails.
export global NameRules {
    pure callback linked-server-name(string) -> string;
}

// Why a new server's selection disagrees with the server files it would be
// built from, answered by the same check creation refuses with. Empty when it
// agrees. (Minecraft release, loader, loader build, then what the files name:
// release, loader, build, whether they carry mods.)
export global ServerPackRules {
    pure callback conflict(string, string, string, string, string, string, bool) -> string;
}

// Why a server's Start/Stop, Restart or Force kill is unavailable, read from
// the state the server is in. A start or stop is blamed only when one is
// really under way.
export global ServerHints {
    pure function uncontrolled(state-kind: string) -> bool {
        return state-kind == "unknown" || state-kind == "orphaned";
    }
    pure public function start(state-kind: string, installed: bool) -> string {
        if (uncontrolled(state-kind)) {
            return GuiI18n.text("gui-hint-server-uncontrolled-start");
        }
        if (state-kind == "needs-recovery") {
            return GuiI18n.text("gui-hint-server-needs-recovery");
        }
        if (!installed) {
            return GuiI18n.text("gui-hint-server-not-installed");
        }
        return GuiI18n.text("gui-hint-state-changing");
    }
    pure public function restart(state-kind: string) -> string {
        if (uncontrolled(state-kind)) {
            return GuiI18n.text("gui-hint-stop-server-uncontrolled");
        }
        if (state-kind == "stopped" || state-kind == "needs-recovery") {
            return GuiI18n.text("gui-hint-restart-server-stopped");
        }
        return GuiI18n.text("gui-hint-restart-server-unavailable");
    }
    // A failed run leaves the server stopped, so its settings stay editable.
    // A running server reads what is saved once it restarts.
    pure public function can-save(state-kind: string) -> bool {
        return state-kind == "stopped" || state-kind == "failed" || state-kind == "running";
    }
    pure public function save(state-kind: string) -> string {
        if (uncontrolled(state-kind)) {
            return GuiI18n.text("gui-hint-save-server-uncontrolled");
        }
        if (state-kind == "needs-recovery") {
            return GuiI18n.text("gui-hint-server-needs-recovery");
        }
        if (state-kind == "stopping") {
            return GuiI18n.text("gui-hint-save-server-stopping");
        }
        return GuiI18n.text("gui-hint-save-server-starting");
    }
    pure public function kill(state-kind: string) -> string {
        if (uncontrolled(state-kind)) {
            return GuiI18n.text("gui-hint-stop-server-uncontrolled");
        }
        return GuiI18n.text("gui-hint-force-kill-server");
    }
}
