                                                if server.state-kind == "needs-recovery" : AppButton { text: GuiI18n.text("gui-repair-server"); tone: "primary"; clicked => { root.repair-server(server.id); } }
                                                AppButton { text: card.paired ? GuiI18n.text("gui-unpair") : GuiI18n.text("gui-pair-this-server"); clicked => { if card.paired { root.clear-linked-pair(host.id); } else { root.set-linked-pair(host.id, server.id, false); } } }
                                                AppButton { text: GuiI18n.text("gui-delete-server"); tone: "danger"; clicked => { root.pending-action-id = server.id; root.pending-action-name = server.name; root.pending-snapshot-deletion-note = server.snapshot-deletion-note; root.modal-error = ""; root.modal = "delete-server"; } }
