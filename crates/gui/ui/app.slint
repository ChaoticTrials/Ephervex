+ root.mod-impact-unidentifiable.length + root.mod-requires-disabled.length + root.mod-requires-absent.length + root.mod-requires-incompatible.length) * 24px, parent.height - 80px) : root.modal == "delete-mod" ? 320px : root.modal == "mod-stand-in" ? min(340px * Theme.text-scale, parent.height - 80px) : root.modal == "remove-java-runtime" ? (root.pending-java-pinning == "" && root.pending-java-pins-known ? 320px : 320px + 66px * Theme.text-scale) : root.modal == "mod-clash" ? 380px : root.modal == "absent-mods" ? min(250px + root.absent-mods.length * 22px, parent.height - 80px) : root.modal == "make-persistent" ? min(290px + root.promote-servers.length * 28px, parent.height - 80px) : root.modal == "open-pack-link" ? 300px : root.modal == "theme-problems" ? min(260px * Theme.text-scale + root.theme-problems.length * 44px, parent.height - 80px) : root.modal == "create-server" ? min((root.create-server-client-id == "" ? 640px : 535px) + (root.create-server-client-id == "" && root.create-server-loader != "Vanilla" ? 44px : 0px) + (root.create-server-pack != "" && root.create-server-pack-note != "" ? 44px : 0px), parent.height - 80px) : 570px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            radius: Theme.dialog-radius;
            lift: Theme.shadow-offset-dialog;
            fill: Theme.elevated;
            accessible-role: groupbox;
            accessible-label: root.modal == "create-instance" ? GuiI18n.text("gui-modal-new-instance") : "";
            // A header in the color of what is being made, for the dialogs
            // that make something.
            if root.modal == "create-instance" || root.modal == "create-server" || root.modal == "add-mods" : Rectangle {
                x: Theme.strong-border-width;
                y: Theme.strong-border-width;
                width: parent.width - 2 * Theme.strong-border-width;
                height: 22px + title-row.preferred-height + 13px - Theme.strong-border-width;
                clip: true;
                Rectangle {
                    width: parent.width;
                    height: parent.height + Theme.dialog-radius;
                    border-radius: Theme.dialog-radius;
                    background: root.modal == "create-server" ? Theme.state-stopped : root.modal == "add-mods" ? Theme.state-running : Theme.background;
                }
            }
            modal-body := VerticalLayout { padding: 22px; spacing: 13px;
                title-row := HorizontalLayout { cross-axis-alignment: center; spacing: 12px; // A name or a version is long and unpredictable, so those titles stay in the body face and elide.
                    property <string> title-text: root.modal == "add-mods" ? GuiI18n.value("gui-modal-add-mods-for", root.host-views[root.add-mods-host].kind == "server" ? root.host-views[root.add-mods-host].server.name : root.host-views[root.add-mods-host].client.name) : root.modal == "microsoft-sign-in" ? GuiI18n.text("gui-modal-microsoft-sign-in") : root.modal == "pane-host" ? GuiI18n.text("gui-modal-pane-host") : root.modal == "create-instance" ? GuiI18n.text("gui-modal-new-instance") : root.modal == "import" ? GuiI18n.text("gui-modal-import") : root.modal == "create-server" ? (root.create-server-client-id != "" ? GuiI18n.text("gui-create-linked-server") : GuiI18n.text("gui-modal-new-server")) : root.modal == "mod-plan" ? GuiI18n.text("gui-modal-install-mod") : root.modal == "mod-manage" ? GuiI18n.text("gui-modal-manage-mod") : root.modal == "mod-acquire" ? GuiI18n.text("gui-modal-mod-acquire") : root.modal == "loader-change" ? GuiI18n.text("gui-modal-change-loader") : root.modal == "mod-remove" ? GuiI18n.text("gui-modal-remove-mod") : root.modal == "mod-apply" ? GuiI18n.text("gui-modal-apply-mod") : root.modal == "mod-result" ? GuiI18n.text("gui-modal-mod-result") : root.modal == "eula" ? GuiI18n.text("gui-server-eula") : root.modal == "kill" ? GuiI18n.text("gui-modal-force-kill") : root.modal == "delete-instance" ? GuiI18n.text("gui-delete-instance") : root.modal == "delete-server" ? GuiI18n.text("gui-delete-server") : root.modal == "launcher-bundle" ? GuiI18n.text("gui-launcher-bundle-save-title") : root.modal == "groups" ? GuiI18n.text("gui-modal-groups") : root.modal == "rename" ? (root.pending-action-kind == "new-group" ? GuiI18n.text("gui-modal-new-group") : GuiI18n.text("gui-modal-rename")) : root.modal == "snapshot-create" ? GuiI18n.text("gui-snapshot-create") : root.modal == "snapshot-restore" ? GuiI18n.text("gui-snapshot-restore") : root.modal == "snapshot-rename" ? GuiI18n.text("gui-snapshot-rename") : root.modal == "snapshot-delete" ? GuiI18n.text("gui-snapshot-delete") : root.modal == "mod-impact" ? GuiI18n.value(root.mod-impact-enabling ? "gui-mod-impact-enable-title" : "gui-mod-impact-disable-title", root.mod-impact-name) : root.modal == "delete-mod" ? GuiI18n.text("gui-modal-delete-mod") : root.modal == "mod-stand-in" ? GuiI18n.text("gui-modal-mod-stand-in") : root.modal == "remove-java-runtime" ? GuiI18n.text("gui-java-remove-runtime-title") : root.modal == "storage-cleanup" ? GuiI18n.text("gui-storage-cleanup-title") : root.modal == "mod-clash" ? GuiI18n.text("gui-modal-mod-clash") : root.modal == "absent-mods" ? GuiI18n.text("gui-modal-absent-mods") : root.modal == "make-persistent" ? GuiI18n.text("gui-make-persistent") : root.modal == "open-pack-link" ? GuiI18n.text("gui-open-pack-link") : root.modal == "theme-problems" ? GuiI18n.text("gui-modal-theme-problems") : root.modal == "license" ? GuiI18n.text("gui-modal-apache-license") : root.third-party-open >= 0 ? root.third-party-packages[root.third-party-open].name + " " + root.third-party-packages[root.third-party-open].version + " | " + root.third-party-packages[root.third-party-open].license : GuiI18n.text("gui-third-party-licenses"); property <bool> dynamic-title: root.modal == "mod-impact" || (root.modal == "third-party" && root.third-party-open >= 0); if !title-row.dynamic-title : DisplayHeading { text: title-row.title-text; font-size: Theme.modal-title-size; overflow: elide; horizontal-stretch: 1; } if title-row.dynamic-title : Heading { text: title-row.title-text; font-size: Theme.modal-title-size; overflow: elide; horizontal-stretch: 1; } IconButton { icon: @image-url("../../../assets/icons/close.svg"); accessible-name: GuiI18n.text("gui-close"); clicked => { if root.modal == "import" { root.close-import-modal(); } else if root.modal == "mod-stand-in" { root.answer-mod-stand-in(root.mod-stand-in-id, false); } else { if root.modal == "mod-plan" { root.abandon-browser-install(); } if root.modal == "mod-acquire" { root.cancel-mod-acquisition(root.mod-acquisition-id); } if root.modal == "open-pack-link" { root.cancel-pack-link(); } if root.modal == "microsoft-sign-in" { root.cancel-microsoft-sign-in(); } root.modal = ""; root.modal-error = ""; } } } }
                Divider { }
                if root.modal == "add-mods" && root.add-mods-host >= 0 : ModBrowser {
                    vertical-stretch: 1;
                    host: root.host-views[root.add-mods-host];
                    page-sizes: root.mod-page-sizes;
                    page-size-label: root.mod-page-size-label;
                    switch-catalog(provider) => { root.switch-mod-catalog(self.host.kind, self.host.id, provider); }
                    search(provider, text) => { root.search-mods(self.host.kind, self.host.id, provider, text); }
                    load-more(provider, text, offset) => { root.load-more-mods(self.host.kind, self.host.id, provider, text, offset); }
                    install(project) => { root.install-from-browser(self.host.kind, self.host.id, self.host.browser-provider, project); }
                    set-include-incompatible(on) => { root.set-mod-include-incompatible(self.host.kind, self.host.id, on); }
                    set-page-size(label) => { root.set-mod-page-size(label); }
                    open-provider-settings => { root.modal = ""; root.open-settings("Providers & APIs"); }
                }
                if root.modal == "create-instance" : VerticalLayout {
                    spacing: 10px;
                    ScrollView {
                    vertical-stretch: 1;
                    content-width: self.visible-width;
                    VerticalLayout {
                        alignment: start;
                        spacing: 14px;
                        padding-left: Theme.lift-room;
                        padding-top: Theme.lift-room;
                        padding-right: Theme.shadow-room;
                        padding-bottom: Theme.shadow-room;
                        SectionHeading { title: GuiI18n.text("gui-create-basics"); }
                        HorizontalLayout {
                            spacing: 16px;
                            VerticalLayout { horizontal-stretch: 1; spacing: 4px; alignment: start;
                                FieldCaption { label: GuiI18n.text("gui-name"); note: GuiI18n.text("gui-create-name-note"); }
                                TextField { text <=> root.create-name; placeholder: root.create-name-suggestion; accessible-name: GuiI18n.text("gui-name"); }
                            }
                            VerticalLayout { horizontal-stretch: 1; spacing: 4px; alignment: start;
                                FieldCaption { label: GuiI18n.text("gui-issue-link"); note: GuiI18n.text("gui-create-optional"); }
                                TextField { text <=> root.create-issue-link; placeholder: GuiI18n.text("gui-issue-link-placeholder"); accessible-name: GuiI18n.text("gui-issue-link-optional"); }
                            }
                        }
                        HorizontalLayout {
                            spacing: 16px;
                            VerticalLayout { horizontal-stretch: 1; spacing: 4px; alignment: start;
                                FieldCaption { label: GuiI18n.text("gui-minecraft"); note: GuiI18n.text("gui-create-favorite-note"); }
                                HorizontalLayout {
                                    spacing: 8px;
                                    ValueComboBox {
                                        horizontal-stretch: 1;
                                        label: GuiI18n.text("gui-minecraft-release");
                                        model: root.minecraft-releases;
                                        value: root.create-minecraft;
                                        selected(value) => { root.create-minecraft = value; root.create-loader-version = ""; root.create-loader-versions = []; root.minecraft-selection-changed("client", value); if root.create-loader != "Vanilla" { root.request-loader-catalog("client", root.create-loader, value); } root.recompute-create-name(); }
                                    }
                                    FavoriteToggle { version: root.create-minecraft; favorite: root.create-minecraft-favorite; enabled: root.create-minecraft != ""; hint: GuiI18n.text("gui-hint-choose-minecraft-release"); toggled => { root.toggle-favorite-version(root.create-minecraft); } }
                                }
                            }
                            VerticalLayout { horizontal-stretch: 1; spacing: 4px; alignment: start;
                                FieldCaption { label: GuiI18n.text("gui-loader"); }
                                HorizontalLayout { padding-right: Theme.shadow-room; padding-bottom: Theme.shadow-room;
                                    SegmentedChoice {
                                        horizontal-stretch: 1;
                                        accessible-name: GuiI18n.text("gui-loader");
                                        options: root.create-loaders;
                                        current-value: root.create-loader;
                                        chosen(value) => { root.create-loader = value; root.create-loader-version = ""; root.create-loader-versions = []; if value != "Vanilla" { root.request-loader-catalog("client", value, root.create-minecraft); } root.recompute-create-name(); }
                                    }
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: 16px;
                            VerticalLayout { horizontal-stretch: 1; spacing: 4px; alignment: start;
                                FieldCaption { label: GuiI18n.text("gui-loader-build"); note: GuiI18n.text("gui-create-build-note"); }
                                ValueComboBox {
                                    label: GuiI18n.text("gui-loader-version-placeholder");
                                    enabled: root.create-loader != "Vanilla";
                                    model: root.create-loader-versions;
                                    value: root.create-loader-version;
                                    selected(value) => { root.create-loader-version = value; }
                                    changed value => { root.recompute-create-name(); }
                                }
                            }
                            VerticalLayout { horizontal-stretch: 1; spacing: 4px; alignment: start;
                                FieldCaption { label: GuiI18n.text("gui-storage"); }
                                HorizontalLayout { padding-right: Theme.shadow-room; padding-bottom: Theme.shadow-room;
                                    SegmentedChoice {
                                        horizontal-stretch: 1;
                                        accessible-name: GuiI18n.text("gui-storage");
                                        options: [GuiI18n.text("gui-temporary"), GuiI18n.text("gui-persistent")];
                                        current: root.create-persistent ? 1 : 0;
                                        selected(index) => { root.create-persistent = index == 1; }
                                    }
                                }
                            }
                        }
                        SectionHeading { title: GuiI18n.text("gui-linked-server-heading"); detail: GuiI18n.text("gui-create-optional"); }
                        HorizontalLayout { padding-right: Theme.shadow-room; padding-bottom: Theme.shadow-room;
                            CheckRow {
                                label: GuiI18n.text("gui-create-with-server");
                                note: GuiI18n.text("gui-create-with-server-note");
                                checked: root.create-linked-server;
                                toggled(value) => { root.create-linked-server = value; }
                            }
                        }
                        if root.create-linked-server : HorizontalLayout {
                            spacing: 16px;
                            VerticalLayout { horizontal-stretch: 2; spacing: 4px; alignment: start;
                                FieldCaption { label: GuiI18n.text("gui-linked-server-name"); }
                                TextField {
                                    text <=> root.create-linked-server-name;
                                    placeholder: NameRules.linked-server-name(root.create-name != "" ? root.create-name : root.create-name-suggestion);
                                    accessible-name: GuiI18n.text("gui-linked-server-name");
                                }
                            }
                            VerticalLayout { horizontal-stretch: 1; spacing: 4px; alignment: start;
                                FieldCaption { label: GuiI18n.text("gui-port"); note: GuiI18n.text("gui-create-port-note"); }
                                TextField {
                                    text <=> root.create-linked-port;
                                    placeholder: root.stored-server-port-custom ? root.stored-server-port : "25565";
                                    input-type: InputType.number;
                                    invalid: root.create-linked-port != "" && PropertyRules.port-error(root.create-linked-port) != "";
                                    accessible-name: GuiI18n.text("gui-port");
                                }
                            }
                            VerticalLayout { horizontal-stretch: 2; spacing: 4px; alignment: start;
                                FieldCaption { label: GuiI18n.text("gui-accounts"); }
                                HorizontalLayout { padding-right: Theme.shadow-room; padding-bottom: Theme.shadow-room;
                                    SegmentedChoice {
                                        horizontal-stretch: 1;
                                        accessible-name: GuiI18n.text("gui-accounts");
                                        options: [GuiI18n.text("gui-accounts-online"), GuiI18n.text("gui-accounts-offline")];
                                        current: root.create-linked-online ? 0 : 1;
                                        selected(index) => { root.create-linked-online = index == 0; }
                                    }
                                }
                            }
                        }
                        if root.create-linked-server : ServerPackZone {
                            file: root.create-instance-server-pack;
                            file-name: root.create-instance-server-pack-name;
                            browse => { root.choose-instance-server-pack(); }
                            clear => { root.clear-instance-server-pack(); }
                        }
                    }
                    }
                    // Outside the form, so a refusal is seen however far it is scrolled.
                    if root.modal-error != "" : BodyText { text: root.modal-error; color: Theme.danger; wrap: word-wrap; }
                    InfoBanner {
                        text: GuiI18n.values(root.create-persistent ? "gui-create-summary-persistent" : "gui-create-summary-temporary", root.create-minecraft, root.create-loader == "Vanilla" || root.create-loader-version == "" ? root.create-loader : root.create-loader + " " + root.create-loader-version);
                    }
                    ActionRow {
                            Rectangle { horizontal-stretch: 1; }
                            AppButton { text: GuiI18n.text("gui-cancel"); clicked => { root.modal = ""; } }
                            AppButton {
                                text: GuiI18n.text("gui-create-instance");
                                icon: @image-url("../../../assets/icons/add.svg");
                                tone: "primary";
                                enabled: root.minecraft-releases.length > 0 && (root.create-name != "" || root.create-name-suggestion != "") && root.create-minecraft != "" && (root.create-loader == "Vanilla" || root.create-loader-version != "");
                                hint: root.minecraft-releases.length == 0 ? GuiI18n.text("gui-hint-minecraft-list-unavailable") : root.create-minecraft == "" ? GuiI18n.text("gui-hint-choose-minecraft-release") : root.create-name == "" && root.create-name-suggestion == "" ? GuiI18n.text("gui-hint-enter-name") : GuiI18n.text("gui-hint-choose-loader-version");
                                clicked => {
                                    root.submit-create-instance(root.create-name != "" ? root.create-name : root.create-name-suggestion, root.create-minecraft, root.create-loader, root.create-loader-version, root.create-persistent, root.create-issue-link, root.create-linked-server, root.create-linked-server-name, root.create-instance-server-pack, root.create-linked-port, root.create-linked-online);
                                }
                            }
                    }
                }
                if root.modal == "import" : ScrollView {
                    content-width: self.width;
                    VerticalLayout {
                        padding-left: Theme.lift-room; padding-top: Theme.lift-room; padding-right: Theme.shadow-room;
                        padding-bottom: Theme.shadow-room;
                        spacing: 11px;
                        BodyText { text: GuiI18n.text("gui-import-detail"); wrap: word-wrap; }
                        Text { text: GuiI18n.text("gui-modpack-archive"); color: Theme.text-secondary; font-size: Theme.label-size; }
                        HorizontalLayout {
                            TextField {
                                // Display-only: it always mirrors the archive
                                // the current analysis is for, and Browse is
                                // the only way to start a new one.
                                text: root.import-path;
                                placeholder: GuiI18n.text("gui-modpack-placeholder");
                                horizontal-stretch: 1;
                                enabled: false;
                            }
                            AppButton {
                                text: GuiI18n.text("gui-browse");
                                accessible-name: GuiI18n.text("gui-choose-modpack-archive");
                                enabled: root.import-status-kind != "submitting"; hint: GuiI18n.text("gui-hint-import-running");
                                clicked => { root.choose-import-file(); }
                            }
                        }
                        if root.import-status-kind == "analyzing" || root.import-status-kind == "resolving" : HorizontalLayout {
                            spacing: 7px;
                            BusySpinner { width: 16px; height: 16px; }
                            BodyText {
                                text: root.import-status-kind == "resolving" ? GuiI18n.text("gui-import-resolving") : GuiI18n.text("gui-import-analyzing");
                                color: Theme.text-secondary;
                            }
                        }
                        if root.import-pack-header != "" : Rectangle {
                            border-radius: Theme.card-radius;
                            border-width: Theme.strong-border-width;
                            border-color: root.import-status-kind == "ready" || root.import-status-kind == "submitting" ? Theme.success : Theme.border-strong;
                            background: Theme.surface;
                            // Left to itself, the card measures its wrapped lines unwrapped.
                            height: pack-summary.preferred-height;
                            pack-summary := VerticalLayout {
                                padding: 12px;
                                spacing: 4px;
                                Heading { text: root.import-pack-header; font-size: Theme.row-heading-size; wrap: word-wrap; }
                                if root.import-author-line != "" : BodyText { text: root.import-author-line; color: Theme.text-secondary; wrap: word-wrap; }
                                BodyText { text: root.import-minecraft-line; color: Theme.text-secondary; wrap: word-wrap; }
                                BodyText { text: root.import-loader-line; color: Theme.text-secondary; wrap: word-wrap; }
                                BodyText { text: root.import-required-line + " | " + root.import-optional-line; color: Theme.text-secondary; wrap: word-wrap; }
                            }
                        }
                        if root.import-optional-items.length > 0 : ScrollView {
                            content-width: self.width;
                            height: min(root.import-optional-items.length * 28px, 200px);
                            VerticalLayout {
                                for item in root.import-optional-items : HorizontalLayout {
                                    spacing: 8px;
                                    height: 28px;
                                    Toggle {
                                        checked: item.selected;
                                        accessible-name: item.display;
                                        toggled(selected) => { root.toggle-import-optional(item.logical-path); }
                                    }
                                    BodyText { text: item.display; overflow: elide; vertical-alignment: center; }
                                }
                            }
                        }
                        // Wrapped text stays a direct child: a conditional layout here measures it unwrapped.
                        if root.import-blocked-items.length > 0 : BodyText { text: GuiI18n.text("gui-import-blocked-detail"); color: Theme.warning; wrap: word-wrap; }
                        if root.import-blocked-items.length > 0 : HorizontalLayout {
                            Rectangle { horizontal-stretch: 1; }
                            AppButton {
                                text: GuiI18n.text("gui-import-open-watched-folders");
                                clicked => { root.close-import-modal(); root.open-settings("Storage"); }
                            }
                        }
                        if root.import-blocked-items.length > 0 : ScrollView {
                            content-width: self.width;
                            height: min(root.import-blocked-items.length * 64px, 220px);
                            VerticalLayout {
                                spacing: 6px;
                                for item in root.import-blocked-items : Rectangle {
                                    height: 58px;
                                    border-radius: Theme.card-radius;
                                    border-width: Theme.strong-border-width;
                                    border-color: Theme.border-strong;
                                    background: Theme.surface;
                                    accessible-role: list-item;
                                    accessible-label: item.project-line;
                                    HorizontalLayout {
                                        padding: 8px;
                                        spacing: 8px;
                                        VerticalLayout {
                                            alignment: center;
                                            BodyText { text: item.project-line; overflow: elide; }
                                            BodyText { text: item.file-line; color: Theme.text-muted; overflow: elide; }
                                        }
                                        Rectangle { horizontal-stretch: 1; }
                                        AppButton {
                                            text: GuiI18n.text("gui-open-in-browser");
                                            enabled: item.browser-url != ""; hint: GuiI18n.text("gui-hint-no-project-page");
                                            clicked => { root.open-blocked-file(item.browser-url); }
                                        }
                                        AppButton {
                                            text: GuiI18n.text("gui-skip");
                                            tone: "danger";
                                            clicked => { root.skip-blocked-file(item.identity); }
                                        }
                                    }
                                }
                            }
                        }
                        if root.import-duplicate-items.length > 0 : BodyText { text: GuiI18n.text("gui-import-duplicate-detail"); color: Theme.text-secondary; wrap: word-wrap; }
                        if root.import-duplicate-items.length > 0 : ScrollView {
                            content-width: self.width;
                            height: min(root.import-duplicate-items.length * 100px, 260px);
                            VerticalLayout {
                                spacing: 6px;
                                for item in root.import-duplicate-items : Rectangle {
                                    height: max(
                                        58px,
                                        project-text.preferred-height
                                            + kept-text.preferred-height
                                            + reason-text.preferred-height
                                            + 22px);
                                    border-radius: Theme.card-radius;
                                    border-width: Theme.strong-border-width;
                                    border-color: Theme.border-strong;
                                    background: Theme.surface;
                                    VerticalLayout {
                                        padding: 8px;
                                        spacing: 2px;
                                        project-text := BodyText { text: item.project-line; wrap: word-wrap; }
                                        kept-text := BodyText {
                                            text: GuiI18n.values("gui-import-duplicate-kept", item.kept-line, item.discarded-line);
                                            color: Theme.text-muted;
                                            wrap: word-wrap;
                                        }
                                        reason-text := BodyText {
                                            text: item.matched-minecraft-version ? GuiI18n.text("gui-import-duplicate-matches-version") : GuiI18n.text("gui-import-duplicate-newer");
                                            color: Theme.text-muted;
                                            font-size: Theme.caption-size;
                                            wrap: word-wrap;
                                        }
                                    }
                                }
                            }
                        }
                        Text { text: GuiI18n.text("gui-instance-name-optional"); color: Theme.text-secondary; font-size: Theme.label-size; }
                        TextField {
                            text <=> root.import-name;
                            placeholder: GuiI18n.text("gui-detected-pack-name");
                            enabled: root.import-status-kind != "submitting";
                            edited(text) => { root.import-name-edited(text); }
                        }
                        HorizontalLayout { BodyText { text: GuiI18n.text("gui-store-persistently"); } Toggle { checked <=> root.create-persistent; } }
                        HorizontalLayout { spacing: 10px; cross-axis-alignment: center; VerticalLayout { horizontal-stretch: 1; spacing: 2px; BodyText { text: GuiI18n.text("gui-import-create-server"); } BodyText { text: GuiI18n.text("gui-import-create-server-detail"); color: Theme.text-muted; wrap: word-wrap; } } Toggle { checked <=> root.import-create-server; accessible-name: GuiI18n.text("gui-import-create-server"); } }
                        if root.import-create-server : Text { text: GuiI18n.text("gui-server-pack"); color: Theme.text-secondary; font-size: Theme.label-size; }
                        if root.import-create-server : BodyText { text: GuiI18n.text("gui-server-pack-detail"); color: Theme.text-muted; wrap: word-wrap; }
                        if root.import-create-server : HorizontalLayout { spacing: 8px; alignment: start;
                            AppButton { text: GuiI18n.text("gui-browse"); accessible-name: GuiI18n.text("gui-choose-server-pack"); clicked => { root.choose-import-server-pack(); } }
                            if root.import-server-pack != "" : AppButton { text: GuiI18n.text("gui-clear"); accessible-name: GuiI18n.text("gui-clear-server-pack"); clicked => { root.clear-import-server-pack(); } }
                            if root.import-server-pack != "" : VerticalLayout { alignment: center; horizontal-stretch: 1; BodyText { text: root.import-server-pack-name; overflow: elide; } }
                        }
                        // Absorbs whatever space the content above did not
                        // need, so sparse content (an idle picker) keeps its
                        // rows tight instead of spreading them across the
                        // scroll viewport.
                        Rectangle { vertical-stretch: 1; }
                    }
                }
                // Outside the scroll view, so the error and buttons are always in view.
                if root.modal == "import" && root.modal-error != "" : BodyText { text: root.modal-error; color: Theme.danger; wrap: word-wrap; }
                if root.modal == "import" && root.modal-error != "" && (root.import-error-kind == "missing-credential" || root.import-error-kind == "rejected-credential") : HorizontalLayout {
                    alignment: start;
                    AppButton {
                        text: GuiI18n.text("gui-import-open-providers");
                        clicked => { root.close-import-modal(); root.open-settings("Providers & APIs"); }
                    }
                }
                if root.modal == "import" : ActionRow {
                    Rectangle { horizontal-stretch: 1; }
                    AppButton { text: GuiI18n.text("gui-cancel"); clicked => { root.close-import-modal(); } }
                    AppButton {
                        text: GuiI18n.text("gui-import-modpack");
                        tone: "primary";
                        enabled: root.import-ready; hint: root.import-status-kind == "idle" ? GuiI18n.text("gui-hint-import-choose") : root.import-status-kind == "analyzing" || root.import-status-kind == "resolving" ? GuiI18n.text("gui-hint-import-reading") : root.import-status-kind == "submitting" ? GuiI18n.text("gui-hint-import-running") : root.import-status-kind == "failed" ? GuiI18n.text("gui-hint-import-failed") : GuiI18n.text("gui-hint-import-blocked");
                        clicked => { root.submit-import(root.import-name, root.create-persistent, root.import-create-server, root.import-server-pack); }
                    }
                }
                if root.modal == "create-server" : VerticalLayout { spacing: 10px;
                    ScrollView {
                        vertical-stretch: 1;
                        content-width: self.visible-width;
                        VerticalLayout {
                            padding-left: Theme.lift-room;
                            padding-top: Theme.lift-room;
                            padding-right: Theme.shadow-room;
                            padding-bottom: Theme.shadow-room;
                            spacing: 14px;
                            alignment: start;
                            VerticalLayout { spacing: 4px;
                                FieldCaption { label: GuiI18n.text("gui-name"); }
                                TextField { text <=> root.create-server-name; placeholder: root.create-server-name-suggestion; accessible-name: GuiI18n.text("gui-name"); }
                            }
                            if root.create-server-client-id == "" : HorizontalLayout {
                                spacing: 16px;
                                VerticalLayout { horizontal-stretch: 1; spacing: 4px; alignment: start;
                                    FieldCaption { label: GuiI18n.text("gui-minecraft"); }
                                    ValueComboBox {
                                        label: GuiI18n.text("gui-minecraft-release");
                                        model: root.minecraft-releases;
                                        value: root.create-server-minecraft;
                                        selected(value) => { root.create-server-minecraft = value; root.create-server-loader-version = ""; root.create-server-loader-versions = []; root.minecraft-selection-changed("server", value); if root.create-server-loader != "Vanilla" { root.request-loader-catalog("server", root.create-server-loader, value); } root.recompute-create-server-name(); }
                                    }
                                }
                                VerticalLayout { horizontal-stretch: 1; spacing: 4px; alignment: start;
                                    FieldCaption { label: GuiI18n.text("gui-loader"); }
                                    HorizontalLayout { padding-right: Theme.shadow-room; padding-bottom: Theme.shadow-room;
                                        SegmentedChoice {
                                            horizontal-stretch: 1;
                                            accessible-name: GuiI18n.text("gui-loader");
                                            options: root.create-server-loaders;
                                            current-value: root.create-server-loader;
                                            chosen(value) => { root.create-server-loader = value; root.create-server-loader-version = ""; root.create-server-loader-versions = []; if value != "Vanilla" { root.request-loader-catalog("server", value, root.create-server-minecraft); } root.recompute-create-server-name(); }
                                        }
                                    }
                                }
                            }
                            HorizontalLayout {
                                spacing: 16px;
                                if root.create-server-client-id == "" : VerticalLayout { horizontal-stretch: 1; spacing: 4px; alignment: start;
                                    FieldCaption { label: GuiI18n.text("gui-loader-build"); note: GuiI18n.text("gui-create-build-note"); }
                                    ValueComboBox {
                                        label: GuiI18n.text("gui-loader-version-placeholder");
                                        enabled: root.create-server-loader != "Vanilla";
                                        model: root.create-server-loader-versions;
                                        value: root.create-server-loader-version;
                                        selected(value) => { root.create-server-loader-version = value; }
                                        changed value => { root.recompute-create-server-name(); }
                                    }
                                }
                                VerticalLayout { horizontal-stretch: 1; spacing: 4px; alignment: start;
                                    FieldCaption { label: GuiI18n.text("gui-port"); note: GuiI18n.text("gui-create-port-note"); }
                                    TextField {
                                        text <=> root.create-server-port;
                                        placeholder: root.stored-server-port-custom ? root.stored-server-port : "25565";
                                        input-type: InputType.number;
                                        invalid: root.create-server-port != "" && PropertyRules.port-error(root.create-server-port) != "";
                                        accessible-name: GuiI18n.text("gui-port");
                                    }
                                }
                            }
                            HorizontalLayout {
                                spacing: 16px;
                                VerticalLayout { horizontal-stretch: 1; spacing: 4px; alignment: start;
                                    FieldCaption { label: GuiI18n.text("gui-accounts"); }
                                    HorizontalLayout { padding-right: Theme.shadow-room; padding-bottom: Theme.shadow-room;
                                        SegmentedChoice {
                                            horizontal-stretch: 1;
                                            accessible-name: GuiI18n.text("gui-accounts");
                                            options: [GuiI18n.text("gui-accounts-online"), GuiI18n.text("gui-accounts-offline")];
                                            current: root.create-server-online ? 0 : 1;
                                            selected(index) => { root.create-server-online = index == 0; }
                                        }
                                    }
                                }
                                VerticalLayout { horizontal-stretch: 1; spacing: 4px; alignment: start;
                                    FieldCaption { label: GuiI18n.text("gui-link-to-instance"); note: GuiI18n.text("gui-create-optional"); }
                                    IndexComboBox {
                                        label: GuiI18n.text("gui-link-to-instance");
                                        model: root.server-link-labels;
                                        index: root.create-server-link-index;
                                        selected(index, value) => {
                                            root.create-server-link-index = index;
                                            root.create-server-client-id = root.server-link-ids[index];
                                            if index == 0 { root.recompute-create-server-name(); } else { root.create-server-name-suggestion = NameRules.linked-server-name(value); }
                                        }
                                    }
                                }
                            }
                            VerticalLayout { spacing: 4px;
                                FieldCaption { label: GuiI18n.text("gui-storage"); }
                                HorizontalLayout { padding-right: Theme.shadow-room; padding-bottom: Theme.shadow-room; alignment: start;
                                    SegmentedChoice {
                                        accessible-name: GuiI18n.text("gui-storage");
                                        options: [GuiI18n.text("gui-temporary"), GuiI18n.text("gui-persistent")];
                                        current: root.create-server-persistent ? 1 : 0;
                                        selected(index) => { root.create-server-persistent = index == 1; }
                                    }
                                }
                            }
                            ServerPackZone {
                                file: root.create-server-pack;
                                file-name: root.create-server-pack-name;
                                note: root.create-server-pack-note;
                                browse => { root.choose-server-pack(); }
                                clear => { root.clear-server-pack(); }
                            }
                            BodyText { text: GuiI18n.text("gui-eula-create-warning"); color: Theme.warning; wrap: word-wrap; }
                        }
                    }
                    if root.modal-error != "" : BodyText { text: root.modal-error; color: Theme.danger; wrap: word-wrap; }
                    ActionRow {
                        Rectangle { horizontal-stretch: 1; }
                        AppButton { text: GuiI18n.text("gui-cancel"); clicked => { root.modal = ""; } }
                        AppButton {
                            text: GuiI18n.text("gui-create-server");
                            icon: @image-url("../../../assets/icons/server.svg");
                            tone: "info";
                            enabled: (root.create-server-name != "" || root.create-server-name-suggestion != "") && (root.create-server-client-id != "" || (root.minecraft-releases.length > 0 && root.create-server-minecraft != "" && (root.create-server-loader == "Vanilla" || root.create-server-loader-version != ""))) && root.create-server-pack-conflict == "";
                            hint: root.create-server-name == "" && root.create-server-name-suggestion == "" ? GuiI18n.text("gui-hint-enter-name") : root.create-server-pack-conflict != "" ? root.create-server-pack-conflict : root.create-server-client-id == "" && root.minecraft-releases.length == 0 ? GuiI18n.text("gui-hint-minecraft-list-unavailable") : root.create-server-client-id == "" && root.create-server-minecraft == "" ? GuiI18n.text("gui-hint-choose-minecraft-release") : GuiI18n.text("gui-hint-choose-loader-version");
                            clicked => { root.submit-create-server(root.create-server-name != "" ? root.create-server-name : root.create-server-name-suggestion, root.create-server-client-id, root.create-server-minecraft, root.create-server-loader, root.create-server-loader-version, root.create-server-persistent, root.create-server-port == "", root.create-server-port, root.create-server-pack, root.create-server-online); }
                        }
                    }
                }
                if root.modal == "mod-plan" : VerticalLayout { spacing: 12px; Heading { text: root.mod-plan-title + " " + root.mod-plan-version; font-size: Theme.section-size; } BodyText { text: root.mod-plan-kind == "server" ? GuiI18n.text("gui-server-mod-plan-compatible") : GuiI18n.text("gui-mod-plan-compatible"); wrap: word-wrap; } Rectangle { height: 116px; border-radius: Theme.card-radius; border-width: Theme.strong-border-width; border-color: Theme.border-strong; background: Theme.background; VerticalLayout { padding: 12px; spacing: 5px; BodyText { text: GuiI18n.count("gui-mod-plan-install", root.mod-plan-install-count); color: Theme.text; } BodyText { text: GuiI18n.count("gui-mod-plan-required", root.mod-plan-dependency-count); } BodyText { text: GuiI18n.count("gui-mod-plan-existing", root.mod-plan-existing-count); } BodyText { text: GuiI18n.count("gui-mod-plan-optional", root.mod-plan-optional-count); } } } if root.mod-plan-warning-count > 0 : BodyText { text: GuiI18n.count("gui-mod-plan-warnings", root.mod-plan-warning-count); color: Theme.warning; wrap: word-wrap; }
                    if root.mod-plan-unstated.length > 0 : VerticalLayout { spacing: 4px;
                        BodyText { text: GuiI18n.text("gui-server-mod-plan-unstated"); color: Theme.warning; wrap: word-wrap; }
                        for name in root.mod-plan-unstated : BodyText { text: "- " + name; }
                    }
                    if root.mod-plan-client-only.length > 0 : VerticalLayout { spacing: 4px;
                        BodyText { text: GuiI18n.text("gui-server-mod-plan-client-only"); color: Theme.warning; wrap: word-wrap; }
                        for line in root.mod-plan-client-only : BodyText { text: line; wrap: word-wrap; }
                    }
                    if root.mod-plan-restart-note != "" : BodyText { text: root.mod-plan-restart-note; color: Theme.text-muted; wrap: word-wrap; }
                    if root.linked-targets.length > 0 : Text { text: GuiI18n.text("gui-linked-servers"); color: Theme.text-secondary; font-size: Theme.label-size; }
                    if root.linked-targets.length > 0 && root.linked-support != "" : BodyText { text: root.linked-support; color: Theme.text-muted; wrap: word-wrap; }
                    if root.linked-targets.length > 0 : LinkedTargetsPanel { vertical-stretch: 1; rows: root.linked-targets; selectable: true; toggled(index) => { root.linked-targets[index].selected = !root.linked-targets[index].selected; } }
                    ActionRow { Rectangle { horizontal-stretch: 1; } AppButton { text: GuiI18n.text("gui-cancel"); clicked => { root.modal = ""; root.abandon-browser-install(); } } AppButton { text: GuiI18n.text("gui-install-required"); tone: "primary"; enabled: root.mod-plan-install-count > 0 && !root.mod-action-pending; hint: root.mod-action-pending ? GuiI18n.text("gui-hint-mod-action-pending") : GuiI18n.text("gui-hint-nothing-to-install"); clicked => { root.mod-action-pending = true; if root.mod-plan-kind == "server" { root.install-server-mod(root.mod-plan-instance, root.mod-plan-provider, root.mod-plan-project, root.mod-plan-version-id, root.mod-plan-unstated-ids); } else { root.install-mod(root.mod-plan-instance, root.mod-plan-provider, root.mod-plan-project, root.mod-plan-version-id); } root.modal = ""; } } } }
                if root.modal == "mod-manage" : VerticalLayout { spacing: 11px;
                    // The mod's own name leads to its project page, beside the
                    // arrow that says a name can be pressed at all. The row of
                    // actions below already carries up to four for a mod the pack
                    // declares, and a fifth button for the project page left them
                    // no room in a dialog this wide.
                    HorizontalLayout { spacing: 8px; cross-axis-alignment: center;
                        if root.mod-action-project-url == "" : Heading { text: root.mod-action-name; font-size: Theme.section-size; overflow: elide; horizontal-stretch: 1; }
                        if root.mod-action-project-url != "" : Rectangle {
                            horizontal-stretch: 1;
                            height: max(project-title.preferred-height, 22px);
                            // The name and its arrow, and nothing else: what is
                            // announced as a button, what takes the press, and
                            // what lights up on hover are all this one box, so
                            // the rest of the header is not a click target that
                            // opens a browser.
                            Rectangle {
                                x: 0px;
                                width: project-title.width + 22px;
                                height: parent.height;
                                accessible-role: button;
                                accessible-label: GuiI18n.text("gui-mod-open-project-page");
                                accessible-action-default => { root.open-mod-project-page(root.mod-action-project-url); }
                            // Packed to the left rather than stretched: the
                            // arrow belongs against the end of the name, and a
                            // stretched title would carry it off to the middle
                            // of the dialog where it reads as its own control.
                            HorizontalLayout {
                                spacing: 7px;
                                alignment: start;
                                cross-axis-alignment: center;
                                project-title := Text {
                                    // Its own width, capped short of the
                                    // dialog's own 720px so a very long name
                                    // elides rather than pushing the arrow out.
                                    // A constant because deriving it from the
                                    // row would be a layout loop: the row is
                                    // sized by this text.
                                    width: min(self.preferred-width, 560px);
                                    text: root.mod-action-name;
                                    color: project-link.has-hover ? Theme.accent : Theme.text;
                                    font-size: Theme.section-size;
                                    font-weight: 600;
                                    overflow: elide;
                                    vertical-alignment: center;
                                }
                                Image {
                                    width: 15px;
                                    height: 15px;
                                    source: @image-url("../../../assets/icons/external-link.svg");
                                    image-fit: contain;
                                    colorize: project-link.has-hover ? Theme.accent : Theme.text-secondary;
                                }
                            }
                            project-link := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.open-mod-project-page(root.mod-action-project-url); }
                            }
                            }
                            HoverNote {
                                text: GuiI18n.text("gui-mod-open-project-page-hint");
                                hovered: project-link.has-hover;
                                pointer-x: project-link.mouse-x;
                                pointer-y: project-link.mouse-y;
                            }
                        }
                        if root.mod-action-up-to-date : Pill { text: GuiI18n.text("gui-mod-up-to-date"); tone-color: Theme.success; }
                    }
                    if root.mod-action-notice != "" : BodyText { text: root.mod-action-notice; color: root.mod-action-can-change ? Theme.text-muted : Theme.warning; wrap: word-wrap; }
                    if root.mod-action-loading : BodyText { text: GuiI18n.text("gui-mod-versions-loading"); color: Theme.text-muted; }
                    if !root.mod-action-loading && root.mod-versions.length == 0 && root.mod-action-notice == "" : BodyText { text: GuiI18n.text("gui-mod-no-compatible-versions"); color: Theme.text-muted; wrap: word-wrap; }
                    if root.mod-versions.length > 0 : Text { text: GuiI18n.text("gui-mod-compatible-versions"); color: Theme.text-secondary; font-size: Theme.label-size; }
                    if root.mod-versions.length > 0 : Rectangle {
                        vertical-stretch: 1; border-radius: Theme.card-radius; border-width: Theme.strong-border-width; border-color: Theme.border-strong; background: Theme.background;
                        ScrollView { content-width: self.width; VerticalLayout { padding: 6px; spacing: 4px;
                            for entry in root.mod-versions : Rectangle {
                                height: 46px; border-radius: Theme.small-radius;
                                border-width: entry.version-id == root.mod-action-selected ? Theme.selection-outline-width : Theme.strong-border-width;
                                border-color: entry.version-id == root.mod-action-selected ? Theme.accent : entry.installed ? Theme.accent-secondary.with-alpha(0.5) : Theme.border-strong.with-alpha(0.6);
                                background: entry.installed ? Theme.accent-secondary.with-alpha(0.08) : Theme.surface;
                                HorizontalLayout { padding-left: 10px; padding-right: 10px; spacing: 8px;
                                    VerticalLayout { alignment: center; spacing: 2px; horizontal-stretch: 1;
                                        Text { text: entry.number; color: Theme.text; font-size: Theme.label-size; font-weight: 600; overflow: elide; }
                                        Text { text: entry.published + " | " + entry.channel; color: Theme.text-muted; font-size: Theme.caption-size; overflow: elide; }
                                    }
                                    // One trailing group rather than a column
                                    // each: an empty wrapper still takes the
                                    // row's spare width, which pushed whichever
                                    // badge was showing away from the edge. The
                                    // two are not exclusive, because the
                                    // installed release is often also the newest
                                    // one and that is worth saying.
                                    HorizontalLayout { spacing: 8px; horizontal-stretch: 0;
                                        if entry.installed : VerticalLayout { alignment: center; Pill { text: GuiI18n.text("gui-mod-installed-version"); tone-color: Theme.accent-secondary; } }
                                        if entry.newest : VerticalLayout { alignment: center; Pill { text: GuiI18n.text("gui-mod-newest-version"); tone-color: Theme.success; } }
                                        if entry.restricted : VerticalLayout { alignment: center; Pill { text: GuiI18n.text("gui-mod-browser-download"); tone-color: Theme.warning; } }
                                    }
                                }
                                TouchArea { enabled: root.mod-action-can-change && !entry.installed; mouse-cursor: pointer; clicked => { root.mod-action-selected = entry.version-id; } }
                            }
                        } }
                    }
                    // Both directions side by side, because the question a
                    // reader has here is symmetric: what this needs, and
                    // what would stop working without it. The warning the
                    // toggle raises is the same data, one closure further.
                    HorizontalLayout { spacing: 10px; vertical-stretch: 0;
                        VerticalLayout { spacing: 5px; horizontal-stretch: 1;
                            Text { text: GuiI18n.text("gui-mod-requires"); color: Theme.text-secondary; font-size: Theme.label-size; }
                            RelationList { rows: root.mod-action-requires; note: root.mod-action-requires-note; }
                        }
                        VerticalLayout { spacing: 5px; horizontal-stretch: 1;
                            Text { text: GuiI18n.text("gui-mod-required-by"); color: Theme.text-secondary; font-size: Theme.label-size; }
                            RelationList { rows: root.mod-action-required-by; note: GuiI18n.text("gui-mod-required-by-nothing"); }
                        }
                    }
                    if root.mod-action-relations-refreshable : HorizontalLayout { AppButton { text: GuiI18n.text("gui-mod-impact-refresh"); clicked => { root.refresh-mod-dependencies(root.mod-action-host-kind, root.mod-action-host, root.mod-action-path); } } Rectangle { horizontal-stretch: 1; } }
                    if root.modal-error != "" : BodyText { text: root.modal-error; color: Theme.danger; wrap: word-wrap; }
                    // With no release list to take the dialog's height, the rest
                    // stays together at the top instead of spreading out.
                    if root.mod-versions.length == 0 : Rectangle { vertical-stretch: 1; }
                    // Leaving on the left, acting on the right, and the one
                    // that takes the selected release last. The two groups
                    // are placed by hand: when one row cannot hold both, the
                    // acting group moves to a row of its own under the other,
                    // whatever width the font gives the captions.
                    Rectangle {
                        property <length> gap: 8px;
                        property <bool> one-row: leaving.min-width + self.gap + acting.min-width <= self.width;
                        height: self.one-row ? Theme.control-height : 2 * Theme.control-height + self.gap;
                        leaving := HorizontalLayout {
                            x: 0px;
                            y: 0px;
                            width: self.min-width;
                            height: Theme.control-height;
                            spacing: parent.gap;
                            if root.mod-action-can-remove : AppButton { text: GuiI18n.text("gui-remove"); tone: "danger"; enabled: !root.mod-action-pending; hint: GuiI18n.text("gui-hint-mod-action-pending"); clicked => { root.mod-action-pending = true; root.modal-error = ""; root.mod-remove-returns-to-manager = true; root.plan-mod-removal(root.mod-action-host-kind, root.mod-action-host, root.mod-action-path); } }
                            AppButton { text: GuiI18n.text("gui-close"); clicked => { root.modal = ""; root.modal-error = ""; } }
                        }
                        acting := HorizontalLayout {
                            x: max(0px, parent.width - self.width);
                            y: parent.one-row ? 0px : Theme.control-height + parent.gap;
                            width: self.min-width;
                            height: Theme.control-height;
                            spacing: parent.gap;
                            if root.mod-action-is-pack-owned && root.mod-action-pack-original-version != "" : AppButton { text: GuiI18n.text("gui-mod-reset-to-pack-version"); enabled: !root.mod-action-pending; hint: GuiI18n.text("gui-hint-mod-action-pending"); clicked => { root.mod-action-pending = true; root.modal-error = ""; root.plan-mod-apply(root.mod-action-host, root.mod-action-path, root.mod-action-pack-original-version); } }
                            if root.mod-action-can-update : AppButton { text: GuiI18n.text("gui-mod-update"); enabled: !root.mod-action-pending; hint: GuiI18n.text("gui-hint-mod-action-pending"); clicked => { root.mod-action-pending = true; root.modal-error = ""; root.plan-mod-apply(root.mod-action-host, root.mod-action-path, ""); } }
                            if root.mod-action-can-change : AppButton { text: GuiI18n.text("gui-mod-change-version"); tone: "primary"; enabled: !root.mod-action-pending && root.mod-action-selected != "" && root.mod-action-selected != root.mod-action-installed; hint: root.mod-action-pending ? GuiI18n.text("gui-hint-mod-action-pending") : root.mod-action-selected == "" ? GuiI18n.text("gui-hint-choose-version") : GuiI18n.text("gui-hint-version-already-installed"); clicked => { root.mod-action-pending = true; root.modal-error = ""; root.plan-mod-apply(root.mod-action-host, root.mod-action-path, root.mod-action-selected); } }
                        }
                    }
                }
                if root.modal == "mod-acquire" : VerticalLayout { spacing: 11px;
                    BodyText { text: GuiI18n.value("gui-mod-acquire-detail", root.mod-acquisition-name); wrap: word-wrap; }
                    BodyText { text: GuiI18n.text("gui-mod-acquire-watching"); color: Theme.text-muted; wrap: word-wrap; }
                    Rectangle {
                        vertical-stretch: 1; border-radius: Theme.card-radius; border-width: Theme.strong-border-width; border-color: Theme.border-strong; background: Theme.background;
                        ScrollView { content-width: self.width; VerticalLayout { alignment: start; padding: 6px; spacing: 6px;
                            for item in root.mod-acquisition-items : Rectangle {
                                height: 58px; border-radius: Theme.card-radius; border-width: Theme.strong-border-width; border-color: Theme.border-strong; background: Theme.surface;
                                HorizontalLayout { padding: 8px; spacing: 8px;
                                    VerticalLayout { alignment: center; horizontal-stretch: 1;
                                        BodyText { text: item.project-line; overflow: elide; }
                                        BodyText { text: item.file-line; color: Theme.text-muted; overflow: elide; }
                                    }
                                    AppButton { text: GuiI18n.text("gui-open-in-browser"); tone: "primary"; enabled: item.browser-url != ""; hint: GuiI18n.text("gui-hint-no-project-page"); clicked => { root.open-blocked-file(item.browser-url); } }
                                }
                            }
                        } }
                    }
                    HorizontalLayout { spacing: 8px;
                        AppButton { text: GuiI18n.text("gui-import-open-watched-folders"); clicked => { root.cancel-mod-acquisition(root.mod-acquisition-id); root.modal = ""; root.open-settings("Storage"); } }
                        Rectangle { horizontal-stretch: 1; }
                        AppButton { text: GuiI18n.text("gui-cancel"); clicked => { root.cancel-mod-acquisition(root.mod-acquisition-id); root.modal = ""; root.modal-error = ""; root.mod-action-pending = false; } }
                    }
                }
                if root.modal == "mod-remove" : VerticalLayout { spacing: 12px;
                    BodyText { text: GuiI18n.value("gui-mod-remove-detail", root.mod-action-name); color: Theme.warning; wrap: word-wrap; }
                    if root.mod-removal-dependencies.length > 0 : BodyText { text: GuiI18n.count("gui-mod-remove-dependencies", root.mod-removal-dependencies.length); wrap: word-wrap; }
                    if root.mod-removal-dependencies.length > 0 : Rectangle {
                        // Sized to its own content so that the linked-server
                        // list beside it is not squeezed by an empty box.
                        vertical-stretch: 1; max-height: root.mod-removal-dependencies.length * 24px + 18px; border-radius: Theme.card-radius; border-width: Theme.strong-border-width; border-color: Theme.border-strong; background: Theme.background;
                        ScrollView { content-width: self.width; VerticalLayout { alignment: start; padding: 9px; spacing: 4px; for name in root.mod-removal-dependencies : Text { text: name; color: Theme.text-secondary; font-size: Theme.label-size; height: 20px; overflow: elide; } } }
                    }
                    if root.mod-removal-dependencies.length == 0 && !root.mod-removal-unprovable : BodyText { text: GuiI18n.text("gui-mod-remove-no-dependencies"); color: Theme.text-muted; wrap: word-wrap; }
                    if root.mod-removal-unprovable : BodyText { text: GuiI18n.text("gui-mod-remove-dependencies-unprovable"); color: Theme.text-muted; wrap: word-wrap; }
                    if root.linked-targets.length > 0 : Text { text: GuiI18n.text("gui-linked-servers"); color: Theme.text-secondary; font-size: Theme.label-size; }
                    if root.linked-targets.length > 0 : LinkedTargetsPanel { vertical-stretch: 1; rows: root.linked-targets; selectable: true; toggled(index) => { root.linked-targets[index].selected = !root.linked-targets[index].selected; } }
                    if root.modal-error != "" : BodyText { text: root.modal-error; color: Theme.danger; wrap: word-wrap; }
                    HorizontalLayout { spacing: 8px; Rectangle { horizontal-stretch: 1; }
                        AppButton { text: GuiI18n.text("gui-cancel"); clicked => { root.modal = root.mod-remove-returns-to-manager ? "mod-manage" : ""; root.modal-error = ""; } }
                        AppButton { text: GuiI18n.text("gui-mod-remove-action"); tone: "danger"; enabled: !root.mod-action-pending; hint: GuiI18n.text("gui-hint-mod-action-pending"); clicked => { root.modal-error = ""; root.remove-mod(root.mod-action-host, root.mod-action-path); root.modal = ""; } }
                    }
                }
                if root.modal == "mod-apply" : VerticalLayout { spacing: 11px;
                    Heading { text: root.linked-name; font-size: Theme.section-size; overflow: elide; }
                    if root.linked-version-number != "" : BodyText { text: GuiI18n.value("gui-linked-exact-release", root.linked-version-number); wrap: word-wrap; }
                    if root.linked-support != "" : BodyText { text: root.linked-support; color: Theme.text-muted; wrap: word-wrap; }
                    Text { text: GuiI18n.text("gui-linked-servers"); color: Theme.text-secondary; font-size: Theme.label-size; }
                    LinkedTargetsPanel { vertical-stretch: 1; rows: root.linked-targets; selectable: true; toggled(index) => { root.linked-targets[index].selected = !root.linked-targets[index].selected; } }
                    if root.modal-error != "" : BodyText { text: root.modal-error; color: Theme.danger; wrap: word-wrap; }
                    HorizontalLayout { spacing: 8px; Rectangle { horizontal-stretch: 1; }
                        AppButton { text: GuiI18n.text("gui-cancel"); clicked => { root.modal = "mod-manage"; root.modal-error = ""; root.mod-action-pending = false; } }
                        AppButton { text: GuiI18n.text("gui-linked-apply"); tone: "primary"; enabled: !root.mod-action-pending; hint: GuiI18n.text("gui-hint-mod-action-pending"); clicked => { root.modal-error = ""; root.change-mod-version(root.mod-action-host, root.linked-path, root.linked-version); root.modal = ""; } }
                    }
                }
                if root.modal == "mod-result" : VerticalLayout { spacing: 11px;
                    Heading { text: root.linked-result-title; font-size: Theme.section-size; overflow: elide; }
                    BodyText { text: root.linked-result-summary; wrap: word-wrap; }
                    LinkedTargetsPanel { vertical-stretch: 1; rows: root.linked-results; }
                    ActionRow { Rectangle { horizontal-stretch: 1; } AppButton { text: GuiI18n.text("gui-close"); tone: "primary"; clicked => { root.modal = ""; } } }
                }
                if root.modal == "loader-change" : VerticalLayout { spacing: 12px;
                    BodyText { text: GuiI18n.text("gui-loader-change-detail"); wrap: word-wrap; }
                    HorizontalLayout { FactLabel { text: GuiI18n.text("gui-loader-change-current"); } BodyText { text: root.loader-change-current != "" ? root.loader-change-current : GuiI18n.text("gui-mod-version-unknown"); } }
                    Text { text: GuiI18n.text("gui-loader-change-target"); color: Theme.text-secondary; font-size: Theme.label-size; }
                    if root.loader-change-loading : BodyText { text: GuiI18n.text("gui-mod-versions-loading"); color: Theme.text-muted; }
                    if !root.loader-change-loading && root.loader-change-versions.length > 0 : ValueComboBox { label: GuiI18n.text("gui-loader-change-target"); model: root.loader-change-versions; value: root.loader-change-selected; selected(value) => { root.loader-change-selected = value; } }
                    if !root.loader-change-loading && root.loader-change-versions.length == 0 : BodyText { text: GuiI18n.text("gui-loader-change-unavailable"); color: Theme.warning; wrap: word-wrap; }
                    if root.loader-change-unverifiable > 0 : BodyText { text: GuiI18n.count("gui-loader-change-unverifiable", root.loader-change-unverifiable); color: Theme.text-muted; wrap: word-wrap; }
                    BodyText { text: GuiI18n.text("gui-loader-change-mods-untouched"); color: Theme.text-muted; wrap: word-wrap; }
                    if root.modal-error != "" : BodyText { text: root.modal-error; color: Theme.danger; wrap: word-wrap; }
                    HorizontalLayout { spacing: 8px; Rectangle { horizontal-stretch: 1; }
                        AppButton { text: GuiI18n.text("gui-cancel"); clicked => { root.modal = ""; root.modal-error = ""; } }
                        AppButton { text: GuiI18n.text("gui-loader-change-action"); tone: "primary"; enabled: !root.loader-change-pending && root.loader-change-selected != "" && root.loader-change-selected != root.loader-change-current-build; hint: root.loader-change-pending ? GuiI18n.text("gui-hint-busy") : root.loader-change-selected == "" ? GuiI18n.text("gui-hint-choose-build") : GuiI18n.text("gui-hint-build-already-current"); clicked => { root.loader-change-pending = true; root.modal-error = ""; root.change-loader-version(root.mod-action-host, root.loader-change-selected); } }
                    }
                }
                if root.modal == "eula" : VerticalLayout { spacing: 12px; BodyText { text: GuiI18n.text("gui-eula-detail"); wrap: word-wrap; } AppButton { text: GuiI18n.text("gui-open-minecraft-eula"); clicked => { root.open-eula-reference(); } } Rectangle { height: 70px; border-radius: Theme.card-radius; border-width: Theme.strong-border-width; border-color: root.eula-accepted ? Theme.success : Theme.warning; background: Theme.surface; BodyText { x: 12px; width: parent.width - 24px; text: root.eula-status; wrap: word-wrap; } } if !root.eula-accepted : BodyText { text: GuiI18n.text("gui-eula-confirm"); color: Theme.text; wrap: word-wrap; } ActionRow { Rectangle { horizontal-stretch: 1; } if root.eula-accepted : AppButton { text: GuiI18n.text("gui-revoke-consent"); tone: "danger"; clicked => { root.revoke-eula(); } } if !root.eula-accepted : AppButton { text: GuiI18n.text("gui-accept-eula"); tone: "primary"; clicked => { root.accept-eula(); } } } }
                if root.modal == "kill" : VerticalLayout { spacing: 14px; BodyText { text: GuiI18n.value("gui-force-kill-detail", root.pending-action-name != "" ? root.pending-action-name : GuiI18n.text("gui-this-server")); color: Theme.warning; wrap: word-wrap; } ActionRow { Rectangle { horizontal-stretch: 1; } AppButton { text: GuiI18n.text("gui-cancel"); clicked => { root.modal = ""; } } AppButton { text: GuiI18n.text("gui-force-kill-action"); tone: "danger"; clicked => { root.server-kill(root.pending-action-id); root.modal = ""; } } } }
                if root.modal == "groups" : VerticalLayout { spacing: 12px;
                    BodyText { text: GuiI18n.text("gui-groups-detail"); wrap: word-wrap; }
                    if root.instance-groups.length == 0 : BodyText { text: GuiI18n.text("gui-groups-none"); color: Theme.text-muted; wrap: word-wrap; }
                    ScrollView {
                        content-width: self.visible-width;
                        VerticalLayout {
                            alignment: start; spacing: 8px;
                            for group in root.instance-groups : Rectangle {
                                height: 56px; border-radius: Theme.card-radius; border-width: Theme.strong-border-width; border-color: Theme.border-strong; background: Theme.surface;
                                HorizontalLayout {
                                    padding: 8px; padding-left: 12px; spacing: 8px;
                                    VerticalLayout { alignment: center; Rectangle { width: 10px; height: 10px; border-radius: 5px; background: Theme.group-tone(group.tone); } }
                                    VerticalLayout { horizontal-stretch: 1; alignment: center; Text { text: group.name; color: Theme.text; font-size: Theme.body-size; font-weight: 600; overflow: elide; } BodyText { text: GuiI18n.count("gui-group-members-count", group.members); color: Theme.text-muted; } }
                                    VerticalLayout { alignment: center; AppButton { text: GuiI18n.text("gui-rename"); clicked => { root.pending-action-kind = "group"; root.pending-action-id = group.id; root.pending-rename-text = group.name; root.modal-error = ""; root.modal = "rename"; } } }
                                    VerticalLayout { alignment: center; AppButton { text: GuiI18n.text("gui-delete-group"); tone: "danger"; clicked => { root.delete-group(group.id); } } }
                                }
                            }
                        }
                    }
                    ActionRow { Rectangle { horizontal-stretch: 1; } AppButton { text: GuiI18n.text("gui-new-group"); clicked => { root.pending-action-kind = "new-group"; root.pending-action-id = ""; root.pending-rename-text = ""; root.modal-error = ""; root.modal = "rename"; } } AppButton { text: GuiI18n.text("gui-close"); tone: "primary"; clicked => { root.modal = ""; } } }
                }
                if root.modal == "rename" : VerticalLayout { spacing: 14px; BodyText { text: root.pending-action-kind == "new-group" ? GuiI18n.text("gui-new-group-detail") : GuiI18n.text("gui-rename-detail"); wrap: word-wrap; } VerticalLayout { spacing: 6px; Text { text: GuiI18n.text("gui-name"); color: Theme.text-secondary; font-size: Theme.label-size; } TextField { text <=> root.pending-rename-text; accessible-name: GuiI18n.text("gui-name"); accepted => { root.rename-entity(root.pending-action-kind, root.pending-action-id, root.pending-rename-text); } } } if root.modal-error != "" : BodyText { text: root.modal-error; color: Theme.danger; wrap: word-wrap; } ActionRow { Rectangle { horizontal-stretch: 1; } AppButton { text: GuiI18n.text("gui-cancel"); clicked => { root.modal = ""; root.modal-error = ""; } } AppButton { text: root.pending-action-kind == "new-group" ? GuiI18n.text("gui-create-group") : GuiI18n.text("gui-rename"); tone: "primary"; enabled: root.pending-rename-text != ""; hint: GuiI18n.text("gui-hint-enter-name"); clicked => { root.rename-entity(root.pending-action-kind, root.pending-action-id, root.pending-rename-text); } } } }
                // Four groups, each hidden when empty, because each says
                // something different: these stop working, these lose a
                // feature, Ephervex has not asked about these, and
                // Ephervex cannot ask about these.
                if root.modal == "mod-impact" : VerticalLayout { spacing: 11px;
                    if root.mod-impact-breaks.length > 0 : BodyText { text: GuiI18n.count("gui-mod-impact-breaks", root.mod-impact-breaks.length); color: Theme.danger; wrap: word-wrap; }
                    if root.mod-impact-breaks.length > 0 : ImpactList { rows: root.mod-impact-breaks; }
                    if root.mod-requires-disabled.length > 0 : BodyText { text: GuiI18n.count("gui-mod-impact-needs", root.mod-requires-disabled.length); color: Theme.warning; wrap: word-wrap; }
                    if root.mod-requires-disabled.length > 0 : ImpactList { rows: root.mod-requires-disabled; }
                    if root.mod-requires-absent.length > 0 : BodyText { text: GuiI18n.count("gui-mod-impact-absent", root.mod-requires-absent.length); color: Theme.text-muted; wrap: word-wrap; }
                    if root.mod-requires-absent.length > 0 : ImpactList { rows: root.mod-requires-absent; }
                    if root.mod-requires-incompatible.length > 0 : BodyText { text: GuiI18n.count("gui-mod-impact-incompatible", root.mod-requires-incompatible.length); color: Theme.warning; wrap: word-wrap; }
                    if root.mod-requires-incompatible.length > 0 : ImpactList { rows: root.mod-requires-incompatible; }
                    if root.mod-impact-degrades.length > 0 : BodyText { text: GuiI18n.count("gui-mod-impact-degrades", root.mod-impact-degrades.length); color: Theme.text-secondary; wrap: word-wrap; }
                    if root.mod-impact-degrades.length > 0 : ImpactList { rows: root.mod-impact-degrades; }
                    if root.mod-impact-unknown.length > 0 : BodyText { text: GuiI18n.count("gui-mod-impact-unknown", root.mod-impact-unknown.length); color: Theme.text-muted; wrap: word-wrap; }
                    if root.mod-impact-unknown.length > 0 : ImpactList { rows: root.mod-impact-unknown; }
                    if root.mod-impact-unknown.length > 0 : HorizontalLayout { AppButton { text: GuiI18n.text("gui-mod-impact-refresh"); clicked => { root.refresh-mod-dependencies(root.mod-impact-kind, root.mod-impact-host, ""); root.modal = ""; } } Rectangle { horizontal-stretch: 1; } }
                    if root.mod-impact-unidentifiable.length > 0 : BodyText { text: GuiI18n.count("gui-mod-impact-unidentifiable", root.mod-impact-unidentifiable.length); color: Theme.text-muted; wrap: word-wrap; }
                    if root.mod-impact-unidentifiable.length > 0 : ImpactList { rows: root.mod-impact-unidentifiable; }
                    if root.mod-impact-breaks.length > 0 || root.mod-requires-disabled.length > 0 : LabeledToggle {
                        label: !root.mod-impact-enabling ? GuiI18n.text("gui-mod-impact-cascade-off") : GuiI18n.text("gui-mod-impact-cascade-on");
                        width: 100%;
                        checked <=> root.mod-impact-cascade;
                    }
                    LabeledToggle { label: GuiI18n.text("gui-mod-impact-remember"); width: 100%; checked <=> root.mod-impact-remember; }
                    if root.modal-error != "" : BodyText { text: root.modal-error; color: Theme.danger; wrap: word-wrap; }
                    ActionRow {
                        Rectangle { horizontal-stretch: 1; }
                        AppButton { text: GuiI18n.text("gui-cancel"); clicked => { root.modal = ""; root.modal-error = ""; } }
                        AppButton {
                            text: root.mod-impact-deleting ? GuiI18n.text("gui-delete") : root.mod-impact-enabling ? GuiI18n.text("gui-mod-impact-turn-on") : GuiI18n.text("gui-mod-impact-turn-off");
                            tone: !root.mod-impact-enabling ? "danger" : "primary";
                            clicked => { root.apply-mod-impact(root.mod-impact-cascade); }
                        }
                    }
                }
                if root.modal == "snapshot-create" : VerticalLayout { spacing: 14px;
                    BodyText { text: GuiI18n.text("gui-snapshot-create-detail"); wrap: word-wrap; }
                    FieldLabel { text: GuiI18n.text("gui-snapshot-label"); }
                    TextField { text <=> root.snapshot-action-label; placeholder: root.snapshot-label-suggestion; accessible-name: GuiI18n.text("gui-snapshot-label"); }
                    BodyText { text: GuiI18n.text("gui-snapshot-local-note"); color: Theme.text-muted; wrap: word-wrap; }
                    ActionRow { Rectangle { horizontal-stretch: 1; } AppButton { text: GuiI18n.text("gui-cancel"); clicked => { root.modal = ""; } } AppButton { text: GuiI18n.text("gui-snapshot-create"); tone: "primary"; enabled: root.snapshot-action-label != "" || root.snapshot-label-suggestion != ""; hint: GuiI18n.text("gui-hint-enter-name"); clicked => { root.modal = ""; root.create-snapshot(root.snapshot-host-kind, root.snapshot-host-id, root.snapshot-action-label != "" ? root.snapshot-action-label : root.snapshot-label-suggestion); } } }
                }
                if root.modal == "snapshot-restore" : VerticalLayout { spacing: 14px;
                    BodyText { text: GuiI18n.value("gui-snapshot-restore-detail", root.snapshot-action-label); color: Theme.warning; wrap: word-wrap; }
                    BodyText { text: GuiI18n.text("gui-snapshot-replacement-note"); wrap: word-wrap; }
                    LabeledToggle { label: GuiI18n.text("gui-snapshot-safety-copy"); width: 100%; checked <=> root.snapshot-safety-copy; }
                    ActionRow { Rectangle { horizontal-stretch: 1; } AppButton { text: GuiI18n.text("gui-cancel"); clicked => { root.modal = ""; } } AppButton { text: GuiI18n.text("gui-snapshot-restore"); tone: "danger"; clicked => { root.modal = ""; root.restore-snapshot(root.snapshot-host-kind, root.snapshot-host-id, root.snapshot-action-id, root.snapshot-safety-copy); } } }
                }
                if root.modal == "snapshot-rename" : VerticalLayout { spacing: 14px;
                    BodyText { text: GuiI18n.text("gui-snapshot-rename-detail"); wrap: word-wrap; }
                    FieldLabel { text: GuiI18n.text("gui-snapshot-label"); }
                    TextField { text <=> root.snapshot-action-label; accessible-name: GuiI18n.text("gui-snapshot-label"); }
                    ActionRow { Rectangle { horizontal-stretch: 1; } AppButton { text: GuiI18n.text("gui-cancel"); clicked => { root.modal = ""; } } AppButton { text: GuiI18n.text("gui-rename"); tone: "primary"; enabled: root.snapshot-action-label != ""; hint: GuiI18n.text("gui-hint-enter-name"); clicked => { root.modal = ""; root.rename-snapshot(root.snapshot-host-kind, root.snapshot-host-id, root.snapshot-action-id, root.snapshot-action-label); } } }
                }
                if root.modal == "snapshot-delete" : VerticalLayout { spacing: 14px;
                    BodyText { text: GuiI18n.value("gui-snapshot-delete-detail", root.snapshot-action-label); color: Theme.warning; wrap: word-wrap; }
                    BodyText { text: GuiI18n.text("gui-snapshot-delete-note"); wrap: word-wrap; }
                    ActionRow { Rectangle { horizontal-stretch: 1; } AppButton { text: GuiI18n.text("gui-cancel"); clicked => { root.modal = ""; } } AppButton { text: GuiI18n.text("gui-delete"); tone: "danger"; clicked => { root.modal = ""; root.delete-snapshot(root.snapshot-host-kind, root.snapshot-host-id, root.snapshot-action-id); } } }
                }
                if root.modal == "delete-mod" : VerticalLayout { spacing: 14px; BodyText { text: GuiI18n.value(root.mod-action-is-hand-placed ? "gui-delete-mod-detail" : "gui-delete-restorable-mod-detail", root.pending-action-name); color: Theme.warning; wrap: word-wrap; } BodyText { text: GuiI18n.text(root.mod-action-is-hand-placed ? "gui-delete-mod-note" : "gui-delete-restorable-mod-note"); wrap: word-wrap; } if root.modal-error != "" : BodyText { text: root.modal-error; color: Theme.danger; wrap: word-wrap; } ActionRow { Rectangle { horizontal-stretch: 1; } AppButton { text: GuiI18n.text("gui-cancel"); clicked => { root.modal = ""; root.modal-error = ""; } } AppButton { text: GuiI18n.text("gui-delete"); tone: "danger"; clicked => { root.delete-hand-placed-mod(root.pending-action-kind, root.pending-action-id, root.mod-action-path); } } } }
                if root.modal == "mod-stand-in" : VerticalLayout { spacing: 14px; BodyText { text: root.mod-stand-in-detail; color: Theme.warning; wrap: word-wrap; } BodyText { text: root.mod-stand-in-note; wrap: word-wrap; } ActionRow { Rectangle { horizontal-stretch: 1; } AppButton { text: GuiI18n.text("gui-cancel"); clicked => { root.answer-mod-stand-in(root.mod-stand-in-id, false); } } AppButton { text: GuiI18n.text("gui-mod-stand-in-accept"); tone: "primary"; clicked => { root.answer-mod-stand-in(root.mod-stand-in-id, true); } } } }
                if root.modal == "storage-cleanup" : VerticalLayout {
                    spacing: 12px;
                    vertical-stretch: 1;
                    ScrollView {
                        content-width: self.width;
                        vertical-stretch: 1;
                        VerticalLayout {
                            padding-left: Theme.lift-room; padding-top: Theme.lift-room; padding-right: Theme.shadow-room;
                            padding-bottom: Theme.shadow-room;
                            spacing: 10px;
                            Heading { text: root.storage-plan-summary; font-size: Theme.row-heading-size; wrap: word-wrap; }
                            if root.storage-plan-empty : BodyText { text: GuiI18n.text("gui-storage-cleanup-empty"); wrap: word-wrap; }
                            for item in root.storage-plan-items : Rectangle {
                                border-radius: Theme.card-radius;
                                border-width: Theme.strong-border-width;
                                border-color: Theme.border-strong;
                                background: Theme.surface;
                                height: plan-item-body.preferred-height;
                                plan-item-body := VerticalLayout {
                                    padding: 12px;
                                    spacing: 4px;
                                    HorizontalLayout {
                                        spacing: 10px;
                                        Heading { text: item.label; font-size: Theme.row-heading-size; horizontal-stretch: 1; }
                                        BodyText { text: item.size; vertical-alignment: center; }
                                    }
                                    for line in item.lines : BodyText { text: line; wrap: word-wrap; }
                                    BodyText { text: item.detail; color: Theme.text-secondary; wrap: word-wrap; }
                                    for example in item.examples : BodyText { text: example; color: Theme.text-muted; font-size: Theme.caption-size; wrap: word-wrap; }
                                }
                            }
                            if root.storage-plan-kept.length > 0 : Heading { text: GuiI18n.text("gui-storage-cleanup-kept"); font-size: Theme.row-heading-size; }
                            for kept in root.storage-plan-kept : BodyText { text: kept; color: Theme.text-secondary; wrap: word-wrap; }
                            if root.storage-plan-incomplete : BodyText { text: GuiI18n.text("gui-storage-cleanup-incomplete"); color: Theme.warning; wrap: word-wrap; }
                            BodyText { text: GuiI18n.text("gui-storage-cleanup-protected"); color: Theme.text-muted; wrap: word-wrap; }
                        }
                    }
                    ActionRow {
                        Rectangle { horizontal-stretch: 1; }
                        AppButton { text: GuiI18n.text("gui-cancel"); clicked => { root.modal = ""; } }
                        AppButton { text: root.storage-plan-confirm; tone: "danger"; enabled: !root.storage-plan-empty; hint: GuiI18n.text("gui-storage-cleanup-empty"); clicked => { root.confirm-storage-cleanup(root.storage-plan-id); root.modal = ""; } }
                    }
                }
                if root.modal == "remove-java-runtime" : VerticalLayout { spacing: 14px; BodyText { text: GuiI18n.value("gui-java-remove-runtime-detail", root.pending-action-name); color: Theme.warning; wrap: word-wrap; } BodyText { text: root.pending-action-id; color: Theme.text-muted; wrap: word-wrap; } if root.pending-java-pinning != "" : BodyText { text: GuiI18n.value("gui-java-remove-runtime-pinned", root.pending-java-pinning); color: Theme.warning; wrap: word-wrap; } if !root.pending-java-pins-known : BodyText { text: GuiI18n.text("gui-java-remove-runtime-pins-unknown"); color: Theme.warning; wrap: word-wrap; } BodyText { text: GuiI18n.text("gui-java-remove-runtime-note"); wrap: word-wrap; } if root.modal-error != "" : BodyText { text: root.modal-error; color: Theme.danger; wrap: word-wrap; } ActionRow { Rectangle { horizontal-stretch: 1; } AppButton { text: GuiI18n.text("gui-cancel"); clicked => { root.modal = ""; root.modal-error = ""; } } AppButton { text: GuiI18n.text("gui-remove"); tone: "danger"; clicked => { root.remove-java-runtime(root.pending-action-id); root.modal = ""; root.modal-error = ""; } } } }
                if root.modal == "mod-clash" && root.mod-clash-index < root.mod-clashes.length : VerticalLayout { spacing: 14px; BodyText { text: GuiI18n.value("gui-mod-clash-detail", root.mod-clashes[root.mod-clash-index].file-name); wrap: word-wrap; } if root.mod-clashes[root.mod-clash-index].existing-is-disabled : BodyText { text: GuiI18n.text("gui-mod-clash-disabled"); color: Theme.warning; wrap: word-wrap; } if root.mod-clashes[root.mod-clash-index].existing-is-recorded : BodyText { text: GuiI18n.text("gui-mod-clash-recorded"); color: Theme.warning; wrap: word-wrap; } if root.mod-clashes.length > 1 : BodyText { text: GuiI18n.values("gui-mod-clash-progress", root.mod-clash-index + 1, root.mod-clashes.length); color: Theme.text-muted; font-size: Theme.caption-size; } ActionRow { AppButton { text: GuiI18n.text("gui-skip-all"); clicked => { root.resolve-mod-clash("skip-all"); } } AppButton { text: GuiI18n.text("gui-overwrite-all"); clicked => { root.resolve-mod-clash("overwrite-all"); } } Rectangle { horizontal-stretch: 1; } AppButton { text: GuiI18n.text("gui-skip"); clicked => { root.resolve-mod-clash("skip"); } } AppButton { text: GuiI18n.text("gui-overwrite"); tone: "primary"; clicked => { root.resolve-mod-clash("overwrite"); } } } }
                if root.modal == "pane-host" : VerticalLayout { spacing: 12px;
                    TextField { text <=> root.pane-host-query; placeholder: GuiI18n.text("gui-filter-hosts"); input-type: InputType.search; edited(text) => { root.pane-host-query-changed(); } }
                    ScrollView {
                        content-width: self.visible-width;
                        VerticalLayout {
                            // The selected card's ring and every card's shadow lie outside it.
                            padding: Theme.shadow-room;
                            alignment: start; spacing: 8px;
                            Eyebrow { text: GuiI18n.text("gui-instances"); }
                            if root.workspace-client-choices.length == 0 : BodyText { text: GuiI18n.text("gui-pane-host-no-clients"); color: Theme.text-muted; wrap: word-wrap; }
                            for choice in root.workspace-client-choices : HostPickerCard {
                                item: choice; current-kind: root.pane-host-picker-kind; current-id: root.pane-host-picker-id;
                                picked(kind, id) => { root.modal = ""; root.choose-pane-host(root.pane-host-picker-pane, kind, id); }
                            }
                            Rectangle { height: 6px; }
                            Eyebrow { text: GuiI18n.text("gui-servers"); }
                            if root.workspace-server-choices.length == 0 : BodyText { text: GuiI18n.text("gui-pane-host-no-servers"); color: Theme.text-muted; wrap: word-wrap; }
                            for choice in root.workspace-server-choices : HostPickerCard {
                                item: choice; current-kind: root.pane-host-picker-kind; current-id: root.pane-host-picker-id;
                                picked(kind, id) => { root.modal = ""; root.choose-pane-host(root.pane-host-picker-pane, kind, id); }
                            }
                        }
                    }
                    ActionRow { Rectangle { horizontal-stretch: 1; } AppButton { text: GuiI18n.text("gui-cancel"); clicked => { root.modal = ""; } } }
                }
                if root.modal == "open-pack-link" : VerticalLayout { spacing: 14px;
                    BodyText { text: root.pack-link-downloading ? GuiI18n.text("gui-downloading-pack") : root.pack-link-redirected ? GuiI18n.text("gui-open-pack-link-redirected-detail") : GuiI18n.text("gui-open-pack-link-detail"); wrap: word-wrap; }
                    // The address itself, on its own line and selectable by
                    // eye: this is the thing being agreed to.
                    Rectangle { border-radius: Theme.card-radius; border-width: Theme.strong-border-width; border-color: Theme.border-strong; background: Theme.background; VerticalLayout { padding: 12px; BodyText { text: root.pack-link-display; font-family: Theme.mono-family; wrap: word-wrap; } } }
                    if !root.pack-link-downloading : HorizontalLayout { spacing: 8px; VerticalLayout { alignment: center; Toggle { checked: root.pack-link-remember; accessible-name: GuiI18n.text("gui-open-pack-link-remember"); toggled(on) => { root.pack-link-remember = on; } } } BodyText { text: GuiI18n.text("gui-open-pack-link-remember"); vertical-alignment: center; } }
                    if root.modal-error != "" : BodyText { text: root.modal-error; color: Theme.danger; wrap: word-wrap; }
                    ActionRow { Rectangle { horizontal-stretch: 1; } AppButton { text: GuiI18n.text("gui-cancel"); clicked => { root.cancel-pack-link(); root.modal = ""; root.modal-error = ""; } } if !root.pack-link-downloading : AppButton { text: GuiI18n.text("gui-open-pack-link-confirm"); tone: "primary"; clicked => { root.open-pack-link(root.pack-link-url, root.pack-link-host, root.pack-link-remember); } } }
                }
                if root.modal == "microsoft-sign-in" : VerticalLayout { spacing: 14px;
                    BodyText { text: GuiI18n.text("gui-microsoft-sign-in-detail"); wrap: word-wrap; }
                    Rectangle {
                        border-radius: 6px; border-width: 1px; border-color: Theme.border; background: Theme.background;
                        VerticalLayout {
                            padding: 16px; spacing: 6px;
                            Text { text: root.microsoft-sign-in-code; font-family: Theme.mono-family; font-size: Theme.page-title-size; color: Theme.text; horizontal-alignment: center; accessible-role: text; accessible-label: GuiI18n.text("gui-microsoft-sign-in-code-label") + ": " + root.microsoft-sign-in-code; }
                            BodyText { text: root.microsoft-sign-in-address; font-family: Theme.mono-family; color: Theme.text-secondary; horizontal-alignment: center; wrap: word-wrap; }
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px; alignment: center;
                        AppButton { text: GuiI18n.text("gui-microsoft-sign-in-copy-code"); clicked => { root.copy-text(root.microsoft-sign-in-code); } }
                        AppButton { text: GuiI18n.text("gui-microsoft-sign-in-open-page"); enabled: root.microsoft-sign-in-address-openable; hint: GuiI18n.text("gui-microsoft-sign-in-open-page-unavailable"); clicked => { root.open-microsoft-sign-in-page(); } }
                    }
                    HorizontalLayout {
                        spacing: 7px; alignment: center;
                        BusySpinner { width: 16px; height: 16px; }
                        BodyText { text: GuiI18n.text("gui-microsoft-sign-in-waiting"); color: Theme.text-secondary; vertical-alignment: center; }
                    }
                    ActionRow { Rectangle { horizontal-stretch: 1; } AppButton { text: GuiI18n.text("gui-cancel"); clicked => { root.cancel-microsoft-sign-in(); root.modal = ""; root.modal-error = ""; } } }
                }
                if root.modal == "make-persistent" : VerticalLayout { spacing: 14px;
                    BodyText { text: GuiI18n.value("gui-make-persistent-detail", root.promote-instance-name); wrap: word-wrap; }
                    // The exact destination, because a user who set their
                    // own persistent instance folder wants to see it.
                    BodyText { text: root.promote-destination; color: Theme.text-muted; font-size: Theme.caption-size; wrap: word-wrap; }
                    if root.promote-servers.length > 0 : BodyText { text: GuiI18n.count("gui-make-persistent-servers", root.promote-servers.length); wrap: word-wrap; }
                    if root.promote-servers.length > 0 : ScrollView {
                        content-width: self.width;
                        height: min(root.promote-servers.length * 28px, 168px);
                        vertical-stretch: 0;
                        VerticalLayout {
                            for server[index] in root.promote-servers : HorizontalLayout {
                                spacing: 8px;
                                height: 28px;
                                Toggle {
                                    checked: server.selected;
                                    accessible-name: server.display;
                                    toggled(on) => { root.promote-servers[index].selected = on; }
                                }
                                BodyText { text: server.display; overflow: elide; vertical-alignment: center; }
                            }
                        }
                    }
                    if root.modal-error != "" : BodyText { text: root.modal-error; color: Theme.danger; wrap: word-wrap; }
                    ActionRow { Rectangle { horizontal-stretch: 1; } AppButton { text: GuiI18n.text("gui-cancel"); clicked => { root.modal = ""; root.modal-error = ""; } } AppButton { text: GuiI18n.text("gui-make-persistent-confirm"); tone: "primary"; clicked => { root.submit-make-persistent(root.pending-action-id); } } }
                }
                if root.modal == "absent-mods" : VerticalLayout { spacing: 14px; BodyText { text: GuiI18n.count("gui-absent-mods-detail", root.absent-mods.length); wrap: word-wrap; } ScrollView { height: min(140px, root.absent-mods.length * 22px); vertical-stretch: 0; content-width: self.width; VerticalLayout { spacing: 2px; for name in root.absent-mods : BodyText { text: "\u{2022} " + name; color: Theme.text-secondary; font-size: Theme.caption-size; overflow: elide; } } } BodyText { text: GuiI18n.text("gui-absent-mods-note"); color: Theme.text-muted; font-size: Theme.caption-size; wrap: word-wrap; } ActionRow { Rectangle { horizontal-stretch: 1; } AppButton { text: GuiI18n.text("gui-cancel"); clicked => { root.modal = ""; } } AppButton { text: GuiI18n.text("gui-copy-without-them"); clicked => { root.duplicate-client-deciding(root.pending-action-id, true); } } AppButton { text: GuiI18n.text("gui-copy-with-them"); tone: "primary"; clicked => { root.duplicate-client-deciding(root.pending-action-id, false); } } } }
                if root.modal == "delete-instance" || root.modal == "delete-server" : VerticalLayout { spacing: 14px; BodyText { text: GuiI18n.value(root.modal == "delete-instance" ? "gui-delete-instance-detail" : "gui-delete-server-detail", root.pending-action-name); color: Theme.warning; wrap: word-wrap; } BodyText { text: root.pending-snapshot-deletion-note; color: Theme.warning; wrap: word-wrap; } if root.modal == "delete-instance" && root.pending-action-linked-servers > 0 : BodyText { text: GuiI18n.count("gui-delete-instance-linked", root.pending-action-linked-servers); color: Theme.warning; wrap: word-wrap; } if root.modal == "delete-instance" && root.pending-deletion-stops-servers : BodyText { text: GuiI18n.count("gui-delete-instance-stops-servers", root.pending-action-stoppable-linked-servers); color: Theme.warning; wrap: word-wrap; } if root.modal == "delete-instance" && root.pending-action-unstoppable-linked-servers > 0 : BodyText { text: GuiI18n.count("gui-delete-instance-unstoppable-servers", root.pending-action-unstoppable-linked-servers); color: Theme.danger; wrap: word-wrap; } if root.modal-error != "" : BodyText { text: root.modal-error; color: Theme.danger; wrap: word-wrap; } // What happens to the files is the choice, so each outcome is a card of its own.
                    HorizontalLayout { spacing: 12px; padding-right: Theme.shadow-room;
                        Outlined { radius: Theme.card-radius; height: 190px * Theme.text-scale;
                            VerticalLayout { padding: 14px; spacing: 8px;
                                Heading { text: GuiI18n.text("gui-delete-keep-title"); font-size: Theme.item-title-size; }
                                BodyText { text: GuiI18n.text("gui-delete-keep-detail"); wrap: word-wrap; }
                                Rectangle { vertical-stretch: 1; }
                                HorizontalLayout { padding-right: Theme.shadow-room; padding-bottom: Theme.shadow-room; AppButton { horizontal-stretch: 1; text: GuiI18n.text(root.modal == "delete-instance" && root.pending-deletion-stops-servers ? "gui-stop-and-keep-files" : "gui-remove-from-ephervex"); clicked => { if root.modal == "delete-instance" { root.delete-client(root.pending-action-id, false, root.pending-deletion-stops-servers); } else { root.delete-server(root.pending-action-id, false); } } } }
                            }
                        }
                        Outlined { radius: Theme.card-radius; outline: Theme.danger; height: 190px * Theme.text-scale;
                            VerticalLayout { padding: 14px; spacing: 8px;
                                Heading { text: GuiI18n.text("gui-delete-files-title"); font-size: Theme.item-title-size; }
                                BodyText { text: GuiI18n.text("gui-delete-files-detail"); wrap: word-wrap; }
                                Rectangle { vertical-stretch: 1; }
                                HorizontalLayout { padding-right: Theme.shadow-room; padding-bottom: Theme.shadow-room; AppButton { horizontal-stretch: 1; text: GuiI18n.text(root.modal == "delete-instance" && root.pending-deletion-stops-servers ? "gui-stop-and-delete-files" : "gui-delete-files"); tone: "danger"; clicked => { if root.modal == "delete-instance" { root.delete-client(root.pending-action-id, true, root.pending-deletion-stops-servers); } else { root.delete-server(root.pending-action-id, true); } } } }
                            }
                        }
                    }
                    ActionRow { Rectangle { horizontal-stretch: 1; } AppButton { text: GuiI18n.text("gui-cancel"); clicked => { root.modal = ""; root.modal-error = ""; } } } }
                if root.modal == "launcher-bundle" : DiagnosticBundlePanel {
                    empty-text: GuiI18n.text("gui-launcher-bundle-empty");
                    parts: root.launcher-bundle-parts;
                    selection: root.launcher-bundle-selection;
                    selected-count: root.launcher-bundle-selected-count;
                    exporting: root.launcher-bundle-exporting;
                    result: root.launcher-bundle-result;
                    result-path: root.launcher-bundle-result-path;
                    error: root.launcher-bundle-error;
                    toggle(name, value) => { root.toggle-launcher-bundle-part(name, value); }
                    select-all(value) => { root.select-all-launcher-bundle-parts(value); }
                    export => { root.export-launcher-bundle(); }
                    open-folder => { root.open-bundle-folder(root.launcher-bundle-result-path); }
                }
                if root.modal == "theme-problems" : VerticalLayout {
                    spacing: 14px;
                    BodyText { text: GuiI18n.value("gui-theme-problems-detail", root.themes-folder); wrap: word-wrap; }
                    ScrollView {
                        vertical-stretch: 1;
                        content-width: self.width;
                        content-height: theme-problem-list.preferred-height;
                        theme-problem-list := VerticalLayout {
                            alignment: start;
                            spacing: 8px;
                            for problem in root.theme-problems : BodyText { text: problem; color: Theme.text-secondary; wrap: word-wrap; }
                        }
                    }
                    ActionRow { Rectangle { horizontal-stretch: 1; } AppButton { text: GuiI18n.text("gui-close"); clicked => { root.modal = ""; } } }
                }
                if root.modal == "license" : ScrollView {
                    vertical-stretch: 1;
                    content-width: self.width;
                    // Without the content's own height the viewport keeps the ScrollView's, and a longer text is centered in it rather than scrolled from the top.
                    content-height: ephervex-license.preferred-height;
                    ephervex-license := HorizontalLayout {
                        alignment: center;
                        Text { text: root.license-text; color: Theme.text-secondary; font-family: Theme.mono-family; font-size: Theme.label-size; wrap: word-wrap; }
                    }
                }
                if root.modal == "third-party" && root.third-party-open < 0 : VerticalLayout {
                    spacing: 12px;
                    if root.third-party-error != "" : BodyText { text: root.third-party-error; color: Theme.danger; wrap: word-wrap; }
                    if root.third-party-error == "" : BodyText { text: root.third-party-summary; }
                    if root.third-party-error == "" : BodyText { text: GuiI18n.text("gui-third-party-select"); color: Theme.text-muted; font-size: Theme.caption-size; wrap: word-wrap; }
                    if root.third-party-error == "" : ListView {
                        vertical-stretch: 1;
                        for package[index] in root.third-party-packages : Rectangle {
                            height: Theme.license-row-height;
                            background: touch.has-hover ? Theme.selection : transparent;
                            border-radius: 4px;
                            touch := TouchArea {
                                // The whole row, because a list read with
                                // the eyes is pointed at with the mouse.
                                mouse-cursor: pointer;
                                clicked => { root.third-party-open = index; }
                            }
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 10px;
                                BodyText { text: package.name; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                                BodyText { text: package.version; color: Theme.text-secondary; font-size: Theme.caption-size; vertical-alignment: center; }
                                BodyText { text: package.license; color: Theme.text-muted; font-size: Theme.caption-size; vertical-alignment: center; overflow: elide; width: 180px; horizontal-alignment: right; }
                            }
                        }
                    }
                    // Attribution itself, which the royalty-free license
                    // Ephervex uses Slint under asks for on this screen.
                    BodyText { text: GuiI18n.text("gui-slint-attribution"); color: Theme.text-muted; font-size: Theme.caption-size; wrap: word-wrap; }
                    if root.third-party-error == "" : BodyText { text: GuiI18n.text("gui-third-party-note"); color: Theme.text-muted; font-size: Theme.caption-size; wrap: word-wrap; }
                    ActionRow { Rectangle { horizontal-stretch: 1; } AppButton { text: GuiI18n.text("gui-close"); tone: "primary"; clicked => { root.modal = ""; } } }
                }
                if root.modal == "third-party" && root.third-party-open >= 0 : VerticalLayout {
                    spacing: 12px;
                    ScrollView {
                        vertical-stretch: 1;
                        // A dependency's license file is not hard-wrapped
                        // the way Ephervex's own LICENSE is, so the text
                        // has to be given the viewport's width to wrap
                        // against. Without it the paragraph takes its
                        // natural width and the reader scrolls sideways
                        // through every line.
                        content-width: self.width;
                        // And its height, or the viewport keeps the ScrollView's and centers a longer license in it instead of scrolling from the top.
                        content-height: third-party-license.preferred-height;
                        third-party-license := Text { text: root.third-party-packages[root.third-party-open].text; width: parent.width; color: Theme.text-secondary; font-family: Theme.mono-family; font-size: Theme.label-size; wrap: word-wrap; }
                    }
                    ActionRow { AppButton { text: GuiI18n.text("gui-third-party-back"); clicked => { root.third-party-open = -1; } } Rectangle { horizontal-stretch: 1; } AppButton { text: GuiI18n.text("gui-close"); tone: "primary"; clicked => { root.modal = ""; } } }
                }
            }
        }
    }

    dialog-end := FocusEdge { active: root.modal != ""; }
    FocusEdge { active: root.modal != ""; reached => { dialog-start.focus(); } }
    HoverNoteLayer { width: root.width; height: root.height; }
}
