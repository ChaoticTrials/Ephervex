    // Leaving the page that shows the capturing row destroys it without the
    // row ever losing focus, so the capture ends here.
    changed settings-tab => {
        if (self.minecraft-capturing-id != "") { self.minecraft-cancel-capture(); }
    }
    changed settings-open => {
        if (self.minecraft-capturing-id != "") { self.minecraft-cancel-capture(); }
        shell.list-open = false;
    }
    changed shows-home => {
        if (self.shows-home) { self.home-appeared(); }
        shell.side-open = false;
    }
    changed shows-host-column => { shell.side-open = false; }
    changed column-host-key => { shell.side-open = false; }
    // Whatever opens a page from the list leaves the list's drawer behind.
    changed workspace-open => { shell.list-open = false; }
    changed create-minecraft => {
        if root.create-minecraft != "" {
            root.warm-language-catalog(root.create-minecraft);
        }
    }
    // Focus goes into a dialog when it opens, and is kept there by the edges
    // below, so the page behind it cannot be tabbed to and pressed.
    changed modal => {
        if root.modal != "" {
            dialog-start.focus();
        }
    }
    changed create-server-minecraft => {
        if root.create-server-minecraft != "" {
            root.warm-language-catalog(root.create-server-minecraft);
        }
    }

    // Reads what Home shows. Run when Home appears, and once at startup.
    public function home-appeared() {
        root.load-running();
        if (!root.artifact-cache-requested) {
            root.artifact-cache-requested = true;
            root.measure-artifact-cache();
        }
    }
    // Opens a settings page over the host panes or Home, and reads what the
    // page shows.
    public function open-settings(tab: string) {
        root.close-quick-view();
        root.settings-tab = tab;
        root.settings-open = true;
        if (tab == "Minecraft") {
            root.request-version-catalog();
        } else if (tab == "Java") {
            root.load-java-runtimes();
        } else if (tab == "Storage") {
            root.measure-artifact-cache();
        } else if (tab == "Diagnostics") {
            root.request-launcher-bundle();
        }
    }
    // Leaves the settings and any open host for Home.
    public function open-home() {
        root.settings-open = false;
        root.close-workspace();
    }
    function open-host(kind: string, id: string) {
        root.open-host-surface(kind, id, "Overview");
    }
    function open-host-surface(kind: string, id: string, surface: string) {
        root.settings-open = false;
        root.open-workspace(kind, id, surface);
    }
    // Shows a host in the quick view and puts keyboard focus where Escape reaches it.
    public function show-quick-view(kind: string, id: string) {
        root.open-quick-view(kind, id);
        shell.focus-keys();
    }
    // The New Server dialog for a server on its own.
    public function open-create-server() {
        root.create-server-client-id = "";
        root.create-server-name = "";
        root.recompute-create-server-name();
        root.modal-error = "";
        root.request-version-catalog();
        root.warm-language-catalog(root.create-server-minecraft);
        root.create-server-pack = "";
        root.create-server-pack-name = "";
        root.create-server-automatic-port = !root.stored-server-port-custom;
        root.create-server-port = root.stored-server-port-custom ? root.stored-server-port : "";
        root.create-server-online = root.default-server-online;
        root.create-server-link-index = 0;
        root.modal = "create-server";
    }
    // The New Server dialog for a server linked to one client.
    function open-create-linked-server(client-id: string, client-name: string) {
        root.create-server-client-id = client-id;
        root.create-server-name = "";
        root.create-server-name-suggestion = NameRules.linked-server-name(client-name);
        root.create-server-pack = "";
        root.create-server-pack-name = "";
        root.create-server-automatic-port = !root.stored-server-port-custom;
        root.create-server-port = root.stored-server-port-custom ? root.stored-server-port : "";
        root.create-server-online = root.default-server-online;
        root.create-server-link-index = root.server-link-index(client-id);
        root.modal = "create-server";
    }

    function save-server-port-edits() {
        if (root.default-server-port-editing) {
            root.default-server-port-editing = false;
            root.save-server-port-default(root.default-server-port-custom, root.default-server-port);
        }
    }
    // A save asked for while the last one is still running waits for it, so
    // that what is on the page is always what ends up stored.
    private property <bool> java-resave: false;
    private property <bool> java-edited: false;
    function save-java() {
        if (root.java-saving) {
            root.java-resave = true;
        } else {
            root.save-java-settings(root.java-auto-detect, root.java-auto-download, root.java-memory-min, root.java-memory-max, root.java-preferred-path);
        }
    }
    function save-java-edits() {
        if (root.java-edited) {
            root.java-edited = false;
            root.save-java();
        }
    }
    changed java-saving => {
        if (!root.java-saving && root.java-resave) {
            root.java-resave = false;
            root.save-java();
        }
    }
    private property <bool> cache-limit-resave: false;
    private property <bool> cache-limit-edited: false;
    function save-cache-limit() {
        // A custom limit waits for its size.
        if (root.artifact-cache-limit-index == root.artifact-cache-custom-index && root.artifact-cache-custom-value == "") {
            return;
        }
        if (root.artifact-cache-limit-saving) {
            root.cache-limit-resave = true;
        } else {
            root.save-artifact-cache-limit(root.artifact-cache-limit-index, root.artifact-cache-custom-value, root.artifact-cache-custom-unit);
        }
    }
    function save-cache-limit-edits() {
        if (root.cache-limit-edited) {
            root.cache-limit-edited = false;
            root.save-cache-limit();
        }
    }
    changed artifact-cache-limit-saving => {
        if (!root.artifact-cache-limit-saving && root.cache-limit-resave) {
            root.cache-limit-resave = false;
            root.save-cache-limit();
        }
    }
    // Stores the General settings as they stand.
    function save-general() {
        root.save-general-settings(root.application-text-scale, root.technical-text-size, root.application-theme, root.show-linked-servers, root.make-default-account-operator, root.operator-permission-level);
    }

    // Where Tab begins when nothing has focus, which with a dialog open must
    // be the dialog.
    FocusEdge { active: root.modal != ""; reached => { dialog-start.focus(); } }

    VerticalLayout {
        spacing: 0px;
        min-width: Theme.window-min-width;
        preferred-width: 1480px;
        min-height: Theme.window-min-height;
        preferred-height: 900px;
        shell := AppShell {
            vertical-stretch: 1;
            escape-leaves: root.quick-view-open && root.modal == "";
            escape => { if root.quick-view-fullscreen { root.quick-view-fullscreen = false; } else { root.close-quick-view(); } }
            has-side: root.shows-home || root.shows-host-column;
            side-rail: root.shows-home;
            side-inline-from: root.shows-home ? Theme.shell-side-inline-width : Theme.shell-host-side-inline-width;
            list-button-label: GuiI18n.text("gui-shell-show-list");
            side-button-label: GuiI18n.text("gui-shell-show-side");
            list-hide-label: GuiI18n.text("gui-shell-hide-list");
            side-hide-label: GuiI18n.text("gui-shell-hide-side");
            // Every instance and server, beside whatever the page shows, or
            // over it as a drawer in a narrow window.
            Rectangle {
                // Beside the page the column sits on the floor; as a drawer
                // it is a plate over the page, under its button.
                property <length> inset: shell.list-inline ? Theme.shell-padding : Theme.shell-drawer-padding;
                z: 13;
                x: shell.list-inline ? 0px : shell.list-open ? Theme.shell-padding : -self.width - Theme.shell-padding;
                y: shell.list-inline ? 0px : Theme.shell-padding + shell.list-top;
                width: self.inset + Theme.list-column-width + self.inset;
                height: shell.list-inline ? shell.height : shell.content-height - shell.list-top;
                visible: (shell.list-inline && !(root.quick-view-open && root.quick-view-fullscreen)) || shell.list-open;
                if !shell.list-inline : Plate {
                    width: parent.width;
                    height: parent.height;
                    radius: Theme.dialog-radius;
                    fill: Theme.background;
                    TouchArea { }
                }
            VerticalLayout {
                x: parent.inset;
                y: parent.inset;
                width: Theme.list-column-width;
                height: parent.height - 2 * parent.inset;
                spacing: 14px;
                BrandBar {
                    logo: root.logo;
                    version: root.app-version;
                    refresh => { root.refresh(); }
                }
                HostList {
                    vertical-stretch: 1;
                    home-selected: root.shows-home;
                    open-home => { shell.list-open = false; root.open-home(); }
                    instances: root.instances;
                    servers: root.listed-servers;
                    pending-instances: root.pending-instances;
                    pending-servers: root.pending-servers;
                    instance-group-entries: root.instance-group-entries;
                    loading: root.loading;
                    startup-error: root.startup-error;
                    instance-total: root.instance-total;
                    instance-filters-active: root.instance-filters-active;
                    list-query <=> root.list-query;
                    instance-filters-open <=> root.instance-filters-open;
                    instance-filter <=> root.instance-filter;
                    instance-favorites-only <=> root.instance-favorites-only;
                    instance-minecraft-options: root.instance-minecraft-options;
                    instance-minecraft-index <=> root.instance-minecraft-index;
                    instance-loader-options: root.instance-loader-options;
                    instance-loader-index <=> root.instance-loader-index;
                    instance-run-options: root.instance-run-options;
                    instance-run-index <=> root.instance-run-index;
                    instance-linking-options: root.instance-linking-options;
                    instance-linking-index <=> root.instance-linking-index;
                    instance-group-options: root.instance-group-options;
                    instance-group-index <=> root.instance-group-index;
                    instance-sort-options: root.instance-sort-options;
                    instance-sort-index <=> root.instance-sort-index;
                    reveal-host-id: root.reveal-host-id;
                    reveal-token: root.reveal-token;
                    list-query-changed => { root.instance-view-changed(); }
                    instance-view-changed => { root.instance-view-changed(); }
                    choose-instance-sort(index) => { root.choose-instance-sort(index); }
                    clear-instance-filters => { root.clear-instance-filters(); }
                    open-groups => { root.modal-error = ""; root.modal = "groups"; }
                    create-instance => { root.open-create-instance-modal(); }
                    import-modpack => { root.open-import-modal(); }
                    create-server => { root.open-create-server(); }
                    open-client(id) => { shell.list-open = false; root.open-host("client", id); }
                    quick-view-client(id) => { shell.list-open = false; root.show-quick-view("client", id); }
                    toggle-client-favorite(id, favorite) => { root.set-favorite("client", id, favorite); }
                    set-client-group(id, group) => { root.set-client-group(id, group); }
                    new-client-group(id) => { root.pending-action-kind = "new-group"; root.pending-action-id = id; root.pending-rename-text = ""; root.modal-error = ""; root.modal = "rename"; }
                    pick-client-icon(id) => { root.pick-host-icon("client", id); }
                    clear-client-icon(id) => { root.clear-host-icon("client", id); }
                    launch-client(id) => { root.launch-client(id); }
                    kill-client(id) => { root.kill-instance(id, ""); }
                    open-client-folder(id) => { root.open-client-folder(id); }
                    create-linked-server(id, name) => { root.open-create-linked-server(id, name); }
                    duplicate-client(id) => { root.duplicate-client(id); }
                    make-client-persistent(id) => { root.open-make-persistent(id); }
                    rename-client(id, name) => { root.pending-action-kind = "client"; root.pending-action-id = id; root.pending-rename-text = name; root.modal-error = ""; root.modal = "rename"; }
                    delete-client(row) => { root.pending-action-id = row.id; root.pending-action-name = row.name; root.pending-snapshot-deletion-note = row.snapshot-deletion-note; root.pending-action-linked-servers = row.linked-servers; root.pending-action-stoppable-linked-servers = row.stoppable-linked-servers; root.pending-action-unstoppable-linked-servers = row.unstoppable-linked-servers; root.modal-error = ""; root.modal = "delete-instance"; }
                    open-server(id) => { shell.list-open = false; root.open-host("server", id); }
                    quick-view-server(id) => { shell.list-open = false; root.show-quick-view("server", id); }
                    toggle-server-favorite(id, favorite) => { root.set-favorite("server", id, favorite); }
                    pick-server-icon(id) => { root.pick-host-icon("server", id); }
                    clear-server-icon(id) => { root.clear-host-icon("server", id); }
                    start-server(id) => { root.server-start(id); }
                    stop-server(id) => { root.server-stop(id); }
                    restart-server(id) => { root.server-restart(id); }
                    kill-server(id, name) => { root.pending-action-id = id; root.pending-action-name = name; root.modal = "kill"; }
                    open-server-folder(id) => { root.open-server-folder(id); }
                    rename-server(id, name) => { root.pending-action-kind = "server"; root.pending-action-id = id; root.pending-rename-text = name; root.modal-error = ""; root.modal = "rename"; }
                    delete-server(row) => { root.pending-action-id = row.id; root.pending-action-name = row.name; root.pending-snapshot-deletion-note = row.snapshot-deletion-note; root.modal-error = ""; root.modal = "delete-server"; }
                }
                AccountFooter {
                    account-name: root.default-account-name;
                    account-initial: root.default-account-initial;
                    account-kind: root.default-account-kind;
                    account-entries: root.account-launch-entries;
                    choose-account(id) => { root.set-default-account(id); }
                    manage-accounts => { root.open-settings("Accounts"); }
                    open-settings => { shell.list-open = false; root.open-settings("General"); }
                }
            }
            if root.quick-view-open : Scrim { x: 0px; y: 0px; width: parent.width; height: parent.height; pressed => { root.close-quick-view(); } }
            }

            // The page: the settings, the host panes, or Home. One container
            // that always claims the space between the columns.
            //
            // A conditional child contributes no layout information of its
            // own, so a page that asked to stretch was given only the width
            // its content preferred. That is why an instance workspace
            // collapsed into a column whenever the open tab happened to be a
            // narrow one.
            Rectangle {
                x: shell.page-x;
                y: Theme.shell-padding;
                width: shell.page-width;
                height: shell.content-height;

                if root.shows-home : HomePage {
                    greeting: root.home-greeting;
                    summary: root.home-summary;
                    running: root.running;
                    attention: root.home-attention;
                    resume: root.home-resume;
                    activities: root.activities;
                    new-instance => { root.open-create-instance-modal(); }
                    import-modpack => { root.open-import-modal(); }
                    new-server => { root.open-create-server(); }
                    open-host(kind, id, surface) => { root.open-host-surface(kind, id, surface); }
                    open-log(kind, id) => { root.open-host-surface(kind, id, "Logs"); }
                    open-console(id) => { root.open-host-surface("server", id, "Console"); }
                    launch(kind, id) => { if kind == "server" { root.server-start(id); } else { root.launch-client(id); } }
                    stop(kind, id, launch) => { if kind == "server" { root.server-stop(id); } else { root.kill-instance(id, launch); } }
                    force-stop(id, launch) => { root.force-stop-launch(id, launch); }
                    cancel-operation(id) => { root.cancel-operation(id); }
                }
                // The host workspace. Each pane is one HostWorkspace over the
                // host view it names; the controller places the panes and
                // keeps every host view current, so two panes on one host
                // read one state.
                if root.workspace-open && !root.settings-open : Rectangle {
                    horizontal-stretch: 1;
                    // Two equal columns of one or two equal rows. A window
                    // too small for the panes' minimum cuts them off rather than
                    // letting one pane draw over another. The panes themselves
                    // are drawn beside the page, at the window's level.
                    if root.pane-split : HorizontalLayout {
                        y: 0px;
                        height: root.pane-head;
                        padding-left: 12px; padding-right: 12px; padding-top: 12px;
                        spacing: 12px;
                        AppButton { text: root.workspace-back-label; clicked => { root.workspace-back(); } }
                        Heading { text: GuiI18n.text("gui-workspace-split-title"); vertical-alignment: center; overflow: elide; }
                        Rectangle { horizontal-stretch: 1; }
                    }
                }

                // Settings.
                if root.settings-open : Panel {
                    lift: Theme.shadow-offset-card;
                    // Escape leaves Settings, from wherever focus is inside it.
                    FocusScope {
                        width: parent.width;
                        height: parent.height;
                        focus-on-tab-navigation: false;
                        init => { self.focus(); }
                        key-pressed(event) => {
                            if (event.text == Key.Escape && root.modal == "") {
                                root.settings-open = false;
                                return accept;
                            }
                            return reject;
                        }
                        VerticalLayout { spacing: 0px;
                            // The page's own header: the way out, what this is, and the key for it.
                            Rectangle { height: settings-head.preferred-height; background: Theme.surface;
                                Rectangle { y: parent.height - self.height; height: Theme.strong-border-width; background: Theme.border-strong; }
                                settings-head := HorizontalLayout { padding-left: 22px; padding-right: 26px; padding-top: 16px; padding-bottom: 16px; spacing: 16px; cross-axis-alignment: center;
                                    AppButton { text: GuiI18n.text("gui-settings-back"); icon: @image-url("../../../assets/icons/chevron-left.svg"); clicked => { root.settings-open = false; } }
                                    DisplayHeading { text: GuiI18n.text("gui-settings-heading"); font-size: Theme.workspace-title-size; vertical-alignment: center; }
                                    Rectangle { horizontal-stretch: 1; }
                                    BodyText { text: GuiI18n.text("gui-settings-escape-hint"); color: Theme.text-muted; vertical-alignment: center; }
                                }
                            }
                            HorizontalLayout { spacing: 0px;
                                Rectangle { width: 252px; background: Theme.surface;
                                    Rectangle { x: parent.width - self.width; width: Theme.strong-border-width; background: Theme.border-strong; }
                                    VerticalLayout { padding: 16px; padding-right: 16px + Theme.strong-border-width; spacing: 8px;
                                        SettingsNavItem { label: GuiI18n.text("gui-settings-general"); icon: @image-url("../../../assets/icons/nav-settings.svg"); selected: root.settings-tab == "General"; clicked => { root.open-settings("General"); } }
                                        SettingsNavItem { label: GuiI18n.text("gui-settings-minecraft"); icon: @image-url("../../../assets/icons/settings-minecraft.svg"); selected: root.settings-tab == "Minecraft"; clicked => { root.open-settings("Minecraft"); } }
                                        SettingsNavItem { label: GuiI18n.text("gui-settings-java"); icon: @image-url("../../../assets/icons/settings-java.svg"); selected: root.settings-tab == "Java"; clicked => { root.open-settings("Java"); } }
                                        SettingsNavItem { label: GuiI18n.text("gui-settings-accounts"); icon: @image-url("../../../assets/icons/settings-accounts.svg"); selected: root.settings-tab == "Accounts"; clicked => { root.open-settings("Accounts"); } }
                                        SettingsNavItem { label: GuiI18n.text("gui-settings-providers"); icon: @image-url("../../../assets/icons/settings-providers.svg"); selected: root.settings-tab == "Providers & APIs"; clicked => { root.open-settings("Providers & APIs"); } }
                                        SettingsNavItem { label: GuiI18n.text("gui-settings-server-properties"); icon: @image-url("../../../assets/icons/server.svg"); selected: root.settings-tab == "Server Properties"; clicked => { root.open-settings("Server Properties"); } }
                                        // Measuring walks the cache, so it happens when the page
                                        // that shows the figure is opened rather than on every
                                        // refresh of everything else.
                                        SettingsNavItem { label: GuiI18n.text("gui-settings-storage"); icon: @image-url("../../../assets/icons/folder.svg"); selected: root.settings-tab == "Storage"; clicked => { root.open-settings("Storage"); } }
                                        // The launcher's logs change as the launcher runs, so the
                                        // offer is read again whenever the page is opened.
                                        SettingsNavItem { label: GuiI18n.text("gui-settings-diagnostics"); icon: @image-url("../../../assets/icons/settings-diagnostics.svg"); selected: root.settings-tab == "Diagnostics"; clicked => { root.open-settings("Diagnostics"); } }
                                        Rectangle { vertical-stretch: 1; }
                                        Divider { }
                                        SettingsNavItem { label: GuiI18n.text("gui-settings-about"); icon: @image-url("../../../assets/icons/settings-about.svg"); selected: root.settings-tab == "About & Licenses"; clicked => { root.open-settings("About & Licenses"); } }
                                    }
                                }
                                Rectangle { horizontal-stretch: 1; background: Theme.surface; ScrollView { content-width: self.visible-width; VerticalLayout { width: parent.width; alignment: start; padding-left: 36px; padding-right: 36px; padding-top: 22px; padding-bottom: 36px; spacing: 14px;
                                if root.settings-tab == "Minecraft" : PageIntro { title: GuiI18n.text("gui-minecraft-defaults-heading"); subtitle: GuiI18n.text("gui-minecraft-defaults-detail"); }
                                if root.settings-tab == "Server Properties" : PageIntro { title: GuiI18n.text("gui-server-defaults-heading"); subtitle: GuiI18n.text("gui-server-defaults-intro"); }
                                if root.settings-tab == "General" : VerticalLayout { alignment: start; spacing: 14px;
                                    SectionHeading { title: GuiI18n.text("gui-application-display"); detail: GuiI18n.text("gui-application-display-detail"); }
                                    SettingsGroup {
                                        text-size-row := SettingRow {
                                            title: GuiI18n.text("gui-application-text-size");
                                            detail: GuiI18n.text("gui-application-text-size-detail");
                                            ChoiceBar {
                                                available-width: text-size-row.control-room;
                                                accessible-name: GuiI18n.text("gui-application-text-size");
                                                options: [GuiI18n.text("gui-text-scale-90"), GuiI18n.text("gui-text-scale-100"), GuiI18n.text("gui-text-scale-110"), GuiI18n.text("gui-text-scale-125")];
                                                current: root.application-text-scale == 90 ? 0 : root.application-text-scale == 110 ? 2 : root.application-text-scale == 125 ? 3 : 1;
                                                selected(index) => { root.application-text-scale = index == 0 ? 90 : index == 2 ? 110 : index == 3 ? 125 : 100; root.save-general(); }
                                            }
                                        }
                                        technical-size-row := SettingRow {
                                            title: GuiI18n.text("gui-technical-text-size");
                                            detail: GuiI18n.text("gui-technical-text-size-detail");
                                            ChoiceBar {
                                                available-width: technical-size-row.control-room;
                                                accessible-name: GuiI18n.text("gui-technical-text-size");
                                                options: [GuiI18n.text("gui-technical-size-11"), GuiI18n.text("gui-technical-size-12"), GuiI18n.text("gui-technical-size-14"), GuiI18n.text("gui-technical-size-16")];
                                                current: root.technical-text-size == 11 ? 0 : root.technical-text-size == 14 ? 2 : root.technical-text-size == 16 ? 3 : 1;
                                                selected(index) => { root.technical-text-size = index == 0 ? 11 : index == 2 ? 14 : index == 3 ? 16 : 12; root.save-general(); }
                                            }
                                        }
                                        SettingRow {
                                            title: GuiI18n.text("gui-application-color-scheme");
                                            detail: GuiI18n.text("gui-application-color-scheme-detail");
                                            link: root.theme-problems.length > 0 ? GuiI18n.text("gui-show-theme-problems") : "";
                                            link-clicked => { root.modal = "theme-problems"; }
                                            HorizontalLayout { spacing: 12px; alignment: end; padding-right: Theme.shadow-room; padding-bottom: Theme.shadow-room;
                                                for label[index] in root.theme-labels : ThemeCard {
                                                    label: label;
                                                    swatch-fill: root.theme-swatches[index].fill;
                                                    swatch-outline: root.theme-swatches[index].outline;
                                                    selected: index == root.theme-index;
                                                    clicked => { root.theme-index = index; root.application-theme = root.theme-ids[index]; root.save-general(); }
                                                }
                                            }
                                        }
                                        // Offered only while a season is on, since the
                                        // switch has no effect on any other day.
                                        if root.seasonal-theme-in-season : SettingRow {
                                            title: GuiI18n.text("gui-seasonal-themes");
                                            detail: GuiI18n.text("gui-seasonal-themes-detail");
                                            note: root.seasonal-theme-note;
                                            Toggle { accessible-name: GuiI18n.text("gui-seasonal-themes"); checked: root.seasonal-themes; toggled(value) => { root.set-seasonal-themes(value); } }
                                        }
                                    }
                                    SectionHeading { title: GuiI18n.text("gui-favorite-versions"); detail: GuiI18n.text("gui-favorite-versions-detail"); }
                                    SettingsGroup {
                                        Rectangle {
                                            min-height: favorites.preferred-height;
                                            preferred-height: favorites.preferred-height;
                                            favorites := HorizontalLayout { padding: 16px; spacing: 10px; alignment: start;
                                                if root.favorite-minecraft-versions.length == 0 : BodyText { text: GuiI18n.text("gui-no-favorite-versions"); color: Theme.text-muted; vertical-alignment: center; }
                                                for version in root.favorite-minecraft-versions : FavoriteChip { version: version; remove => { root.remove-favorite-version(version); } }
                                            }
                                        }
                                    }
                                    SectionHeading { title: GuiI18n.text("gui-linked-server-defaults"); detail: GuiI18n.text("gui-linked-server-defaults-detail"); }
                                    SettingsGroup {
                                        SettingRow {
                                            title: GuiI18n.text("gui-show-linked-servers");
                                            detail: GuiI18n.text("gui-show-linked-servers-detail");
                                            Toggle { accessible-name: GuiI18n.text("gui-show-linked-servers"); checked <=> root.show-linked-servers; toggled => { root.save-general(); } }
                                        }
                                        SettingRow {
                                            title: GuiI18n.text("gui-default-account-operator");
                                            detail: GuiI18n.text("gui-default-account-operator-detail");
                                            Toggle { accessible-name: GuiI18n.text("gui-default-account-operator"); checked <=> root.make-default-account-operator; toggled => { root.save-general(); } }
                                        }
                                        SettingRow {
                                            title: GuiI18n.text("gui-port");
                                            detail: root.default-server-port-custom ? GuiI18n.text("gui-port-custom-detail") : GuiI18n.text("gui-port-automatic-detail");
                                            HorizontalLayout { spacing: 10px; alignment: end; padding-right: Theme.shadow-room;
                                                if root.default-server-port-custom : TextField { width: 100px; text <=> root.default-server-port; input-type: InputType.number; accessible-name: GuiI18n.text("gui-port"); edited(value) => { root.default-server-port-editing = true; } accepted => { root.save-server-port-edits(); } focus-lost => { root.save-server-port-edits(); } }
                                                SegmentedChoice {
                                                    accessible-name: GuiI18n.text("gui-port");
                                                    options: [GuiI18n.text("gui-port-automatic"), GuiI18n.text("gui-port-custom")];
                                                    current: root.default-server-port-custom ? 1 : 0;
                                                    selected(index) => {
                                                        if ((index == 1) != root.default-server-port-custom) {
                                                            root.default-server-port-custom = index == 1;
                                                            root.save-server-port-default(index == 1, root.default-server-port);
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                        SettingRow {
                                            title: GuiI18n.text("gui-default-operator-level");
                                            IndexComboBox { label: GuiI18n.text("gui-default-operator-level"); width: 220px; model: [GuiI18n.text("gui-operator-level-1"), GuiI18n.text("gui-operator-level-2"), GuiI18n.text("gui-operator-level-3"), GuiI18n.text("gui-operator-level-4")]; index: root.operator-permission-level - 1; selected(index, value) => { root.operator-permission-level = index + 1; root.save-general(); } }
                                        }
                                    }
                                    // The same decision the mod dialog's own "do
                                    // not ask again" records, somewhere it can be
                                    // taken back. Without this, turning it off is
                                    // a one-way door out of a dialog.
                                    SectionHeading { title: GuiI18n.text("gui-mod-changes"); detail: GuiI18n.text("gui-mod-changes-detail"); }
                                    SettingsGroup {
                                        SettingRow {
                                            title: GuiI18n.text("gui-follow-dependencies");
                                            detail: GuiI18n.text("gui-follow-dependencies-detail");
                                            Toggle { accessible-name: GuiI18n.text("gui-follow-dependencies"); sets-its-own-position: false; checked: root.follow-mod-dependencies; toggled(value) => { root.set-dependency-following(value); } }
                                        }
                                        // Greyed rather than hidden while nothing is
                                        // being carried along: with no other mod
                                        // changing, there is nothing for a
                                        // confirmation to be about, and a row that
                                        // vanished would read as a setting that was
                                        // lost.
                                        SettingRow {
                                            title: GuiI18n.text("gui-dependency-warning");
                                            detail: root.follow-mod-dependencies ? GuiI18n.text("gui-dependency-warning-detail") : GuiI18n.text("gui-dependency-warning-unused");
                                            Toggle { accessible-name: GuiI18n.text("gui-dependency-warning"); enabled: root.follow-mod-dependencies; sets-its-own-position: false; checked: root.warn-on-dependency-impact && root.follow-mod-dependencies; toggled(value) => { root.set-dependency-warning(value); } }
                                        }
                                    }
                                    // Whether the scheme is claimed at all is settled by
                                    // installing, not here (ADR 0028, ADR 0029). What this page
                                    // manages is the answers the user has given to link prompts.
                                    SectionHeading { title: GuiI18n.text("gui-trusted-pack-hosts"); detail: GuiI18n.text("gui-trusted-pack-hosts-detail"); }
                                    SettingsGroup {
                                        if root.trusted-pack-hosts.length == 0 : Rectangle {
                                            min-height: no-trusted-hosts.preferred-height + 32px;
                                            preferred-height: no-trusted-hosts.preferred-height + 32px;
                                            no-trusted-hosts := BodyText { x: 18px; y: 16px; width: parent.width - 36px; text: GuiI18n.text("gui-no-trusted-pack-hosts"); color: Theme.text-muted; wrap: word-wrap; }
                                        }
                                        for host in root.trusted-pack-hosts : Rectangle {
                                            height: 56px;
                                            if self.y > 0px : Rectangle { y: 0px; height: 1px; background: Theme.border; }
                                            HorizontalLayout {
                                                padding-left: 18px; padding-right: 18px; padding-top: 8px; padding-bottom: 8px; spacing: 10px;
                                                BodyText { text: host; color: Theme.text; horizontal-stretch: 1; vertical-alignment: center; overflow: elide; }
                                                VerticalLayout { alignment: center; AppButton { text: GuiI18n.text("gui-forget-pack-host"); tone: "danger"; compact: true; clicked => { root.forget-pack-host(host); } } }
                                            }
                                        }
                                    }
                                }
                                // The screen keeps its own height and scrolls only the
                                // rows, so the category tabs, the filter, and Save and
                                // Discard stay reachable however long the list is.
                                if root.settings-tab == "Minecraft" : VerticalLayout { spacing: 12px;
                                    height: max(360px, root.height - 258px);
                                    if root.minecraft-preserved-notice != "" : Rectangle { height: max(46px, preserved-text.preferred-height + 22px); border-radius: Theme.card-radius; border-width: Theme.strong-border-width; border-color: Theme.border-strong; background: Theme.surface;
                                        preserved-text := BodyText { x: 12px; width: parent.width - 24px; text: root.minecraft-preserved-notice; color: Theme.text-muted; wrap: word-wrap; }
                                    }
                                    if root.minecraft-unusable-notice != "" : Rectangle { height: max(46px, unusable-text.preferred-height + 22px); border-radius: Theme.card-radius; border-width: Theme.strong-border-width; border-color: Theme.warning.with-alpha(0.55); background: Theme.surface;
                                        unusable-text := BodyText { x: 12px; width: parent.width - 24px; text: root.minecraft-unusable-notice; color: Theme.warning; wrap: word-wrap; }
                                    }
                            // The stable catalog categories, one button each.
                                    // The stable catalog categories, one button each, while the page has the room.
                                    if !root.minecraft-narrow : HorizontalLayout { spacing: 10px; alignment: start; vertical-stretch: 0; padding-right: Theme.shadow-room; padding-bottom: Theme.shadow-room;
                                        for category[index] in root.minecraft-categories : AppButton {
                                            text: category;
                                            compact: true;
                                            tone: !root.minecraft-raw-open && index == root.minecraft-category-index ? "primary" : "secondary";
                                            clicked => { root.minecraft-raw-open = false; root.minecraft-select-category(index); }
                                        }
                                        AppButton {
                                            text: GuiI18n.text("gui-minecraft-raw-tab");
                                            compact: true;
                                            tone: root.minecraft-raw-open ? "primary" : "secondary";
                                            clicked => { root.minecraft-raw-open = true; }
                                        }
                                    }
                                    // Otherwise as many tabs as fit, then More, as on a host page.
                                    if root.minecraft-narrow : SurfaceTabs {
                                        vertical-stretch: 0;
                                        tab-size: 190px * Theme.text-scale;
                                        surfaces: root.minecraft-category-tabs;
                                        selected: root.minecraft-raw-open ? "raw" : "\{root.minecraft-category-index}";
                                        selected-index: root.minecraft-raw-open ? root.minecraft-categories.length : root.minecraft-category-index;
                                        chosen(id) => {
                                            if (id == "raw") {
                                                root.minecraft-raw-open = true;
                                            } else {
                                                root.minecraft-raw-open = false;
                                                root.minecraft-select-category(Math.floor(id.to-float()));
                                            }
                                        }
                                    }
                            if root.minecraft-raw-open : VerticalLayout { spacing: 10px; vertical-stretch: 1;
                                BodyText { text: GuiI18n.text("gui-minecraft-raw-detail"); color: Theme.text-muted; wrap: word-wrap; vertical-stretch: 0; }
                                MultilineField {
                                    vertical-stretch: 1;
                                    text <=> root.minecraft-raw-options;
                                    placeholder: GuiI18n.text("gui-minecraft-raw-placeholder");
                                    accessible-name: GuiI18n.text("gui-minecraft-raw-label");
                                    enabled: !root.minecraft-saving;
                                    edited(value) => { root.minecraft-edit-raw-options(value); }
                                }
                                if root.minecraft-raw-problems != "" : Rectangle { height: max(46px, raw-problems-text.preferred-height + 22px); vertical-stretch: 0; border-radius: Theme.card-radius; border-width: Theme.strong-border-width; border-color: Theme.warning.with-alpha(0.55); background: Theme.surface;
                                    raw-problems-text := BodyText { x: 12px; width: parent.width - 24px; text: root.minecraft-raw-problems; color: Theme.warning; wrap: word-wrap; }
                                }
                            }
                            if !root.minecraft-raw-open : HorizontalLayout { spacing: 14px; cross-axis-alignment: center; vertical-stretch: 0;
                                        filter-field := TextField {
                                            horizontal-stretch: 1;
                                            min-width: 120px;
                                            preferred-width: 270px;
                                            max-width: 270px;
                                            placeholder: GuiI18n.text("gui-minecraft-filter");
                                            accessible-name: GuiI18n.text("gui-minecraft-filter");
                                            input-type: InputType.search;
                                            edited(value) => { root.minecraft-query = value; root.minecraft-set-query(value); }
                                        }
                                        if root.minecraft-query != "" : AppButton { text: GuiI18n.text("gui-clear"); compact: true; clicked => { filter-field.text = ""; root.minecraft-query = ""; root.minecraft-set-query(""); } }
                                        BodyText { text: GuiI18n.text("gui-minecraft-only-overridden"); color: Theme.text; horizontal-stretch: 0; }
                                        Toggle { accessible-name: GuiI18n.text("gui-minecraft-only-overridden"); checked: root.minecraft-only-overridden; toggled(value) => { root.minecraft-set-only-overridden(value); } }
                                        if root.minecraft-has-advanced : BodyText { text: GuiI18n.text("gui-minecraft-show-advanced"); color: Theme.text; horizontal-stretch: 0; }
                                        if root.minecraft-has-advanced : Toggle { accessible-name: GuiI18n.text("gui-minecraft-show-advanced"); checked: root.minecraft-show-advanced; toggled(value) => { root.minecraft-set-show-advanced(value); } }
                                        Rectangle { horizontal-stretch: 1; min-width: 4px; }
                                        if root.width >= 1400px : preview-label := BodyText { text: GuiI18n.text("gui-minecraft-preview"); color: Theme.text; font-weight: 700; horizontal-stretch: 0; }
                                        if root.width >= 1400px : ValueComboBox {
                                            width: 190px;
                                            label: GuiI18n.text("gui-minecraft-preview");
                                            model: root.minecraft-releases;
                                            value: root.minecraft-preview-release;
                                            selected(value) => { root.minecraft-set-preview-release(value); }
                                        }
                                    }
                                    // Below the filter when the page is too narrow to hold both on one row.
                                    if root.width < 1400px && !root.minecraft-raw-open : HorizontalLayout { spacing: 14px; alignment: end; vertical-stretch: 0; padding-right: Theme.shadow-room;
                                        VerticalLayout { alignment: center; BodyText { text: GuiI18n.text("gui-minecraft-preview"); color: Theme.text; font-weight: 700; horizontal-stretch: 0; } }
                                        ValueComboBox {
                                            width: 190px;
                                            label: GuiI18n.text("gui-minecraft-preview");
                                            model: root.minecraft-releases;
                                            value: root.minecraft-preview-release;
                                            selected(value) => { root.minecraft-set-preview-release(value); }
                                        }
                                    }
                            // The outline stays put and the rows scroll inside it, so
                            // the list is closed at both ends however far it is scrolled.
                            if !root.minecraft-raw-open : Panel { vertical-stretch: 1; rows-view := ScrollView { content-width: self.visible-width; VerticalLayout { alignment: start; spacing: 0px;
                                    if root.minecraft-preference-rows.length == 0 : EmptyState { title: GuiI18n.text("gui-minecraft-no-matches"); message: GuiI18n.text("gui-minecraft-no-matches-detail"); }
                                    // Two columns of rows once each can split on its own: the first half of the
                                    // rows on the left, the rest on the right. The scroll bar's room is kept
                                    // back so a column never lands just under its own split width.
                                    columns := Rectangle {
                                        property <bool> two: rows-view.width >= 2 * Theme.preference-row-split-width + 2px + 24px;
                                        property <int> per-column: Math.ceil(root.minecraft-preference-rows.length / 2);
                                        height: max(columns-layout.preferred-height, rows-view.height);
                                    columns-layout := HorizontalLayout { x: 0px; y: 0px; width: parent.width; height: parent.height; spacing: 0px;
                                        VerticalLayout { alignment: start; spacing: 0px;
                                            for row[index] in root.minecraft-preference-rows : VerticalLayout { if !columns.two || index < columns.per-column : MinecraftPreferenceRowCard {
                                                item: row;
                                                compact: root.minecraft-narrow;
                                                capturing: root.minecraft-capturing-id == row.id;
                                                languages-available: root.minecraft-languages-available;
                                                set-boolean(id, on) => { root.minecraft-set-boolean(id, on); }
                                                set-number(id, value) => { root.minecraft-set-number(id, value); }
                                                edit-number(id, value) => { root.minecraft-edit-number(id, value); }
                                                commit-number(id, value) => { root.minecraft-commit-number(id, value); }
                                                set-enumeration(id, index) => { root.minecraft-set-enumeration(id, index); }
                                                set-language(id, index) => { root.minecraft-set-language(id, index); }
                                                aspect-labels: root.minecraft-aspect-labels;
                                                edit-window(id, width, height) => { root.minecraft-edit-window(id, width, height); }
                                                commit-window-width(id, width, height) => { root.minecraft-commit-window-width(id, width, height); }
                                                commit-window-height(id, width, height) => { root.minecraft-commit-window-height(id, width, height); }
                                                set-window-aspect(id, index) => { root.minecraft-set-window-aspect(id, index); }
                                                set-window-lock(id, held) => { root.minecraft-set-window-lock(id, held); }
                                                open-window-preview(id) => { root.minecraft-open-window-preview(id); }
                                                commit-text(id, value) => { root.minecraft-commit-text(id, value); }
                                                forget(id) => { root.minecraft-forget-preference(id); }
                                                begin-capture(id) => { root.minecraft-begin-capture(id); }
                                                cancel-capture => { root.minecraft-cancel-capture(); }
                                                captured-key(id, reported) => { root.minecraft-captured-key(id, reported); }
                                                captured-mouse(id, reported) => { root.minecraft-captured-mouse(id, reported); }
                                                retry-languages => { root.minecraft-retry-languages(); }
                                            } }
                                        }
                                        if columns.two : Rectangle { width: 2px; background: Theme.border-strong.with-alpha(0.35); }
                                        if columns.two : VerticalLayout { alignment: start; spacing: 0px;
                                            // Keeps the columns' first rows level when only the first column opens with a section heading.
                                            if root.minecraft-preference-rows[0].section-heading != "" && root.minecraft-preference-rows[columns.per-column].section-heading == "" : VerticalLayout { spacing: 0px; Rectangle { height: Theme.preference-heading-height; background: Theme.background; } Rectangle { height: 1px; background: Theme.border; } }
                                            for row[index] in root.minecraft-preference-rows : VerticalLayout { if index >= columns.per-column : MinecraftPreferenceRowCard {
                                                item: row;
                                                compact: root.minecraft-narrow;
                                                capturing: root.minecraft-capturing-id == row.id;
                                                languages-available: root.minecraft-languages-available;
                                                set-boolean(id, on) => { root.minecraft-set-boolean(id, on); }
                                                set-number(id, value) => { root.minecraft-set-number(id, value); }
                                                edit-number(id, value) => { root.minecraft-edit-number(id, value); }
                                                commit-number(id, value) => { root.minecraft-commit-number(id, value); }
                                                set-enumeration(id, index) => { root.minecraft-set-enumeration(id, index); }
                                                set-language(id, index) => { root.minecraft-set-language(id, index); }
                                                aspect-labels: root.minecraft-aspect-labels;
                                                edit-window(id, width, height) => { root.minecraft-edit-window(id, width, height); }
                                                commit-window-width(id, width, height) => { root.minecraft-commit-window-width(id, width, height); }
                                                commit-window-height(id, width, height) => { root.minecraft-commit-window-height(id, width, height); }
                                                set-window-aspect(id, index) => { root.minecraft-set-window-aspect(id, index); }
                                                set-window-lock(id, held) => { root.minecraft-set-window-lock(id, held); }
                                                open-window-preview(id) => { root.minecraft-open-window-preview(id); }
                                                commit-text(id, value) => { root.minecraft-commit-text(id, value); }
                                                forget(id) => { root.minecraft-forget-preference(id); }
                                                begin-capture(id) => { root.minecraft-begin-capture(id); }
                                                cancel-capture => { root.minecraft-cancel-capture(); }
                                                captured-key(id, reported) => { root.minecraft-captured-key(id, reported); }
                                                captured-mouse(id, reported) => { root.minecraft-captured-mouse(id, reported); }
                                                retry-languages => { root.minecraft-retry-languages(); }
                                            } }
                                        }
                                    }
                                    }
                                    } } }
                                    DraftBar {
                                        message: root.minecraft-dirty ? GuiI18n.count("gui-minecraft-unsaved-count", root.minecraft-dirty-count) : GuiI18n.count("gui-minecraft-total-count", root.minecraft-total-count);
                                        dirty: root.minecraft-dirty && !root.minecraft-saving;
                                        can-save: root.minecraft-can-save && !root.minecraft-saving;
                                        discard-hint: root.minecraft-saving ? GuiI18n.text("gui-save-in-progress-hint") : GuiI18n.text("gui-hint-no-unsaved-changes");
                                        save-hint: root.minecraft-saving ? GuiI18n.text("gui-save-in-progress-hint") : GuiI18n.text("gui-hint-nothing-to-save");
                                        discard => { root.minecraft-discard-defaults(); }
                                        save => { root.minecraft-save-defaults(); }
                                    }
                                }
                                if root.settings-tab == "Server Properties" : ServerDefaultsPanel {
                                    height: max(360px, root.height - 258px);
                                    groups: root.server-defaults-groups;
                                    edits: root.server-defaults-edits;
                                    invalid: root.server-defaults-invalid;
                                    show-advanced: root.server-defaults-show-advanced;
                                    edit(key, value) => { root.edit-server-default(key, value); }
                                    choose(key, index) => { root.choose-server-default(key, index); }
                                    reset(key) => { root.reset-server-default(key); }
                                    advanced(show) => { root.show-advanced-server-defaults(show); }
                                    discard => { root.discard-server-defaults(); }
                                    save => { root.save-server-defaults(); }
                                }
                                if root.settings-tab == "Java" : VerticalLayout { alignment: start; spacing: 14px;
                                    SectionHeading { title: GuiI18n.text("gui-java-settings-heading"); }
                                    SettingsGroup {
                                        SettingRow {
                                            title: GuiI18n.text("gui-java-detect");
                                            detail: GuiI18n.text("gui-java-detect-detail");
                                            Toggle { accessible-name: GuiI18n.text("gui-java-detect"); checked <=> root.java-auto-detect; toggled => { root.save-java(); } }
                                        }
                                        SettingRow {
                                            title: GuiI18n.text("gui-java-download");
                                            detail: GuiI18n.text("gui-java-download-detail");
                                            Toggle { accessible-name: GuiI18n.text("gui-java-download"); checked <=> root.java-auto-download; toggled => { root.save-java(); } }
                                        }
                                        SettingRow {
                                            title: GuiI18n.text("gui-java-memory");
                                            detail: GuiI18n.text("gui-java-memory-detail");
                                            HorizontalLayout { spacing: 10px; alignment: end; padding-right: Theme.shadow-room;
                                                TextField { text <=> root.java-memory-min; accessible-name: GuiI18n.text("gui-java-memory-min"); note: GuiI18n.text("gui-java-memory-min"); input-type: InputType.number; width: 110px; edited(value) => { root.java-edited = true; } accepted => { root.save-java-edits(); } focus-lost => { root.save-java-edits(); } }
                                                BodyText { text: "-"; color: Theme.text; vertical-alignment: center; horizontal-stretch: 0; }
                                                TextField { text <=> root.java-memory-max; accessible-name: GuiI18n.text("gui-java-memory-max"); note: GuiI18n.text("gui-java-memory-max"); input-type: InputType.number; width: 110px; edited(value) => { root.java-edited = true; } accepted => { root.save-java-edits(); } focus-lost => { root.save-java-edits(); } }
                                                BodyText { text: GuiI18n.text("gui-java-memory-unit"); color: Theme.text; vertical-alignment: center; horizontal-stretch: 0; }
                                            }
                                        }
                                        SettingRow {
                                            title: GuiI18n.text("gui-java-preferred");
                                            detail: GuiI18n.text("gui-java-preferred-detail");
                                            verdict: root.java-path-verdict;
                                            verdict-ok: root.java-path-verdict-ok;
                                            HorizontalLayout { spacing: 10px; alignment: end; padding-right: Theme.shadow-room;
                                                TextField { text <=> root.java-preferred-path; accessible-name: GuiI18n.text("gui-java-preferred"); placeholder: "/usr/bin/java"; min-width: 140px; preferred-width: 320px; horizontal-stretch: 1; edited(value) => { root.java-edited = true; root.java-path-verdict = ""; } accepted => { root.save-java-edits(); } focus-lost => { root.save-java-edits(); } }
                                                AppButton {
                                                    text: GuiI18n.text("gui-java-custom-check");
                                                    enabled: !root.java-path-checking && root.java-preferred-path != "";
                                                    hint: root.java-path-checking ? GuiI18n.text("gui-java-custom-checking") : GuiI18n.text("gui-java-custom-path-empty");
                                                    clicked => { root.check-java-path(root.java-preferred-path); }
                                                }
                                            }
                                        }
                                    }
                                    // The list is its own thing, and the button that
                                    // rebuilds it belongs beside it rather than beside the
                                    // Save that has nothing to do with it.
                                    HorizontalLayout { spacing: 12px; cross-axis-alignment: end;
                                        SectionHeading { title: GuiI18n.text("gui-java-runtimes"); detail: GuiI18n.count("gui-java-runtimes-found", root.java-runtimes.length); horizontal-stretch: 1; }
                                        VerticalLayout { alignment: end; padding-right: Theme.shadow-room; padding-bottom: 2px; AppButton { text: GuiI18n.text("gui-java-refresh"); icon: @image-url("../../../assets/icons/refresh.svg"); compact: true; clicked => { root.refresh-java(); } } }
                                    }
                                    if root.java-runtimes.length == 0 : EmptyState { title: GuiI18n.text("gui-java-no-runtimes"); message: GuiI18n.text("gui-java-no-runtimes-detail"); }
                                    if root.java-runtimes.length > 0 : SettingsGroup {
                                        for java in root.java-runtimes : Rectangle {
                                            min-height: runtime-row.preferred-height;
                                            preferred-height: runtime-row.preferred-height;
                                            if self.y > 0px : Rectangle { y: 0px; height: 1px; background: Theme.border; }
                                            runtime-row := HorizontalLayout { padding-left: 18px; padding-right: 18px; padding-top: 12px; padding-bottom: 12px; spacing: 12px; cross-axis-alignment: center;
                                                VerticalLayout { horizontal-stretch: 1; spacing: 3px;
                                                    HorizontalLayout { spacing: 8px; alignment: start;
                                                        Heading { text: java.title; font-size: Theme.row-heading-size; overflow: elide; }
                                                        if java.origin == "managed" : VerticalLayout { alignment: center; Chip { text: GuiI18n.text("gui-java-managed"); tone: "server"; } }
                                                    }
                                                    BodyText { text: java.path; font-family: Theme.mono-family; font-size: Theme.label-size; overflow: elide; }
                                                    if java.pinned-by != "" : BodyText { text: java.pinned-by; color: Theme.text-muted; font-size: Theme.label-size; wrap: word-wrap; }
                                                }
                                                // Only what the launcher installed itself offers the
                                                // bin: a runtime found on the system belongs to
                                                // whoever put it there.
                                                if java.origin != "managed" : BodyText { text: java.origin == "sdkman" ? GuiI18n.text("gui-java-origin-sdkman") : java.origin == "java-home" ? GuiI18n.text("gui-java-origin-java-home") : java.origin == "path" ? GuiI18n.text("gui-java-origin-path") : java.origin == "user-supplied" ? GuiI18n.text("gui-java-origin-user") : java.origin == "system" ? GuiI18n.text("gui-java-origin-system") : GuiI18n.text("gui-java-origin-detected"); color: Theme.text-muted; font-size: Theme.label-size; vertical-alignment: center; }
                                                if java.origin == "managed" : VerticalLayout { alignment: center; padding-right: Theme.shadow-room; AppButton { text: GuiI18n.text("gui-remove"); icon: @image-url("../../../assets/icons/trash.svg"); compact: true; tone: "danger"; accessible-name: GuiI18n.value("gui-java-remove-runtime", java.path); clicked => { root.pending-action-name = java.title; root.pending-action-id = java.path; root.pending-java-pinning = java.pinning; root.pending-java-pins-known = java.pins-known; root.modal = "remove-java-runtime"; } } }
                                            }
                                        }
                                    }
                                }
                                if root.settings-tab == "Accounts" : VerticalLayout { alignment: start; spacing: 14px;
                                    BodyText { text: GuiI18n.text("gui-accounts-detail"); color: Theme.text-secondary; wrap: word-wrap; }
                                    SectionHeading { title: GuiI18n.text("gui-settings-accounts"); detail: GuiI18n.count("gui-accounts-count", root.accounts.length); }
                                    SettingsGroup {
                                        if root.accounts.length == 0 : Rectangle {
                                            min-height: no-accounts.preferred-height + 32px;
                                            preferred-height: no-accounts.preferred-height + 32px;
                                            no-accounts := BodyText { x: 18px; y: 16px; width: parent.width - 36px; text: GuiI18n.text("gui-no-accounts-detail"); color: Theme.text-muted; wrap: word-wrap; }
                                        }
                                        for account in root.accounts : Rectangle {
                                            min-height: account-row.preferred-height;
                                            preferred-height: account-row.preferred-height;
                                            accessible-role: list-item;
                                            accessible-label: account.name;
                                            if self.y > 0px : Rectangle { y: 0px; height: 1px; background: Theme.border; }
                                            account-row := HorizontalLayout { padding-left: 18px; padding-right: 18px; padding-top: 12px; padding-bottom: 12px; spacing: 12px; cross-axis-alignment: center;
                                                Rectangle { width: 38px; height: 38px; border-radius: Theme.small-radius; border-width: Theme.strong-border-width; border-color: Theme.border-strong; background: Theme.primary-fill;
                                                    Text { text: account.initial; color: Theme.on-primary; font-family: Theme.heading-family; font-size: Theme.row-heading-size; horizontal-alignment: center; vertical-alignment: center; }
                                                }
                                                VerticalLayout { horizontal-stretch: 1; spacing: 3px; alignment: center;
                                                    HorizontalLayout { spacing: 8px; alignment: start;
                                                        Heading { text: account.name; font-size: Theme.row-heading-size; overflow: elide; }
                                                        VerticalLayout { alignment: center; Chip { text: account.kind; tone: account.kind == "Offline" ? "neutral" : "server"; } }
                                                        if account.is-default : VerticalLayout { alignment: center; Chip { text: GuiI18n.text("gui-default"); tone: "primary"; } }
                                                    }
                                                    BodyText { text: account.credential-state; color: Theme.text-muted; font-size: Theme.label-size; overflow: elide; }
                                                }
                                                VerticalLayout { alignment: center; padding-right: Theme.shadow-room; HorizontalLayout { spacing: 8px;
                                                    if !account.is-default : AppButton { text: GuiI18n.text("gui-make-default"); compact: true; clicked => { root.set-default-account(account.id); } }
                                                    AppButton { text: GuiI18n.text("gui-remove"); compact: true; tone: "danger"; clicked => { root.remove-account(account.id); } }
                                                } }
                                            }
                                        }
                                    }
                                    SectionHeading { title: GuiI18n.text("gui-accounts-add-heading"); }
                                    SettingsGroup {
                                        SettingRow {
                                            title: GuiI18n.text("gui-microsoft-sign-in");
                                            detail: GuiI18n.text("gui-microsoft-account-detail");
                                            VerticalLayout { padding-right: Theme.shadow-room; sign-in-button := AppButton { text: GuiI18n.text("gui-microsoft-sign-in"); icon: @image-url("../../../assets/icons/microsoft.svg"); tone: "info"; min-width: max(sign-in-button.natural-width, add-offline-button.natural-width); clicked => { root.begin-microsoft-login(); } } }
                                        }
                                        SettingRow {
                                            title: GuiI18n.text("gui-add-offline-account");
                                            detail: GuiI18n.text("gui-offline-account-detail");
                                            HorizontalLayout { spacing: 8px; alignment: end; padding-right: Theme.shadow-room;
                                                TextField { text <=> root.offline-account-name; placeholder: GuiI18n.text("gui-offline-account-placeholder"); accessible-name: GuiI18n.text("gui-offline-account-placeholder"); min-width: 100px; preferred-width: 220px; horizontal-stretch: 1; }
                                                add-offline-button := AppButton { text: GuiI18n.text("gui-add-offline-account"); icon: @image-url("../../../assets/icons/add.svg"); min-width: max(sign-in-button.natural-width, add-offline-button.natural-width); clicked => { root.add-offline-account(root.offline-account-name); } }
                                            }
                                        }
                                    }
                                }
                                if root.settings-tab == "Providers & APIs" : VerticalLayout { alignment: start; spacing: 14px;
                                    BodyText { text: GuiI18n.text("gui-provider-detail"); color: Theme.text-secondary; wrap: word-wrap; }
                                    SectionHeading { title: GuiI18n.text("gui-providers-catalogs-heading"); detail: GuiI18n.text("gui-preferred-mod-catalog-detail"); }
                                    SettingsGroup {
                                        SettingRow {
                                            title: GuiI18n.text("gui-preferred-mod-catalog-heading");
                                            detail: root.default-mod-catalog == "" ? GuiI18n.value("gui-preferred-mod-catalog-unrecognized", root.configured-mod-catalog) : GuiI18n.text("gui-preferred-mod-catalog-note");
                                            // Applied the moment a segment is clicked, and the selection follows
                                            // the stored value rather than the click: a save that fails leaves
                                            // the previous catalog selected instead of the one that was asked for.
                                            HorizontalLayout { spacing: 10px; padding-right: Theme.shadow-room;
                                                if root.default-mod-catalog-is-custom : VerticalLayout { alignment: center; AppButton { text: GuiI18n.text("gui-reset-default"); compact: true; clicked => { root.choose-default-mod-catalog(""); } } }
                                                VerticalLayout { alignment: center;
                                                    SegmentedChoice {
                                                        accessible-name: GuiI18n.text("gui-preferred-mod-catalog-heading");
                                                        options: [GuiI18n.text("gui-provider-modrinth"), GuiI18n.text("gui-provider-curseforge")];
                                                        current: root.default-mod-catalog == "curseforge" ? 1 : root.default-mod-catalog == "modrinth" ? 0 : -1;
                                                        selected(index) => { root.choose-default-mod-catalog(index == 0 ? "modrinth" : "curseforge"); }
                                                    }
                                                }
                                            }
                                        }
                                        SettingBlock {
                                            title: GuiI18n.text("gui-curseforge-api-key");
                                            detail: root.curseforge-build-key-available ? GuiI18n.text("gui-curseforge-detail-default") : GuiI18n.text("gui-curseforge-detail-required");
                                            badge: root.curseforge-key-configured ? GuiI18n.text("gui-curseforge-key-configured") : root.curseforge-key-default-in-use ? GuiI18n.text("gui-curseforge-key-default-in-use") : GuiI18n.text("gui-curseforge-key-not-configured");
                                            badge-tone: root.curseforge-key-configured ? Theme.accent : root.curseforge-key-default-in-use ? Theme.text-secondary : Theme.danger;
                                            HorizontalLayout { spacing: 10px; padding-right: Theme.shadow-room;
                                                // Masked because it shows what the user is typing, never what is stored:
                                                // a saved key is not readable from here and the field is emptied on submit.
                                                TextField { text <=> root.curseforge-api-key; placeholder: GuiI18n.text("gui-curseforge-key-placeholder"); accessible-name: GuiI18n.text("gui-curseforge-api-key"); input-type: InputType.password; horizontal-stretch: 1; accepted => { root.save-curseforge-api-key(root.curseforge-api-key); } }
                                                AppButton { text: root.curseforge-key-configured ? GuiI18n.text("gui-curseforge-key-replace") : GuiI18n.text("gui-curseforge-key-save"); tone: "primary"; enabled: root.curseforge-api-key != ""; hint: GuiI18n.text("gui-hint-enter-api-key"); clicked => { root.save-curseforge-api-key(root.curseforge-api-key); } }
                                                if root.curseforge-key-configured : AppButton { text: GuiI18n.text("gui-remove"); tone: "danger"; clicked => { root.remove-curseforge-api-key(); } }
                                            }
                                            // A note only where there is something to say. A
                                            // stored key needs the keyring explained; no key at
