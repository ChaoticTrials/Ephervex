                                if host.available && host.kind == "server" && pane.surface == "Overview" : ScrollView { content-width: self.visible-width; server-overview := VerticalLayout { alignment: start; x: 0px; y: 0px; width: min(parent.width, 980px); spacing: 12px; padding-left: Theme.lift-room; padding-top: Theme.lift-room; padding-right: Theme.shadow-room; padding-bottom: Theme.shadow-room; property <bool> narrow: self.width < 620px; Heading { text: GuiI18n.text("gui-dedicated-server"); overflow: elide; } BodyText { text: host.server.state-detail; wrap: word-wrap; }
