    callback apply-fix(string, string);
    callback copy-diagnosis-report(string, string);
    callback dismiss-run-failure(string, string);
    // (kind, id, part, chosen)
    callback toggle-bundle-part(string, string, string, bool);
    // (kind, id): asks for what a bundle for the host could carry.
    callback plan-host-bundle(string, string);
