                                            if root.curseforge-key-configured : BodyText { text: GuiI18n.text("gui-curseforge-key-storage"); color: Theme.text-muted; font-size: Theme.label-size; wrap: word-wrap; }
                                            if !root.curseforge-key-configured && !root.curseforge-key-default-in-use : BodyText { text: GuiI18n.text("gui-curseforge-key-missing-detail"); color: Theme.warning; font-size: Theme.label-size; wrap: word-wrap; }
                                            HorizontalLayout { alignment: start; AppButton { text: GuiI18n.text("gui-curseforge-key-help"); compact: true; clicked => { root.open-curseforge-key-help(); } } }
                                        }
                                    }
                                    SectionHeading { title: GuiI18n.text("gui-provider-identifiers"); detail: GuiI18n.text("gui-provider-identifiers-detail"); }
                                    SettingsGroup {
                                        OverrideCard {
                                            title: GuiI18n.text("gui-microsoft-client-id");
                                            placeholder: GuiI18n.text("gui-no-override");
                                            effective: root.effective-microsoft-client-id;
                                            custom: root.microsoft-client-id-is-custom;
                                            value <=> root.microsoft-client-id;
                                            saving: root.microsoft-client-id-saving;
                                            reset => { root.reset-microsoft-client-id(); }
                                        }
                                        OverrideCard {
                                            title: GuiI18n.text("gui-user-agent");
                                            placeholder: GuiI18n.text("gui-no-override");
                                            effective: root.effective-user-agent;
                                            custom: root.user-agent-is-custom;
                                            value <=> root.user-agent;
                                            saving: root.user-agent-saving;
                                            reset => { root.reset-user-agent(); }
                                        }
                                    }
                                    ActionRow { Rectangle { horizontal-stretch: 1; } AppButton { text: root.microsoft-client-id-saving || root.user-agent-saving ? GuiI18n.text("gui-saving") : GuiI18n.text("gui-save-api-settings"); accessible-name: GuiI18n.text("gui-save-api-settings"); tone: "primary"; enabled: !root.microsoft-client-id-saving && !root.user-agent-saving; hint: GuiI18n.text("gui-save-in-progress-hint"); clicked => { root.save-api-settings(root.microsoft-client-id, root.user-agent); } } }
                                }
                                if root.settings-tab == "Diagnostics" : VerticalLayout { alignment: start; spacing: 14px;
                                    SectionHeading { title: GuiI18n.text("gui-launcher-bundle-title"); detail: GuiI18n.text("gui-launcher-bundle-detail"); }
                                    SettingsGroup {
                                        if root.launcher-bundle-parts.length == 0 : Rectangle {
                                            min-height: no-launcher-log.preferred-height + 32px;
                                            preferred-height: no-launcher-log.preferred-height + 32px;
                                            no-launcher-log := BodyText { x: 18px; y: 16px; width: parent.width - 36px; text: GuiI18n.text("gui-launcher-bundle-empty"); color: Theme.text-muted; wrap: word-wrap; }
                                        }
                                        for part in root.launcher-bundle-parts : Rectangle {
                                            height: 60px;
                                            if self.y > 0px : Rectangle { y: 0px; height: 1px; background: Theme.border; }
                                            HorizontalLayout {
                                                padding-left: 18px; padding-right: 18px; spacing: 10px;
                                                VerticalLayout {
                                                    horizontal-stretch: 1; alignment: center; spacing: 2px;
                                                    BodyText { text: part.name; color: Theme.text; font-family: Theme.mono-family; font-weight: 700; overflow: elide; }
                                                    BodyText { text: part.modified == "" ? part.kind + " \u{b7} " + part.size : part.kind + " \u{b7} " + part.size + " \u{b7} " + part.modified; color: Theme.text-muted; font-size: Theme.label-size; overflow: elide; }
                                                }
                                                VerticalLayout { alignment: center; padding-right: Theme.shadow-room; AppButton { text: GuiI18n.text("gui-show-file"); accessible-name: GuiI18n.value("gui-show-file-named", part.name); icon: @image-url("../../../assets/icons/external-link.svg"); compact: true; clicked => { root.open-file(part.path); } } }
                                            }
                                        }
                                        Rectangle {
                                            min-height: 64px;
                                            preferred-height: 64px;
                                            if root.launcher-bundle-parts.length > 0 : Rectangle { y: 0px; height: 1px; background: Theme.border; }
                                            HorizontalLayout {
                                                padding-left: 18px; padding-right: 18px; spacing: 10px;
                                                BodyText { text: GuiI18n.text("gui-launcher-bundle-privacy"); color: Theme.text-muted; font-size: Theme.label-size; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                                                VerticalLayout { alignment: center; padding-right: Theme.shadow-room; AppButton { text: GuiI18n.text("gui-launcher-bundle-save"); icon: @image-url("../../../assets/icons/import.svg"); compact: true; tone: "primary"; enabled: root.launcher-bundle-parts.length > 0; hint: GuiI18n.text("gui-launcher-bundle-empty"); clicked => { root.modal = "launcher-bundle"; } } }
                                            }
                                        }
                                    }
                                }
                                if root.settings-tab == "Storage" : VerticalLayout { alignment: start; spacing: 14px;
                                    SectionHeading { title: GuiI18n.text("gui-storage-locations"); }
                                    SettingsGroup {
                                        SettingRow {
                                            title: GuiI18n.text("gui-storage-instances");
                                            detail: root.persistent-root-is-custom ? root.storage-root + "\n" + GuiI18n.value("gui-default-location-path", root.default-persistent-root) : root.storage-root;
                                            detail-mono: true;
                                            HorizontalLayout { spacing: 8px; padding-right: Theme.shadow-room;
                                                if root.persistent-root-is-custom : VerticalLayout { alignment: center; AppButton { text: GuiI18n.text("gui-reset-default"); compact: true; enabled: !root.storage-root-saving; hint: GuiI18n.text("gui-save-in-progress-hint"); clicked => { root.reset-storage-root(); } } }
                                                VerticalLayout { alignment: center; AppButton { text: GuiI18n.text("gui-choose-folder"); icon: @image-url("../../../assets/icons/folder.svg"); compact: true; enabled: !root.storage-root-saving; hint: GuiI18n.text("gui-save-in-progress-hint"); clicked => { root.choose-storage-root(); } } }
                                            }
                                        }
                                    }
                                    HorizontalLayout { spacing: 10px;
                                        SectionHeading { title: GuiI18n.text("gui-watched-download-folders"); detail: GuiI18n.text("gui-watched-download-folders-detail"); horizontal-stretch: 1; }
                                        VerticalLayout { alignment: end; padding-right: Theme.shadow-room; padding-bottom: 2px; AppButton { text: GuiI18n.text("gui-add-watched-folder"); icon: @image-url("../../../assets/icons/add.svg"); compact: true; clicked => { root.choose-watched-folder(); } } }
                                    }
                                    SettingsGroup {
                                        if root.watched-download-folders.length == 0 : Rectangle {
                                            min-height: no-watched-folders.preferred-height + 32px;
                                            preferred-height: no-watched-folders.preferred-height + 32px;
                                            no-watched-folders := BodyText { x: 18px; y: 16px; width: parent.width - 36px; text: GuiI18n.text("gui-watched-download-folders-empty"); color: Theme.text-muted; wrap: word-wrap; }
                                        }
                                        for folder in root.watched-download-folders : Rectangle {
                                            height: 56px;
                                            if self.y > 0px : Rectangle { y: 0px; height: 1px; background: Theme.border; }
                                            HorizontalLayout {
                                                padding-left: 18px; padding-right: 18px; padding-top: 8px; padding-bottom: 8px; spacing: 10px;
                                                BodyText { text: folder; color: Theme.text; font-family: Theme.mono-family; horizontal-stretch: 1; vertical-alignment: center; overflow: elide; }
                                                VerticalLayout { alignment: center; padding-right: Theme.shadow-room; AppButton { text: GuiI18n.text("gui-remove"); tone: "danger"; compact: true; clicked => { root.remove-watched-folder(folder); } } }
                                            }
                                        }
                                    }
                                    SectionHeading { title: GuiI18n.text("gui-artifact-cache"); detail: GuiI18n.text("gui-artifact-cache-detail"); }
                                    SettingsGroup {
                                        SettingRow {
                                            title: GuiI18n.text("gui-artifact-cache-budget");
                                            detail: root.artifact-cache-usage-known ? (root.artifact-cache-usage-exact ? GuiI18n.values("gui-artifact-cache-usage", root.artifact-cache-used, root.artifact-cache-total) : GuiI18n.values("gui-artifact-cache-usage-approximate", root.artifact-cache-used, root.artifact-cache-total)) : GuiI18n.text("gui-artifact-cache-measuring");
                                            note: root.artifact-cache-over-budget ? GuiI18n.text("gui-artifact-cache-over-budget") : "";
                                            HorizontalLayout { spacing: 10px; alignment: end; padding-right: Theme.shadow-room;
                                                // Wide enough for a value far past any preset: the presets
                                                // stop at 100 GiB, the setting does not.
                                                if root.artifact-cache-limit-index == root.artifact-cache-custom-index : TextField { width: 110px; text <=> root.artifact-cache-custom-value; placeholder: "500"; input-type: InputType.number; accessible-name: GuiI18n.text("gui-artifact-cache-custom-value"); note: GuiI18n.text("gui-artifact-cache-custom-value"); edited(value) => { root.cache-limit-edited = true; } accepted => { root.save-cache-limit-edits(); } focus-lost => { root.save-cache-limit-edits(); } }
                                                if root.artifact-cache-limit-index == root.artifact-cache-custom-index : ValueComboBox { width: 100px; label: GuiI18n.text("gui-artifact-cache-custom-value"); model: root.artifact-cache-units; value: root.artifact-cache-custom-unit; selected(value) => { root.artifact-cache-custom-unit = value; root.save-cache-limit(); } }
                                                VerticalLayout { alignment: center;
                                                    ChoiceBox {
                                                        width: 170px;
                                                        accessible-label: GuiI18n.text("gui-artifact-cache-limit");
                                                        model: root.artifact-cache-limit-labels;
                                                        current-index <=> root.artifact-cache-limit-index;
                                                        // Custom waits for its size to be typed: saving the size
                                                        // it starts with would turn it back into the preset it equals.
                                                        selected(value) => { if (root.artifact-cache-limit-index != root.artifact-cache-custom-index) { root.save-cache-limit(); } }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    DiskUsagePanel {
                                        state: root.disk-usage-state; progress: root.disk-usage-progress;
                                        total: root.disk-usage-total; measured-at: root.disk-usage-measured-at;
                                        retention: root.disk-usage-retention; categories: root.disk-usage-categories;
                                        incomplete: root.disk-usage-incomplete; incomplete-text: root.disk-usage-incomplete-text; unreadable: root.disk-usage-unreadable;
                                        stale: root.disk-usage-stale;
                                        maintenance-busy: root.storage-maintenance-busy; maintenance-progress: root.storage-maintenance-progress;
                                        maintenance-inspected: root.storage-inspected; maintenance-headline: root.storage-headline; maintenance-hosts: root.storage-hosts;
                                        maintenance-incomplete: root.storage-incomplete; maintenance-groups: root.storage-groups;
                                        maintenance-checked: root.storage-checked; maintenance-integrity: root.storage-integrity;
                                        maintenance-faults: root.storage-faults; maintenance-unchecked: root.storage-unchecked;
                                        maintenance-can-recover: root.storage-can-recover; maintenance-result: root.storage-result;
                                        refresh => { root.measure-disk-usage(); }
                                        stop => { root.stop-disk-usage(); }
                                        inspect => { root.inspect-storage(); }
                                        verify => { root.verify-storage(); }
                                        recover => { root.recover-storage(); }
                                        review => { root.review-storage-cleanup(); }
                                        stop-maintenance => { root.stop-storage-maintenance(); }
                                        open-location(category, index) => { root.open-storage-location(category, index); }
                                    }
                                }
                                if root.settings-tab == "About & Licenses" : VerticalLayout { alignment: start; spacing: 14px;
                                    SettingsGroup {
                                        Rectangle {
                                            min-height: about-head.preferred-height;
                                            preferred-height: about-head.preferred-height;
                                            about-head := HorizontalLayout { padding: 20px; spacing: 20px; cross-axis-alignment: center;
                                                Image { source: root.logo; width: 92px; height: 92px; image-fit: contain; accessible-label: GuiI18n.text("gui-logo-accessible"); }
                                                VerticalLayout { horizontal-stretch: 1; spacing: 5px; alignment: center;
                                                    DisplayHeading { text: "Ephervex"; font-size: Theme.about-title-size; }
                                                    BodyText { text: root.app-version; color: Theme.text-muted; font-family: Theme.mono-family; }
                                                    BodyText { text: GuiI18n.text("gui-tagline"); wrap: word-wrap; }
                                                    HorizontalLayout { alignment: start; spacing: 10px; padding-top: 6px; padding-right: Theme.shadow-room; padding-bottom: Theme.shadow-room;
                                                        AppButton { text: GuiI18n.text("gui-source"); icon: @image-url("../../../assets/icons/external-link.svg"); compact: true; clicked => { root.open-source-page(); } }
                                                        AppButton { text: GuiI18n.text("gui-view-ephervex-license"); icon: @image-url("../../../assets/icons/settings-about.svg"); compact: true; clicked => { root.modal = "license"; } }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    SectionHeading { title: GuiI18n.text("gui-third-party-software"); detail: root.third-party-error == "" ? root.third-party-summary : ""; }
                                    if root.third-party-error != "" : BodyText { text: root.third-party-error; color: Theme.danger; wrap: word-wrap; }
                                    SettingsGroup {
                                        ListView {
                                            height: min(max(200px, root.height - 540px), root.third-party-packages.length * Theme.license-row-height + 2 * Theme.strong-border-width);
                                            for package[index] in root.third-party-packages : Rectangle {
                                                height: Theme.license-row-height;
                                                background: license-touch.has-hover ? Theme.elevated : transparent;
                                                accessible-role: button;
                                                accessible-label: package.name + " " + package.version;
                                                accessible-action-default => { root.third-party-open = index; root.modal = "third-party"; }
                                                if self.y > 0px : Rectangle { y: 0px; height: 1px; background: Theme.border; }
                                                KeyboardFocus { width: parent.width; height: parent.height; ring-radius: Theme.small-radius; activated => { root.third-party-open = index; root.modal = "third-party"; } }
                                                license-touch := TouchArea { mouse-cursor: pointer; clicked => { root.third-party-open = index; root.modal = "third-party"; } }
                                                HorizontalLayout { padding-left: 18px; padding-right: 18px; spacing: 10px;
                                                    BodyText { text: package.name; color: Theme.text; font-weight: 700; vertical-alignment: center; overflow: elide; }
                                                    BodyText { text: package.version; color: Theme.text-muted; font-family: Theme.mono-family; font-size: Theme.label-size; vertical-alignment: center; horizontal-stretch: 1; }
                                                    VerticalLayout { alignment: center; Chip { text: package.license; width: min(self.natural-width, 240px); } }
                                                }
                                            }
                                        }
                                    }
                                    // Attribution itself, which the royalty-free license
                                    // Ephervex uses Slint under asks for on this screen.
                                    Rectangle { width: 290px; height: 105px; border-radius: Theme.card-radius; border-width: Theme.strong-border-width; border-color: Theme.border-strong; background: Theme.surface; AboutSlint { } TouchArea { mouse-cursor: pointer; accessible-role: button; accessible-label: GuiI18n.text("gui-open-slint-page"); clicked => { root.open-slint-page(); } } }
                                }
                            } } }
                            }
                        }
                    }
                }
            }

            // Dims what the quick view covers; a press on it closes the quick view.
            if root.quick-view-open : Scrim {
                x: 0px;
                y: 0px;
                width: shell.width;
                height: shell.height;
                z: 10;
                pressed => { root.close-quick-view(); }
            }
            // The host panes and the quick view. They are children of the shell
            // rather than of the page so that the quick view can cover the
            // columns, and each is placed by the controller's pane rows. Each
            // pane is one HostWorkspace over the host view it names; the
            // controller keeps every host view current, so two panes on one
            // host read one state.
                            for pane in root.workspace-panes : host-pane := HostWorkspace {
                                property <HostView> host: root.host-views[pane.host];
                                property <LogView> log-view: root.log-views[pane.log];
                                property <bool> is-client: host.kind == "client";
                                // A pane of a split or the quick view, which has no column beside it.
                                property <bool> split: root.pane-split || pane.overlay;
                                property <string> pair-display: host.pair-restart-stage != "" ? GuiI18n.text("gui-state-restarting") : host.pair-state;
                                // Workspace panes sit in the page's area; the quick view
                                // is a plate over the window, above both columns.
                                x: pane.overlay ? root.quick-view-x : root.pane-area-x + root.pane-margin + pane.column * (root.pane-column-width + root.pane-gap);
                                y: pane.overlay ? Theme.shell-padding + root.quick-view-top : root.pane-area-y + root.pane-margin + pane.row * (root.pane-stacked-height + root.pane-gap);
                                width: pane.overlay ? root.quick-view-width : root.pane-column-width;
                                height: pane.overlay ? shell.content-height - root.quick-view-top : pane.stacked ? root.pane-stacked-height : root.pane-area-height;
                                z: 11;
                                visible: pane.overlay || (root.workspace-open && !root.settings-open);
                                quick: pane.overlay;
                                dimmed: root.quick-view-open && !pane.overlay;
                                close-dimmed => { root.close-quick-view(); }
                                quick-fullscreen: root.quick-view-fullscreen;
                                compact: root.pane-split && !pane.overlay;
                                open-quick-as-page => { root.open-quick-view-as-page(); }
                                toggle-quick-fullscreen => { root.quick-view-fullscreen = !root.quick-view-fullscreen; }
                                host-id: host.id;
                                has-issue-link: self.is-client;
                                issue-link: self.is-client ? host.client.issue-link : "";
                                set-issue-link(link) => { root.set-issue-link(host.id, link); }
                                open-issue-link => { root.open-issue-link(host.client.issue-link); }
                                actions-in-column: !pane.overlay && shell.side-inline && root.shows-host-column && !root.pane-split;
                                show-column-button: !pane.overlay && !shell.side-inline && root.shows-host-column;
                                column-button-label: self.is-client ? GuiI18n.text("gui-workspace-show-column") : GuiI18n.text("gui-workspace-show-storage");
                                show-column => { shell.open-side(); }
                                pane-label: pane.label;
                                host-kind-label: self.is-client ? GuiI18n.text("gui-client") : GuiI18n.text("gui-server");
                                folder-label: self.is-client ? GuiI18n.text("gui-open-instance-folder") : GuiI18n.text("gui-open-server-folder");
                                surface-choice: pane.surface-choice;
                                can-split-beside: pane.can-split-beside;
                                can-split-below: pane.can-split-below;
                                can-close: pane.can-close;
                                paired: self.is-client ? host.client.paired-server-id != "" : host.server.paired-client-id != "";
                                pair-label: self.pair-display == "" ? GuiI18n.text("gui-paired") : GuiI18n.value(self.is-client ? "gui-paired-server-state" : "gui-paired-client-state", self.pair-display);
                                pair-state-kind: host.pair-restart-stage != "" ? "restarting" : host.pair-state-kind;
                                pair-starting: self.is-client ? host.client.pair-starting : host.server.pair-starting;
                                java-summary: host.java-summary;
                                java-tone: host.java-tone;
                                java-tone-label: host.java-tone-label;
                                java-origin: host.java-origin;
                                open-java => { root.show-pane-surface(pane.id, "Settings"); }
                                address: self.is-client ? "" : host.server.address;
                                minecraft: self.is-client ? host.client.minecraft : host.server.minecraft;
                                loader: self.is-client ? host.client.loader : host.server.loader;
                                loader-kind: self.is-client ? host.client.loader-kind : host.server.loader-kind;
                                storage: self.is-client ? host.client.storage : host.server.storage;
                                mods: self.is-client ? host.client.mods : -1;
                                linked-name: self.is-client ? host.client.paired-server-name : host.server.paired-client-name;
                                linked-tone: self.is-client ? "server" : "neutral";
                                restart-required: !self.is-client && host.server.restart-required;
                                stamp-client: self.is-client;
                                stamp-problems: self.is-client ? host.client.problems : host.server.problems;
                                stamp-reproduced: self.is-client ? host.client.case-reproduced : 0;
                                choose-host => { root.pane-host-picker-pane = pane.id; root.pane-host-picker-kind = host.kind; root.pane-host-picker-id = host.id; root.pane-host-query = ""; root.pane-host-query-changed(); root.modal = "pane-host"; }
                                split-beside => { root.split-pane-beside(pane.id); }
                                split-below => { root.split-pane-below(pane.id); }
                                close-pane => { if pane.overlay { root.close-quick-view(); } else { root.close-pane(pane.id); } }
                                title: self.is-client ? host.client.name : host.server.name;
                                back-label: pane.overlay ? "" : root.workspace-back-label;
                                status: self.is-client ? host.client.state : host.server.state;
                                status-kind: self.is-client ? host.client.state-kind : host.server.state-kind;
                                host-running: self.is-client ? host.client.can-kill : host.server.can-stop;
                                surfaces: host.surfaces;
                                selected-surface: pane.surface;
                                account-entries: root.account-launch-entries;
                                show-launch-as: self.is-client;
                                launch-alongside: self.is-client && host.client.can-kill;
                                primary-label: HostActions.primary-label(host);
                                primary-tone: HostActions.primary-tone(host);
                                primary-enabled: HostActions.primary-enabled(host);
                                primary-hint: HostActions.primary-hint(host);
                                kill-visible: !self.is-client;
                                kill-enabled: HostActions.kill-enabled(host);
                                kill-hint: HostActions.kill-hint(host);
                                restart-visible: true;
                                restart-enabled: HostActions.restart-enabled(host);
                                restart-hint: HostActions.restart-hint(host);
                                restart-stage: self.is-client ? host.client.restart-stage : host.server.restart-stage;
                                workflow-id: host.workflow-id;
                                workflow-here: host.workflow-pane == 0 || host.workflow-pane == pane.id;
                                busy: root.host-busy-kind == host.kind && root.host-busy-id == host.id;
                                busy-text: root.host-busy-text;
                                workflow-title: host.workflow-title;
                                workflow-summary: host.workflow-summary;
                                workflow-actions: host.workflow-actions;
                                back => { root.workspace-back(); }
                                open-folder => { if self.is-client { root.open-client-folder(host.id); } else { root.open-server-folder(host.id); } }
                                primary => {
                                    if self.is-client {
                                        if host.client.can-kill { root.kill-instance(host.id, ""); } else { root.launch-client(host.id); }
                                    } else {
                                        if host.server.can-stop { root.server-stop(host.id); } else { root.server-start(host.id); }
                                    }
                                }
                                restart => { if self.is-client { root.client-restart(host.id); } else { root.server-restart(host.id); } }
                                kill => { root.pending-action-id = host.id; root.pending-action-name = host.server.name; root.modal = "kill"; }
                                launch-as(account, alongside) => { root.launch-client-as(host.id, account, alongside); }
                                add-account => { root.open-settings("Accounts"); }
                                surface-selected(surface) => { root.show-pane-surface(pane.id, surface); }
                                workflow-action(workflow, action) => { root.workflow-action(pane.id, host.kind, host.id, workflow, action); }
                                // Above every surface but Diagnostics, which already leads
                                // with a failure; a refused start has none to lead with.
                                // Any of its actions retires it.
                                if host.available && host.run-failure-title != "" && (pane.surface != "Diagnostics" || host.run-eula-refused) : RunFailureNotice {
                                    host: host;
                                    review-eula => { root.modal = "eula"; root.dismiss-run-failure(host.kind, host.id); }
                                    open-diagnostics => { root.show-pane-surface(pane.id, "Diagnostics"); root.dismiss-run-failure(host.kind, host.id); }
                                    verify-host => { root.show-pane-surface(pane.id, "Diagnostics"); root.diagnose-host(host.kind, host.id); root.dismiss-run-failure(host.kind, host.id); }
                                    open-crash-report => { root.show-pane-surface(pane.id, "Logs"); root.log-show(pane.id, "crashes"); root.log-open-file(pane.id, host.run-crash-report); root.dismiss-run-failure(host.kind, host.id); }
                                    open-log => { root.show-pane-surface(pane.id, "Logs"); root.log-show(pane.id, "live"); root.dismiss-run-failure(host.kind, host.id); }
                                    dismiss => { root.dismiss-run-failure(host.kind, host.id); }
                                }
                                if !host.available : EmptyState {
                                    icon: @image-url("../../../assets/icons/nav-instances.svg");
                                    title: GuiI18n.text("gui-workspace-host-gone");
                                    message: GuiI18n.text("gui-workspace-host-gone-detail");
                                }
                                // Never wider than the pane: a narrow pane wraps its
                                // text and stacks its buttons rather than scrolling
                                // sideways into a column centered off screen.
                                if host.available && host.kind == "client" && pane.surface == "Overview" : ScrollView {
                                    content-width: self.visible-width;
                                    client-overview := VerticalLayout { alignment: start; x: 0px; y: 0px; width: parent.width; spacing: 12px; padding-left: Theme.lift-room; padding-top: Theme.lift-room; padding-right: Theme.shadow-room; padding-bottom: Theme.shadow-room;
                                        property <bool> narrow: self.width < 620px;
                                        ClientOverviewSummary {
                                            host: host;
                                            quick: pane.overlay;
                                            primary-label: HostActions.primary-label(host);
                                            primary-tone: HostActions.primary-tone(host);
                                            primary-enabled: HostActions.primary-enabled(host) && !host-pane.primary-waits;
                                            primary-hint: host-pane.primary-reason;
                                            primary => { if host.client.can-kill { root.kill-instance(host.id, ""); } else { root.launch-client(host.id); } }
                                            count-reproduced => { root.case-count-reproduced(host.id); }
                                            open-issue-link => { root.open-issue-link(host.client.issue-link); }
                                            add-step(text) => { root.case-add-step(host.id, text); }
                                            set-step-done(step, done) => { root.case-set-step-done(host.id, step, done); }
                                            remove-step(step) => { root.case-remove-step(host.id, step); }
                                        }
                                        if host.client.paired-server-id != "" : HorizontalLayout { spacing: 10px;
                                            BodyText { text: GuiI18n.value("gui-paired-with-host", host.client.paired-server-name); color: Theme.accent; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
                                            if !host.pair-shown : AppButton { text: GuiI18n.text("gui-pair-show-beside"); enabled: host.pair-room; hint: host.pair-room ? "" : GuiI18n.text("gui-pair-no-room"); clicked => { root.show-linked-pair(pane.id, "server", host.client.paired-server-id); } }
                                        }
                                        if !client-overview.narrow : HorizontalLayout { spacing: 10px;
                                            if host.client.loader-kind != "vanilla" : BodyText { text: GuiI18n.value("gui-loader-change-summary", host.client.loader); color: Theme.text-secondary; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                                            if host.client.loader-kind == "vanilla" : Rectangle { horizontal-stretch: 1; }
                                            if host.client.storage-kind == "temporary" : AppButton { text: GuiI18n.text("gui-make-persistent"); enabled: !host.client.can-kill; hint: GuiI18n.text("gui-make-persistent-while-running"); clicked => { root.open-make-persistent(host.id); } }
                                            if host.client.loader-kind != "vanilla" : AppButton { text: GuiI18n.text("gui-loader-change-open"); clicked => { root.open-loader-change(host.id); } }
                                        }
                                        if client-overview.narrow && host.client.loader-kind != "vanilla" : BodyText { text: GuiI18n.value("gui-loader-change-summary", host.client.loader); color: Theme.text-secondary; wrap: word-wrap; }
                                        if client-overview.narrow : HorizontalLayout { spacing: 10px; alignment: start;
                                            if host.client.storage-kind == "temporary" : AppButton { text: GuiI18n.text("gui-make-persistent"); enabled: !host.client.can-kill; hint: GuiI18n.text("gui-make-persistent-while-running"); clicked => { root.open-make-persistent(host.id); } }
                                            if host.client.loader-kind != "vanilla" : AppButton { text: GuiI18n.text("gui-loader-change-open"); clicked => { root.open-loader-change(host.id); } }
                                        }
                                        BodyText { text: host.client.storage-kind == "temporary" ? GuiI18n.text("gui-temporary-lifecycle") : GuiI18n.text("gui-persistent-lifecycle"); color: Theme.text-muted; wrap: word-wrap; }
                                        // A pane of a split has no column beside it, so its Overview
                                        // keeps the linked servers; otherwise the column holds them.
                                        property <[ServerRow]> no-servers;
                                        property <[PendingEntityRow]> no-pending;
                                        property <[ServerRow]> listed-servers: split ? host.linked-servers : self.no-servers;
                                        property <[PendingEntityRow]> listed-pending: split ? host.pending-servers : self.no-pending;
                                        if split : Divider { }
                                        if split : HorizontalLayout { spacing: 10px; Heading { text: GuiI18n.text("gui-linked-server"); font-size: Theme.section-size; overflow: elide; horizontal-stretch: 1; } if host.linked-servers.length == 0 && host.pending-servers.length == 0 : AppButton { text: GuiI18n.text("gui-create-linked-server"); clicked => { root.open-create-linked-server(host.id, host.client.name); } } }
                                        if split && host.linked-servers.length == 0 && host.pending-servers.length == 0 : BodyText { text: GuiI18n.text("gui-no-linked-server-detail"); color: Theme.text-muted; wrap: word-wrap; }
                                        for pending in self.listed-pending : PendingCard { item: pending; }
                                        for server in self.listed-servers : Rectangle { border-radius: Theme.card-radius; border-width: Theme.strong-border-width; border-color: server.needs-attention ? Theme.warning : Theme.border-strong; background: Theme.surface; card := VerticalLayout { padding: 14px; spacing: 8px;
                                            // Every action on one row needs about this much room.
                                            property <bool> narrow: self.width < 840px;
                                            property <bool> paired: host.client.paired-server-id == server.id;
                                            HorizontalLayout { spacing: 10px; Heading { text: server.name; font-size: Theme.row-heading-size; overflow: elide; horizontal-stretch: 1; } if card.paired : VerticalLayout { alignment: center; Pill { text: GuiI18n.text("gui-paired"); tone-color: Theme.accent; } } VerticalLayout { alignment: center; StatePill { state: server.state; state-kind: server.state-kind; restarting: server.restart-stage != ""; } } BodyText { text: server.address; color: Theme.text-muted; vertical-alignment: center; } }
                                            BodyText { text: server.needs-attention ? GuiI18n.text("gui-server-needs-attention") : server.state-detail; color: server.needs-attention ? Theme.warning : Theme.text-secondary; wrap: word-wrap; }
                                            HorizontalLayout { spacing: 8px; alignment: start;
                                                if !card.narrow : AppButton { text: GuiI18n.text("gui-open-server-workspace"); clicked => { root.follow-host(pane.id, "server", server.id, "Overview"); } }
                                                if server.can-start || server.can-stop : AppButton { text: server.can-start ? GuiI18n.text("gui-start") : GuiI18n.text("gui-stop"); tone: "primary"; clicked => { if server.can-start { root.server-start(server.id); } else { root.server-stop(server.id); } } }
