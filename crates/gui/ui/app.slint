    callback save-storage-settings(string);
    callback choose-storage-root();
    callback reset-storage-root();
    callback choose-watched-folder();
    callback remove-watched-folder(string);
    callback measure-artifact-cache();
    callback save-artifact-cache-limit(int, string, string);
    // Text scale, technical text size, whether linked servers are listed
    // globally, whether the default account is made an operator, and the
    // level it is given. One callback because the General page saves with
    // one button: two buttons on one page meant two ways to half-save it.
    callback save-general-settings(int, int, string, bool, bool, int);
    // Applied on the click rather than on Save, like the other remembered
    // answers on this screen: it is one recorded decision, not a form.
    callback set-dependency-warning(bool);
    callback set-dependency-following(bool);
    callback set-seasonal-themes(bool);
    // What the Java settings page asks for when it opens, against the
    // cached inventory. `refresh-java` is the page's own button, which
    // rescans because the cache cannot notice a JDK installed since.
    callback load-java-runtimes();
    callback refresh-java();
    callback check-java-path(string);
    // Offered only for a runtime Ephervex installed: the rest were found,
    // not placed, and are not the launcher's to delete.
    callback remove-java-runtime(string);
    callback save-java-settings(bool, bool, string, string, string);
    callback minecraft-select-category(int);
    callback minecraft-set-query(string);
    callback minecraft-set-show-advanced(bool);
    callback minecraft-set-only-overridden(bool);
    callback minecraft-set-preview-release(string);
