    callback log-select-at(int, int, int, bool);
    // Selects the whole word under a double click.
    callback log-select-word-at(int, int, int);
    callback log-select-all(int);
    callback load-server-workspace(string);
    callback refresh-server-statistics(string);
    callback load-server-mods(string);
    callback load-running();
    // The instance, and which of its launches to end.
    callback force-stop-launch(string, string);
    // Asks a provider about a host's mods again. Names and artwork are
    // otherwise fetched once per host per run and repainted from the
    // shared cache after that.
    callback refresh-mods(string, string);
    callback disable-suggested-mods(string);
    // (server, online mode, access, address, port); the other settings are
    // the edits the controller keeps for the server.
    callback save-server-properties(string, bool, string, string, string);
    // (server, key, value) and (server, key, entry index): an edit to one row
    // of a server's Properties form.
    callback edit-server-property(string, string, string);
    callback choose-server-property(string, string, int);
    callback show-advanced-server-properties(string, bool);
    callback discard-server-properties(string);
    // The server.properties values new servers start with, as the Settings
    // page shows them, unsaved edits included.
    in property <[ServerPropertyGroup]> server-defaults-groups;
    in property <int> server-defaults-edits;
    in property <bool> server-defaults-invalid;
    in property <bool> server-defaults-show-advanced;
    // (key, value) and (key, entry index); empty text or the first entry
    // takes a default away.
    callback edit-server-default(string, string);
    callback choose-server-default(string, int);
    callback reset-server-default(string);
    callback show-advanced-server-defaults(bool);
    callback discard-server-defaults();
    callback save-server-defaults();
    callback accept-eula();
    callback revoke-eula();
    callback open-eula-reference();
