// The application window: the properties and callbacks the Rust side reads and
// invokes, the navigation shell, its pages, and its modals.

import { AboutSlint, ListView, Palette, ScrollView } from "std-widgets.slint";
import "fonts/PixelifySans-Regular.ttf";
import "fonts/PixelifySans-SemiBold.ttf";
import "fonts/SpaceGrotesk-Regular.ttf";
import "fonts/SpaceGrotesk-Medium.ttf";
import "fonts/SpaceGrotesk-SemiBold.ttf";
import "fonts/SpaceGrotesk-Bold.ttf";
import "fonts/IBMPlexMono-Regular.ttf";
import "fonts/IBMPlexMono-Medium.ttf";
import "fonts/IBMPlexMono-SemiBold.ttf";
import { ChoiceBar, ChoiceBox, IndexComboBox, ValueComboBox } from "components/selection.slint";
import { HostIcon } from "components/artwork.slint";
import { Outlined, Panel, Plate, Scrim } from "components/surface.slint";
import {
    AppButton,
    BusySpinner,
    CheckRow,
    Chip,
    DraftBar,
    EmptyState,
    FavoriteToggle,
    FieldCaption,
    FilterChip,
    FocusEdge,
    IconButton,
    InfoBanner,
    InlineToggle,
    KeyboardFocus,
    LabeledToggle,
    MultilineField,
    Pill,
    FavoriteChip,
    SegmentedChoice,
    SettingBlock,
    SettingCard,
    SettingRow,
    SettingsGroup,
    SettingsNavItem,
    ThemeCard,
    StatePill,
    TextField,
    ToastPanel,
    Toggle
} from "components/controls.slint";
import {
    ActionRow,
    BodyText,
    Divider,
    DisplayHeading,
    Eyebrow,
    FactLabel,
    FieldLabel,
    Heading,
    PageIntro,
    SectionHeading,
    SectionTitle,
    HoverNote,
    HoverNoteLayer,
    SelectableText
} from "components/text.slint";
import { ServerFiles, ServerCommandInput } from "workspace/server-tools.slint";
import { ServerStatisticsCard } from "workspace/server-statistics.slint";
import { ModBrowser } from "workspace/mod-browser.slint";
import { GuiI18n, NameRules, PropertyRules, ServerHints, ServerPackRules } from "globals.slint";
import { HomePage } from "home/home-page.slint";
import { ServerPackZone } from "components/server-pack-zone.slint";
import { CaseSurface } from "workspace/case.slint";
import { ClientOverviewSummary } from "workspace/overview.slint";
import { StorageCard } from "home/storage-card.slint";
import { HostActions } from "workspace/host-actions.slint";
import { BundleCard, HostStorageCard, LinkedServersCard, ReportCard, RunCard } from "workspace/host-column.slint";
import { TipsCard } from "home/tips-card.slint";
import { PendingCard } from "host-list/host-card.slint";
import { HostList } from "host-list/host-list.slint";
import { AccountFooter } from "shell/account-footer.slint";
import { AppShell } from "shell/app-shell.slint";
import { BrandBar } from "shell/brand-bar.slint";
import { RightColumn } from "shell/right-column.slint";
import {
    AccountRow,
    ActivityRow,
    AttentionRow,
    BlockedFileRow,
    BundlePartRow,
    DiskUsageRow,
    GroupRow,
    HostView,
    ImpactRow,
    ImportDuplicateRow,
    ImportOptionRow,
    InstanceRow,
    JavaRow,
    ThemeSwatch,
    LicenseRow,
    LinkedTargetRow,
    LocalModClashRow,
    LogView,
    MenuRow,
    MinecraftPreferenceRow,
    ModVersionRow,
    PendingEntityRow,
    PromoteServerRow,
    RelationRow,
    ResumeRow,
    RunningRow,
    ServerPropertyGroup,
    ServerRow,
    StorageGroupRow,
    ToastRow,
    WorkspaceHostChoice,
    WorkspaceSurfaceRow,
    WorkspacePaneRow
} from "models.slint";
import { DiskUsagePanel, OverrideCard } from "settings/application.slint";
import { MinecraftPreferenceRowCard } from "settings/minecraft-defaults.slint";
import { ServerDefaultsPanel } from "settings/server-defaults.slint";
import { Theme } from "theme.slint";
import { DiagnosticBundlePanel, DiagnosticsSurface, RunFailureNotice } from "workspace/diagnostics.slint";
import { HostRuntimeForm, ServerPropertiesForm } from "workspace/host-settings.slint";
import { HostPickerCard, HostWorkspace, SurfaceTabs, WorkspaceTab } from "workspace/host-workspace.slint";
import { IsolationSurface } from "workspace/isolation.slint";
import { CrashNotice, DiagnosticFileList, LiveLogViewer } from "workspace/logs.slint";
import { ImpactList, LinkedTargetsPanel, ManagedModsPanel, RelationList } from "workspace/mods.slint";
import { PackContentPanel } from "workspace/packs.slint";
import { SnapshotPanel } from "workspace/snapshots.slint";

export { GuiI18n } from "globals.slint";
export { HostIcons, NameRules, PropertyRules, ServerPackRules } from "globals.slint";
export { BuiltInPalettes, ThemePalette } from "palettes.slint";
export { Theme } from "theme.slint";
export { WindowSizePreview } from "settings/minecraft-defaults.slint";
export * from "models.slint";

export component AppWindow inherits Window {
    title: "Ephervex";
    icon: root.theme-icon.width > 0 ? root.theme-icon : root.default-logo;
    preferred-width: 1480px;
    preferred-height: 900px;
    min-width: Theme.window-min-width;
    min-height: Theme.window-min-height;
    background: Theme.background;
    default-font-family: Theme.body-family;
    default-font-size: Theme.body-size;

    // The shipped widgets paint from their own palette, which is writable
    // and repaints every ScrollView and ListView when it changes. Moved with
    // this window's scheme so a widget never sits light on a dark page.
    // `init` runs before the first frame.
    property <ColorScheme> widget-scheme: Theme.widget-scheme;
    init => { Palette.color-scheme = self.widget-scheme; }
    changed widget-scheme => { Palette.color-scheme = self.widget-scheme; }

    // The chosen theme's logo and window icon, or an empty image for the
    // embedded default. Images keep their aspect ratio where they are drawn.
    in property <image> theme-logo;
    in property <image> theme-icon;
    private property <image> default-logo: @image-url("../../../assets/logo.png");
    private property <image> logo: root.theme-logo.width > 0 ? root.theme-logo : root.default-logo;
    // Whether the Minecraft defaults page is laid out for the narrower window.
    private property <bool> minecraft-narrow: root.width < 1700px;
    // Whether the settings are on screen instead of the host panes or Home.
    in-out property <bool> settings-open: false;
    // Whether Home is the page: neither the settings nor a host is open.
    out property <bool> shows-home: !root.workspace-open && !root.settings-open;
    // The one pane whose host has a column of cards beside it. A split has
    // none: each pane keeps what it shows on its own page.
    private property <WorkspacePaneRow> column-pane: root.workspace-panes[0];
    // How the workspace panes divide the page's area, below the split's own
    // header. The quick view is not one of them.
    private property <int> pane-count: root.workspace-panes.length - (root.quick-view-open ? 1 : 0);
    private property <bool> pane-split: root.pane-count > 1;
    private property <length> pane-gap: 10px;
    private property <length> pane-margin: root.pane-split ? 12px : 0px;
    private property <length> pane-head: root.pane-split ? 12px + Theme.control-height : 0px;
    private property <length> pane-area-x: shell.page-x;
    private property <length> pane-area-y: Theme.shell-padding + root.pane-head;
    private property <length> pane-area-height: max(shell.content-height - root.pane-head - 2 * root.pane-margin, root.pane-split ? 2 * Theme.workspace-pane-min-height + root.pane-gap : 0px);
    private property <length> pane-area-width: max(shell.page-width - 2 * root.pane-margin, root.pane-split ? 2 * Theme.workspace-pane-min-width + root.pane-gap : 0px);
    private property <length> pane-column-width: root.pane-split ? (root.pane-area-width - root.pane-gap) / 2 : root.pane-area-width;
    private property <length> pane-stacked-height: (root.pane-area-height - root.pane-gap) / 2;
    // The quick view takes the right part of the window, or all of it.
    private property <length> quick-view-width: root.quick-view-fullscreen ? shell.width - 2 * Theme.shell-padding : max(Theme.quick-view-min-width, shell.width * 0.46);
    // Below the rail buttons that open the drawers, where they would cover its header.
    private property <length> quick-view-top: (root.shows-home && !shell.side-inline) || (root.quick-view-fullscreen && !shell.list-inline) ? Theme.control-height + 14px : 0px;
    private property <length> quick-view-x: shell.width - Theme.shell-padding - root.quick-view-width;
    private property <HostView> column-host: root.host-views[root.column-pane.host];
    // Which host the column is about, so its drawer can close when that changes.
    private property <string> column-host-key: root.column-host.kind + ":" + root.column-host.id;
    out property <bool> shows-host-column: root.workspace-open && !root.settings-open && root.pane-count == 1 && root.column-host.available;
    // The delete dialog: its two outcome cards, and a line for each note that
    // applies to what is being deleted.
    private property <length> delete-dialog-height: (392px
        + (root.modal == "delete-instance" && root.pending-action-linked-servers > 0 ? 32px : 0px)
        + (root.modal == "delete-instance" && root.pending-deletion-stops-servers ? 62px : 0px)
        + (root.modal == "delete-instance" && root.pending-action-unstoppable-linked-servers > 0 ? 62px : 0px)
        + (root.modal-error != "" ? 62px : 0px)) * Theme.text-scale;
    // The artifact cache is measured the first time Home appears and not on
    // every visit, because measuring walks the cache.
    private property <bool> artifact-cache-requested: false;
    in-out property <[InstanceRow]> instances;
    // Every server the combined list search and the linked-servers setting let
    // through, favorites first, written by Rust from `list-query`.
    in-out property <[ServerRow]> listed-servers;
    // The one search text that narrows instances and servers together.
    in-out property <string> list-query;
    // The Home page, written by Rust.
    in-out property <string> home-greeting;
    in-out property <string> home-summary;
    in-out property <[AttentionRow]> home-attention;
    in-out property <[ResumeRow]> home-resume;
    in-out property <int> home-temporary-count: 0;
    in-out property <int> home-persistent-count: 0;
    in-out property <int> home-server-count: 0;
    // What the launcher is running right now. Polled only while Home is on
    // screen.
    in-out property <[RunningRow]> running;
    // -- dropping jars onto a mod list.
    //
    // One question at a time, because "this name is taken" is a question
    // about one file and answering it six times over is not a dialog
    // anybody wants. The two "all" answers fold the rest away.
    in-out property <[LocalModClashRow]> mod-clashes;
    in-out property <int> mod-clash-index: 0;
    // -- what a copy would inherit with no jar behind it.
    in-out property <[string]> absent-mods;
    // -- what the selected host's newest crash report says. Empty report
    // means it has never crashed, which is what clears a notice left by a
    // previous selection.
    // -- managing one mod, which is what the mod modals act on.
    in-out property <string> mod-action-path;
    in-out property <string> mod-action-name;
    // Whether deleting the selected jar also forgets its adopted record.
    // Every other origin stays in the list and can be restored.
    in-out property <bool> mod-action-is-hand-placed: false;
    in-out property <string> mod-action-installed;
    in-out property <string> mod-action-notice;
    in-out property <bool> mod-action-can-change: false;
    in-out property <bool> mod-action-can-update: false;
    in-out property <bool> mod-action-can-remove: false;
    in-out property <bool> mod-action-up-to-date: false;
    in-out property <bool> mod-action-loading: false;
    in-out property <string> mod-action-project-url;
    in-out property <bool> mod-action-is-pack-owned: false;
    in-out property <string> mod-action-pack-original-version;
    // Set the moment a mutation is submitted and cleared when it answers,
    // so one click cannot become two operations.
    in-out property <bool> mod-action-pending: false;
    in-out property <string> mod-action-selected;
    in-out property <[ModVersionRow]> mod-versions;
    // Whether the removal confirmation was opened from the Manage Mod
    // dialog, which is what leaving it goes back to. Opened from a row's
    // bin it goes back to the list, because that is where the reader was.
    in-out property <bool> mod-remove-returns-to-manager;
    // The releases a pending version change still needs the user to
    // fetch, and the mod they belong to. Empty whenever no acquisition is
    // waiting.
    in-out property <[BlockedFileRow]> mod-acquisition-items;
    in-out property <string> mod-acquisition-id;
    in-out property <string> mod-acquisition-name;
    // The question whether a jar already on a host may stand in for a
    // dependency an operation needs. Empty whenever none is waiting.
    in-out property <string> mod-stand-in-id;
    in-out property <string> mod-stand-in-detail;
    in-out property <string> mod-stand-in-note;
    // What this mod declares and what declares it, direct relations only.
    in-out property <[RelationRow]> mod-action-requires;
    in-out property <[RelationRow]> mod-action-required-by;
    // What to say instead of an empty "Requires" list, and whether asking
    // the catalog again would turn it into an answer.
    in-out property <string> mod-action-requires-note;
    in-out property <bool> mod-action-relations-refreshable: false;
    in-out property <[string]> mod-removal-dependencies;
    // What turning a mod off, or deleting its jar, would do to the rest.
    // Written whole by the controller; the markup decides nothing here.
    in-out property <string> mod-impact-kind;
    in-out property <string> mod-impact-host;
    in-out property <string> mod-impact-path;
    in-out property <string> mod-impact-name;
    in-out property <bool> mod-impact-deleting;
    // Which question the dialog asks: turning the mod on, or off. The lists it
    // holds cannot say, since a turn-off with nothing proven breaking is empty.
    in-out property <bool> mod-impact-enabling;
    in-out property <[ImpactRow]> mod-impact-breaks;
    in-out property <[ImpactRow]> mod-impact-degrades;
    in-out property <[ImpactRow]> mod-impact-unknown;
    in-out property <[ImpactRow]> mod-impact-unidentifiable;
    // Ticked by default when there is a proven cascade: the set that still
    // loads is the one the user almost always wants.
    in-out property <bool> mod-impact-cascade: true;
    in-out property <bool> mod-impact-remember;
    // The inverse question, for turning a mod back on.
    in-out property <[ImpactRow]> mod-requires-disabled;
    in-out property <[ImpactRow]> mod-requires-absent;
    in-out property <[ImpactRow]> mod-requires-incompatible;
    callback apply-mod-impact(bool);
    // The host kind, the host, and the mod whose page to refill, if any.
    callback refresh-mod-dependencies(string, string, string);
    in-out property <bool> mod-removal-unprovable: false;
    // -- carrying the same mod decision to this client's linked servers.
    in-out property <[LinkedTargetRow]> linked-targets;
    in-out property <string> linked-support;
    in-out property <string> linked-path;
    in-out property <string> linked-version;
    in-out property <string> linked-name;
    in-out property <string> linked-version-number;
    in-out property <[LinkedTargetRow]> linked-results;
    in-out property <string> linked-result-title;
    in-out property <string> linked-result-summary;
    // -- changing the loader build this instance runs.
    in-out property <string> loader-change-current;
    // The build alone, as the build list names it, without the loader's name.
    in-out property <string> loader-change-current-build;
    // The loader family and Minecraft release the open dialog lists builds for.
    in-out property <string> loader-change-loader;
    in-out property <string> loader-change-minecraft;
    in-out property <string> loader-change-selected;
    in-out property <[string]> loader-change-versions;
    in-out property <bool> loader-change-loading: false;
    in-out property <bool> loader-change-pending: false;
    in-out property <int> loader-change-unverifiable: 0;
    callback open-loader-change(string);
    callback change-loader-version(string, string);
    // (host kind, host id, the mod's path)
    callback open-mod-manager(string, string, string);
    // The host the open mod dialog acts on, set by whichever pane opened it.
    in-out property <string> mod-action-host;
    // `"client"` or `"server"`, for `mod-action-host`.
    in-out property <string> mod-action-host-kind: "client";
    // (host kind, host id, the mod's path, whether the loader loads it)
    callback set-mod-enabled(string, string, string, bool);
    callback restore-mod-file(string, string, string);
    callback change-mod-version(string, string, string);
    // (host kind, host id, the mod's path)
    callback plan-mod-removal(string, string, string);
    // Works out what a change or an update would do here and on every
    // linked server. An empty version means "the newest release that fits
    // this host", which is a different request from an exact choice.
    callback plan-mod-apply(string, string, string);
    callback remove-mod(string, string);
    callback open-mod-project-page(string);
    // The host and snapshot selected by a snapshot modal. IDs rather than
    // row positions keep the action attached when a refreshed list moves.
    in-out property <string> snapshot-host-kind;
    in-out property <string> snapshot-host-id;
    in-out property <string> snapshot-action-id;
    in-out property <string> snapshot-action-label;
    in-out property <bool> snapshot-safety-copy: true;
    // The one host whose files a change is rewriting, and what it is
    // doing. Isolation and repair both claim it, so every surface of that
    // host reads a single answer to "is something changing it".
    in-out property <string> host-busy-kind;
    in-out property <string> host-busy-id;
    in-out property <string> host-busy-text;
    // The disk usage view: one measurement of Ephervex's own storage.
    in-out property <string> disk-usage-state: "idle";
    in-out property <string> disk-usage-progress;
    in-out property <string> disk-usage-total;
    in-out property <string> disk-usage-measured-at;
    in-out property <[DiskUsageRow]> disk-usage-retention;
    in-out property <[DiskUsageRow]> disk-usage-categories;
    in-out property <bool> disk-usage-incomplete;
    in-out property <string> disk-usage-incomplete-text;
    in-out property <[string]> disk-usage-unreadable;
    // The bundle of the launcher's own logs, chosen on the Diagnostics page.
    in-out property <[BundlePartRow]> launcher-bundle-parts;
    in-out property <string> launcher-bundle-selection;
    in-out property <int> launcher-bundle-selected-count;
    in-out property <bool> launcher-bundle-exporting;
    in-out property <string> launcher-bundle-result;
    in-out property <string> launcher-bundle-result-path;
    in-out property <string> launcher-bundle-error;
    // Maintenance changed the disk after the last measurement, so its totals
    // are not shown as current.
    in-out property <bool> disk-usage-stale;
    // The maintenance section of the disk usage view, and the cleanup review.
    in-out property <string> storage-maintenance-busy;
    in-out property <string> storage-maintenance-progress;
    in-out property <bool> storage-inspected;
    in-out property <string> storage-headline;
    in-out property <string> storage-hosts;
    in-out property <bool> storage-incomplete;
    in-out property <[StorageGroupRow]> storage-groups;
    in-out property <bool> storage-checked;
    in-out property <string> storage-integrity;
    in-out property <[string]> storage-faults;
    in-out property <[string]> storage-unchecked;
    in-out property <bool> storage-can-recover;
    in-out property <[string]> storage-result;
    // The plan the review shows, named so a confirmation applies that plan and
    // no other.
    in-out property <int> storage-plan-id;
    in-out property <string> storage-plan-summary;
    in-out property <[StorageGroupRow]> storage-plan-items;
    in-out property <[string]> storage-plan-kept;
    in-out property <bool> storage-plan-incomplete;
    in-out property <bool> storage-plan-empty;
    in-out property <string> storage-plan-confirm;
    in-out property <[ActivityRow]> activities;
    in-out property <[AccountRow]> accounts;
    // The default account's name, or empty when there is none.
    in-out property <string> default-account-name;
    // The first letter of that name, and what sort of account it is.
    in-out property <string> default-account-initial;
    in-out property <string> default-account-kind;
    // The same accounts as menu rows, for the Launch as menu.
    in-out property <[MenuRow]> account-launch-entries;
    in-out property <[JavaRow]> java-runtimes;
    // -- Minecraft defaults for future client instances.
    in-out property <[MinecraftPreferenceRow]> minecraft-preference-rows;
    in-out property <[string]> minecraft-categories;
    // The same categories, and the custom lines, as the tabs that choose between them.
    in-out property <[WorkspaceSurfaceRow]> minecraft-category-tabs;
    // The ratios the window size picker offers, in the order it lists them.
    in-out property <[string]> minecraft-aspect-labels;
    in-out property <int> minecraft-category-index: 0;
    in-out property <string> minecraft-query;
    // Whether the catalog has developer-facing rows for the switch to reveal.
    in-out property <bool> minecraft-has-advanced: false;
    in-out property <bool> minecraft-show-advanced: false;
    in-out property <bool> minecraft-only-overridden: false;
    // The row waiting for a key or mouse press, by product id. Kept out of
    // the row model on purpose: entering capture must not rebuild the
    // rows, because rebuilding them would destroy the control that just
    // took focus.
    in-out property <string> minecraft-capturing-id;
    in-out property <bool> minecraft-languages-available: false;
    in-out property <string> minecraft-preview-release;
    in-out property <bool> minecraft-dirty: false;
    in-out property <bool> minecraft-can-save: false;
    in-out property <int> minecraft-dirty-count: 0;
    in-out property <int> minecraft-total-count: 0;
    in-out property <string> minecraft-preserved-notice;
    in-out property <string> minecraft-unusable-notice;
    in-out property <bool> minecraft-saving: false;
    // The custom options.txt lines, and which of them will not be written.
    in-out property <string> minecraft-raw-options;
    in-out property <string> minecraft-raw-problems;
    // Whether the custom lines are shown in place of the settings tabs.
    in-out property <bool> minecraft-raw-open: false;
    // A save started from each settings group and not yet finished. The
    // group's Save and Reset buttons stay disabled until it is.
    in-out property <bool> java-saving: false;
    in-out property <bool> storage-root-saving: false;
    in-out property <bool> microsoft-client-id-saving: false;
    in-out property <bool> user-agent-saving: false;
    in-out property <bool> artifact-cache-limit-saving: false;
    in-out property <[PendingEntityRow]> pending-instances;
    in-out property <[PendingEntityRow]> pending-servers;
    // Every instance's pending linked server, for the overview, which
    // places each one against the card whose id it names.
    in-out property <[PendingEntityRow]> linked-pending-servers;
    // One viewer per Logs or Console pane, indexed by the pane's `log`.
    in-out property <[LogView]> log-views;
    in-out property <string> instance-filter: "all";
    // The instance list's other filters, as positions in the option lists
    // the controller writes. Position 0 of each is "any".
    in-out property <bool> instance-favorites-only: false;
    in-out property <bool> instance-filters-open: false;
    in-out property <[string]> instance-minecraft-options;
    in-out property <int> instance-minecraft-index: 0;
    in-out property <[string]> instance-loader-options;
    in-out property <int> instance-loader-index: 0;
    in-out property <[string]> instance-run-options;
    in-out property <int> instance-run-index: 0;
    in-out property <[string]> instance-linking-options;
    in-out property <int> instance-linking-index: 0;
    in-out property <[string]> instance-group-options;
    in-out property <int> instance-group-index: 0;
    in-out property <[string]> instance-sort-options;
    in-out property <int> instance-sort-index: 0;
    // Every group, and "no group" followed by their names for a group choice.
    in-out property <[GroupRow]> instance-groups;
    // The same groups as menu rows, for the instance card menu.
    in-out property <[MenuRow]> instance-group-entries;
    // How many instances exist, and how many conditions narrow the list.
    in-out property <int> instance-total: 0;
    in-out property <int> instance-filters-active: 0;
    in-out property <string> pane-host-query;
    function clear-instance-filters() {
        root.instance-filter = "all";
        root.list-query = "";
        root.instance-favorites-only = false;
        root.instance-minecraft-index = 0;
        root.instance-loader-index = 0;
        root.instance-run-index = 0;
        root.instance-linking-index = 0;
        root.instance-group-index = 0;
        root.instance-view-changed();
    }
    // How many results one Search or one Load More aims to put on screen.
    // Not a provider page size: a provider is asked in pages of at most
    // what one request may take, and a larger choice is filled by asking
    // again.
    in-out property <int> mod-page-size: 10;
    // The same number as the picker spells it. Kept beside the count
    // because a combo box selects by its own text and the fill arithmetic
    // needs a number.
    in-out property <string> mod-page-size-label: "10";
    in-out property <[string]> mod-page-sizes: ["10", "25", "50", "100"];
    // Which Settings page is open.
    in-out property <string> settings-tab: "General";
    // Whether the host panes are on screen instead of Home.
    in-out property <bool> workspace-open: false;
    // The workspace's panes, in reading order, and the host each one shows.
    in-out property <[WorkspacePaneRow]> workspace-panes;
    in-out property <bool> quick-view-fullscreen;
    // Which host view the Add mods dialog searches for.
    in-out property <int> add-mods-host: -1;
    in-out property <bool> quick-view-open;
    callback open-quick-view(string, string);
    callback close-quick-view();
    callback open-quick-view-as-page();
    in-out property <[HostView]> host-views;
    in-out property <string> workspace-back-label;
    // What the host picker offers: every client, running ones first, and
    // the servers the list shows, running ones first.
    in-out property <[WorkspaceHostChoice]> workspace-client-choices;
    in-out property <[WorkspaceHostChoice]> workspace-server-choices;
    // The pane the host picker is choosing for, and the host it shows now.
    in-out property <int> pane-host-picker-pane;
    in-out property <string> pane-host-picker-kind;
    in-out property <string> pane-host-picker-id;
    // Whether a file from the desktop is being held over the window. Set
    // only while the drop would be accepted, so the highlight never
    // promises something a release would not do.
    in-out property <bool> file-drop-active: false;
    // What releasing would do: "import" or "mods". A drop has no cursor
    // position, so the overlay is the only thing that can say which.
    in-out property <string> file-drop-kind: "import";
    in-out property <string> modal: "";
    in-out property <string> modal-error;
    in-out property <bool> loading: true;
    // Why the background service is not running, shown in the window for as
    // long as it is down. Empty while it is running.
    in-out property <string> startup-error;
    in-out property <string> storage-root;
    in-out property <string> app-version;
    in-out property <string> license-text;
    // The software Ephervex is built on, read from this build's own
    // generated inventory.
    in-out property <[LicenseRow]> third-party-packages;
    in-out property <string> third-party-summary;
    // Set only when this build's own list could not be read.
    in-out property <string> third-party-error;
    // Which package's license is open, or -1 for the list itself.
    in-out property <int> third-party-open: -1;
    in-out property <[ToastRow]> toasts;
    in-out property <string> pending-action-id;
    in-out property <string> pending-action-name;
    // The settings that pin the runtime the removal confirmation names.
    in-out property <string> pending-java-pinning;
    in-out property <bool> pending-java-pins-known: true;
    // How many servers go with the instance the delete dialog is about, so
    // "Delete Files" is never a surprise.
    in-out property <int> pending-action-linked-servers: 0;
    // How many of them can be stopped, so the dialog can say it stops them.
    in-out property <int> pending-action-stoppable-linked-servers: 0;
    // How many of them may be running where Ephervex cannot stop them, which the deletion refuses.
    in-out property <int> pending-action-unstoppable-linked-servers: 0;
    // A server Ephervex cannot stop makes the core refuse, so the dialog stops nothing then.
    property <bool> pending-deletion-stops-servers: root.pending-action-stoppable-linked-servers > 0 && root.pending-action-unstoppable-linked-servers == 0;
    in-out property <string> pending-snapshot-deletion-note;
    // "client" or "server", for the dialogs that serve both.
    in-out property <string> pending-action-kind;
    // What the rename field holds. Seeded with the current name, which is
    // the value being edited rather than a suggestion.
    in-out property <string> pending-rename-text;
    in-out property <string> mod-plan-instance;
    in-out property <string> mod-plan-provider;
    in-out property <string> mod-plan-project;
    // The exact release the confirmation showed, which is the release
    // installing it asks for. A newer one published since must not take its
    // place, here or on any selected server.
    in-out property <string> mod-plan-version-id;
    in-out property <string> mod-plan-title;
    in-out property <string> mod-plan-version;
    in-out property <int> mod-plan-install-count;
    in-out property <int> mod-plan-dependency-count;
    in-out property <int> mod-plan-optional-count;
    in-out property <int> mod-plan-existing-count;
    in-out property <int> mod-plan-warning-count;
    // "client" or "server": which kind of host the confirmation installs onto.
    in-out property <string> mod-plan-kind: "client";
    // For a server, the mods whose catalog never stated server support, by
    // name for the dialog and by project id for the confirmation it sends.
    in-out property <[string]> mod-plan-unstated;
    in-out property <[string]> mod-plan-unstated-ids;
    // The required dependencies a server takes although the catalog says they
    // do not run on one, one sentence each.
    in-out property <[string]> mod-plan-client-only;
    // Set while the server runs: the change waits for its next start.
    in-out property <string> mod-plan-restart-note;
    property <length> mod-plan-extra: (root.mod-plan-unstated.length * 24px + root.mod-plan-client-only.length * 64px + (root.mod-plan-restart-note != "" ? 44px : 0px) + (root.mod-plan-unstated.length > 0 ? 44px : 0px)) * Theme.text-scale;

    // Dialog form state.
    // What the user typed, which is empty until they type. The launcher's
    // own suggestion is shown as the placeholder beside it and is what a
    // field left empty means, so a suggestion can never go stale against
    // the release and loader actually selected.
    in-out property <string> create-name;
    in-out property <string> create-name-suggestion;
    in-out property <[string]> minecraft-releases;
    // The releases pinned to the front of every version list, in the order
    // the user recorded them.
    in-out property <[string]> favorite-minecraft-versions;
    // Whether the release the New Instance dialog currently offers is one
    // of them. Kept as its own value because Slint cannot ask a model
    // whether it contains something.
    in-out property <bool> create-minecraft-favorite: false;
    in-out property <[string]> create-loader-versions;
    in-out property <[string]> create-server-loader-versions;
    in-out property <string> create-minecraft;
    in-out property <string> create-loader: "Vanilla";
    // The loaders offered for the release currently selected. Narrowed in
    // Rust rather than written out here, because which loader ever existed
    // for a Minecraft release is a fact `ephervex-core` owns.
    in-out property <[string]> create-loaders: ["Vanilla", "Forge", "NeoForge"];
    in-out property <string> create-loader-version;
    in-out property <bool> create-persistent: false;
    // The issue the new instance reproduces, and whether to build a server
    // linked to it and under which name (empty for the suggested one).
    in-out property <string> create-issue-link;
    in-out property <bool> create-linked-server: false;
    in-out property <string> create-linked-server-name;
    // Published server files for that server, as a path and the name shown.
    in-out property <string> create-instance-server-pack;
    in-out property <string> create-instance-server-pack-name;
    in-out property <string> import-path;
    in-out property <string> import-name;
    // Whether the import should also leave a server behind. Off by
    // default: most imports are opened to reproduce a client.
    in-out property <bool> import-create-server: false;
    // "idle" | "analyzing" | "resolving" | "ready" | "failed" | "submitting".
    // Drives which part of the import modal is visible and whether the
    // archive picker and the Import button are enabled.
    in-out property <string> import-status-kind: "idle";
    in-out property <string> import-format;
    // Pre-composed, already-localized lines: the modal displays them as
    // plain text and does not itself run any of this through GuiI18n.
    in-out property <string> import-pack-header;
    in-out property <string> import-author-line;
    in-out property <string> import-minecraft-line;
    in-out property <string> import-loader-line;
    in-out property <string> import-required-line;
    in-out property <string> import-optional-line;
    in-out property <[ImportOptionRow]> import-optional-items;
    in-out property <[BlockedFileRow]> import-blocked-items;
    in-out property <[ImportDuplicateRow]> import-duplicate-items;
    // Whether the current archive has a successful, fully resolved
    // analysis: the only condition the Import button's `enabled` needs.
    in-out property <bool> import-ready;
    // "missing-credential" | "rejected-credential" | "file-unavailable" |
    // "distribution-restricted" | "malformed-pack" | "unsupported-loader"
    // | "other". Classified from the core error's stable id (never from
    // `modal-error`'s text), and only consulted while `import-status-kind`
    // is "failed": it decides whether the modal offers a state-specific
    // affordance alongside the error text.
    in-out property <string> import-error-kind: "other";
    in-out property <string> create-server-client-id;
    in-out property <string> create-server-name;
    // What the name field shows when it is empty, and what an untouched
    // dialog creates. A client's default name with "Server" after it: a
    // linked server borrows the client's own name, a standalone one is
    // named for its exact target the same way a new instance is.
    in-out property <string> create-server-name-suggestion;
    // Filters one host's mod list: (kind, id, query). Filtering happens in
    // Rust so the list a `for` builds is only the rows that match, which is
    // also what keeps a large pack from laying out every card to show three.
    callback filter-mods(string, string, string);
    in-out property <string> create-server-minecraft;
    in-out property <string> create-server-loader: "Vanilla";
    in-out property <[string]> create-server-loaders: ["Vanilla", "Forge", "NeoForge"];
    in-out property <string> create-server-loader-version;
    in-out property <bool> create-server-persistent: false;
    // The port a new server is offered, chosen in Settings.
    in-out property <bool> default-server-port-custom: false;
    in-out property <string> default-server-port: "25565";
    // What is stored, which the choice goes back to when a save is refused.
    in-out property <bool> stored-server-port-custom: false;
    in-out property <string> stored-server-port: "25565";
    // The field is being typed in, so a refreshed value does not replace it.
    in-out property <bool> default-server-port-editing: false;
    callback save-server-port-default(bool, string);
    in-out property <bool> create-server-automatic-port: true;
    // Whether a new server checks players against Mojang accounts by default.
    in-out property <bool> default-server-online: false;
    // The linked server asked for in the New Instance dialog: its port, empty
    // for one chosen on creation, and whether it checks players.
    in-out property <string> create-linked-port;
    in-out property <bool> create-linked-online: root.default-server-online;
    // The New Server dialog's account check, and the instance it is linked to:
    // the choices (Standalone first), their ids, and which one is chosen.
    in-out property <bool> create-server-online: root.default-server-online;
    in-out property <[string]> server-link-labels: [GuiI18n.text("gui-standalone")];
    in-out property <[string]> server-link-ids: [""];
    in-out property <int> create-server-link-index: 0;
    // Where an instance is among the choices above, 0 when it is not.
    pure callback server-link-index(string) -> int;
    in-out property <string> create-server-port: "";
    // The archive a server's content comes from, empty when the server is
    // built the usual way. Holds the full path because that is what the
    // backend needs; the modal shows only the file name.
    in-out property <string> create-server-pack;
    in-out property <string> create-server-pack-name;
    // What the chosen archive's entry names say it was made for, each empty
    // when they do not say, and the note telling the user where any value the
    // dialog filled in came from. Meaningful only while an archive is chosen.
    in-out property <bool> create-server-pack-mods;
    in-out property <string> create-server-pack-minecraft;
    in-out property <string> create-server-pack-loader;
    in-out property <string> create-server-pack-loader-version;
    in-out property <string> create-server-pack-note;
    // How a standalone selection disagrees with its archive; empty when it
    // agrees or no archive is chosen.
    property <string> create-server-pack-conflict: root.create-server-client-id == "" && root.create-server-pack != "" ? ServerPackRules.conflict(root.create-server-minecraft, root.create-server-loader, root.create-server-loader-version, root.create-server-pack-minecraft, root.create-server-pack-loader, root.create-server-pack-loader-version, root.create-server-pack-mods) : "";
    // The same choice for the server an import builds alongside its client.
    // Separate from the create-server dialog's, because both can be open in
    // one session and neither is the other's default.
    in-out property <string> import-server-pack;
    in-out property <string> import-server-pack-name;
    in-out property <bool> eula-accepted;
    in-out property <string> eula-status;
    in-out property <string> offline-account-name;
    in-out property <string> microsoft-client-id;
    in-out property <string> effective-microsoft-client-id;
    in-out property <bool> microsoft-client-id-is-custom;
    in-out property <string> user-agent;
    in-out property <string> effective-user-agent;
    in-out property <bool> user-agent-is-custom;
    // Whether the user stored their own CurseForge API key in the
    // keyring. The only thing the view is told about it: there is no
    // property the value could arrive in, so no snapshot can push a
    // stored secret back into the window.
    in-out property <bool> curseforge-key-configured;
    // Whether this build's baked-in fallback key is in effect because the
    // user has not configured their own (ADR 0030).
    in-out property <bool> curseforge-key-default-in-use;
    // Whether this build carries a key of its own at all, which is what
    // decides whether having none configured is a state to warn about.
    in-out property <bool> curseforge-build-key-available;
    // What the user is typing right now, and nothing else. Cleared on
    // submit and never written from a snapshot.
    in-out property <string> curseforge-api-key;
    // Which catalog the mod browser opens on, as the settings file records
    // it. Written only from a snapshot of what is stored, so a refused save
    // leaves the previous choice selected rather than the attempted one.
    in-out property <string> default-mod-catalog;
    // The recorded name exactly as stored, shown when it is a catalog this
    // build cannot resolve.
    in-out property <string> configured-mod-catalog;
    in-out property <bool> default-mod-catalog-is-custom;
    in-out property <string> persistent-root;
    in-out property <string> default-persistent-root;
    in-out property <bool> persistent-root-is-custom;
    in-out property <[string]> watched-download-folders;
    in-out property <[string]> artifact-cache-limit-labels;
    in-out property <int> artifact-cache-limit-index;
    // Which entry in the list above is Custom. Held rather than hardcoded so
    // adding a preset cannot silently move the size box onto another entry.
    in-out property <int> artifact-cache-custom-index: -1;
    in-out property <[string]> artifact-cache-units;
    in-out property <string> artifact-cache-custom-value;
    in-out property <string> artifact-cache-custom-unit;
    in-out property <string> artifact-cache-used;
    in-out property <string> artifact-cache-total;
    // False until the cache has actually been measured, so the usage line
    // shows that it is loading rather than claiming the cache is empty.
    in-out property <bool> artifact-cache-usage-known;
    in-out property <bool> artifact-cache-usage-exact: true;
    in-out property <bool> artifact-cache-over-budget;
    // How much of the budget is used, from 0 to 1, and whether there is no
    // budget. Meaningful once the usage is known.
    in-out property <float> artifact-cache-fill;
    in-out property <bool> artifact-cache-unlimited;
    // The cache could not be measured, so there is nothing to show yet.
    in-out property <bool> artifact-cache-unreadable;
    in-out property <int> application-text-scale: 100;
    in-out property <int> technical-text-size: 12;
    // The chosen theme by its recorded name, and the theme list: labels to
    // show, recorded names in the same order, and where the choice sits.
    in-out property <string> application-theme: "workbench";
    in-out property <[string]> theme-labels: [GuiI18n.text("gui-color-scheme-light")];
    in-out property <[string]> theme-ids: ["workbench"];
    in-out property <int> theme-index: 0;
    // One entry per theme in the list: the colors that theme paints a page with.
    in-out property <[ThemeSwatch]> theme-swatches;
    // Whether a season is on today, which is when its switch is offered.
    in-out property <bool> seasonal-theme-in-season: false;
    // Whether a season's theme may stand in for Dark or Light, the name of
    // the theme painted now, and what the page says while a season's theme
    // is shown. Written from the stored value only.
    in-out property <bool> seasonal-themes: true;
    in-out property <string> shown-theme: "dark";
    in-out property <string> seasonal-theme-note;
    // Where theme files go, and what was wrong with the ones found there.
    in-out property <string> themes-folder;
    in-out property <[string]> theme-problems;
    in-out property <string> java-memory-min: "512";
    in-out property <string> java-memory-max: "4096";
    in-out property <string> java-preferred-path;
    // What probing the preferred executable found, and whether it is a runtime.
    in-out property <string> java-path-verdict;
    in-out property <bool> java-path-verdict-ok;
    in-out property <bool> java-path-checking;
    in-out property <bool> java-auto-detect: true;
    in-out property <bool> java-auto-download: true;
    in-out property <bool> show-linked-servers: false;
    // Whether a mod change acts on the mods its relations name, and
    // whether it stops to be confirmed when it does. Both written from the
    // stored value, never from the click, so a save that fails leaves the
    // switch showing what is actually recorded.
    in-out property <bool> follow-mod-dependencies: true;
    in-out property <bool> warn-on-dependency-impact: true;
    in-out property <bool> make-default-account-operator: true;
    in-out property <int> operator-permission-level: 4;

    callback refresh();
    callback instance-view-changed();
    callback choose-instance-sort(int);
    callback pane-host-query-changed();
    callback set-favorite(string, string, bool);
    // An instance's case: its id, then what changed.
    callback case-add-step(string, string);
    callback case-set-step-done(string, int, bool);
    callback case-remove-step(string, int);
    callback case-save-note(string, string);
    callback case-count-reproduced(string);
    callback case-reset-reproduced(string);
    // An instance's issue link: its id and the link to store (empty clears),
    // and a link to open in the browser.
    callback set-issue-link(string, string);
    callback open-issue-link(string);
    callback set-client-group(string, string);
    callback delete-group(string);
    callback pick-host-icon(string, string);
    callback clear-host-icon(string, string);
    callback request-version-catalog();
    callback warm-language-catalog(string);
    callback request-loader-catalog(string, string, string);
    callback minecraft-selection-changed(string, string);
    callback toggle-favorite-version(string);
    callback remove-favorite-version(string);
    callback launch-client(string);
    // Launches one instance as a named account, for this launch only.
    // Launches one instance as a named account, for this launch only. The
    // last argument asks for a second client alongside one already running.
    callback launch-client-as(string, string, bool);
    // The instance, and which of its launches to stop. An instance can hold
    // more than one, and stopping should reach only the one asked for.
    callback kill-instance(string, string);
    callback launch-and-connect(string, string);
    // (client, server, start together): pairs a client with one of its
    // linked servers, or changes whether the pair starts together.
    callback set-linked-pair(string, string, bool);
    callback clear-linked-pair(string);
    callback open-client-folder(string);
    callback open-server-folder(string);
    callback open-server-location(string, string);
    // Making a temporary instance persistent. The destination and the
    // servers are read before the dialog opens, so the user decides with
    // the list in front of them rather than after the fact.
    in-out property <string> promote-instance-name;
    in-out property <string> promote-destination;
    in-out property <[PromoteServerRow]> promote-servers;
    // A modpack a web page offered through an ephervex:// link. The
    // address is held so the answer can be sent back with it, and shown
    // with its query removed so a prompt never prints a token.
    in-out property <string> pack-link-url;
    in-out property <string> pack-link-display;
    // The host the open question is about, sent back with the answer.
    in-out property <string> pack-link-host;
    // The download was redirected to the address shown, off the link's own site.
    in-out property <bool> pack-link-redirected;
    in-out property <bool> pack-link-remember: true;
    callback open-pack-link(string, string, bool);
    // The window's number for the newest link request it sent. Events and
    // cancellations name the request they are about, so one from an older
    // request is ignored.
    in-out property <int> pack-link-generation;
    // The newest request is waiting on its download: the dialog shows that and
    // offers Cancel instead of the question.
    in-out property <bool> pack-link-downloading;
    // Stop that download. Every way out of the dialog calls this first.
    callback cancel-pack-link();
    // A link this process was started for, or one a later launch handed
    // over. Asking is still the backend's decision, not this call's.
    callback deliver-pack-link(string);
    // The sites agreed to serve modpacks. Granting happens in the link
    // dialog; this is where it is seen and taken back.
    in-out property <[string]> trusted-pack-hosts;
    callback forget-pack-host(string);
    callback open-make-persistent(string);
    callback submit-make-persistent(string);
    callback duplicate-client(string);
    // Duplicating may have a question to ask first, so `duplicate-client`
    // starts it and this finishes it once the answer is in.
    callback duplicate-client-deciding(string, bool);
    callback rename-entity(string, string, string);
    callback delete-hand-placed-mod(string, string, string);
    callback pick-local-mods(string, string);
    // "overwrite", "skip", "overwrite-all" or "skip-all".
    callback resolve-mod-clash(string);
    // Instance id, whether its files are deleted, and whether running linked servers are stopped first.
    callback delete-client(string, bool, bool);
    callback delete-server(string, bool);
    callback repair-server(string);
    // (kind, id, minimum memory, maximum memory, arguments)
    callback save-host-runtime(string, string, string, string, string);
    // A host's Java: read it, choose a runtime for review, check a path the
    // user typed, or install the runtime the host expects.
    callback load-host-java(string, string);
    callback choose-host-java(string, string, string);
    callback check-host-java-path(string, string, string);
    callback install-host-java(string, string);
    callback clear-host-runtime(string, string);
    // (kind, id, allow)
    callback set-allow-pack-mod-version-changes(string, string, bool);
    callback load-instance-workspace(string);
    // Opens the workspace on one host and surface: (kind, id, surface).
    callback open-workspace(string, string, string);
    callback close-workspace();
    // Back from the workspace header: to the host it was followed from, or out.
    callback workspace-back();
    // (pane, surface)
    callback show-pane-surface(int, string);
    // Points a pane at another host, as a link inside it does: (pane, kind, id, surface).
    callback follow-host(int, string, string, string);
    // Shows a pane's paired host without changing any pane: (pane, kind, id).
    callback show-linked-pair(int, string, string);
    // Adds a pane beside or below the pane, showing its host.
    callback split-pane-beside(int);
    callback split-pane-below(int);
    callback close-pane(int);
    // Points a pane at the host its picker chose: (pane, kind, id).
    callback choose-pane-host(int, string, string);
    callback search-mods(string, string, string, string);
    callback load-more-mods(string, string, string, string, int);
    // (instance, catalog)
    callback switch-mod-catalog(string, string, string);
    callback set-mod-include-incompatible(string, string, bool);
    callback install-from-browser(string, string, string, string);
    // Like the browser's install, but the plan is always confirmed first:
    // (instance, catalog, project).
    callback install-from-diagnostics(string, string, string, string);
    // The user closed a browser install's confirmation. The queue behind it
    // has to hear that, or the next queued install never starts.
    callback abandon-browser-install();
    callback set-mod-page-size(string);
    // The host whose card to bring into view when `reveal-token` changes.
    // A counter rather than a function, because the list only exists while
    // there is one to show and a name inside a conditional cannot be
    // reached from here.
    in-out property <string> reveal-host-id;
    in-out property <int> reveal-token: 0;
    // The instance still waiting to be scrolled to, if any. An id rather
    // than a flag: a card's position is only known once the list holding it
    // has arrived, and by then the request has to still name what it was
    // for.
    in-out property <string> pending-reveal-instance;
    callback install-mod(string, string, string, string);
    callback install-server-mod(string, string, string, string, [string]);
    callback submit-create-instance(string, string, string, string, bool, string, bool, string, string, string, bool);
