    callback minecraft-set-window-lock(string, bool);
    callback minecraft-open-window-preview(string);
    callback minecraft-commit-text(string, string);
    callback minecraft-forget-preference(string);
    callback minecraft-begin-capture(string);
    callback minecraft-cancel-capture();
    callback minecraft-captured-key(string, string);
    callback minecraft-captured-mouse(string, string);
    callback minecraft-retry-languages();
    callback minecraft-save-defaults();
    callback minecraft-discard-defaults();
    callback cancel-operation(string);
    callback present-toast(string, bool);
    callback dismiss-toast(int);

    // Leaving the page that shows the capturing row destroys it without the
    // row ever losing focus, so the capture ends here.
    changed settings-tab => {
        if (self.minecraft-capturing-id != "") { self.minecraft-cancel-capture(); }
    }
    changed page => {
        if (self.minecraft-capturing-id != "") { self.minecraft-cancel-capture(); }
    }
    changed create-minecraft => {
        if root.create-minecraft != "" {
            root.warm-language-catalog(root.create-minecraft);
        }
    }
    // Focus goes into a dialog when it opens, and is kept there by the edges
    // below, so the page behind it cannot be tabbed to and pressed.
    changed modal => {
        if root.modal != "" {
            dialog-start.focus();
        }
    }
    changed create-server-minecraft => {
        if root.create-server-minecraft != "" {
            root.warm-language-catalog(root.create-server-minecraft);
        }
    }

    // Where Tab begins when nothing has focus, which with a dialog open must
    // be the dialog.
    FocusEdge { active: root.modal != ""; reached => { dialog-start.focus(); } }

    VerticalLayout {
        spacing: 0px;
        min-width: 980px;
        preferred-width: 1480px;
        min-height: 680px;
        preferred-height: 900px;
        // Application header.
        Rectangle {
            min-height: 68px;
            max-height: 68px;
            background: Theme.bar;
            border-width: 1px;
            border-color: Theme.border;
            HorizontalLayout {
                // No `alignment`: under anything but the default, every cell
                // is given its preferred size, which collapses the spacer
                // below to nothing and centers the whole bar as one block.
                cross-axis-alignment: center;
                padding-left: 20px; padding-right: 20px; spacing: 14px;
                Image { source: root.logo; width: 32px; height: 32px; image-fit: contain; accessible-label: GuiI18n.text("gui-logo-accessible"); }
                Heading { text: "Ephervex"; font-size: Theme.brand-size; }
                Rectangle { horizontal-stretch: 1; }
                if root.page == 0 && !root.workspace-open : AppButton { text: GuiI18n.text("gui-import-modpack"); clicked => { root.open-import-modal(); } }
                if root.page == 0 && !root.workspace-open : AppButton { text: GuiI18n.text("gui-new-instance"); tone: "primary"; min-width: 148px; clicked => { root.open-create-instance-modal(); } }
                if root.page == 1 && !root.workspace-open : AppButton { text: GuiI18n.text("gui-new-server"); tone: "primary"; min-width: 130px; clicked => { root.create-server-client-id = ""; root.create-server-name = ""; root.recompute-create-server-name(); root.modal-error = ""; root.request-version-catalog(); root.warm-language-catalog(root.create-server-minecraft); root.create-server-pack = ""; root.create-server-pack-name = ""; root.modal = "create-server"; } }
                IconButton { icon: @image-url("../../../assets/icons/refresh.svg"); accessible-name: GuiI18n.text("gui-refresh"); clicked => { root.refresh(); } }
            }
        }

        HorizontalLayout {
            spacing: 0px;
            // Primary navigation.
            Rectangle {
                width: Theme.sidebar-width;
                background: Theme.bar;
                border-width: 1px;
                border-color: Theme.border;
                VerticalLayout {
                    padding: 14px; spacing: 8px;
                    NavItem { icon: @image-url("../../../assets/icons/nav-instances.svg"); label: GuiI18n.text("gui-instances"); selected: root.page == 0; clicked => { root.close-workspace(); root.page = 0; } }
                    NavItem { icon: @image-url("../../../assets/icons/nav-servers.svg"); label: GuiI18n.text("gui-servers"); selected: root.page == 1; clicked => { root.close-workspace(); root.page = 1; } }
                    NavItem { icon: @image-url("../../../assets/icons/nav-logs.svg"); label: GuiI18n.text("gui-running"); selected: root.page == 2; clicked => { root.close-workspace(); root.page = 2; root.load-running(); } }
                    NavItem { icon: @image-url("../../../assets/icons/nav-activity.svg"); label: GuiI18n.text("gui-activity"); selected: root.page == 3; clicked => { root.close-workspace(); root.page = 3; } }
                    NavItem { icon: @image-url("../../../assets/icons/nav-settings.svg"); label: GuiI18n.text("gui-settings"); selected: root.page == 4; clicked => { root.close-workspace(); root.page = 4; root.settings-tab = "General"; } }
                    Rectangle { vertical-stretch: 1; }
                    BodyText { text: GuiI18n.text("gui-tagline"); color: Theme.text-muted; font-size: Theme.caption-size; wrap: word-wrap; }
                }
            }

            // One container for every page body, always present and
            // always claiming the space beside the sidebar.
            //
            // A conditional child contributes no layout information of
            // its own, so a page that asked to stretch was given only
            // the width its content preferred. That is why an instance
            // workspace collapsed into a column whenever the open tab
            // happened to be a narrow one.
            Rectangle {
                horizontal-stretch: 1;
                background: Theme.background;

                // Instances list and inspector.
                if root.page == 0 && !root.workspace-open : HorizontalLayout {
                    spacing: 0px;
                    horizontal-stretch: 1;
                    Rectangle {
                        horizontal-stretch: 1;
                        background: Theme.background;
                        VerticalLayout {
                            padding: 24px; spacing: 18px;
                            HorizontalLayout {
                                PageIntro { title: GuiI18n.text("gui-instances"); subtitle: GuiI18n.text("gui-instances-detail"); }
                                // No count until there is a list to count. A
                                // list that loaded before the service went
                                // away still has one.
                                if !root.loading && (root.startup-error == "" || root.instance-total > 0) : BodyText { text: root.instance-filters-active > 0 ? GuiI18n.values("gui-instances-shown-of-total", "" + root.instances.length, "" + root.instance-total) : GuiI18n.count("gui-client-instances-count", root.instances.length); color: Theme.text-muted; }
                            }
                            // The layout's own padding is its inset, so the
                            // card is exactly as tall as what it holds.
                            Rectangle {
                                height: filter-bar.preferred-height; border-radius: 8px; border-width: 1px; border-color: Theme.border; background: Theme.surface;
                                filter-bar := VerticalLayout {
                                    padding: 10px; spacing: 12px;
                                    HorizontalLayout {
                                        cross-axis-alignment: center; spacing: 8px;
                                        AppButton { text: GuiI18n.text("gui-all"); tone: root.instance-filter == "all" ? "primary" : "secondary"; min-width: 70px; clicked => { root.instance-filter = "all"; root.instance-view-changed(); } }
                                        AppButton { text: GuiI18n.text("gui-temporary"); tone: root.instance-filter == "temporary" ? "primary" : "secondary"; clicked => { root.instance-filter = "temporary"; root.instance-view-changed(); } }
                                        AppButton { text: GuiI18n.text("gui-persistent"); tone: root.instance-filter == "persistent" ? "primary" : "secondary"; clicked => { root.instance-filter = "persistent"; root.instance-view-changed(); } }
                                        // Favorites narrows whichever of the three is
                                        // chosen, so it stands apart from them.
                                        Rectangle { width: 1px; height: Theme.control-height - 12px; background: Theme.border; }
                                        AppButton { text: GuiI18n.text("gui-favorites"); accessible-name: GuiI18n.text("gui-favorites-only"); tone: root.instance-favorites-only ? "primary" : "secondary"; clicked => { root.instance-favorites-only = !root.instance-favorites-only; root.instance-view-changed(); } }
                                        Rectangle { horizontal-stretch: 1; }
                                        if root.instance-filters-active > 0 : AppButton { text: GuiI18n.text("gui-clear-filters"); clicked => { root.clear-instance-filters(); } }
                                        AppButton { text: GuiI18n.text("gui-groups"); clicked => { root.modal-error = ""; root.modal = "groups"; } }
                                        AppButton { text: root.panel-filters > 0 ? GuiI18n.value("gui-more-filters-active", "" + root.panel-filters) : GuiI18n.text("gui-more-filters"); tone: root.instance-filters-open || root.panel-filters > 0 ? "primary" : "secondary"; clicked => { root.instance-filters-open = !root.instance-filters-open; } }
                                        TextField { text <=> root.instance-query; placeholder: GuiI18n.text("gui-filter-instances"); input-type: InputType.search; width: 240px; edited(text) => { root.instance-view-changed(); } accepted => { root.instance-view-changed(); } }
                                    }
                                    // Two rows of three equal columns, each named
                                    // above its choice, so what narrows the list and
                                    // what orders it read as separate settings.
                                    if root.instance-filters-open : GridLayout {
                                        spacing-horizontal: 12px; spacing-vertical: 12px;
                                        Row {
                                            LabeledChoice { caption: GuiI18n.text("gui-minecraft-version"); label: GuiI18n.text("gui-filter-minecraft-version"); model: root.instance-minecraft-options; index: root.instance-minecraft-index; selected(index) => { root.instance-minecraft-index = index; root.instance-view-changed(); } }
                                            LabeledChoice { caption: GuiI18n.text("gui-loader"); label: GuiI18n.text("gui-filter-loader"); model: root.instance-loader-options; index: root.instance-loader-index; selected(index) => { root.instance-loader-index = index; root.instance-view-changed(); } }
                                            LabeledChoice { caption: GuiI18n.text("gui-running-state"); label: GuiI18n.text("gui-filter-run-state"); model: root.instance-run-options; index: root.instance-run-index; selected(index) => { root.instance-run-index = index; root.instance-view-changed(); } }
                                        }
                                        Row {
                                            LabeledChoice { caption: GuiI18n.text("gui-linked-servers"); label: GuiI18n.text("gui-filter-linking"); model: root.instance-linking-options; index: root.instance-linking-index; selected(index) => { root.instance-linking-index = index; root.instance-view-changed(); } }
                                            LabeledChoice { caption: GuiI18n.text("gui-group"); label: GuiI18n.text("gui-filter-group"); model: root.instance-group-options; index: root.instance-group-index; selected(index) => { root.instance-group-index = index; root.instance-view-changed(); } }
                                            LabeledChoice { caption: GuiI18n.text("gui-sort-caption"); label: GuiI18n.text("gui-sort-by"); model: root.instance-sort-options; index: root.instance-sort-index; selected(index) => { root.instance-sort-index = index; root.choose-instance-sort(index); } }
                                        }
                                    }
                                }
                            }
                            if root.loading && root.startup-error == "" : LoadingState { text: GuiI18n.text("gui-loading-instances"); }
                            // With the service down nothing else takes the
                            // page's height, and the header and filter bar
                            // would be spread down it.
                            if root.startup-error != "" && (root.loading || (root.instances.length == 0 && root.pending-instances.length == 0)) : Rectangle { vertical-stretch: 1; }
                            if !root.loading && root.startup-error == "" && root.instance-total == 0 && root.instances.length == 0 && root.pending-instances.length == 0 : EmptyState {
                                title: GuiI18n.text("gui-no-client-instances");
                                message: GuiI18n.text("gui-no-client-instances-detail");
                                primary-text: GuiI18n.text("gui-modal-new-instance"); secondary-text: GuiI18n.text("gui-import-modpack");
                                primary => { root.open-create-instance-modal(); }
                                secondary => { root.open-import-modal(); }
                            }
                            if !root.loading && root.startup-error == "" && root.instance-total > 0 && root.instances.length == 0 && root.pending-instances.length == 0 : EmptyState {
                                title: GuiI18n.text("gui-no-matching-instances");
                                message: GuiI18n.text("gui-no-matching-instances-detail");
                                primary-text: GuiI18n.text("gui-clear-filters");
                                primary => { root.clear-instance-filters(); }
                            }
                            if !root.loading && (root.instances.length > 0 || root.pending-instances.length > 0) : instance-scroll := ScrollView {
                                viewport-width: self.width;
                                // Cards and the gap between them are fixed,
                                // so where one sits is arithmetic rather
                                // than a query into the list.
                                private property <int> observed-reveal: root.reveal-selected-instance;
                                changed observed-reveal => {
                                    if root.selected-instance-index >= 0 {
                                        instance-scroll.viewport-y = max(
                                            min(0px, instance-scroll.visible-height - instance-scroll.viewport-height),
                                            -1 * (root.pending-instances.length + root.selected-instance-index) * (Theme.card-height + Theme.card-gap));
                                    }
                                }
                                VerticalLayout {
                                    spacing: Theme.card-gap;
                                    for pending in root.pending-instances : PendingCard { item: pending; }
                                    for item[index] in root.instances : VerticalLayout {
                                    InstanceCard {
                                        item: item;
                                        group-entries: root.instance-group-entries;
                                        toggle-favorite(id, favorite) => { root.set-favorite("client", id, favorite); }
                                        set-group(id, group) => { root.set-client-group(id, group); }
                                        new-group(id) => { root.pending-action-kind = "new-group"; root.pending-action-id = id; root.pending-rename-text = ""; root.modal-error = ""; root.modal = "rename"; }
                                        pick-icon(id) => { root.pick-host-icon("client", id); }
                                        clear-icon(id) => { root.clear-host-icon("client", id); }
                                        selected: item.id == root.selected-instance-id;
                                        choose(id) => { root.selected-instance-id = id; root.select-instance(id); }
                                        launch(id) => { root.launch-client(id); }
                                        kill(id) => { root.kill-instance(id, ""); }
                                        open-workspace(id) => { root.selected-instance-id = id; root.selected-instance-index = index; root.select-instance(id); root.open-workspace("client", id, "Overview"); }
                                        open-folder(id) => { root.open-client-folder(id); }
                                        create-server(id, name) => { root.create-server-client-id = id; root.create-server-name = ""; root.create-server-name-suggestion = NameRules.linked-server-name(name); root.create-server-pack = ""; root.create-server-pack-name = ""; root.modal = "create-server"; }
                                        duplicate(id) => { root.duplicate-client(id); }
                                        make-persistent(id) => { root.open-make-persistent(id); }
                                        rename(id, name) => { root.pending-action-kind = "client"; root.pending-action-id = id; root.pending-rename-text = name; root.modal-error = ""; root.modal = "rename"; }
                                        delete(id, name) => { root.pending-action-id = id; root.pending-action-name = name; root.pending-snapshot-deletion-note = item.snapshot-deletion-note; root.pending-action-linked-servers = item.linked-servers; root.pending-action-stoppable-linked-servers = item.stoppable-linked-servers; root.pending-action-unstoppable-linked-servers = item.unstoppable-linked-servers; root.modal-error = ""; root.modal = "delete-instance"; }
                                    }
                                    }
                                }
                            }
                        }
                    }
                    if root.show-inspector && root.selected-instance-index >= 0 : InstanceInspector {
                        width: 360px;
                        has-selection: root.selected-instance-index >= 0;
                        item: root.selected-instance-index >= 0 ? root.instances[root.selected-instance-index] : {};
                        groups: root.instance-groups;
                        group-names: root.instance-group-names;
                        toggle-favorite(id, favorite) => { root.set-favorite("client", id, favorite); }
                        set-group(id, group) => { root.set-client-group(id, group); }
                        manage-groups => { root.modal-error = ""; root.modal = "groups"; }
                        pick-icon(id) => { root.pick-host-icon("client", id); }
                        clear-icon(id) => { root.clear-host-icon("client", id); }
                        account-entries: root.account-launch-entries;
                        launch(id) => { root.launch-client(id); }
                        launch-as(id, account, alongside) => { root.launch-client-as(id, account, alongside); }
                        add-account => { root.close-workspace(); root.page = 4; root.settings-tab = "Accounts"; }
                        kill(id) => { root.kill-instance(id, ""); }
                        connect(client, server) => { root.launch-and-connect(client, server); }
                        open-folder(id) => { root.open-client-folder(id); }
                        workspace(id) => { root.open-workspace("client", id, "Overview"); }
                        create-server(id, name) => { root.create-server-client-id = id; root.create-server-name = ""; root.create-server-name-suggestion = NameRules.linked-server-name(name); root.create-server-pack = ""; root.create-server-pack-name = ""; root.modal = "create-server"; }
                        diagnostics(id) => { root.open-workspace("client", id, "Logs"); }
                    }
                }


                // Servers.
                if root.page == 1 && !root.workspace-open : HorizontalLayout {
                    spacing: 0px;
                    horizontal-stretch: 1;
                    Rectangle { horizontal-stretch: 1; background: Theme.background;
                        VerticalLayout { padding: 24px; spacing: 18px;
                            HorizontalLayout {
                                PageIntro { title: GuiI18n.text("gui-servers"); subtitle: GuiI18n.text("gui-servers-detail"); }
                                TextField { text <=> root.server-query; placeholder: GuiI18n.text("gui-filter-servers"); input-type: InputType.search; width: 290px; accepted => { root.refresh(); } }
                            }
                            if root.loading && root.startup-error == "" : LoadingState { text: GuiI18n.text("gui-loading-servers"); }
                            if root.startup-error != "" && (root.loading || (root.global-servers.length == 0 && root.pending-servers.length == 0)) : Rectangle { vertical-stretch: 1; }
                            if !root.loading && root.startup-error == "" && root.global-servers.length == 0 && root.pending-servers.length == 0 : EmptyState { icon: @image-url("../../../assets/icons/nav-servers.svg"); title: GuiI18n.text("gui-no-servers"); message: GuiI18n.text("gui-no-standalone-servers-detail"); primary-text: GuiI18n.text("gui-modal-new-server"); primary => { root.create-server-client-id = ""; root.create-server-name = ""; root.recompute-create-server-name(); root.modal-error = ""; root.request-version-catalog(); root.warm-language-catalog(root.create-server-minecraft); root.create-server-pack = ""; root.create-server-pack-name = ""; root.modal = "create-server"; } }
                            if !root.loading && (root.global-servers.length > 0 || root.pending-servers.length > 0) : ScrollView { viewport-width: self.width; VerticalLayout { spacing: 12px; for pending in root.pending-servers : PendingCard { item: pending; } for item[index] in root.global-servers : ServerCard { item: item; toggle-favorite(id, favorite) => { root.set-favorite("server", id, favorite); } pick-icon(id) => { root.pick-host-icon("server", id); } clear-icon(id) => { root.clear-host-icon("server", id); } selected: item.id == root.selected-global-server-id; choose(id) => { root.selected-global-server-id = id; root.selected-global-server-index = index; root.select-server(id); } primary(id) => { if item.can-start { root.server-start(id); } else { root.server-stop(id); } } open-workspace(id) => { root.selected-global-server-id = id; root.selected-global-server-index = index; root.select-server(id); root.open-workspace("server", id, "Overview"); } open-folder(id) => { root.open-server-folder(id); } restart(id) => { root.server-restart(id); } kill(id, name) => { root.pending-action-id = id; root.pending-action-name = name; root.modal = "kill"; } rename(id, name) => { root.pending-action-kind = "server"; root.pending-action-id = id; root.pending-rename-text = name; root.modal-error = ""; root.modal = "rename"; } delete(id, name) => { root.pending-action-id = id; root.pending-action-name = name; root.pending-snapshot-deletion-note = item.snapshot-deletion-note; root.modal-error = ""; root.modal = "delete-server"; } } } }
                        }
                    }
                    if root.show-inspector && root.selected-global-server-index >= 0 : Rectangle { width: 360px; background: Theme.surface; border-width: 1px; border-color: Theme.border;
                        if root.selected-global-server-index < 0 : EmptyState { icon: @image-url("../../../assets/icons/nav-servers.svg"); title: GuiI18n.text("gui-no-server-selected"); message: GuiI18n.text("gui-select-server"); }
                        if root.selected-global-server-index >= 0 : VerticalLayout { alignment: start; padding: 22px; spacing: 12px;
                            HorizontalLayout {
                                spacing: 12px;
                                HostIcon { slot: root.global-servers[root.selected-global-server-index].icon-slot; kind: root.global-servers[root.selected-global-server-index].loader-kind; server: true; }
                                VerticalLayout { spacing: 4px; horizontal-stretch: 1;
                                    ElidedHeading { text: root.global-servers[root.selected-global-server-index].name; }
                                    StatePill { state: root.global-servers[root.selected-global-server-index].state; state-kind: root.global-servers[root.selected-global-server-index].state-kind; restarting: root.global-servers[root.selected-global-server-index].restart-stage != ""; }
                                }
                            }
                            Divider { }
                            Eyebrow { text: GuiI18n.text("gui-server-run"); }
                            HorizontalLayout { InspectorLabel { text: GuiI18n.text("gui-target"); } BodyText { text: root.global-servers[root.selected-global-server-index].minecraft + " | " + root.global-servers[root.selected-global-server-index].loader; } }
                            HorizontalLayout { InspectorLabel { text: GuiI18n.text("gui-relation"); } BodyText { text: root.global-servers[root.selected-global-server-index].relationship; } }
                            HorizontalLayout { InspectorLabel { text: GuiI18n.text("gui-address"); } BodyText { text: root.global-servers[root.selected-global-server-index].address; } }
                            Divider { }
                            Eyebrow { text: GuiI18n.text("gui-actions"); }
                            if root.global-servers[root.selected-global-server-index].can-start || root.global-servers[root.selected-global-server-index].can-stop : AppButton { text: root.global-servers[root.selected-global-server-index].can-start ? GuiI18n.text("gui-start") : GuiI18n.text("gui-stop"); tone: "primary"; clicked => { if root.global-servers[root.selected-global-server-index].can-start { root.server-start(root.selected-global-server-id); } else { root.server-stop(root.selected-global-server-id); } } }
                            HorizontalLayout { spacing: 8px; AppButton { text: GuiI18n.text("gui-open-server-workspace"); clicked => { root.open-workspace("server", root.selected-global-server-id, "Overview"); } } AppButton { text: GuiI18n.text("gui-restart"); enabled: root.global-servers[root.selected-global-server-index].can-restart && root.global-servers[root.selected-global-server-index].restart-stage == ""; hint: root.global-servers[root.selected-global-server-index].restart-stage != "" ? GuiI18n.text("gui-hint-restart-in-progress") : ServerHints.restart(root.global-servers[root.selected-global-server-index].state-kind); clicked => { root.server-restart(root.selected-global-server-id); } } }
                            if root.global-servers[root.selected-global-server-index].linked-client-id != "" : AppButton { text: GuiI18n.text("gui-launch-client-connect"); enabled: root.global-servers[root.selected-global-server-index].can-connect; hint: root.global-servers[root.selected-global-server-index].connect-reason; clicked => { root.launch-and-connect(root.global-servers[root.selected-global-server-index].linked-client-id, root.selected-global-server-id); } }
                            HorizontalLayout { spacing: 8px;
                                AppButton { text: GuiI18n.text("gui-open-folder"); clicked => { root.open-server-folder(root.selected-global-server-id); } }
                                AppButton { text: GuiI18n.text("gui-view-logs"); clicked => { root.open-workspace("server", root.selected-global-server-id, "Logs"); } }
                            }
                            Divider { }
                            AppButton { text: GuiI18n.text("gui-force-kill"); tone: "danger"; enabled: root.global-servers[root.selected-global-server-index].can-kill; hint: ServerHints.kill(root.global-servers[root.selected-global-server-index].state-kind); clicked => { root.pending-action-id = root.selected-global-server-id; root.pending-action-name = root.global-servers[root.selected-global-server-index].name; root.modal = "kill"; } }
                        }
                    }
                }

                // The host workspace. Each pane is one HostWorkspace over the
                // host view it names; the controller places the panes and
                // keeps every host view current, so two panes on one host
                // read one state.
                if root.workspace-open && (root.page == 0 || root.page == 1) : Rectangle {
                    property <bool> split: root.workspace-panes.length > 1;
                    horizontal-stretch: 1;
                    background: Theme.background;
                    VerticalLayout {
                        if split : HorizontalLayout {
                            padding-left: 12px; padding-right: 12px; padding-top: 12px;
                            spacing: 12px;
                            AppButton { text: root.workspace-back-label; clicked => { root.workspace-back(); } }
                            Heading { text: GuiI18n.text("gui-workspace-split-title"); vertical-alignment: center; overflow: elide; }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        // Two equal columns of one or two equal rows. A window
                        // too small for the panes' minimum scrolls them rather
                        // than letting one pane draw over another.
                        pane-area := ScrollView {
                            property <length> gap: 10px;
                            property <length> margin: split ? 12px : 0px;
                            property <length> area-width: max(self.visible-width - 2 * self.margin, split ? 2 * Theme.workspace-pane-min-width + self.gap : 0px);
                            property <length> area-height: max(self.visible-height - 2 * self.margin, split ? 2 * Theme.workspace-pane-min-height + self.gap : 0px);
                            property <length> column-width: split ? (self.area-width - self.gap) / 2 : self.area-width;
                            property <length> stacked-height: (self.area-height - self.gap) / 2;
                            vertical-stretch: 1;
                            viewport-width: self.area-width + 2 * self.margin;
                            viewport-height: self.area-height + 2 * self.margin;
                            for pane in root.workspace-panes : HostWorkspace {
                                property <HostView> host: root.host-views[pane.host];
                                property <LogView> log-view: root.log-views[pane.log];
                                property <bool> is-client: host.kind == "client";
                                property <string> pair-display: host.pair-restart-stage != "" ? GuiI18n.text("gui-state-restarting") : host.pair-state;
                                x: pane-area.margin + pane.column * (pane-area.column-width + pane-area.gap);
                                y: pane-area.margin + pane.row * (pane-area.stacked-height + pane-area.gap);
                                width: pane-area.column-width;
                                height: pane.stacked ? pane-area.stacked-height : pane-area.area-height;
                                compact: split;
                                pane-label: pane.label;
                                host-kind-label: self.is-client ? GuiI18n.text("gui-client") : GuiI18n.text("gui-server");
                                folder-label: self.is-client ? GuiI18n.text("gui-open-instance-folder") : GuiI18n.text("gui-open-server-folder");
                                surface-choice: pane.surface-choice;
                                can-split-beside: pane.can-split-beside;
                                can-split-below: pane.can-split-below;
                                can-close: pane.can-close;
                                paired: self.is-client ? host.client.paired-server-id != "" : host.server.paired-client-id != "";
                                pair-label: self.pair-display == "" ? GuiI18n.text("gui-paired") : GuiI18n.value(self.is-client ? "gui-paired-server-state" : "gui-paired-client-state", self.pair-display);
                                pair-state-kind: host.pair-restart-stage != "" ? "restarting" : host.pair-state-kind;
                                pair-starting: self.is-client ? host.client.pair-starting : host.server.pair-starting;
                                java-summary: host.java-summary;
                                java-tone: host.java-tone;
                                java-tone-label: host.java-tone-label;
                                java-origin: host.java-origin;
                                open-java => { root.show-pane-surface(pane.id, "Settings"); }
                                address: self.is-client ? "" : host.server.address;
                                restart-required: !self.is-client && host.server.restart-required;
                                choose-host => { root.pane-host-picker-pane = pane.id; root.pane-host-picker-kind = host.kind; root.pane-host-picker-id = host.id; root.pane-host-query = ""; root.pane-host-query-changed(); root.modal = "pane-host"; }
                                split-beside => { root.split-pane-beside(pane.id); }
                                split-below => { root.split-pane-below(pane.id); }
                                close-pane => { root.close-pane(pane.id); }
                                title: self.is-client ? host.client.name : host.server.name;
                                back-label: root.workspace-back-label;
                                status: self.is-client ? host.client.state : host.server.state;
                                status-kind: self.is-client ? host.client.state-kind : host.server.state-kind;
                                host-running: self.is-client ? host.client.can-kill : host.server.can-stop;
                                surfaces: host.surfaces;
                                selected-surface: pane.surface;
                                account-entries: root.account-launch-entries;
                                show-launch-as: self.is-client;
                                launch-alongside: self.is-client && host.client.can-kill;
                                primary-label: self.is-client ? (host.client.can-kill ? GuiI18n.text("gui-stop-game") : GuiI18n.text("gui-launch")) : (host.server.can-stop ? GuiI18n.text("gui-stop") : GuiI18n.text("gui-start"));
                                primary-tone: self.is-client && host.client.can-kill ? "danger" : "primary";
                                primary-enabled: host.available && (self.is-client ? host.client.can-launch || host.client.can-kill : host.server.can-start || host.server.can-stop);
                                primary-hint: !host.available ? GuiI18n.text("gui-workspace-host-gone") : self.is-client ? (host.client.needs-attention ? GuiI18n.text("gui-hint-needs-attention") : GuiI18n.text("gui-hint-state-changing")) : ServerHints.start(host.server.state-kind, host.server.installed);
                                kill-visible: !self.is-client;
                                kill-enabled: host.available && !self.is-client && host.server.can-kill;
                                kill-hint: !host.available ? GuiI18n.text("gui-workspace-host-gone") : ServerHints.kill(host.server.state-kind);
                                restart-visible: true;
                                restart-enabled: host.available && (self.is-client ? host.client.can-kill && host.client.can-restart : host.server.can-restart);
                                restart-hint: !host.available ? GuiI18n.text("gui-workspace-host-gone") : self.is-client ? (!host.client.can-kill ? GuiI18n.text("gui-hint-restart-client-stopped") : !host.client.can-restart ? GuiI18n.text("gui-restart-client-unavailable") : "") : ServerHints.restart(host.server.state-kind);
                                restart-stage: self.is-client ? host.client.restart-stage : host.server.restart-stage;
                                workflow-id: host.workflow-id;
                                workflow-here: host.workflow-pane == 0 || host.workflow-pane == pane.id;
                                busy: root.host-busy-kind == host.kind && root.host-busy-id == host.id;
                                busy-text: root.host-busy-text;
                                workflow-title: host.workflow-title;
                                workflow-summary: host.workflow-summary;
                                workflow-actions: host.workflow-actions;
                                back => { root.workspace-back(); }
                                open-folder => { if self.is-client { root.open-client-folder(host.id); } else { root.open-server-folder(host.id); } }
                                primary => {
                                    if self.is-client {
                                        if host.client.can-kill { root.kill-instance(host.id, ""); } else { root.launch-client(host.id); }
                                    } else {
                                        if host.server.can-stop { root.server-stop(host.id); } else { root.server-start(host.id); }
                                    }
                                }
                                restart => { if self.is-client { root.client-restart(host.id); } else { root.server-restart(host.id); } }
                                kill => { root.pending-action-id = host.id; root.pending-action-name = host.server.name; root.modal = "kill"; }
                                launch-as(account, alongside) => { root.launch-client-as(host.id, account, alongside); }
                                // Closing the workspace drops this pane mid-handler, so navigate first.
                                add-account => { root.page = 4; root.settings-tab = "Accounts"; root.close-workspace(); }
                                surface-selected(surface) => { root.show-pane-surface(pane.id, surface); }
                                workflow-action(workflow, action) => { root.workflow-action(pane.id, host.kind, host.id, workflow, action); }
                                // Above every surface but Diagnostics, which already leads
                                // with a failure; a refused start has none to lead with.
                                // Any of its actions retires it.
                                if host.available && host.run-failure-title != "" && (pane.surface != "Diagnostics" || host.run-eula-refused) : RunFailureNotice {
                                    host: host;
                                    review-eula => { root.modal = "eula"; root.dismiss-run-failure(host.kind, host.id); }
                                    open-diagnostics => { root.show-pane-surface(pane.id, "Diagnostics"); root.dismiss-run-failure(host.kind, host.id); }
                                    verify-host => { root.show-pane-surface(pane.id, "Diagnostics"); root.diagnose-host(host.kind, host.id); root.dismiss-run-failure(host.kind, host.id); }
                                    open-crash-report => { root.show-pane-surface(pane.id, "Logs"); root.log-show(pane.id, "crashes"); root.log-open-file(pane.id, host.run-crash-report); root.dismiss-run-failure(host.kind, host.id); }
                                    open-log => { root.show-pane-surface(pane.id, "Logs"); root.log-show(pane.id, "live"); root.dismiss-run-failure(host.kind, host.id); }
                                    dismiss => { root.dismiss-run-failure(host.kind, host.id); }
                                }
                                if !host.available : EmptyState {
                                    icon: @image-url("../../../assets/icons/nav-instances.svg");
                                    title: GuiI18n.text("gui-workspace-host-gone");
                                    message: GuiI18n.text("gui-workspace-host-gone-detail");
                                }
                                // Never wider than the pane: a narrow pane wraps its
                                // text and stacks its buttons rather than scrolling
                                // sideways into a column centered off screen.
                                if host.available && host.kind == "client" && pane.surface == "Overview" : ScrollView {
                                    viewport-width: self.visible-width;
                                    client-overview := VerticalLayout { alignment: start; width: min(parent.width, 980px); spacing: 12px;
                                        property <bool> narrow: self.width < 620px;
                                        Heading { text: GuiI18n.text("gui-reproduction-environment"); overflow: elide; }
                                        BodyText { text: GuiI18n.text("gui-reproduction-environment-detail"); wrap: word-wrap; }
                                        Rectangle { border-radius: 8px; border-width: 1px; border-color: Theme.border; background: Theme.surface;
                                            HorizontalLayout { padding: 18px; spacing: 18px; HostIcon { slot: host.client.icon-slot; kind: host.client.loader-kind; } VerticalLayout { horizontal-stretch: 1; Heading { text: host.client.name; overflow: elide; } BodyText { text: GuiI18n.values("gui-target-summary", host.client.minecraft, host.client.loader); overflow: elide; } BodyText { text: host.client.storage + " | " + host.client.source; overflow: elide; } BodyText { text: host.client.path; color: Theme.text-muted; overflow: elide; } if host.client.paired-server-id != "" : BodyText { text: GuiI18n.value("gui-paired-with-host", host.client.paired-server-name); color: Theme.accent; overflow: elide; } } if host.client.paired-server-id != "" && !host.pair-shown : VerticalLayout { alignment: center; AppButton { text: GuiI18n.text("gui-pair-show-beside"); enabled: host.pair-room; hint: host.pair-room ? "" : GuiI18n.text("gui-pair-no-room"); clicked => { root.show-linked-pair(pane.id, "server", host.client.paired-server-id); } } } }
                                        }
                                        if !client-overview.narrow : HorizontalLayout { spacing: 10px;
                                            if host.client.loader-kind != "vanilla" : BodyText { text: GuiI18n.value("gui-loader-change-summary", host.client.loader); color: Theme.text-secondary; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                                            if host.client.loader-kind == "vanilla" : Rectangle { horizontal-stretch: 1; }
                                            if host.client.storage-kind == "temporary" : AppButton { text: GuiI18n.text("gui-make-persistent"); enabled: !host.client.can-kill; hint: GuiI18n.text("gui-make-persistent-while-running"); clicked => { root.open-make-persistent(host.id); } }
                                            if host.client.loader-kind != "vanilla" : AppButton { text: GuiI18n.text("gui-loader-change-open"); clicked => { root.open-loader-change(host.id); } }
                                        }
                                        if client-overview.narrow && host.client.loader-kind != "vanilla" : BodyText { text: GuiI18n.value("gui-loader-change-summary", host.client.loader); color: Theme.text-secondary; wrap: word-wrap; }
                                        if client-overview.narrow : HorizontalLayout { spacing: 10px; alignment: start;
                                            if host.client.storage-kind == "temporary" : AppButton { text: GuiI18n.text("gui-make-persistent"); enabled: !host.client.can-kill; hint: GuiI18n.text("gui-make-persistent-while-running"); clicked => { root.open-make-persistent(host.id); } }
                                            if host.client.loader-kind != "vanilla" : AppButton { text: GuiI18n.text("gui-loader-change-open"); clicked => { root.open-loader-change(host.id); } }
                                        }
                                        BodyText { text: host.client.storage-kind == "temporary" ? GuiI18n.text("gui-temporary-lifecycle") : GuiI18n.text("gui-persistent-lifecycle"); color: Theme.text-muted; wrap: word-wrap; }
                                        Divider { }
                                        HorizontalLayout { spacing: 10px; Heading { text: GuiI18n.text("gui-linked-server"); font-size: Theme.section-size; overflow: elide; horizontal-stretch: 1; } if host.linked-servers.length == 0 && host.pending-servers.length == 0 : AppButton { text: GuiI18n.text("gui-create-linked-server"); clicked => { root.create-server-client-id = host.id; root.create-server-name = ""; root.create-server-name-suggestion = NameRules.linked-server-name(host.client.name); root.create-server-pack = ""; root.create-server-pack-name = ""; root.modal = "create-server"; } } }
                                        if host.linked-servers.length == 0 && host.pending-servers.length == 0 : BodyText { text: GuiI18n.text("gui-no-linked-server-detail"); color: Theme.text-muted; wrap: word-wrap; }
                                        for pending in host.pending-servers : PendingCard { item: pending; }
                                        for server in host.linked-servers : Rectangle { border-radius: 8px; border-width: 1px; border-color: server.needs-attention ? Theme.warning : Theme.border; background: Theme.surface; card := VerticalLayout { padding: 14px; spacing: 8px;
                                            // Every action on one row needs about this much room.
                                            property <bool> narrow: self.width < 840px;
                                            property <bool> paired: host.client.paired-server-id == server.id;
                                            HorizontalLayout { spacing: 10px; Heading { text: server.name; font-size: Theme.row-heading-size; overflow: elide; horizontal-stretch: 1; } if card.paired : VerticalLayout { alignment: center; Pill { text: GuiI18n.text("gui-paired"); tone-color: Theme.accent; } } VerticalLayout { alignment: center; StatePill { state: server.state; state-kind: server.state-kind; restarting: server.restart-stage != ""; } } BodyText { text: server.address; color: Theme.text-muted; vertical-alignment: center; } }
                                            BodyText { text: server.needs-attention ? GuiI18n.text("gui-server-needs-attention") : server.state-detail; color: server.needs-attention ? Theme.warning : Theme.text-secondary; wrap: word-wrap; }
                                            HorizontalLayout { spacing: 8px; alignment: start;
                                                if !card.narrow : AppButton { text: GuiI18n.text("gui-open-server-workspace"); clicked => { root.follow-host(pane.id, "server", server.id, "Overview"); } }
                                                if server.can-start || server.can-stop : AppButton { text: server.can-start ? GuiI18n.text("gui-start") : GuiI18n.text("gui-stop"); tone: "primary"; clicked => { if server.can-start { root.server-start(server.id); } else { root.server-stop(server.id); } } }
                                                AppButton { text: GuiI18n.text("gui-launch-client-connect"); enabled: server.can-connect; hint: server.connect-reason; clicked => { root.launch-and-connect(host.id, server.id); } }
                                                if !card.narrow : AppButton { text: GuiI18n.text("gui-open-folder"); clicked => { root.open-server-folder(server.id); } }
                                                if !card.narrow && server.state-kind == "needs-recovery" : AppButton { text: GuiI18n.text("gui-repair-server"); tone: "primary"; clicked => { root.repair-server(server.id); } }
                                                if !card.narrow : AppButton { text: card.paired ? GuiI18n.text("gui-unpair") : GuiI18n.text("gui-pair-this-server"); clicked => { if card.paired { root.clear-linked-pair(host.id); } else { root.set-linked-pair(host.id, server.id, false); } } }
                                                if !card.narrow : AppButton { text: GuiI18n.text("gui-delete-server"); tone: "danger"; clicked => { root.pending-action-id = server.id; root.pending-action-name = server.name; root.pending-snapshot-deletion-note = server.snapshot-deletion-note; root.modal-error = ""; root.modal = "delete-server"; } }
                                            }
                                            if card.narrow : HorizontalLayout { spacing: 8px; alignment: start;
                                                AppButton { text: GuiI18n.text("gui-open-server-workspace"); clicked => { root.follow-host(pane.id, "server", server.id, "Overview"); } }
                                                AppButton { text: GuiI18n.text("gui-open-folder"); clicked => { root.open-server-folder(server.id); } }
                                            }
                                            if card.narrow : HorizontalLayout { spacing: 8px; alignment: start;
                                                if server.state-kind == "needs-recovery" : AppButton { text: GuiI18n.text("gui-repair-server"); tone: "primary"; clicked => { root.repair-server(server.id); } }
                                                AppButton { text: card.paired ? GuiI18n.text("gui-unpair") : GuiI18n.text("gui-pair-this-server"); clicked => { if card.paired { root.clear-linked-pair(host.id); } else { root.set-linked-pair(host.id, server.id, false); } } }
                                                AppButton { text: GuiI18n.text("gui-delete-server"); tone: "danger"; clicked => { root.pending-action-id = server.id; root.pending-action-name = server.name; root.pending-snapshot-deletion-note = server.snapshot-deletion-note; root.modal-error = ""; root.modal = "delete-server"; } }
                                            }
                                            if card.paired : InlineToggle { label: GuiI18n.text("gui-pair-start-together"); checked: host.client.pair-start-together; toggled(value) => { root.set-linked-pair(host.id, server.id, value); } }
                                        } }
                                    }
                                }
                                if host.available && host.kind == "client" && pane.surface == "Mods" : HorizontalLayout {
                                    spacing: 16px;
                                    ManagedModsPanel {
                                        width: 46%;
                                        host: host;
                                        detail: GuiI18n.text("gui-managed-mods-detail");
                                        empty-detail: GuiI18n.text("gui-no-managed-mods-detail");
                                        mods-are-the-users: host.allow-pack-mod-changes;
                                        filter(text) => { root.filter-mods("client", host.id, text); }
                                        add-jars => { root.pick-local-mods("client", host.id); }
                                        refresh => { root.refresh-mods("client", host.id); }
                                        manage(path) => { root.open-mod-manager("client", host.id, path); }
                                        toggle(path, on) => { root.set-mod-enabled("client", host.id, path, on); }
                                        restore-file(path) => { root.restore-mod-file("client", host.id, path); }
                                        delete-file(mod, path, title) => { root.pending-action-kind = "client"; root.pending-action-id = host.id; root.pending-action-name = title; root.mod-action-path = path; root.mod-action-name = title; root.mod-action-is-hand-placed = mod.origin-kind == "hand-placed"; root.modal-error = ""; root.mod-remove-returns-to-manager = false; if mod.can-delete-file && !(host.allow-pack-mod-changes && mod.can-remove) { root.modal = "delete-mod"; } else { root.plan-mod-removal("client", host.id, path); } }
                                    }
                                    ModBrowser {
                                        horizontal-stretch: 1;
                                        host: host;
                                        page-sizes: root.mod-page-sizes;
                                        page-size-label: root.mod-page-size-label;
                                        switch-catalog(provider) => { root.switch-mod-catalog(host.kind, host.id, provider); }
                                        search(provider, text) => { root.search-mods(host.kind, host.id, provider, text); }
                                        load-more(provider, text, offset) => { root.load-more-mods(host.kind, host.id, provider, text, offset); }
                                        install(project) => { root.install-from-browser(host.kind, host.id, host.browser-provider, project); }
                                        set-include-incompatible(on) => { root.set-mod-include-incompatible(host.kind, host.id, on); }
                                        set-page-size(label) => { root.set-mod-page-size(label); }
                                        // Closing the workspace drops this pane mid-handler, so navigate first.
                                        open-provider-settings => { root.page = 4; root.settings-tab = "Providers & APIs"; root.close-workspace(); }
                                    }
                                }
                                if host.available && pane.surface == "Isolation" : IsolationSurface {
                                    phase: host.isolation-phase == "" ? "none" : host.isolation-phase;
                                    busy: root.host-busy-kind == host.kind && root.host-busy-id == host.id;
                                    recovery: host.isolation-recovery; recovery-detail: host.isolation-recovery-detail;
                                    host-running: is-client ? host.client.can-kill : host.server.can-stop;
                                    summary: host.isolation-summary; confidence: host.isolation-confidence; round: host.isolation-round; granularity: host.isolation-granularity;
                                    candidates: host.isolation-candidates; enabled-items: host.isolation-enabled; disabled-items: host.isolation-disabled;
                                    unrecorded: host.isolation-unrecorded; unidentifiable: host.isolation-unidentifiable; missing: host.isolation-missing;
                                    linked-servers: host.isolation-linked-servers; remaining-candidates: host.isolation-remaining-candidates; pinned: host.isolation-pinned; required-dependencies: host.isolation-required-dependencies; history: host.isolation-history;
                                    reduced-confidence: host.isolation-reduced-confidence; query: host.isolation-query;
                                    accept-unrecorded: host.isolation-accept-unrecorded; accept-missing: host.isolation-accept-missing; error: host.isolation-error;
                                    begin => { root.open-isolation(host.kind, host.id); }
                                    filter(query) => { root.filter-isolation-candidates(host.kind, host.id, query); }
                                    toggle-pin(path, selected) => { root.toggle-isolation-pin(host.kind, host.id, path, selected); }
                                    acknowledge(what, accepted) => { root.acknowledge-isolation(host.kind, host.id, what, accepted); }
                                    start-session(accept-unrecorded, accept-missing) => { root.start-isolation(host.kind, host.id, accept-unrecorded, accept-missing); }
                                    answer(answer) => { root.answer-isolation(host.kind, host.id, answer); }
                                    undo => { root.undo-isolation(host.kind, host.id); }
                                    finish => { root.finish-isolation(host.kind, host.id); }
                                    cancel => { root.cancel-isolation(host.kind, host.id); }
                                    discard-setup => { root.discard-isolation-setup(host.kind, host.id); }
                                    retry-recovery => { root.retry-isolation-recovery(host.kind, host.id); }
                                    close => { root.dismiss-isolation(host.kind, host.id); root.show-pane-surface(pane.id, "Mods"); }
                                }
                                if host.available && pane.surface == "Settings" : HostRuntimeForm {
                                    host: host;
                                    error: host.runtime-error;
                                    busy: root.host-busy-kind == host.kind && root.host-busy-id == host.id;
                                    save(min, max, args) => { root.save-host-runtime(host.kind, host.id, min, max, args); }
                                    load-java => { root.load-host-java(host.kind, host.id); }
                                    choose-java(key) => { root.choose-host-java(host.kind, host.id, key); }
                                    check-java-path(path) => { root.check-host-java-path(host.kind, host.id, path); }
                                    install-java => { root.install-host-java(host.kind, host.id); }
                                    cancel-fix => { root.cancel-fix(host.kind, host.id); }
                                    apply-fix => { root.apply-fix(host.kind, host.id); }
                                    clear => { root.clear-host-runtime(host.kind, host.id); }
                                    allow-pack-mod-changes(allow) => { root.set-allow-pack-mod-version-changes(host.kind, host.id, allow); }
                                    // Closing the workspace drops this pane mid-handler, so navigate first.
                                    open-global-defaults => { root.page = 4; root.settings-tab = "Minecraft"; root.close-workspace(); }
                                }
                                if host.available && host.kind == "client" && pane.surface == "Snapshots" : SnapshotPanel {
                                    items: host.snapshots; total: host.snapshot-total; has-plain-copies: host.snapshots-have-plain-copies;
                                    create => { root.snapshot-host-kind = host.kind; root.snapshot-host-id = host.id; root.snapshot-action-label = ""; root.recompute-snapshot-label(); root.modal-error = ""; root.modal = "snapshot-create"; }
                                    restore(id, label) => { root.snapshot-host-kind = host.kind; root.snapshot-host-id = host.id; root.snapshot-action-id = id; root.snapshot-action-label = label; root.snapshot-safety-copy = true; root.modal-error = ""; root.modal = "snapshot-restore"; }
                                    rename(id, label) => { root.snapshot-host-kind = host.kind; root.snapshot-host-id = host.id; root.snapshot-action-id = id; root.snapshot-action-label = label; root.modal-error = ""; root.modal = "snapshot-rename"; }
                                    delete(id, label) => { root.snapshot-host-kind = host.kind; root.snapshot-host-id = host.id; root.snapshot-action-id = id; root.snapshot-action-label = label; root.modal-error = ""; root.modal = "snapshot-delete"; }
                                }
                                if host.available && pane.surface == "Diagnostics" : DiagnosticsSurface {
                                    host: host;
                                    busy: root.host-busy-kind == host.kind && root.host-busy-id == host.id;
                                    diagnose => { root.diagnose-host(host.kind, host.id); }
                                    stop => { root.stop-diagnosis(); }
                                    review-fix(key) => { root.review-fix(host.kind, host.id, key); }
                                    cancel-fix => { root.cancel-fix(host.kind, host.id); }
                                    apply-fix => { root.apply-fix(host.kind, host.id); }
                                    copy-report => { root.copy-diagnosis-report(host.kind, host.id); }
                                    open-logs => { root.show-pane-surface(pane.id, "Logs"); }
                                    // Offered on a client alone, which is what the install flow takes.
                                    install-mod(provider, project) => { root.install-from-diagnostics(host.kind, host.id, provider, project); }
                                    open-route(route) => {
                                        if route == "mods" { root.show-pane-surface(pane.id, "Mods"); }
                                        if route == "settings" { root.show-pane-surface(pane.id, "Settings"); }
                                        // Closing the workspace drops this pane mid-handler, so navigate first.
                                        if route == "java-settings" { root.page = 4; root.settings-tab = "Java"; root.load-java-runtimes(); root.close-workspace(); }
                                        if route == "log" { root.show-pane-surface(pane.id, "Logs"); root.log-show(pane.id, "live"); }
                                        if route == "crash-report" { root.show-pane-surface(pane.id, "Logs"); root.log-show(pane.id, "crashes"); root.log-open-file(pane.id, host.diagnosis-crash-report); }
                                        if route == "eula" { root.modal = "eula"; }
                                    }
                                    toggle-bundle-part(name, value) => { root.toggle-bundle-part(host.kind, host.id, name, value); }
                                    select-all-bundle-parts(value) => { root.select-all-bundle-parts(host.kind, host.id, value); }
                                    export-bundle => { root.export-bundle(host.kind, host.id); }
                                    open-bundle-folder => { root.open-bundle-folder(host.bundle-result-path); }
                                }
                                // The pane's own log viewer: what it reads, how it
                                // is filtered, and what is selected belong to this
                                // pane alone.
                                if host.available && pane.surface == "Logs" : VerticalLayout { spacing: 9px;
                                    HorizontalLayout { spacing: 8px;
                                        FilterChip { text: is-client ? GuiI18n.text("gui-live-latest-log") : GuiI18n.text("gui-server-captured-output"); accessible-name: self.text; selected: log-view.mode == "live"; clicked => { root.log-show(pane.id, "live"); } }
                                        FilterChip { text: GuiI18n.text("gui-log-files"); accessible-name: GuiI18n.text("gui-log-files"); selected: log-view.mode == "files"; clicked => { root.log-show(pane.id, "files"); } }
                                        FilterChip { text: GuiI18n.text("gui-crash-reports"); accessible-name: GuiI18n.text("gui-crash-reports"); selected: log-view.mode == "crashes"; clicked => { root.log-show(pane.id, "crashes"); } }
                                        Rectangle { horizontal-stretch: 1; }
                                        // A saved log and a crash report are searched from the same
                                        // place, whether or not one is open yet.
                                        if log-view.mode == "files" : HorizontalLayout { spacing: 8px; horizontal-stretch: 0; property <string> query: log-view.query; changed query => { log-search.text = self.query; } log-search := TextField { placeholder: GuiI18n.text("gui-search-open-log"); accessible-label: GuiI18n.text("gui-search-open-log"); input-type: InputType.search; width: 250px; init => { self.text = log-view.query; } accepted => { root.log-search(pane.id, self.text); } } AppButton { text: GuiI18n.text("gui-find"); enabled: log-view.file != ""; hint: GuiI18n.text("gui-hint-choose-log-file"); clicked => { root.log-search(pane.id, log-search.text); } } }
                                        if log-view.mode == "crashes" : HorizontalLayout { spacing: 8px; horizontal-stretch: 0; report-search := TextField { placeholder: GuiI18n.text("gui-search-open-report"); input-type: InputType.search; width: 250px; accepted => { root.log-search-report(pane.id, self.text); } } AppButton { text: GuiI18n.text("gui-find"); enabled: log-view.file != ""; hint: GuiI18n.text("gui-hint-choose-log-file"); clicked => { root.log-search-report(pane.id, report-search.text); } } }
                                        AppButton { text: GuiI18n.text("gui-folder"); clicked => { if !is-client && log-view.mode == "live" { root.open-server-location(host.id, "capture"); } else { root.log-open-folder(pane.id); } } }
                                    }
                                    // The log being written to, followed as it grows.
                                    if log-view.mode == "live" : LiveLogViewer {
                                        chunks: log-view.chunks; has-content: log-view.has-content; status: log-view.status; history-truncated: log-view.history-truncated; pending-lines: log-view.pending-lines; content-columns: log-view.content-columns; font-size: root.technical-text-size * 1px; query: log-view.query; wrap-lines: log-view.wrap-lines; follow: log-view.follow; trace-enabled: log-view.trace-enabled; debug-enabled: log-view.debug-enabled; info-enabled: log-view.info-enabled; warn-enabled: log-view.warn-enabled; error-enabled: log-view.error-enabled; fatal-enabled: log-view.fatal-enabled; other-enabled: log-view.other-enabled; revision: log-view.revision; selection-start-row: log-view.selection-start-row; selection-start-offset: log-view.selection-start-offset; selection-end-row: log-view.selection-end-row; selection-end-offset: log-view.selection-end-offset; has-selection: log-view.has-selection; selection-revision: log-view.selection-revision;
                                        set-level(level, enabled) => { root.log-set-level(pane.id, level, enabled); } search(query) => { root.log-search(pane.id, query); } copy => { root.log-copy(pane.id); } copy-selection => { root.log-copy-selection(pane.id); } select-at(row, column, extend) => { root.log-select-at(pane.id, row, column, extend); } select-word-at(row, column) => { root.log-select-word-at(pane.id, row, column); } select-all => { root.log-select-all(pane.id); } follow-changed(follow) => { root.log-follow(pane.id, follow); } wrap-changed(wrap) => { root.log-wrap(pane.id, wrap); }
                                    }
                                    // A saved log, read through the same view: a
                                    // finished log has the same levels as a live
                                    // one and is read for the same reasons.
                                    if log-view.mode == "files" : HorizontalLayout { spacing: 10px;
                                        DiagnosticFileList { items: log-view.files; selected: log-view.file; opened(name) => { root.log-open-file(pane.id, name); } }
                                        if log-view.file == "" : Rectangle { horizontal-stretch: 1; background: Theme.well; border-radius: 8px; border-width: 1px; border-color: Theme.border; EmptyState { icon: @image-url("../../../assets/icons/nav-logs.svg"); title: GuiI18n.text("gui-no-file-open"); message: GuiI18n.text("gui-no-file-open-detail"); } }
                                        if log-view.file != "" : LiveLogViewer {
                                        searchable: false;
                                        chunks: log-view.chunks; has-content: log-view.has-content; status: log-view.status; history-truncated: log-view.history-truncated; pending-lines: log-view.pending-lines; content-columns: log-view.content-columns; font-size: root.technical-text-size * 1px; query: log-view.query; wrap-lines: log-view.wrap-lines; follow: log-view.follow; trace-enabled: log-view.trace-enabled; debug-enabled: log-view.debug-enabled; info-enabled: log-view.info-enabled; warn-enabled: log-view.warn-enabled; error-enabled: log-view.error-enabled; fatal-enabled: log-view.fatal-enabled; other-enabled: log-view.other-enabled; revision: log-view.revision; selection-start-row: log-view.selection-start-row; selection-start-offset: log-view.selection-start-offset; selection-end-row: log-view.selection-end-row; selection-end-offset: log-view.selection-end-offset; has-selection: log-view.has-selection; selection-revision: log-view.selection-revision;
                                        set-level(level, enabled) => { root.log-set-level(pane.id, level, enabled); } search(query) => { root.log-search(pane.id, query); } copy => { root.log-copy(pane.id); } copy-selection => { root.log-copy-selection(pane.id); } select-at(row, column, extend) => { root.log-select-at(pane.id, row, column, extend); } select-word-at(row, column) => { root.log-select-word-at(pane.id, row, column); } select-all => { root.log-select-all(pane.id); } follow-changed(follow) => { root.log-follow(pane.id, follow); } wrap-changed(wrap) => { root.log-wrap(pane.id, wrap); }
                                    }
                                    }
                                    // A crash report stays a plain document. It is
                                    // one stack dump, and a level filter over it
                                    // would hide the report rather than narrow it.
                                    if log-view.mode == "crashes" : HorizontalLayout { spacing: 10px;
                                        DiagnosticFileList { items: log-view.files; selected: log-view.file; crash: true; opened(name) => { root.log-open-file(pane.id, name); } }
                                        Rectangle { horizontal-stretch: 1; background: Theme.well; border-radius: 8px; border-width: 1px; border-color: Theme.border; VerticalLayout { if log-view.report == "" : EmptyState { icon: @image-url("../../../assets/icons/nav-logs.svg"); title: GuiI18n.text("gui-no-file-open"); message: GuiI18n.text("gui-no-file-open-detail"); } if log-view.report != "" : SelectableText { text: log-view.report; font-size: root.technical-text-size * 1px; } if log-view.report != "" : AppButton { text: GuiI18n.text("gui-copy"); clicked => { root.copy-text(log-view.report); } } } }
                                    }
                                }
                                if host.available && host.kind == "server" && pane.surface == "Overview" : ScrollView { viewport-width: self.visible-width; server-overview := VerticalLayout { alignment: start; width: min(parent.width, 980px); spacing: 12px; property <bool> narrow: self.width < 620px; Heading { text: GuiI18n.text("gui-dedicated-server"); overflow: elide; } BodyText { text: host.server.state-detail; wrap: word-wrap; }
                                    if host.server.restart-required : BodyText { text: GuiI18n.text("gui-server-restart-required-detail"); color: Theme.warning; wrap: word-wrap; }
                                    ServerFiles {
                                        open-location(location) => { root.open-server-location(host.id, location); }
                                        show-surface(surface) => { root.show-pane-surface(pane.id, surface); }
                                    }
                                    HorizontalLayout { spacing: 8px; alignment: start;
                                        AppButton { text: GuiI18n.text("gui-open-console"); clicked => { root.show-pane-surface(pane.id, "Console"); } }
                                        AppButton { text: GuiI18n.text("gui-crash-reports"); clicked => { root.show-pane-surface(pane.id, "Logs"); root.log-show(pane.id, "crashes"); } }
                                    }
                                    if host.crash-report != "" : CrashNotice { report: host.crash-report; failure: host.crash-failure; client-code-on-server: host.crash-client-code-on-server; suggested: host.crash-suggested; room: server-overview.width; review => { root.show-pane-surface(pane.id, "Mods"); } routes: host.run-failure-title == "" || host.run-eula-refused; open-diagnostics => { root.show-pane-surface(pane.id, "Diagnostics"); } open-crash-report => { root.show-pane-surface(pane.id, "Logs"); root.log-show(pane.id, "crashes"); root.log-open-file(pane.id, host.crash-report); } open-log => { root.show-pane-surface(pane.id, "Logs"); root.log-show(pane.id, "live"); } } Rectangle { border-radius: 8px; border-width: 1px; border-color: Theme.border; background: Theme.surface; VerticalLayout { padding: 18px; spacing: 7px;
                                    HorizontalLayout { InspectorLabel { text: GuiI18n.text("gui-exact-target"); } BodyText { text: GuiI18n.values("gui-target-summary", host.server.minecraft, host.server.loader); overflow: elide; horizontal-stretch: 1; } }
                                    HorizontalLayout { InspectorLabel { text: GuiI18n.text("gui-runtime"); } BodyText { text: host.server.state + " | " + host.server.state-detail; overflow: elide; horizontal-stretch: 1; } if host.server.restart-required : VerticalLayout { alignment: center; Pill { text: GuiI18n.text("gui-server-restart-required"); tone-color: Theme.warning; } } }
                                    HorizontalLayout { InspectorLabel { text: GuiI18n.text("gui-network"); } BodyText { text: host.server.address; overflow: elide; horizontal-stretch: 1; } }
                                    HorizontalLayout { InspectorLabel { text: GuiI18n.text("gui-storage"); } BodyText { text: host.server.storage; overflow: elide; horizontal-stretch: 1; } }
                                    HorizontalLayout { InspectorLabel { text: GuiI18n.text("gui-relationship"); } BodyText { text: host.server.relationship; overflow: elide; horizontal-stretch: 1; } }
                                    if host.server.linked-client-id != "" : HorizontalLayout { InspectorLabel { text: GuiI18n.text("gui-paired-with"); } BodyText { text: host.server.paired-client-id != "" ? host.server.paired-client-name : GuiI18n.text("gui-not-paired"); overflow: elide; horizontal-stretch: 1; } if pair-display != "" : VerticalLayout { alignment: center; StatePill { state: host.pair-state; state-kind: host.pair-state-kind; restarting: host.pair-restart-stage != ""; } } }
                                } }
                                    HorizontalLayout { spacing: 8px; alignment: start; AppButton { text: GuiI18n.text("gui-view-logs"); clicked => { root.show-pane-surface(pane.id, "Logs"); } } if host.server.linked-client-id != "" : AppButton { text: GuiI18n.text("gui-launch-client-connect"); tone: "primary"; enabled: host.server.can-connect; hint: host.server.connect-reason; clicked => { root.launch-and-connect(host.server.linked-client-id, host.id); } } if host.server.paired-client-id != "" && !host.pair-shown : AppButton { text: GuiI18n.text("gui-pair-show-beside"); enabled: host.pair-room; hint: host.pair-room ? "" : GuiI18n.text("gui-pair-no-room"); clicked => { root.show-linked-pair(pane.id, "client", host.server.paired-client-id); } } if host.server.state-kind == "needs-recovery" : AppButton { text: GuiI18n.text("gui-repair-server"); tone: "primary"; clicked => { root.repair-server(host.id); } } if !server-overview.narrow && host.server.linked-client-id != "" : AppButton { text: host.server.paired-client-id != "" ? GuiI18n.text("gui-unpair") : GuiI18n.text("gui-pair-with-client"); clicked => { if host.server.paired-client-id != "" { root.clear-linked-pair(host.server.paired-client-id); } else { root.set-linked-pair(host.server.linked-client-id, host.id, false); } } } if !server-overview.narrow : AppButton { text: GuiI18n.text("gui-delete-server"); tone: "danger"; clicked => { root.pending-action-id = host.id; root.pending-action-name = host.server.name; root.pending-snapshot-deletion-note = host.server.snapshot-deletion-note; root.modal-error = ""; root.modal = "delete-server"; } } }
                                    if server-overview.narrow : HorizontalLayout { spacing: 8px; alignment: start; if host.server.linked-client-id != "" : AppButton { text: host.server.paired-client-id != "" ? GuiI18n.text("gui-unpair") : GuiI18n.text("gui-pair-with-client"); clicked => { if host.server.paired-client-id != "" { root.clear-linked-pair(host.server.paired-client-id); } else { root.set-linked-pair(host.server.linked-client-id, host.id, false); } } } AppButton { text: GuiI18n.text("gui-delete-server"); tone: "danger"; clicked => { root.pending-action-id = host.id; root.pending-action-name = host.server.name; root.pending-snapshot-deletion-note = host.server.snapshot-deletion-note; root.modal-error = ""; root.modal = "delete-server"; } } }
                                    if host.server.paired-client-id != "" : InlineToggle { label: GuiI18n.text("gui-pair-start-together"); checked: host.server.pair-start-together; toggled(value) => { root.set-linked-pair(host.server.paired-client-id, host.id, value); } } } }
                                if host.available && host.kind == "server" && pane.surface == "Snapshots" : SnapshotPanel {
                                    items: host.snapshots; total: host.snapshot-total; has-plain-copies: host.snapshots-have-plain-copies;
                                    create => { root.snapshot-host-kind = host.kind; root.snapshot-host-id = host.id; root.snapshot-action-label = ""; root.recompute-snapshot-label(); root.modal-error = ""; root.modal = "snapshot-create"; }
                                    restore(id, label) => { root.snapshot-host-kind = host.kind; root.snapshot-host-id = host.id; root.snapshot-action-id = id; root.snapshot-action-label = label; root.snapshot-safety-copy = true; root.modal-error = ""; root.modal = "snapshot-restore"; }
                                    rename(id, label) => { root.snapshot-host-kind = host.kind; root.snapshot-host-id = host.id; root.snapshot-action-id = id; root.snapshot-action-label = label; root.modal-error = ""; root.modal = "snapshot-rename"; }
                                    delete(id, label) => { root.snapshot-host-kind = host.kind; root.snapshot-host-id = host.id; root.snapshot-action-id = id; root.snapshot-action-label = label; root.modal-error = ""; root.modal = "snapshot-delete"; }
                                }
                                if host.available && host.kind == "server" && pane.surface == "Console" : VerticalLayout { spacing: 10px;
                                    if host.server.console-status != "" : BodyText { text: host.server.console-status; wrap: word-wrap; }
                                    LiveLogViewer {
                                        vertical-stretch: 1;
                                        chunks: log-view.chunks; has-content: log-view.has-content; status: log-view.status; history-truncated: log-view.history-truncated; pending-lines: log-view.pending-lines; content-columns: log-view.content-columns; font-size: root.technical-text-size * 1px; query: log-view.query; wrap-lines: log-view.wrap-lines; follow: log-view.follow; trace-enabled: log-view.trace-enabled; debug-enabled: log-view.debug-enabled; info-enabled: log-view.info-enabled; warn-enabled: log-view.warn-enabled; error-enabled: log-view.error-enabled; fatal-enabled: log-view.fatal-enabled; other-enabled: log-view.other-enabled; revision: log-view.revision; selection-start-row: log-view.selection-start-row; selection-start-offset: log-view.selection-start-offset; selection-end-row: log-view.selection-end-row; selection-end-offset: log-view.selection-end-offset; has-selection: log-view.has-selection; selection-revision: log-view.selection-revision;
                                        set-level(level, enabled) => { root.log-set-level(pane.id, level, enabled); } search(query) => { root.log-search(pane.id, query); } copy => { root.log-copy(pane.id); } copy-selection => { root.log-copy-selection(pane.id); } select-at(row, column, extend) => { root.log-select-at(pane.id, row, column, extend); } select-word-at(row, column) => { root.log-select-word-at(pane.id, row, column); } select-all => { root.log-select-all(pane.id); } follow-changed(follow) => { root.log-follow(pane.id, follow); } wrap-changed(wrap) => { root.log-wrap(pane.id, wrap); }
                                    }
                                    ServerCommandInput {
                                        server-id: host.id;
                                        available: host.server.can-send-command;
                                        unavailable-reason: host.server.console-status;
                                        completion: host.server.console-completion;
                                        delivered: host.server.console-delivered;
                                        send(command) => { root.server-console(host.id, command); }
                                    }
                                }
                                if host.available && host.kind == "server" && pane.surface == "Mods" : HorizontalLayout {
                                    spacing: 16px;
                                    ManagedModsPanel {
                                        width: host.server.installed && host.server.loader-kind != "vanilla" ? 46% : 100%;
                                        host: host;
                                        detail: GuiI18n.text("gui-server-mods-detail");
                                        empty-detail: GuiI18n.text("gui-no-server-mods-detail");
                                        mods-are-the-users: host.mods-are-the-users;
                                        filter(text) => { root.filter-mods("server", host.id, text); }
                                        add-jars => { root.pick-local-mods("server", host.id); }
                                        refresh => { root.refresh-mods("server", host.id); }
                                        manage(path) => { root.open-mod-manager("server", host.id, path); }
                                        toggle(path, on) => { root.set-mod-enabled("server", host.id, path, on); }
                                        restore-file(path) => { root.restore-mod-file("server", host.id, path); }
                                        delete-file(mod, path, title) => { root.pending-action-kind = "server"; root.pending-action-id = host.id; root.pending-action-name = title; root.mod-action-path = path; root.mod-action-name = title; root.mod-action-is-hand-placed = mod.origin-kind == "hand-placed"; root.modal-error = ""; root.mod-remove-returns-to-manager = false; if mod.can-delete-file && !(host.mods-are-the-users && mod.can-remove) { root.modal = "delete-mod"; } else { root.plan-mod-removal("server", host.id, path); } }
                                        if host.crash-report != "" : CrashNotice { report: host.crash-report; failure: host.crash-failure; client-code-on-server: host.crash-client-code-on-server; suggested: host.crash-suggested; beside-the-mods: true; disable-suggested => { root.disable-suggested-mods(host.id); } routes: host.run-failure-title == "" || host.run-eula-refused; open-crash-report => { root.show-pane-surface(pane.id, "Logs"); root.log-show(pane.id, "crashes"); root.log-open-file(pane.id, host.crash-report); } }
                                    }
                                    if host.server.installed && host.server.loader-kind != "vanilla" : ModBrowser {
                                        horizontal-stretch: 1;
                                        host: host;
                                        page-sizes: root.mod-page-sizes;
                                        page-size-label: root.mod-page-size-label;
                                        switch-catalog(provider) => { root.switch-mod-catalog(host.kind, host.id, provider); }
                                        search(provider, text) => { root.search-mods(host.kind, host.id, provider, text); }
                                        load-more(provider, text, offset) => { root.load-more-mods(host.kind, host.id, provider, text, offset); }
                                        install(project) => { root.install-from-browser(host.kind, host.id, host.browser-provider, project); }
                                        set-include-incompatible(on) => { root.set-mod-include-incompatible(host.kind, host.id, on); }
                                        set-page-size(label) => { root.set-mod-page-size(label); }
                                        // Closing the workspace drops this pane mid-handler, so navigate first.
                                        open-provider-settings => { root.page = 4; root.settings-tab = "Providers & APIs"; root.close-workspace(); }
                                    }
                                }
                                if host.available && host.kind == "server" && pane.surface == "Properties" : ServerPropertiesForm {
                                    host: host;
                                    eula-accepted: root.eula-accepted;
                                    eula-status: root.eula-status;
                                    save(id, online, access, address, port) => { root.save-server-properties(id, online, access, address, port); }
                                    edit(id, key, value) => { root.edit-server-property(id, key, value); }
                                    choose(id, key, index) => { root.choose-server-property(id, key, index); }
                                    show-advanced(id, show) => { root.show-advanced-server-properties(id, show); }
                                    discard(id) => { root.discard-server-properties(id); }
                                    review-eula => { root.modal = "eula"; }
                                }
                            }
                        }
                    }
                }

                // What is running, which is a different question from what
                // the launcher is doing: an operation has a progress
                // fraction and a Cancel, and a running game has neither.
                if root.page == 2 : Rectangle { horizontal-stretch: 1; background: Theme.background;
                    VerticalLayout { padding: 24px; spacing: 18px;
                        PageIntro { title: GuiI18n.text("gui-running"); subtitle: GuiI18n.text("gui-running-detail"); }
                        if root.running.length == 0 : EmptyState { icon: @image-url("../../../assets/icons/nav-activity.svg"); title: GuiI18n.text("gui-nothing-running"); message: GuiI18n.text("gui-nothing-running-detail"); }
                        ScrollView { viewport-width: self.width; VerticalLayout { spacing: 10px; for item in root.running : RunningCard {
                            item: item;
                            open-log(kind, id) => { root.open-workspace(kind, id, "Logs"); }
                            open-console(id) => { root.open-workspace("server", id, "Console"); }
                            open-workspace(kind, id) => { root.open-workspace(kind, id, "Overview"); }
                            stop(kind, id) => { if kind == "server" { root.server-stop(id); } else { root.kill-instance(id, item.launch); } }
                            force-stop(id, launch) => { root.force-stop-launch(id, launch); }
                        } } }
                    }
                }

                if root.page == 3 : Rectangle { horizontal-stretch: 1; background: Theme.background;
                    VerticalLayout { padding: 24px; spacing: 18px;
                        PageIntro { title: GuiI18n.text("gui-activity"); subtitle: GuiI18n.text("gui-activity-detail"); }
                        if root.activities.length == 0 : EmptyState { icon: @image-url("../../../assets/icons/nav-activity.svg"); title: GuiI18n.text("gui-no-recent-activity"); message: GuiI18n.text("gui-no-recent-activity-detail"); }
                        ScrollView { viewport-width: self.width; VerticalLayout { spacing: 10px; for item in root.activities : ActivityCard { item: item; cancel(id) => { root.cancel-operation(id); } } } }
                    }
                }

                // Settings.
                if root.page == 4 : HorizontalLayout { spacing: 0px; horizontal-stretch: 1;
                    Rectangle { width: 208px; background: Theme.surface; border-width: 1px; border-color: Theme.border; VerticalLayout { padding: 14px; spacing: 5px; Eyebrow { text: GuiI18n.text("gui-settings-heading"); }
                        Rectangle { height: 5px; }
                        SettingsNavItem { label: GuiI18n.text("gui-settings-general"); selected: root.settings-tab == "General"; clicked => { root.settings-tab = "General"; } }
                        SettingsNavItem { label: GuiI18n.text("gui-settings-minecraft"); selected: root.settings-tab == "Minecraft"; clicked => { root.settings-tab = "Minecraft"; root.request-version-catalog(); } }
                        SettingsNavItem { label: GuiI18n.text("gui-settings-server-properties"); selected: root.settings-tab == "Server Properties"; clicked => { root.settings-tab = "Server Properties"; } }
                        SettingsNavItem { label: GuiI18n.text("gui-settings-java"); selected: root.settings-tab == "Java"; clicked => { root.settings-tab = "Java"; root.load-java-runtimes(); } }
                        SettingsNavItem { label: GuiI18n.text("gui-settings-accounts"); selected: root.settings-tab == "Accounts"; clicked => { root.settings-tab = "Accounts"; } }
                        SettingsNavItem { label: GuiI18n.text("gui-settings-providers"); selected: root.settings-tab == "Providers & APIs"; clicked => { root.settings-tab = "Providers & APIs"; } }
                        // Measuring walks the cache, so it happens when the page
                        // that shows the figure is opened rather than on every
                        // refresh of everything else.
                        SettingsNavItem { label: GuiI18n.text("gui-settings-storage"); selected: root.settings-tab == "Storage"; clicked => { root.settings-tab = "Storage"; root.measure-artifact-cache(); } }
                        // Measured when asked for, not on opening: a large
                        // installation takes a while to walk.
                        SettingsNavItem { label: GuiI18n.text("gui-settings-disk-usage"); selected: root.settings-tab == "Disk Usage"; clicked => { root.settings-tab = "Disk Usage"; } }
                        // The launcher's logs change as the launcher runs, so the
                        // offer is read again whenever the page is opened.
                        SettingsNavItem { label: GuiI18n.text("gui-settings-diagnostics"); selected: root.settings-tab == "Diagnostics"; clicked => { root.settings-tab = "Diagnostics"; root.request-launcher-bundle(); } }
                        Rectangle { vertical-stretch: 1; }
                        Divider { }
                        SettingsNavItem { label: GuiI18n.text("gui-settings-about"); selected: root.settings-tab == "About & Licenses"; clicked => { root.settings-tab = "About & Licenses"; } }
                    } }
                    Rectangle { horizontal-stretch: 1; background: Theme.background; ScrollView { viewport-width: self.visible-width; VerticalLayout { x: max(0px, (parent.width - self.width) / 2); alignment: start; width: min(parent.width, root.settings-two-columns ? 1500px : 1100px); padding: 30px; spacing: 20px;
                        PageIntro {
                            title: root.settings-tab == "General" ? GuiI18n.text("gui-settings-general") : root.settings-tab == "Minecraft" ? GuiI18n.text("gui-settings-minecraft") : root.settings-tab == "Server Properties" ? GuiI18n.text("gui-settings-server-properties") : root.settings-tab == "Java" ? GuiI18n.text("gui-settings-java") : root.settings-tab == "Accounts" ? GuiI18n.text("gui-settings-accounts") : root.settings-tab == "Providers & APIs" ? GuiI18n.text("gui-settings-providers") : root.settings-tab == "Storage" ? GuiI18n.text("gui-settings-storage") : root.settings-tab == "Disk Usage" ? GuiI18n.text("gui-settings-disk-usage") : root.settings-tab == "Diagnostics" ? GuiI18n.text("gui-settings-diagnostics") : GuiI18n.text("gui-settings-about");
                            subtitle: root.settings-tab == "Minecraft" ? GuiI18n.text("gui-minecraft-defaults-detail") : root.settings-tab == "Server Properties" ? GuiI18n.text("gui-server-defaults-intro") : root.settings-tab == "Java" ? GuiI18n.text("gui-java-detail") : root.settings-tab == "Accounts" ? GuiI18n.text("gui-accounts-detail") : root.settings-tab == "Providers & APIs" ? GuiI18n.text("gui-provider-detail") : root.settings-tab == "Storage" ? GuiI18n.text("gui-storage-detail") : root.settings-tab == "Disk Usage" ? GuiI18n.text("gui-disk-usage-page-detail") : root.settings-tab == "Diagnostics" ? GuiI18n.text("gui-launcher-diagnostics-detail") : root.settings-tab == "About & Licenses" ? GuiI18n.text("gui-tagline") : GuiI18n.text("gui-settings-detail");
                        }
                        if root.settings-tab == "General" : VerticalLayout { alignment: start; spacing: 14px;
                            // Side by side where the window is wide enough for two
                            // readable columns, stacked where it is not. One grid
                            // for both arrangements, so each heading and each
                            // section is declared once: the cells they sit in move,
                            // not the things themselves.
                            //
                            // Headings share a row so that the first card of each
                            // column starts at the same height, whatever number of
                            // lines a heading's description wraps to. Every card
                            // sits in the grid itself rather than in a column of
                            // its own, so a card and the one beside it share a row
                            // and end level however their descriptions wrap.
                            GridLayout {
                                spacing: 14px;
                                SectionTitle {
                                    row: 0; col: 0;
                                    title: GuiI18n.text("gui-linked-server-defaults");
                                    detail: GuiI18n.text("gui-linked-server-defaults-detail");
                                }
                                SectionTitle {
                                    row: root.settings-two-columns ? 0 : 4;
                                    col: root.settings-two-columns ? 1 : 0;
                                    title: GuiI18n.text("gui-application-display");
                                    detail: GuiI18n.text("gui-application-display-detail");
                                }
                                SettingCard {
                                    row: 1; col: 0;
                                    width: root.settings-two-columns ? (parent.width - 14px) / 2 : parent.width;
                                    title: GuiI18n.text("gui-show-linked-servers");
                                    detail: GuiI18n.text("gui-show-linked-servers-detail");
                                    Toggle { accessible-name: GuiI18n.text("gui-show-linked-servers"); checked <=> root.show-linked-servers; toggled => { root.save-general-settings(root.application-text-scale, root.technical-text-size, root.application-theme, root.show-linked-servers, root.make-default-account-operator, root.operator-permission-level); } }
                                }
                                SettingCard {
                                    row: 2; col: 0;
                                    width: root.settings-two-columns ? (parent.width - 14px) / 2 : parent.width;
                                    title: GuiI18n.text("gui-default-account-operator");
                                    detail: GuiI18n.text("gui-default-account-operator-detail");
                                    Toggle { accessible-name: GuiI18n.text("gui-default-account-operator"); checked <=> root.make-default-account-operator; toggled => { root.save-general-settings(root.application-text-scale, root.technical-text-size, root.application-theme, root.show-linked-servers, root.make-default-account-operator, root.operator-permission-level); } }
                                }
                                SettingCard {
                                    row: 3; col: 0;
                                    width: root.settings-two-columns ? (parent.width - 14px) / 2 : parent.width;
                                    title: GuiI18n.text("gui-default-operator-level");
                                    detail: GuiI18n.text("gui-default-operator-level-detail");
                                    IndexComboBox { label: GuiI18n.text("gui-default-operator-level"); width: 220px; model: [GuiI18n.text("gui-operator-level-1"), GuiI18n.text("gui-operator-level-2"), GuiI18n.text("gui-operator-level-3"), GuiI18n.text("gui-operator-level-4")]; index: root.operator-permission-level - 1; selected(index, value) => { root.operator-permission-level = value == GuiI18n.text("gui-operator-level-1") ? 1 : value == GuiI18n.text("gui-operator-level-2") ? 2 : value == GuiI18n.text("gui-operator-level-3") ? 3 : 4; root.save-general-settings(root.application-text-scale, root.technical-text-size, root.application-theme, root.show-linked-servers, root.make-default-account-operator, root.operator-permission-level); } }
                                }
                                SettingCard {
                                    row: root.settings-two-columns ? 1 : 5;
                                    col: root.settings-two-columns ? 1 : 0;
                                    width: root.settings-two-columns ? (parent.width - 14px) / 2 : parent.width;
                                    title: GuiI18n.text("gui-application-text-size");
                                    detail: GuiI18n.text("gui-application-text-size-detail");
                                    IndexComboBox { width: 190px; model: [GuiI18n.text("gui-text-scale-90"), GuiI18n.text("gui-text-scale-100"), GuiI18n.text("gui-text-scale-110"), GuiI18n.text("gui-text-scale-125")]; index: root.application-text-scale == 90 ? 0 : root.application-text-scale == 110 ? 2 : root.application-text-scale == 125 ? 3 : 1; selected(index, value) => { root.application-text-scale = value == GuiI18n.text("gui-text-scale-90") ? 90 : value == GuiI18n.text("gui-text-scale-110") ? 110 : value == GuiI18n.text("gui-text-scale-125") ? 125 : 100; root.save-general-settings(root.application-text-scale, root.technical-text-size, root.application-theme, root.show-linked-servers, root.make-default-account-operator, root.operator-permission-level); } }
                                }
                                SettingCard {
                                    row: root.settings-two-columns ? 2 : 6;
                                    col: root.settings-two-columns ? 1 : 0;
                                    width: root.settings-two-columns ? (parent.width - 14px) / 2 : parent.width;
                                    title: GuiI18n.text("gui-application-color-scheme");
                                    detail: GuiI18n.text("gui-application-color-scheme-detail");
                                    // A count here and the list in a dialog, so the card beside it keeps its height.
                                    note: root.theme-problems.length > 0 ? GuiI18n.count("gui-theme-problems-summary", root.theme-problems.length) : "";
                                    VerticalLayout {
                                        spacing: 8px;
                                        alignment: center;
                                        ChoiceBox { width: 190px; accessible-label: GuiI18n.text("gui-application-color-scheme"); model: root.theme-labels; current-index <=> root.theme-index; selected(value) => { root.application-theme = root.theme-ids[self.current-index]; root.save-general-settings(root.application-text-scale, root.technical-text-size, root.application-theme, root.show-linked-servers, root.make-default-account-operator, root.operator-permission-level); } }
                                        if root.theme-problems.length > 0 : AppButton { text: GuiI18n.text("gui-show-theme-problems"); clicked => { root.modal = "theme-problems"; } }
                                    }
                                }
                                SettingCard {
                                    row: root.settings-two-columns ? 3 : 7;
                                    col: root.settings-two-columns ? 1 : 0;
                                    width: root.settings-two-columns ? (parent.width - 14px) / 2 : parent.width;
                                    title: GuiI18n.text("gui-seasonal-themes");
                                    detail: GuiI18n.text("gui-seasonal-themes-detail");
                                    note: root.seasonal-theme-note;
                                    Toggle { accessible-name: GuiI18n.text("gui-seasonal-themes"); sets-its-own-position: false; checked: root.seasonal-themes; toggled(value) => { root.set-seasonal-themes(value); } }
                                }
                                SettingCard {
                                    row: root.settings-two-columns ? 4 : 8;
                                    col: root.settings-two-columns ? 1 : 0;
                                    width: root.settings-two-columns ? (parent.width - 14px) / 2 : parent.width;
                                    title: GuiI18n.text("gui-technical-text-size");
                                    detail: GuiI18n.text("gui-technical-text-size-detail");
                                    IndexComboBox { width: 190px; model: [GuiI18n.text("gui-technical-size-11"), GuiI18n.text("gui-technical-size-12"), GuiI18n.text("gui-technical-size-14"), GuiI18n.text("gui-technical-size-16")]; index: root.technical-text-size == 11 ? 0 : root.technical-text-size == 14 ? 2 : root.technical-text-size == 16 ? 3 : 1; selected(index, value) => { root.technical-text-size = value == GuiI18n.text("gui-technical-size-11") ? 11 : value == GuiI18n.text("gui-technical-size-14") ? 14 : value == GuiI18n.text("gui-technical-size-16") ? 16 : 12; root.save-general-settings(root.application-text-scale, root.technical-text-size, root.application-theme, root.show-linked-servers, root.make-default-account-operator, root.operator-permission-level); } }
                                }
                            }
                            // The same decision the mod dialog's own "do
                            // not ask again" records, somewhere it can be
                            // taken back. Without this, turning it off is
                            // a one-way door out of a dialog.
                            SectionTitle { title: GuiI18n.text("gui-mod-changes"); detail: GuiI18n.text("gui-mod-changes-detail"); }
                            GridLayout {
                                spacing: 14px;
                                SettingCard {
                                    row: 0;
                                    col: 0;
                                    width: root.settings-two-columns ? (parent.width - 14px) / 2 : parent.width;
                                    title: GuiI18n.text("gui-follow-dependencies");
                                    detail: GuiI18n.text("gui-follow-dependencies-detail");
                                    Toggle { accessible-name: GuiI18n.text("gui-follow-dependencies"); sets-its-own-position: false; checked: root.follow-mod-dependencies; toggled(value) => { root.set-dependency-following(value); } }
                                }
                                // Greyed rather than hidden while nothing is
                                // being carried along: with no other mod
                                // changing, there is nothing for a
                                // confirmation to be about, and a row that
                                // vanished would read as a setting that was
                                // lost.
                                SettingCard {
                                    row: root.settings-two-columns ? 0 : 1;
                                    col: root.settings-two-columns ? 1 : 0;
                                    width: root.settings-two-columns ? (parent.width - 14px) / 2 : parent.width;
                                    title: GuiI18n.text("gui-dependency-warning");
                                    detail: root.follow-mod-dependencies ? GuiI18n.text("gui-dependency-warning-detail") : GuiI18n.text("gui-dependency-warning-unused");
                                    Toggle { accessible-name: GuiI18n.text("gui-dependency-warning"); enabled: root.follow-mod-dependencies; sets-its-own-position: false; checked: root.warn-on-dependency-impact && root.follow-mod-dependencies; toggled(value) => { root.set-dependency-warning(value); } }
                                }
                            }
                            // Whether the scheme is claimed at all is settled by
                            // installing, not here (ADR 0028, ADR 0029). What this page
                            // manages is the answers the user has given to link prompts.
                            SectionTitle { title: GuiI18n.text("gui-trusted-pack-hosts"); detail: GuiI18n.text("gui-trusted-pack-hosts-detail"); }
                            if root.trusted-pack-hosts.length == 0 : Rectangle {
                                width: min(parent.width, 520px);
                                height: max(46px, no-trusted-hosts.preferred-height + 22px);
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: Theme.border;
                                background: Theme.surface;
                                no-trusted-hosts := BodyText { x: 14px; width: parent.width - 28px; text: GuiI18n.text("gui-no-trusted-pack-hosts"); color: Theme.text-muted; wrap: word-wrap; }
                            }
                            // The same row the favorite versions below use, because it
                            // is the same thing: one remembered value and one way to
                            // take it back.
                            for host in root.trusted-pack-hosts : Rectangle {
                                width: min(parent.width, 520px);
                                height: 48px;
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: Theme.border;
                                background: Theme.surface;
                                HorizontalLayout {
                                    padding-left: 14px; padding-right: 8px; padding-top: 6px; padding-bottom: 6px; spacing: 10px;
                                    BodyText { text: host; color: Theme.text; horizontal-stretch: 1; vertical-alignment: center; overflow: elide; }
                                    VerticalLayout { alignment: center; AppButton { text: GuiI18n.text("gui-forget-pack-host"); tone: "danger"; clicked => { root.forget-pack-host(host); } } }
                                }
                            }
                            SectionTitle { title: GuiI18n.text("gui-favorite-versions"); detail: GuiI18n.text("gui-favorite-versions-detail"); }
                            if root.favorite-minecraft-versions.length == 0 : Rectangle { height: max(46px, no-favorites.preferred-height + 22px); border-radius: 6px; border-width: 1px; border-color: Theme.border; background: Theme.surface;
                                no-favorites := BodyText { x: 12px; width: parent.width - 24px; text: GuiI18n.text("gui-no-favorite-versions"); color: Theme.text-muted; wrap: word-wrap; }
                            }
                            for version in root.favorite-minecraft-versions : Rectangle {
                                width: min(parent.width, 520px);
                                height: 48px;
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: Theme.border;
                                background: Theme.surface;
                                HorizontalLayout {
                                    padding-left: 14px; padding-right: 8px; padding-top: 6px; padding-bottom: 6px; spacing: 10px;
                                    BodyText { text: version; color: Theme.text; horizontal-stretch: 1; vertical-alignment: center; overflow: elide; }
                                    VerticalLayout { alignment: center; FavoriteToggle { version: version; favorite: true; toggled => { root.remove-favorite-version(version); } } }
                                }
                            }
                        }
                        // The screen keeps its own height and scrolls only the
                        // rows, so the category tabs, the filter, and Save and
                        // Discard stay reachable however long the list is.
                        if root.settings-tab == "Minecraft" : VerticalLayout { spacing: 12px;
                            height: max(360px, root.height - 258px);
                            if root.minecraft-preserved-notice != "" : Rectangle { height: max(46px, preserved-text.preferred-height + 22px); border-radius: 6px; border-width: 1px; border-color: Theme.border; background: Theme.surface;
                                preserved-text := BodyText { x: 12px; width: parent.width - 24px; text: root.minecraft-preserved-notice; color: Theme.text-muted; wrap: word-wrap; }
                            }
                            if root.minecraft-unusable-notice != "" : Rectangle { height: max(46px, unusable-text.preferred-height + 22px); border-radius: 6px; border-width: 1px; border-color: Theme.warning.with-alpha(0.55); background: Theme.surface;
                                unusable-text := BodyText { x: 12px; width: parent.width - 24px; text: root.minecraft-unusable-notice; color: Theme.warning; wrap: word-wrap; }
                            }
                            // The five stable catalog categories. They wrap
                            // rather than shrink, so a narrow window keeps
                            // every tab readable and reachable.
                            Rectangle { height: category-tabs.preferred-height; vertical-stretch: 0; background: transparent;
                                category-tabs := HorizontalLayout { spacing: 4px; alignment: start;
                                    for category[index] in root.minecraft-categories : WorkspaceTab {
                                        text: category;
                                        min-width: max(88px, self.preferred-width);
                                        selected: index == root.minecraft-category-index;
                                        clicked => { root.minecraft-select-category(index); }
                                    }
                                }
                            }
                            Divider { }
                            HorizontalLayout { spacing: 10px; cross-axis-alignment: center; vertical-stretch: 0;
                                filter-field := TextField {
                                    horizontal-stretch: 1;
                                    max-width: 340px;
                                    placeholder: GuiI18n.text("gui-minecraft-filter");
                                    accessible-name: GuiI18n.text("gui-minecraft-filter");
                                    input-type: InputType.search;
                                    edited(value) => { root.minecraft-query = value; root.minecraft-set-query(value); }
                                }
                                if root.minecraft-query != "" : AppButton { text: GuiI18n.text("gui-clear"); min-width: 84px; clicked => { filter-field.text = ""; root.minecraft-query = ""; root.minecraft-set-query(""); } }
                                Rectangle { horizontal-stretch: 1; min-width: 4px; }
                                BodyText { text: GuiI18n.text("gui-minecraft-only-overridden"); horizontal-stretch: 0; }
                                Toggle { accessible-name: GuiI18n.text("gui-minecraft-only-overridden"); checked: root.minecraft-only-overridden; toggled(value) => { root.minecraft-set-only-overridden(value); } }
                                BodyText { text: GuiI18n.text("gui-minecraft-show-advanced"); horizontal-stretch: 0; }
                                Toggle { accessible-name: GuiI18n.text("gui-minecraft-show-advanced"); checked: root.minecraft-show-advanced; toggled(value) => { root.minecraft-set-show-advanced(value); } }
                            }
                            HorizontalLayout { spacing: 10px; cross-axis-alignment: center; vertical-stretch: 0;
                                VerticalLayout { horizontal-stretch: 1; spacing: 2px;
                                    FieldLabel { text: GuiI18n.text("gui-minecraft-preview"); }
                                    BodyText { text: GuiI18n.text("gui-minecraft-preview-detail"); color: Theme.text-muted; wrap: word-wrap; }
                                }
                                ValueComboBox {
                                    width: root.compact-layout ? 150px : 190px;
                                    label: GuiI18n.text("gui-minecraft-preview");
                                    model: root.minecraft-releases;
                                    value: root.minecraft-preview-release;
                                    selected(value) => { root.minecraft-set-preview-release(value); }
                                }
                            }
                            ScrollView { vertical-stretch: 1; viewport-width: self.width; VerticalLayout { alignment: start; spacing: 12px;
                            if root.minecraft-preference-rows.length == 0 : EmptyState { title: GuiI18n.text("gui-minecraft-no-matches"); message: GuiI18n.text("gui-minecraft-no-matches-detail"); }
                            for row in root.minecraft-preference-rows : MinecraftPreferenceRowCard {
                                item: row;
                                compact: root.compact-layout;
                                capturing: root.minecraft-capturing-id == row.id;
                                languages-available: root.minecraft-languages-available;
                                set-boolean(id, on) => { root.minecraft-set-boolean(id, on); }
                                set-number(id, value) => { root.minecraft-set-number(id, value); }
                                edit-number(id, value) => { root.minecraft-edit-number(id, value); }
                                commit-number(id, value) => { root.minecraft-commit-number(id, value); }
                                set-enumeration(id, index) => { root.minecraft-set-enumeration(id, index); }
                                set-language(id, index) => { root.minecraft-set-language(id, index); }
                                aspect-labels: root.minecraft-aspect-labels;
                                edit-window(id, width, height) => { root.minecraft-edit-window(id, width, height); }
                                commit-window-width(id, width, height) => { root.minecraft-commit-window-width(id, width, height); }
                                commit-window-height(id, width, height) => { root.minecraft-commit-window-height(id, width, height); }
                                set-window-aspect(id, index) => { root.minecraft-set-window-aspect(id, index); }
                                set-window-lock(id, held) => { root.minecraft-set-window-lock(id, held); }
                                open-window-preview(id) => { root.minecraft-open-window-preview(id); }
                                commit-text(id, value) => { root.minecraft-commit-text(id, value); }
                                forget(id) => { root.minecraft-forget-preference(id); }
                                begin-capture(id) => { root.minecraft-begin-capture(id); }
                                cancel-capture => { root.minecraft-cancel-capture(); }
                                captured-key(id, reported) => { root.minecraft-captured-key(id, reported); }
                                captured-mouse(id, reported) => { root.minecraft-captured-mouse(id, reported); }
                                retry-languages => { root.minecraft-retry-languages(); }
                            }
                            } }
                            Divider { }
                            HorizontalLayout { spacing: 10px; cross-axis-alignment: center; vertical-stretch: 0;
                                BodyText { text: root.minecraft-dirty ? GuiI18n.count("gui-minecraft-unsaved-count", root.minecraft-dirty-count) : GuiI18n.count("gui-minecraft-total-count", root.minecraft-total-count); color: root.minecraft-dirty ? Theme.accent : Theme.text-muted; horizontal-stretch: 1; wrap: word-wrap; }
                                AppButton { text: GuiI18n.text("gui-discard-changes"); enabled: root.minecraft-dirty && !root.minecraft-saving; hint: root.minecraft-saving ? GuiI18n.text("gui-save-in-progress-hint") : GuiI18n.text("gui-hint-no-unsaved-changes"); clicked => { root.minecraft-discard-defaults(); } }
                                AppButton { text: GuiI18n.text("gui-save-changes"); tone: "primary"; enabled: root.minecraft-can-save && !root.minecraft-saving; hint: root.minecraft-saving ? GuiI18n.text("gui-save-in-progress-hint") : GuiI18n.text("gui-hint-nothing-to-save"); clicked => { root.minecraft-save-defaults(); } }
                            }
                        }
                        if root.settings-tab == "Server Properties" : ServerDefaultsPanel {
                            height: max(360px, root.height - 258px);
                            groups: root.server-defaults-groups;
                            edits: root.server-defaults-edits;
                            invalid: root.server-defaults-invalid;
                            show-advanced: root.server-defaults-show-advanced;
                            edit(key, value) => { root.edit-server-default(key, value); }
                            choose(key, index) => { root.choose-server-default(key, index); }
                            reset(key) => { root.reset-server-default(key); }
                            advanced(show) => { root.show-advanced-server-defaults(show); }
                            discard => { root.discard-server-defaults(); }
                            save => { root.save-server-defaults(); }
                        }
                        if root.settings-tab == "Java" : VerticalLayout { spacing: 14px;
                            // The same cards the General page uses, two to a row
                            // where the window is wide enough for them.
                            GridLayout {
                                spacing: 14px;
                                SettingCard {
                                    row: 0; col: 0;
                                    title: GuiI18n.text("gui-java-detect");
                                    detail: GuiI18n.text("gui-java-detect-detail");
                                    Toggle { accessible-name: GuiI18n.text("gui-java-detect"); checked <=> root.java-auto-detect; }
                                }
                                SettingCard {
                                    row: root.settings-two-columns ? 0 : 1;
                                    col: root.settings-two-columns ? 1 : 0;
                                    title: GuiI18n.text("gui-java-download");
                                    detail: GuiI18n.text("gui-java-download-detail");
                                    Toggle { accessible-name: GuiI18n.text("gui-java-download"); checked <=> root.java-auto-download; }
                                }
                                SettingCard {
                                    row: root.settings-two-columns ? 1 : 2;
                                    col: 0;
                                    title: GuiI18n.text("gui-java-memory");
                                    detail: GuiI18n.text("gui-java-memory-detail");
                                    HorizontalLayout { spacing: 12px;
                                        VerticalLayout { spacing: 4px; FieldLabel { text: GuiI18n.text("gui-java-memory-min"); } TextField { text <=> root.java-memory-min; accessible-name: GuiI18n.text("gui-java-memory-min"); input-type: InputType.number; width: 130px; } }
                                        VerticalLayout { spacing: 4px; FieldLabel { text: GuiI18n.text("gui-java-memory-max"); } TextField { text <=> root.java-memory-max; accessible-name: GuiI18n.text("gui-java-memory-max"); input-type: InputType.number; width: 130px; } }
                                    }
                                }
                                SettingCard {
                                    row: root.settings-two-columns ? 1 : 3;
                                    col: root.settings-two-columns ? 1 : 0;
                                    title: GuiI18n.text("gui-java-preferred");
                                    detail: GuiI18n.text("gui-java-preferred-detail");
                                    TextField { text <=> root.java-preferred-path; accessible-name: GuiI18n.text("gui-java-preferred"); placeholder: "/usr/bin/java"; width: 260px; }
                                }
                            }
                            ActionRow { Rectangle { horizontal-stretch: 1; } AppButton { text: root.java-saving ? GuiI18n.text("gui-saving") : GuiI18n.text("gui-java-save"); accessible-name: GuiI18n.text("gui-java-save"); tone: "primary"; enabled: !root.java-saving; hint: GuiI18n.text("gui-save-in-progress-hint"); clicked => { root.save-java-settings(root.java-auto-detect, root.java-auto-download, root.java-memory-min, root.java-memory-max, root.java-preferred-path); } } }
                            // The list is its own thing, and the button that
                            // rebuilds it belongs beside it rather than beside the
                            // Save that has nothing to do with it.
                            HorizontalLayout { spacing: 8px; cross-axis-alignment: center;
                                SectionTitle { title: GuiI18n.text("gui-java-runtimes"); detail: GuiI18n.text("gui-java-runtimes-detail"); horizontal-stretch: 1; }
                                VerticalLayout { alignment: center; AppButton { text: GuiI18n.text("gui-java-refresh"); clicked => { root.refresh-java(); } } }
                            }
                            if root.java-runtimes.length == 0 : EmptyState { title: GuiI18n.text("gui-java-no-runtimes"); message: GuiI18n.text("gui-java-no-runtimes-detail"); }
                            for java in root.java-runtimes : Rectangle { height: java.pinned-by == "" ? 75px : 97px; border-radius: 8px; border-width: 1px; border-color: Theme.border; background: Theme.surface; HorizontalLayout { padding: 12px; spacing: 10px; VerticalLayout { horizontal-stretch: 1; VerticalLayout { alignment: center; Heading { text: java.title; font-size: Theme.row-heading-size; } BodyText { text: java.path; overflow: elide; } if java.pinned-by != "" : BodyText { text: java.pinned-by; color: Theme.text-muted; overflow: elide; } } } VerticalLayout { alignment: center; Pill { text: java.origin; tone-color: java.origin == "managed" ? Theme.accent : java.origin == "system" || java.origin == "sdkman" ? Theme.text-secondary : Theme.accent-secondary; } }
                                // Only what the launcher installed itself offers the
                                // bin: a runtime found on the system belongs to
                                // whoever put it there. The slot is kept either way,
                                // so the badges stay in one column down the list.
                                VerticalLayout { width: Theme.control-height; alignment: center; if java.origin == "managed" : IconButton { icon: @image-url("../../../assets/icons/trash.svg"); accessible-name: GuiI18n.value("gui-java-remove-runtime", java.path); clicked => { root.pending-action-name = java.title; root.pending-action-id = java.path; root.pending-java-pinning = java.pinning; root.pending-java-pins-known = java.pins-known; root.modal = "remove-java-runtime"; } } }
                            } }
                        }
                        if root.settings-tab == "Accounts" : VerticalLayout { spacing: 12px;
                            TextField { text <=> root.offline-account-name; placeholder: GuiI18n.text("gui-offline-account-placeholder"); }
                            HorizontalLayout { spacing: 8px; AppButton { text: GuiI18n.text("gui-add-offline-account"); width: 180px; clicked => { root.add-offline-account(root.offline-account-name); } } AppButton { text: GuiI18n.text("gui-microsoft-sign-in"); width: 205px; tone: "primary"; clicked => { root.begin-microsoft-login(); } } Rectangle { horizontal-stretch: 1; } }
                            if root.accounts.length == 0 : EmptyState { title: GuiI18n.text("gui-no-accounts"); message: GuiI18n.text("gui-no-accounts-detail"); }
                            for account in root.accounts : Rectangle { height: 78px; border-radius: 8px; border-width: account.is-default ? 2px : 1px; border-color: account.is-default ? Theme.accent : Theme.border; background: Theme.surface; accessible-role: list-item; accessible-label: account.name; HorizontalLayout { padding: 12px; spacing: 8px; cross-axis-alignment: center; VerticalLayout { alignment: center; horizontal-stretch: 1; Heading { text: account.name; font-size: Theme.row-heading-size; } BodyText { text: account.kind + " | " + account.credential-state; } }
                                // The marker stands where the button it replaces would be, at
                                // that button's size, so the column does not jump between one
                                // row and the next.
                                if account.is-default : Pill { text: GuiI18n.text("gui-default"); tone-color: Theme.accent; min-content-width: 130px; content-height: Theme.control-height; }
                                if !account.is-default : AppButton { text: GuiI18n.text("gui-make-default"); width: 130px; clicked => { root.set-default-account(account.id); } }
                                AppButton { text: GuiI18n.text("gui-remove"); width: 110px; tone: "danger"; clicked => { root.remove-account(account.id); } } } }
                        }
                        if root.settings-tab == "Providers & APIs" : VerticalLayout { spacing: 14px;
                            SectionTitle { title: GuiI18n.text("gui-preferred-mod-catalog"); detail: GuiI18n.text("gui-preferred-mod-catalog-detail"); }
                            Rectangle { height: 146px; border-radius: 8px; border-width: 1px; border-color: Theme.border; background: Theme.surface; VerticalLayout { padding: 16px; spacing: 8px;
                                HorizontalLayout { Heading { text: GuiI18n.text("gui-preferred-mod-catalog-heading"); font-size: Theme.row-heading-size; } Rectangle { horizontal-stretch: 1; } Pill { text: root.default-mod-catalog-is-custom ? GuiI18n.text("gui-override") : GuiI18n.text("gui-default"); tone-color: root.default-mod-catalog-is-custom ? Theme.accent : Theme.text-secondary; } }
                                // Applied the moment a chip is clicked, and the selection follows
                                // the stored value rather than the click: a save that fails leaves
                                // the previous catalog selected instead of the one that was asked for.
                                HorizontalLayout { spacing: 8px; FilterChip { text: GuiI18n.text("gui-provider-modrinth"); accessible-name: GuiI18n.text("gui-provider-modrinth"); selected: root.default-mod-catalog == "modrinth"; clicked => { root.choose-default-mod-catalog("modrinth"); } } FilterChip { text: GuiI18n.text("gui-provider-curseforge"); accessible-name: GuiI18n.text("gui-provider-curseforge"); selected: root.default-mod-catalog == "curseforge"; clicked => { root.choose-default-mod-catalog("curseforge"); } } Rectangle { horizontal-stretch: 1; } if root.default-mod-catalog-is-custom : AppButton { text: GuiI18n.text("gui-reset-default"); clicked => { root.choose-default-mod-catalog(""); } } }
                                BodyText { text: root.default-mod-catalog == "" ? GuiI18n.value("gui-preferred-mod-catalog-unrecognized", root.configured-mod-catalog) : GuiI18n.text("gui-preferred-mod-catalog-note"); color: Theme.text-muted; wrap: word-wrap; }
                            } }
                            SectionTitle { title: GuiI18n.text("gui-provider-identifiers"); detail: GuiI18n.text("gui-provider-identifiers-detail"); }
                            GridLayout {
                                spacing: 14px;
                                OverrideCard {
                                    row: 0; col: 0;
                                    title: GuiI18n.text("gui-microsoft-client-id");
                                    placeholder: GuiI18n.text("gui-no-override");
                                    effective: root.effective-microsoft-client-id;
                                    custom: root.microsoft-client-id-is-custom;
                                    value <=> root.microsoft-client-id;
                                    saving: root.microsoft-client-id-saving;
                                    reset => { root.reset-microsoft-client-id(); }
                                }
                                OverrideCard {
                                    row: root.settings-two-columns ? 0 : 1;
                                    col: root.settings-two-columns ? 1 : 0;
                                    title: GuiI18n.text("gui-user-agent");
                                    placeholder: GuiI18n.text("gui-no-override");
                                    effective: root.effective-user-agent;
                                    custom: root.user-agent-is-custom;
                                    value <=> root.user-agent;
                                    saving: root.user-agent-saving;
                                    reset => { root.reset-user-agent(); }
                                }
                            }
                            ActionRow { Rectangle { horizontal-stretch: 1; } AppButton { text: root.microsoft-client-id-saving || root.user-agent-saving ? GuiI18n.text("gui-saving") : GuiI18n.text("gui-save-api-settings"); accessible-name: GuiI18n.text("gui-save-api-settings"); tone: "primary"; enabled: !root.microsoft-client-id-saving && !root.user-agent-saving; hint: GuiI18n.text("gui-save-in-progress-hint"); clicked => { root.save-api-settings(root.microsoft-client-id, root.user-agent); } } }
                            SectionTitle { title: GuiI18n.text("gui-curseforge"); detail: root.curseforge-build-key-available ? GuiI18n.text("gui-curseforge-detail-default") : GuiI18n.text("gui-curseforge-detail-required"); }
                            Rectangle { height: curseforge-card.preferred-height; border-radius: 8px; border-width: 1px; border-color: Theme.border; background: Theme.surface; curseforge-card := VerticalLayout { padding: 16px; spacing: 8px;
                                HorizontalLayout { Heading { text: GuiI18n.text("gui-curseforge-api-key"); font-size: Theme.row-heading-size; } Rectangle { horizontal-stretch: 1; } Pill { text: root.curseforge-key-configured ? GuiI18n.text("gui-curseforge-key-configured") : root.curseforge-key-default-in-use ? GuiI18n.text("gui-curseforge-key-default-in-use") : GuiI18n.text("gui-curseforge-key-not-configured"); tone-color: root.curseforge-key-configured ? Theme.accent : root.curseforge-key-default-in-use ? Theme.text-secondary : Theme.danger; } }
                                // Masked because it shows what the user is typing, never what is stored:
                                // a saved key is not readable from here and the field is emptied on submit.
                                HorizontalLayout { spacing: 8px; TextField { text <=> root.curseforge-api-key; placeholder: GuiI18n.text("gui-curseforge-key-placeholder"); accessible-name: GuiI18n.text("gui-curseforge-api-key"); input-type: InputType.password; horizontal-stretch: 1; accepted => { root.save-curseforge-api-key(root.curseforge-api-key); } } AppButton { text: root.curseforge-key-configured ? GuiI18n.text("gui-curseforge-key-replace") : GuiI18n.text("gui-curseforge-key-save"); tone: "primary"; enabled: root.curseforge-api-key != ""; hint: GuiI18n.text("gui-hint-enter-api-key"); clicked => { root.save-curseforge-api-key(root.curseforge-api-key); } } if root.curseforge-key-configured : AppButton { text: GuiI18n.text("gui-remove"); tone: "danger"; clicked => { root.remove-curseforge-api-key(); } } }
                                // A note only where there is something to say. A
                                // stored key needs the keyring explained; no key at
                                // all needs what that costs said. A build's own key
                                // standing in needs neither: the heading above
                                // already says so, and it is not kept in a keyring.
                                if root.curseforge-key-configured : BodyText { text: GuiI18n.text("gui-curseforge-key-storage"); color: Theme.text-muted; wrap: word-wrap; }
                                if !root.curseforge-key-configured && !root.curseforge-key-default-in-use : BodyText { text: GuiI18n.text("gui-curseforge-key-missing-detail"); color: Theme.warning; wrap: word-wrap; }
                                HorizontalLayout { AppButton { text: GuiI18n.text("gui-curseforge-key-help"); clicked => { root.open-curseforge-key-help(); } } Rectangle { horizontal-stretch: 1; } }
                            } }
                        }
                        if root.settings-tab == "Disk Usage" : DiskUsagePanel {
                            state: root.disk-usage-state; progress: root.disk-usage-progress;
                            total: root.disk-usage-total; measured-at: root.disk-usage-measured-at;
                            retention: root.disk-usage-retention; categories: root.disk-usage-categories;
                            incomplete: root.disk-usage-incomplete; incomplete-text: root.disk-usage-incomplete-text; unreadable: root.disk-usage-unreadable;
                            stale: root.disk-usage-stale;
                            maintenance-busy: root.storage-maintenance-busy; maintenance-progress: root.storage-maintenance-progress;
                            maintenance-inspected: root.storage-inspected; maintenance-headline: root.storage-headline; maintenance-hosts: root.storage-hosts;
                            maintenance-incomplete: root.storage-incomplete; maintenance-groups: root.storage-groups;
                            maintenance-checked: root.storage-checked; maintenance-integrity: root.storage-integrity;
                            maintenance-faults: root.storage-faults; maintenance-unchecked: root.storage-unchecked;
                            maintenance-can-recover: root.storage-can-recover; maintenance-result: root.storage-result;
                            refresh => { root.measure-disk-usage(); }
                            stop => { root.stop-disk-usage(); }
                            inspect => { root.inspect-storage(); }
                            verify => { root.verify-storage(); }
                            recover => { root.recover-storage(); }
                            review => { root.review-storage-cleanup(); }
                            stop-maintenance => { root.stop-storage-maintenance(); }
                            open-location(category, index) => { root.open-storage-location(category, index); }
                        }
                        if root.settings-tab == "Diagnostics" : VerticalLayout { spacing: 14px;
                            SectionTitle { title: GuiI18n.text("gui-launcher-bundle-title"); detail: GuiI18n.text("gui-launcher-bundle-detail"); }
                            DiagnosticBundlePanel {
                                empty-text: GuiI18n.text("gui-launcher-bundle-empty");
                                parts: root.launcher-bundle-parts;
                                selection: root.launcher-bundle-selection;
                                selected-count: root.launcher-bundle-selected-count;
                                exporting: root.launcher-bundle-exporting;
                                result: root.launcher-bundle-result;
                                result-path: root.launcher-bundle-result-path;
                                error: root.launcher-bundle-error;
                                toggle(name, value) => { root.toggle-launcher-bundle-part(name, value); }
                                select-all(value) => { root.select-all-launcher-bundle-parts(value); }
                                export => { root.export-launcher-bundle(); }
                                open-folder => { root.open-bundle-folder(root.launcher-bundle-result-path); }
                            }
                        }
                        if root.settings-tab == "Storage" : VerticalLayout { spacing: 14px;
                            SectionTitle { title: GuiI18n.text("gui-persistent-storage"); detail: GuiI18n.text("gui-persistent-storage-detail"); }
                            Rectangle { height: 164px; border-radius: 8px; border-width: 1px; border-color: Theme.border; background: Theme.surface; VerticalLayout { padding: 16px; spacing: 9px;
                                HorizontalLayout { Heading { text: GuiI18n.text("gui-storage-root"); font-size: Theme.row-heading-size; } Rectangle { horizontal-stretch: 1; } Pill { text: root.persistent-root-is-custom ? GuiI18n.text("gui-custom-location") : GuiI18n.text("gui-default-location"); tone-color: root.persistent-root-is-custom ? Theme.accent : Theme.text-secondary; } }
                                HorizontalLayout { spacing: 8px; TextField { text <=> root.persistent-root; placeholder: GuiI18n.text("gui-no-override"); horizontal-stretch: 1; } AppButton { text: GuiI18n.text("gui-choose-folder"); clicked => { root.choose-storage-root(); } } }
                                BodyText { text: GuiI18n.value("gui-effective-location", root.storage-root); color: Theme.text-secondary; overflow: elide; }
                                BodyText { text: GuiI18n.value("gui-default-location-path", root.default-persistent-root); color: Theme.text-muted; overflow: elide; }
                            } }
                            ActionRow { if root.persistent-root-is-custom : AppButton { text: GuiI18n.text("gui-reset-default"); enabled: !root.storage-root-saving; hint: GuiI18n.text("gui-save-in-progress-hint"); clicked => { root.reset-storage-root(); } } Rectangle { horizontal-stretch: 1; } AppButton { text: root.storage-root-saving ? GuiI18n.text("gui-saving") : GuiI18n.text("gui-save-storage-root"); accessible-name: GuiI18n.text("gui-save-storage-root"); tone: "primary"; enabled: !root.storage-root-saving; hint: GuiI18n.text("gui-save-in-progress-hint"); clicked => { root.save-storage-settings(root.persistent-root); } } }
                            BodyText { text: GuiI18n.text("gui-storage-change-future-only"); color: Theme.text-muted; wrap: word-wrap; }
                            Divider { }
                            SectionTitle { title: GuiI18n.text("gui-watched-download-folders"); detail: GuiI18n.text("gui-watched-download-folders-detail"); }
                            // The same card the trusted sites and the favorite
                            // versions use: all three are one remembered value and
                            // one way to take it back, and they are read down the
                            // same page.
                            if root.watched-download-folders.length == 0 : Rectangle {
                                width: min(parent.width, 520px);
                                height: max(46px, no-watched-folders.preferred-height + 22px);
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: Theme.border;
                                background: Theme.surface;
                                no-watched-folders := BodyText { x: 14px; width: parent.width - 28px; text: GuiI18n.text("gui-watched-download-folders-empty"); color: Theme.text-muted; wrap: word-wrap; }
                            }
                            for folder in root.watched-download-folders : Rectangle {
                                width: min(parent.width, 520px);
                                height: 48px;
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: Theme.border;
                                background: Theme.surface;
                                HorizontalLayout {
                                    padding-left: 14px; padding-right: 8px; padding-top: 6px; padding-bottom: 6px; spacing: 10px;
                                    BodyText { text: folder; color: Theme.text; horizontal-stretch: 1; vertical-alignment: center; overflow: elide; }
                                    VerticalLayout { alignment: center; AppButton { text: GuiI18n.text("gui-remove"); tone: "danger"; clicked => { root.remove-watched-folder(folder); } } }
                                }
                            }
                            ActionRow { width: min(parent.width, 520px); Rectangle { horizontal-stretch: 1; } AppButton { text: GuiI18n.text("gui-add-watched-folder"); clicked => { root.choose-watched-folder(); } } }
                            Divider { }
                            SectionTitle { title: GuiI18n.text("gui-artifact-cache"); detail: GuiI18n.text("gui-artifact-cache-detail"); }
                            // Height taken from the content rather than fixed:
                            // a bare Rectangle reports no preferred height of
                            // its own, and the scroll view needs a real one or
                            // the row below this card cannot be reached.
                            Rectangle { height: cache-card.preferred-height; border-radius: 8px; border-width: 1px; border-color: Theme.border; background: Theme.surface; cache-card := VerticalLayout { padding: 16px; spacing: 12px;
                                HorizontalLayout { spacing: 10px;
                                    Heading { text: root.artifact-cache-usage-known ? (root.artifact-cache-usage-exact ? GuiI18n.values("gui-artifact-cache-usage", root.artifact-cache-used, root.artifact-cache-total) : GuiI18n.values("gui-artifact-cache-usage-approximate", root.artifact-cache-used, root.artifact-cache-total)) : GuiI18n.text("gui-artifact-cache-measuring"); font-size: Theme.row-heading-size; overflow: elide; horizontal-stretch: 1; }
                                    if root.artifact-cache-over-budget : Pill { text: GuiI18n.text("gui-artifact-cache-over-budget"); tone-color: Theme.warning; }
                                }
                                HorizontalLayout { spacing: 10px; alignment: start;
                                    VerticalLayout { spacing: 4px;
                                        FieldLabel { text: GuiI18n.text("gui-artifact-cache-limit"); }
                                        ChoiceBox {
                                            width: 170px;
                                            accessible-label: GuiI18n.text("gui-artifact-cache-limit");
                                            model: root.artifact-cache-limit-labels;
                                            current-index <=> root.artifact-cache-limit-index;
                                        }
                                    }
                                    if root.artifact-cache-limit-index == root.artifact-cache-custom-index : VerticalLayout { spacing: 4px;
                                        FieldLabel { text: GuiI18n.text("gui-artifact-cache-custom-value"); }
                                        // Wide enough for a value far past any
                                        // preset: the presets stop at 100 GiB,
                                        // the setting does not.
                                        TextField { width: 130px; text <=> root.artifact-cache-custom-value; placeholder: "500"; input-type: InputType.number; accessible-name: GuiI18n.text("gui-artifact-cache-custom-value"); }
                                    }
                                    if root.artifact-cache-limit-index == root.artifact-cache-custom-index : VerticalLayout { spacing: 4px;
                                        FieldLabel { text: " "; }
                                        ValueComboBox { width: 100px; label: GuiI18n.text("gui-artifact-cache-custom-value"); model: root.artifact-cache-units; value: root.artifact-cache-custom-unit; selected(value) => { root.artifact-cache-custom-unit = value; } }
                                    }
                                    VerticalLayout { spacing: 4px;
                                        // An empty label so the button lines up
                                        // with the controls it saves rather than
                                        // with their labels.
                                        FieldLabel { text: " "; }
                                        AppButton { text: root.artifact-cache-limit-saving ? GuiI18n.text("gui-saving") : GuiI18n.text("gui-save-artifact-cache-limit"); accessible-name: GuiI18n.text("gui-save-artifact-cache-limit"); tone: "primary"; enabled: !root.artifact-cache-limit-saving; hint: GuiI18n.text("gui-save-in-progress-hint"); clicked => { root.save-artifact-cache-limit(root.artifact-cache-limit-index, root.artifact-cache-custom-value, root.artifact-cache-custom-unit); } }
                                    }
                                }
                                BodyText { text: GuiI18n.text("gui-artifact-cache-cleanup-note"); color: Theme.text-muted; wrap: word-wrap; }
                            } }
                            HorizontalLayout {
                                // Opens a list of what would be removed. Nothing
                                // is removed until that list is confirmed, and an
                                // instance or a server is never on it.
                                AppButton { text: GuiI18n.text("gui-review-storage-cleanup"); enabled: root.storage-maintenance-busy == ""; hint: GuiI18n.text("gui-storage-busy-hint"); clicked => { root.review-storage-cleanup(); } }
                                Rectangle { horizontal-stretch: 1; }
                            }
                        }
                        if root.settings-tab == "About & Licenses" : VerticalLayout { alignment: start; spacing: 14px;
                            Image { source: root.logo; width: 92px; height: 92px; image-fit: contain; accessible-label: GuiI18n.text("gui-logo-accessible"); }
                            Heading { text: "Ephervex"; font-size: Theme.about-title-size; }
                            BodyText { text: GuiI18n.value("gui-version", root.app-version); }
                            BodyText { text: GuiI18n.text("gui-apache-license"); color: Theme.text; }
                            HorizontalLayout { AppButton { text: GuiI18n.text("gui-view-ephervex-license"); clicked => { root.modal = "license"; } } Rectangle { horizontal-stretch: 1; } }
                            Divider { }
                            Heading { text: GuiI18n.text("gui-built-with-slint"); }
                            Rectangle { width: 290px; height: 105px; border-radius: 8px; border-width: 1px; border-color: Theme.border; background: Theme.surface; AboutSlint { } }
                            Divider { }
                            Heading { text: GuiI18n.text("gui-third-party-software"); }
                            BodyText { text: GuiI18n.text("gui-third-party-detail"); }
                            HorizontalLayout { AppButton { text: GuiI18n.text("gui-third-party-licenses"); clicked => { root.third-party-open = -1; root.modal = "third-party"; } } Rectangle { horizontal-stretch: 1; } }
                        }
                    } } }
                }
            }
        }

        if root.startup-error != "" : Rectangle {
            background: Theme.danger-fill;
            VerticalLayout {
                padding: 10px; spacing: 4px;
                BodyText { text: GuiI18n.text("gui-background-unavailable"); color: Theme.on-danger; font-weight: 600; wrap: word-wrap; }
                BodyText { text: root.startup-error; color: Theme.on-danger; wrap: word-wrap; }
            }
        }

        Rectangle { height: 34px; background: Theme.bar; border-width: 1px; border-color: Theme.border; HorizontalLayout { padding-left: 14px; padding-right: 14px; spacing: 22px; BodyText { text: root.active-operations > 0 ? GuiI18n.count("gui-active-operations", root.active-operations) : GuiI18n.text("gui-no-active-tasks"); color: root.active-operations > 0 ? Theme.accent : Theme.success; font-size: Theme.caption-size; } Rectangle { horizontal-stretch: 1; } BodyText { text: root.status-message; font-size: Theme.caption-size; } BodyText { text: root.storage-root; color: Theme.text-muted; font-size: Theme.caption-size; overflow: elide; width: 300px; } }
        }
    }

    Rectangle {
        x: parent.width - self.width - 22px;
        y: 78px;
        width: min(440px, parent.width - 44px);
        height: parent.height - 126px;
        VerticalLayout { alignment: end; spacing: 8px;
            for toast in root.toasts : ToastPanel { message: toast.message; error: toast.error; repeats: toast.repeats; dismiss => { root.dismiss-toast(toast.id); } }
        }
    }

    // What a file held over the window looks like. Drawn under the modal
    // overlay, and never while one is open, because a drop is refused then.
    if root.file-drop-active : Rectangle {
        background: Theme.background.with-alpha(0.8);
        Rectangle {
            width: min(520px, parent.width - 80px);
            height: 168px;
            border-radius: 10px;
            border-width: 2px;
            border-color: Theme.accent;
            background: Theme.elevated;
            VerticalLayout {
                padding: 24px; spacing: 8px; alignment: center;
                Heading { text: root.file-drop-kind == "mods" ? GuiI18n.text("gui-drop-to-add-mods") : GuiI18n.text("gui-drop-to-import"); font-size: Theme.item-title-size; horizontal-alignment: center; }
                BodyText { text: root.file-drop-kind == "mods" ? GuiI18n.text("gui-drop-to-add-mods-detail") : GuiI18n.text("gui-drop-to-import-detail"); wrap: word-wrap; horizontal-alignment: center; }
            }
        }
    }

    // Tab order runs through the page, then the dialog, then wraps to the
    // page. Shift+Tab off the dialog's start lands on the first edge, and Tab
    // off its end on the last, and each hands focus to the other end.
    FocusEdge { active: root.modal != ""; reached => { dialog-end.focus(); } }
    dialog-start := FocusEdge { active: root.modal != ""; }

    // Modal overlay and focused workflows.
    if root.modal != "" : Rectangle {
        background: Theme.scrim;
        TouchArea { clicked => { } }
        Rectangle {
            width: root.modal == "license" || root.modal == "third-party" ? min(820px, parent.width - 80px) : root.modal == "mod-plan" || root.modal == "mod-apply" || root.modal == "mod-remove" || root.modal == "mod-result" || root.modal == "mod-manage" || root.modal == "mod-acquire" || root.modal == "storage-cleanup" ? min(720px, parent.width - 80px) : min(620px, parent.width - 80px);
            height: root.modal == "license" || root.modal == "third-party" ? min(720px, parent.height - 80px) : root.modal == "import" || root.modal == "pane-host" ? min(620px, parent.height - 80px) : root.modal == "mod-plan" ? min(500px * Theme.text-scale + root.linked-targets.length * 68px + 14px + root.mod-plan-extra, parent.height - 80px) : root.modal == "mod-manage" || root.modal == "storage-cleanup" ? min(620px, parent.height - 80px) : root.modal == "mod-acquire" ? min(260px * Theme.text-scale + root.mod-acquisition-items.length * 64px, parent.height - 80px) : root.modal == "mod-apply" ? min(370px * Theme.text-scale + root.linked-targets.length * 68px + 14px, parent.height - 80px) : root.modal == "mod-result" ? min(300px * Theme.text-scale + root.linked-results.length * 68px + 14px, parent.height - 80px) : root.modal == "loader-change" ? 400px : root.modal == "mod-remove" ? min((root.linked-targets.length > 0 ? 424px : 300px) * Theme.text-scale + root.mod-removal-dependencies.length * 24px + root.linked-targets.length * 68px, parent.height - 80px) : root.modal == "eula" ? 440px : root.modal == "kill" ? 300px : root.modal == "delete-instance" || root.modal == "delete-server" ? 330px : root.modal == "groups" ? min(420px, parent.height - 80px) : root.modal == "rename" ? min(modal-body.preferred-height, parent.height - 80px) : root.modal == "snapshot-create" || root.modal == "snapshot-restore" || root.modal == "snapshot-rename" || root.modal == "snapshot-delete" ? 330px : root.modal == "mod-impact" ? min(300px * Theme.text-scale + (root.mod-impact-breaks.length + root.mod-impact-degrades.length + root.mod-impact-unknown.length + root.mod-impact-unidentifiable.length + root.mod-requires-disabled.length + root.mod-requires-absent.length + root.mod-requires-incompatible.length) * 24px, parent.height - 80px) : root.modal == "delete-mod" ? 320px : root.modal == "mod-stand-in" ? min(340px * Theme.text-scale, parent.height - 80px) : root.modal == "remove-java-runtime" ? (root.pending-java-pinning == "" && root.pending-java-pins-known ? 320px : 320px + 66px * Theme.text-scale) : root.modal == "mod-clash" ? 380px : root.modal == "absent-mods" ? min(250px + root.absent-mods.length * 22px, parent.height - 80px) : root.modal == "make-persistent" ? min(290px + root.promote-servers.length * 28px, parent.height - 80px) : root.modal == "open-pack-link" ? 300px : root.modal == "theme-problems" ? min(260px * Theme.text-scale + root.theme-problems.length * 44px, parent.height - 80px) : root.modal == "create-server" ? min((root.create-server-client-id == "" ? 640px : 535px) + (root.create-server-client-id == "" && root.create-server-loader != "Vanilla" ? 44px : 0px) + (root.create-server-pack != "" && root.create-server-pack-note != "" ? 44px : 0px), parent.height - 80px) : 570px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border;
            background: Theme.elevated;
            modal-body := VerticalLayout { padding: 22px; spacing: 13px;
                HorizontalLayout { cross-axis-alignment: center; Heading { text: root.modal == "pane-host" ? GuiI18n.text("gui-modal-pane-host") : root.modal == "create-instance" ? GuiI18n.text("gui-modal-new-instance") : root.modal == "import" ? GuiI18n.text("gui-modal-import") : root.modal == "create-server" ? GuiI18n.text("gui-modal-new-server") : root.modal == "mod-plan" ? GuiI18n.text("gui-modal-install-mod") : root.modal == "mod-manage" ? GuiI18n.text("gui-modal-manage-mod") : root.modal == "mod-acquire" ? GuiI18n.text("gui-modal-mod-acquire") : root.modal == "loader-change" ? GuiI18n.text("gui-modal-change-loader") : root.modal == "mod-remove" ? GuiI18n.text("gui-modal-remove-mod") : root.modal == "mod-apply" ? GuiI18n.text("gui-modal-apply-mod") : root.modal == "mod-result" ? GuiI18n.text("gui-modal-mod-result") : root.modal == "eula" ? GuiI18n.text("gui-server-eula") : root.modal == "kill" ? GuiI18n.text("gui-modal-force-kill") : root.modal == "delete-instance" ? GuiI18n.text("gui-delete-instance") : root.modal == "delete-server" ? GuiI18n.text("gui-delete-server") : root.modal == "groups" ? GuiI18n.text("gui-modal-groups") : root.modal == "rename" ? (root.pending-action-kind == "new-group" ? GuiI18n.text("gui-modal-new-group") : GuiI18n.text("gui-modal-rename")) : root.modal == "snapshot-create" ? GuiI18n.text("gui-snapshot-create") : root.modal == "snapshot-restore" ? GuiI18n.text("gui-snapshot-restore") : root.modal == "snapshot-rename" ? GuiI18n.text("gui-snapshot-rename") : root.modal == "snapshot-delete" ? GuiI18n.text("gui-snapshot-delete") : root.modal == "mod-impact" ? GuiI18n.value(root.mod-impact-enabling ? "gui-mod-impact-enable-title" : "gui-mod-impact-disable-title", root.mod-impact-name) : root.modal == "delete-mod" ? GuiI18n.text("gui-modal-delete-mod") : root.modal == "mod-stand-in" ? GuiI18n.text("gui-modal-mod-stand-in") : root.modal == "remove-java-runtime" ? GuiI18n.text("gui-java-remove-runtime-title") : root.modal == "storage-cleanup" ? GuiI18n.text("gui-storage-cleanup-title") : root.modal == "mod-clash" ? GuiI18n.text("gui-modal-mod-clash") : root.modal == "absent-mods" ? GuiI18n.text("gui-modal-absent-mods") : root.modal == "make-persistent" ? GuiI18n.text("gui-make-persistent") : root.modal == "open-pack-link" ? GuiI18n.text("gui-open-pack-link") : root.modal == "theme-problems" ? GuiI18n.text("gui-modal-theme-problems") : root.modal == "license" ? GuiI18n.text("gui-modal-apache-license") : root.third-party-open >= 0 ? root.third-party-packages[root.third-party-open].name + " " + root.third-party-packages[root.third-party-open].version + " | " + root.third-party-packages[root.third-party-open].license : GuiI18n.text("gui-third-party-licenses"); font-size: Theme.brand-size; } Rectangle { horizontal-stretch: 1; } IconButton { icon: @image-url("../../../assets/icons/close.svg"); accessible-name: GuiI18n.text("gui-close"); clicked => { if root.modal == "import" { root.close-import-modal(); } else if root.modal == "mod-stand-in" { root.answer-mod-stand-in(root.mod-stand-in-id, false); } else { if root.modal == "mod-plan" { root.abandon-browser-install(); } if root.modal == "mod-acquire" { root.cancel-mod-acquisition(root.mod-acquisition-id); } if root.modal == "open-pack-link" { root.cancel-pack-link(); } root.modal = ""; root.modal-error = ""; } } } }
                Divider { }
                if root.modal == "create-instance" : VerticalLayout { spacing: 11px; BodyText { text: GuiI18n.text("gui-create-instance-detail"); wrap: word-wrap; } Text { text: GuiI18n.text("gui-name"); color: Theme.text-secondary; font-size: Theme.label-size; } TextField { text <=> root.create-name; placeholder: root.create-name-suggestion; accessible-name: GuiI18n.text("gui-name"); } Text { text: GuiI18n.text("gui-minecraft-release"); color: Theme.text-secondary; font-size: Theme.label-size; } HorizontalLayout { spacing: 8px; ValueComboBox { horizontal-stretch: 1; label: GuiI18n.text("gui-minecraft-release"); model: root.minecraft-releases; value: root.create-minecraft; selected(value) => { root.create-minecraft = value; root.create-loader-version = ""; root.create-loader-versions = []; root.minecraft-selection-changed("client", value); if root.create-loader != "Vanilla" { root.request-loader-catalog("client", root.create-loader, value); } root.recompute-create-name(); } } FavoriteToggle { version: root.create-minecraft; favorite: root.create-minecraft-favorite; enabled: root.create-minecraft != ""; hint: GuiI18n.text("gui-hint-choose-minecraft-release"); toggled => { root.toggle-favorite-version(root.create-minecraft); } } } Text { text: GuiI18n.text("gui-loader"); color: Theme.text-secondary; font-size: Theme.label-size; } ValueComboBox { label: GuiI18n.text("gui-loader"); model: root.create-loaders; value: root.create-loader; selected(value) => { root.create-loader = value; root.create-loader-version = ""; root.create-loader-versions = []; if value != "Vanilla" { root.request-loader-catalog("client", value, root.create-minecraft); } root.recompute-create-name(); } } if root.create-loader != "Vanilla" : ValueComboBox { label: GuiI18n.text("gui-loader-version-placeholder"); model: root.create-loader-versions; value: root.create-loader-version; selected(value) => { root.create-loader-version = value; } changed value => { root.recompute-create-name(); } } HorizontalLayout { BodyText { text: GuiI18n.text("gui-store-persistently"); } Toggle { checked <=> root.create-persistent; } BodyText { text: root.create-persistent ? GuiI18n.text("gui-persistent-root") : GuiI18n.text("gui-temporary-root"); color: Theme.text-muted; } } if root.modal-error != "" : BodyText { text: root.modal-error; color: Theme.danger; wrap: word-wrap; } ActionRow { Rectangle { horizontal-stretch: 1; } AppButton { text: GuiI18n.text("gui-cancel"); clicked => { root.modal = ""; } } AppButton { text: GuiI18n.text("gui-create-instance"); tone: "primary"; enabled: root.minecraft-releases.length > 0 && (root.create-name != "" || root.create-name-suggestion != "") && root.create-minecraft != "" && (root.create-loader == "Vanilla" || root.create-loader-version != ""); hint: root.minecraft-releases.length == 0 ? GuiI18n.text("gui-hint-minecraft-list-unavailable") : root.create-minecraft == "" ? GuiI18n.text("gui-hint-choose-minecraft-release") : root.create-name == "" && root.create-name-suggestion == "" ? GuiI18n.text("gui-hint-enter-name") : GuiI18n.text("gui-hint-choose-loader-version"); clicked => { root.submit-create-instance(root.create-name != "" ? root.create-name : root.create-name-suggestion, root.create-minecraft, root.create-loader, root.create-loader-version, root.create-persistent); } } } }
                if root.modal == "import" : ScrollView {
                    viewport-width: self.width;
                    VerticalLayout {
                        spacing: 11px;
                        BodyText { text: GuiI18n.text("gui-import-detail"); wrap: word-wrap; }
                        Text { text: GuiI18n.text("gui-modpack-archive"); color: Theme.text-secondary; font-size: Theme.label-size; }
                        HorizontalLayout {
                            TextField {
                                // Display-only: it always mirrors the archive
                                // the current analysis is for, and Browse is
                                // the only way to start a new one.
                                text: root.import-path;
                                placeholder: GuiI18n.text("gui-modpack-placeholder");
                                horizontal-stretch: 1;
                                enabled: false;
                            }
                            AppButton {
                                text: GuiI18n.text("gui-browse");
                                accessible-name: GuiI18n.text("gui-choose-modpack-archive");
                                enabled: root.import-status-kind != "submitting"; hint: GuiI18n.text("gui-hint-import-running");
                                clicked => { root.choose-import-file(); }
                            }
                        }
                        if root.import-status-kind == "analyzing" || root.import-status-kind == "resolving" : HorizontalLayout {
                            spacing: 7px;
                            BusySpinner { width: 16px; height: 16px; }
                            BodyText {
                                text: root.import-status-kind == "resolving" ? GuiI18n.text("gui-import-resolving") : GuiI18n.text("gui-import-analyzing");
                                color: Theme.text-secondary;
                            }
                        }
                        if root.import-pack-header != "" : Rectangle {
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: root.import-status-kind == "ready" || root.import-status-kind == "submitting" ? Theme.success : Theme.border;
                            background: Theme.surface;
                            // Left to itself, the card measures its wrapped lines unwrapped.
                            height: pack-summary.preferred-height;
                            pack-summary := VerticalLayout {
                                padding: 12px;
                                spacing: 4px;
                                Heading { text: root.import-pack-header; font-size: Theme.row-heading-size; wrap: word-wrap; }
                                if root.import-author-line != "" : BodyText { text: root.import-author-line; color: Theme.text-secondary; wrap: word-wrap; }
                                BodyText { text: root.import-minecraft-line; color: Theme.text-secondary; wrap: word-wrap; }
                                BodyText { text: root.import-loader-line; color: Theme.text-secondary; wrap: word-wrap; }
                                BodyText { text: root.import-required-line + " | " + root.import-optional-line; color: Theme.text-secondary; wrap: word-wrap; }
                            }
                        }
                        if root.import-optional-items.length > 0 : ScrollView {
                            viewport-width: self.width;
                            height: min(root.import-optional-items.length * 28px, 200px);
                            VerticalLayout {
                                for item in root.import-optional-items : HorizontalLayout {
                                    spacing: 8px;
                                    height: 28px;
                                    Toggle {
                                        checked: item.selected;
                                        accessible-name: item.display;
                                        toggled(selected) => { root.toggle-import-optional(item.logical-path); }
                                    }
                                    BodyText { text: item.display; overflow: elide; vertical-alignment: center; }
                                }
                            }
                        }
                        // Wrapped text stays a direct child: a conditional layout here measures it unwrapped.
                        if root.import-blocked-items.length > 0 : BodyText { text: GuiI18n.text("gui-import-blocked-detail"); color: Theme.warning; wrap: word-wrap; }
                        if root.import-blocked-items.length > 0 : HorizontalLayout {
                            Rectangle { horizontal-stretch: 1; }
                            AppButton {
                                text: GuiI18n.text("gui-import-open-watched-folders");
                                clicked => { root.close-import-modal(); root.close-workspace(); root.page = 4; root.settings-tab = "Storage"; }
                            }
                        }
                        if root.import-blocked-items.length > 0 : ScrollView {
                            viewport-width: self.width;
                            height: min(root.import-blocked-items.length * 64px, 220px);
                            VerticalLayout {
                                spacing: 6px;
                                for item in root.import-blocked-items : Rectangle {
                                    height: 58px;
                                    border-radius: 6px;
                                    border-width: 1px;
                                    border-color: Theme.border;
                                    background: Theme.surface;
                                    HorizontalLayout {
                                        padding: 8px;
                                        spacing: 8px;
                                        VerticalLayout {
                                            alignment: center;
                                            BodyText { text: item.project-line; overflow: elide; }
                                            BodyText { text: item.file-line; color: Theme.text-muted; overflow: elide; }
                                        }
                                        Rectangle { horizontal-stretch: 1; }
                                        AppButton {
                                            text: GuiI18n.text("gui-open-in-browser");
                                            enabled: item.browser-url != ""; hint: GuiI18n.text("gui-hint-no-project-page");
                                            clicked => { root.open-blocked-file(item.browser-url); }
                                        }
                                        AppButton {
                                            text: GuiI18n.text("gui-skip");
                                            tone: "danger";
                                            clicked => { root.skip-blocked-file(item.identity); }
                                        }
                                    }
                                }
                            }
                        }
                        if root.import-duplicate-items.length > 0 : BodyText { text: GuiI18n.text("gui-import-duplicate-detail"); color: Theme.text-secondary; wrap: word-wrap; }
                        if root.import-duplicate-items.length > 0 : ScrollView {
                            viewport-width: self.width;
                            height: min(root.import-duplicate-items.length * 100px, 260px);
                            VerticalLayout {
                                spacing: 6px;
                                for item in root.import-duplicate-items : Rectangle {
                                    height: max(
                                        58px,
                                        project-text.preferred-height
                                            + kept-text.preferred-height
                                            + reason-text.preferred-height
                                            + 22px);
                                    border-radius: 6px;
                                    border-width: 1px;
                                    border-color: Theme.border;
                                    background: Theme.surface;
                                    VerticalLayout {
                                        padding: 8px;
                                        spacing: 2px;
                                        project-text := BodyText { text: item.project-line; wrap: word-wrap; }
                                        kept-text := BodyText {
                                            text: GuiI18n.values("gui-import-duplicate-kept", item.kept-line, item.discarded-line);
                                            color: Theme.text-muted;
                                            wrap: word-wrap;
                                        }
                                        reason-text := BodyText {
                                            text: item.matched-minecraft-version ? GuiI18n.text("gui-import-duplicate-matches-version") : GuiI18n.text("gui-import-duplicate-newer");
                                            color: Theme.text-muted;
                                            font-size: Theme.caption-size;
                                            wrap: word-wrap;
                                        }
                                    }
                                }
                            }
                        }
                        Text { text: GuiI18n.text("gui-instance-name-optional"); color: Theme.text-secondary; font-size: Theme.label-size; }
                        TextField {
                            text <=> root.import-name;
                            placeholder: GuiI18n.text("gui-detected-pack-name");
                            enabled: root.import-status-kind != "submitting";
                            edited(text) => { root.import-name-edited(text); }
                        }
                        HorizontalLayout { BodyText { text: GuiI18n.text("gui-store-persistently"); } Toggle { checked <=> root.create-persistent; } }
                        HorizontalLayout { spacing: 10px; cross-axis-alignment: center; VerticalLayout { horizontal-stretch: 1; spacing: 2px; BodyText { text: GuiI18n.text("gui-import-create-server"); } BodyText { text: GuiI18n.text("gui-import-create-server-detail"); color: Theme.text-muted; wrap: word-wrap; } } Toggle { checked <=> root.import-create-server; accessible-name: GuiI18n.text("gui-import-create-server"); } }
                        if root.import-create-server : Text { text: GuiI18n.text("gui-server-pack"); color: Theme.text-secondary; font-size: Theme.label-size; }
                        if root.import-create-server : BodyText { text: GuiI18n.text("gui-server-pack-detail"); color: Theme.text-muted; wrap: word-wrap; }
                        if root.import-create-server : HorizontalLayout { spacing: 8px; alignment: start;
                            AppButton { text: GuiI18n.text("gui-browse"); accessible-name: GuiI18n.text("gui-choose-server-pack"); clicked => { root.choose-import-server-pack(); } }
                            if root.import-server-pack != "" : AppButton { text: GuiI18n.text("gui-clear"); accessible-name: GuiI18n.text("gui-clear-server-pack"); clicked => { root.clear-import-server-pack(); } }
                            if root.import-server-pack != "" : VerticalLayout { alignment: center; horizontal-stretch: 1; BodyText { text: root.import-server-pack-name; overflow: elide; } }
                        }
                        // Absorbs whatever space the content above did not
                        // need, so sparse content (an idle picker) keeps its
                        // rows tight instead of spreading them across the
                        // scroll viewport.
                        Rectangle { vertical-stretch: 1; }
                    }
                }
                // Outside the scroll view, so the error and buttons are always in view.
                if root.modal == "import" && root.modal-error != "" : BodyText { text: root.modal-error; color: Theme.danger; wrap: word-wrap; }
                if root.modal == "import" && root.modal-error != "" && (root.import-error-kind == "missing-credential" || root.import-error-kind == "rejected-credential") : HorizontalLayout {
                    alignment: start;
                    AppButton {
                        text: GuiI18n.text("gui-import-open-providers");
                        clicked => { root.close-import-modal(); root.close-workspace(); root.page = 4; root.settings-tab = "Providers & APIs"; }
                    }
                }
                if root.modal == "import" : ActionRow {
                    Rectangle { horizontal-stretch: 1; }
                    AppButton { text: GuiI18n.text("gui-cancel"); clicked => { root.close-import-modal(); } }
                    AppButton {
                        text: GuiI18n.text("gui-import-modpack");
                        tone: "primary";
                        enabled: root.import-ready; hint: root.import-status-kind == "idle" ? GuiI18n.text("gui-hint-import-choose") : root.import-status-kind == "analyzing" || root.import-status-kind == "resolving" ? GuiI18n.text("gui-hint-import-reading") : root.import-status-kind == "submitting" ? GuiI18n.text("gui-hint-import-running") : root.import-status-kind == "failed" ? GuiI18n.text("gui-hint-import-failed") : GuiI18n.text("gui-hint-import-blocked");
                        clicked => { root.submit-import(root.import-name, root.create-persistent, root.import-create-server, root.import-server-pack); }
                    }
                }
                if root.modal == "create-server" : ScrollView { VerticalLayout { spacing: 10px; alignment: start; BodyText { text: root.create-server-client-id != "" ? GuiI18n.text("gui-create-linked-server-detail") : GuiI18n.text("gui-create-standalone-server-detail"); wrap: word-wrap; } Text { text: GuiI18n.text("gui-name"); color: Theme.text-secondary; font-size: Theme.label-size; } TextField { text <=> root.create-server-name; placeholder: root.create-server-name-suggestion; accessible-name: GuiI18n.text("gui-name"); } if root.create-server-client-id == "" : Text { text: GuiI18n.text("gui-minecraft-release"); color: Theme.text-secondary; font-size: Theme.label-size; } if root.create-server-client-id == "" : ValueComboBox { label: GuiI18n.text("gui-minecraft-release"); model: root.minecraft-releases; value: root.create-server-minecraft; selected(value) => { root.create-server-minecraft = value; root.create-server-loader-version = ""; root.create-server-loader-versions = []; root.minecraft-selection-changed("server", value); if root.create-server-loader != "Vanilla" { root.request-loader-catalog("server", root.create-server-loader, value); } root.recompute-create-server-name(); } } if root.create-server-client-id == "" : Text { text: GuiI18n.text("gui-loader"); color: Theme.text-secondary; font-size: Theme.label-size; } if root.create-server-client-id == "" : ValueComboBox { label: GuiI18n.text("gui-loader"); model: root.create-server-loaders; value: root.create-server-loader; selected(value) => { root.create-server-loader = value; root.create-server-loader-version = ""; root.create-server-loader-versions = []; if value != "Vanilla" { root.request-loader-catalog("server", value, root.create-server-minecraft); } root.recompute-create-server-name(); } } if root.create-server-client-id == "" && root.create-server-loader != "Vanilla" : ValueComboBox { label: GuiI18n.text("gui-loader-version-placeholder"); model: root.create-server-loader-versions; value: root.create-server-loader-version; selected(value) => { root.create-server-loader-version = value; } changed value => { root.recompute-create-server-name(); } } HorizontalLayout { BodyText { text: GuiI18n.text("gui-store-persistently"); } Toggle { checked <=> root.create-server-persistent; } } HorizontalLayout { BodyText { text: GuiI18n.text("gui-port-automatic"); } Toggle { checked <=> root.create-server-automatic-port; accessible-name: GuiI18n.text("gui-port-automatic"); } } if root.create-server-automatic-port : BodyText { text: GuiI18n.text("gui-port-automatic-detail"); color: Theme.text-muted; wrap: word-wrap; } if !root.create-server-automatic-port : HorizontalLayout { FieldLabel { text: GuiI18n.text("gui-port-custom"); } TextField { accessible-label: GuiI18n.text("gui-port-custom"); text <=> root.create-server-port; input-type: InputType.number; width: 150px; } } Text { text: GuiI18n.text("gui-server-pack"); color: Theme.text-secondary; font-size: Theme.label-size; } BodyText { text: GuiI18n.text("gui-server-pack-detail"); color: Theme.text-muted; wrap: word-wrap; } HorizontalLayout { spacing: 8px; alignment: start; AppButton { text: GuiI18n.text("gui-browse"); accessible-name: GuiI18n.text("gui-choose-server-pack"); clicked => { root.choose-server-pack(); } } if root.create-server-pack != "" : AppButton { text: GuiI18n.text("gui-clear"); accessible-name: GuiI18n.text("gui-clear-server-pack"); clicked => { root.clear-server-pack(); } } if root.create-server-pack != "" : VerticalLayout { alignment: center; horizontal-stretch: 1; BodyText { text: root.create-server-pack-name; overflow: elide; } } } if root.create-server-pack != "" && root.create-server-pack-note != "" : BodyText { text: root.create-server-pack-note; color: Theme.text-muted; wrap: word-wrap; } BodyText { text: GuiI18n.text("gui-eula-create-warning"); color: Theme.warning; wrap: word-wrap; } if root.modal-error != "" : BodyText { text: root.modal-error; color: Theme.danger; wrap: word-wrap; } ActionRow { Rectangle { horizontal-stretch: 1; } AppButton { text: GuiI18n.text("gui-cancel"); clicked => { root.modal = ""; } } AppButton { text: GuiI18n.text("gui-create-server"); tone: "primary"; enabled: (root.create-server-name != "" || root.create-server-name-suggestion != "") && (root.create-server-client-id != "" || (root.minecraft-releases.length > 0 && root.create-server-minecraft != "" && (root.create-server-loader == "Vanilla" || root.create-server-loader-version != ""))) && root.create-server-pack-conflict == ""; hint: root.create-server-name == "" && root.create-server-name-suggestion == "" ? GuiI18n.text("gui-hint-enter-name") : root.create-server-pack-conflict != "" ? root.create-server-pack-conflict : root.create-server-client-id == "" && root.minecraft-releases.length == 0 ? GuiI18n.text("gui-hint-minecraft-list-unavailable") : root.create-server-client-id == "" && root.create-server-minecraft == "" ? GuiI18n.text("gui-hint-choose-minecraft-release") : GuiI18n.text("gui-hint-choose-loader-version"); clicked => { root.submit-create-server(root.create-server-name != "" ? root.create-server-name : root.create-server-name-suggestion, root.create-server-client-id, root.create-server-minecraft, root.create-server-loader, root.create-server-loader-version, root.create-server-persistent, root.create-server-automatic-port, root.create-server-port, root.create-server-pack); } } } } }
                if root.modal == "mod-plan" : VerticalLayout { spacing: 12px; Heading { text: root.mod-plan-title + " " + root.mod-plan-version; font-size: Theme.section-size; } BodyText { text: root.mod-plan-kind == "server" ? GuiI18n.text("gui-server-mod-plan-compatible") : GuiI18n.text("gui-mod-plan-compatible"); wrap: word-wrap; } Rectangle { height: 116px; border-radius: 6px; border-width: 1px; border-color: Theme.border; background: Theme.background; VerticalLayout { padding: 12px; spacing: 5px; BodyText { text: GuiI18n.count("gui-mod-plan-install", root.mod-plan-install-count); color: Theme.text; } BodyText { text: GuiI18n.count("gui-mod-plan-required", root.mod-plan-dependency-count); } BodyText { text: GuiI18n.count("gui-mod-plan-existing", root.mod-plan-existing-count); } BodyText { text: GuiI18n.count("gui-mod-plan-optional", root.mod-plan-optional-count); } } } if root.mod-plan-warning-count > 0 : BodyText { text: GuiI18n.count("gui-mod-plan-warnings", root.mod-plan-warning-count); color: Theme.warning; wrap: word-wrap; }
                    if root.mod-plan-unstated.length > 0 : VerticalLayout { spacing: 4px;
                        BodyText { text: GuiI18n.text("gui-server-mod-plan-unstated"); color: Theme.warning; wrap: word-wrap; }
                        for name in root.mod-plan-unstated : BodyText { text: "- " + name; }
                    }
                    if root.mod-plan-client-only.length > 0 : VerticalLayout { spacing: 4px;
                        BodyText { text: GuiI18n.text("gui-server-mod-plan-client-only"); color: Theme.warning; wrap: word-wrap; }
                        for line in root.mod-plan-client-only : BodyText { text: line; wrap: word-wrap; }
                    }
                    if root.mod-plan-restart-note != "" : BodyText { text: root.mod-plan-restart-note; color: Theme.text-muted; wrap: word-wrap; }
                    if root.linked-targets.length > 0 : Text { text: GuiI18n.text("gui-linked-servers"); color: Theme.text-secondary; font-size: Theme.label-size; }
                    if root.linked-targets.length > 0 && root.linked-support != "" : BodyText { text: root.linked-support; color: Theme.text-muted; wrap: word-wrap; }
                    if root.linked-targets.length > 0 : LinkedTargetsPanel { vertical-stretch: 1; rows: root.linked-targets; selectable: true; toggled(index) => { root.linked-targets[index].selected = !root.linked-targets[index].selected; } }
                    ActionRow { Rectangle { horizontal-stretch: 1; } AppButton { text: GuiI18n.text("gui-cancel"); clicked => { root.modal = ""; root.abandon-browser-install(); } } AppButton { text: GuiI18n.text("gui-install-required"); tone: "primary"; enabled: root.mod-plan-install-count > 0 && !root.mod-action-pending; hint: root.mod-action-pending ? GuiI18n.text("gui-hint-mod-action-pending") : GuiI18n.text("gui-hint-nothing-to-install"); clicked => { root.mod-action-pending = true; if root.mod-plan-kind == "server" { root.install-server-mod(root.mod-plan-instance, root.mod-plan-provider, root.mod-plan-project, root.mod-plan-version-id, root.mod-plan-unstated-ids); } else { root.install-mod(root.mod-plan-instance, root.mod-plan-provider, root.mod-plan-project, root.mod-plan-version-id); } root.modal = ""; } } } }
                if root.modal == "mod-manage" : VerticalLayout { spacing: 11px;
                    // The mod's own name leads to its project page, beside the
                    // arrow that says a name can be pressed at all. The row of
                    // actions below already carries up to four for a mod the pack
                    // declares, and a fifth button for the project page left them
                    // no room in a dialog this wide.
                    HorizontalLayout { spacing: 8px; cross-axis-alignment: center;
                        if root.mod-action-project-url == "" : Heading { text: root.mod-action-name; font-size: Theme.section-size; overflow: elide; horizontal-stretch: 1; }
                        if root.mod-action-project-url != "" : Rectangle {
                            horizontal-stretch: 1;
                            height: max(project-title.preferred-height, 22px);
                            // The name and its arrow, and nothing else: what is
                            // announced as a button, what takes the press, and
                            // what lights up on hover are all this one box, so
                            // the rest of the header is not a click target that
                            // opens a browser.
                            Rectangle {
                                x: 0px;
                                width: project-title.width + 22px;
                                height: parent.height;
                                accessible-role: button;
                                accessible-label: GuiI18n.text("gui-mod-open-project-page");
                                accessible-action-default => { root.open-mod-project-page(root.mod-action-project-url); }
                            // Packed to the left rather than stretched: the
                            // arrow belongs against the end of the name, and a
                            // stretched title would carry it off to the middle
                            // of the dialog where it reads as its own control.
                            HorizontalLayout {
                                spacing: 7px;
                                alignment: start;
                                cross-axis-alignment: center;
                                project-title := Text {
                                    // Its own width, capped short of the
                                    // dialog's own 720px so a very long name
                                    // elides rather than pushing the arrow out.
                                    // A constant because deriving it from the
                                    // row would be a layout loop: the row is
                                    // sized by this text.
                                    width: min(self.preferred-width, 560px);
                                    text: root.mod-action-name;
                                    color: project-link.has-hover ? Theme.accent : Theme.text;
                                    font-size: Theme.section-size;
                                    font-weight: 600;
                                    overflow: elide;
                                    vertical-alignment: center;
                                }
                                Image {
                                    width: 15px;
                                    height: 15px;
                                    source: @image-url("../../../assets/icons/external-link.svg");
                                    image-fit: contain;
                                    colorize: project-link.has-hover ? Theme.accent : Theme.text-secondary;
                                }
                            }
                            project-link := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.open-mod-project-page(root.mod-action-project-url); }
                            }
                            }
                            HoverNote {
                                text: GuiI18n.text("gui-mod-open-project-page-hint");
                                hovered: project-link.has-hover;
                                pointer-x: project-link.mouse-x;
                                pointer-y: project-link.mouse-y;
                            }
                        }
                        if root.mod-action-up-to-date : Pill { text: GuiI18n.text("gui-mod-up-to-date"); tone-color: Theme.success; }
                    }
                    if root.mod-action-notice != "" : BodyText { text: root.mod-action-notice; color: root.mod-action-can-change ? Theme.text-muted : Theme.warning; wrap: word-wrap; }
                    if root.mod-action-loading : BodyText { text: GuiI18n.text("gui-mod-versions-loading"); color: Theme.text-muted; }
                    if !root.mod-action-loading && root.mod-versions.length == 0 && root.mod-action-notice == "" : BodyText { text: GuiI18n.text("gui-mod-no-compatible-versions"); color: Theme.text-muted; wrap: word-wrap; }
                    if root.mod-versions.length > 0 : Text { text: GuiI18n.text("gui-mod-compatible-versions"); color: Theme.text-secondary; font-size: Theme.label-size; }
                    if root.mod-versions.length > 0 : Rectangle {
                        vertical-stretch: 1; border-radius: 6px; border-width: 1px; border-color: Theme.border; background: Theme.background;
                        ScrollView { viewport-width: self.width; VerticalLayout { padding: 6px; spacing: 4px;
                            for entry in root.mod-versions : Rectangle {
                                height: 46px; border-radius: 5px;
                                border-width: entry.version-id == root.mod-action-selected ? 2px : 1px;
                                border-color: entry.version-id == root.mod-action-selected ? Theme.accent : entry.installed ? Theme.accent-secondary.with-alpha(0.5) : Theme.border.with-alpha(0.6);
                                background: entry.installed ? Theme.accent-secondary.with-alpha(0.08) : Theme.surface;
                                HorizontalLayout { padding-left: 10px; padding-right: 10px; spacing: 8px;
                                    VerticalLayout { alignment: center; spacing: 2px; horizontal-stretch: 1;
                                        Text { text: entry.number; color: Theme.text; font-size: Theme.label-size; font-weight: 600; overflow: elide; }
                                        Text { text: entry.published + " | " + entry.channel; color: Theme.text-muted; font-size: Theme.caption-size; overflow: elide; }
                                    }
                                    // One trailing group rather than a column
                                    // each: an empty wrapper still takes the
                                    // row's spare width, which pushed whichever
                                    // badge was showing away from the edge. The
                                    // two are not exclusive, because the
                                    // installed release is often also the newest
                                    // one and that is worth saying.
                                    HorizontalLayout { spacing: 8px; horizontal-stretch: 0;
                                        if entry.installed : VerticalLayout { alignment: center; Pill { text: GuiI18n.text("gui-mod-installed-version"); tone-color: Theme.accent-secondary; } }
                                        if entry.newest : VerticalLayout { alignment: center; Pill { text: GuiI18n.text("gui-mod-newest-version"); tone-color: Theme.success; } }
                                        if entry.restricted : VerticalLayout { alignment: center; Pill { text: GuiI18n.text("gui-mod-browser-download"); tone-color: Theme.warning; } }
                                    }
                                }
                                TouchArea { enabled: root.mod-action-can-change && !entry.installed; mouse-cursor: pointer; clicked => { root.mod-action-selected = entry.version-id; } }
                            }
                        } }
                    }
                    // Both directions side by side, because the question a
                    // reader has here is symmetric: what this needs, and
                    // what would stop working without it. The warning the
                    // toggle raises is the same data, one closure further.
                    HorizontalLayout { spacing: 10px; vertical-stretch: 0;
                        VerticalLayout { spacing: 5px; horizontal-stretch: 1;
                            Text { text: GuiI18n.text("gui-mod-requires"); color: Theme.text-secondary; font-size: Theme.label-size; }
                            RelationList { rows: root.mod-action-requires; note: root.mod-action-requires-note; }
                        }
                        VerticalLayout { spacing: 5px; horizontal-stretch: 1;
                            Text { text: GuiI18n.text("gui-mod-required-by"); color: Theme.text-secondary; font-size: Theme.label-size; }
                            RelationList { rows: root.mod-action-required-by; note: GuiI18n.text("gui-mod-required-by-nothing"); }
                        }
                    }
                    if root.mod-action-relations-refreshable : HorizontalLayout { AppButton { text: GuiI18n.text("gui-mod-impact-refresh"); clicked => { root.refresh-mod-dependencies(root.mod-action-host-kind, root.mod-action-host, root.mod-action-path); } } Rectangle { horizontal-stretch: 1; } }
                    if root.modal-error != "" : BodyText { text: root.modal-error; color: Theme.danger; wrap: word-wrap; }
                    // With no release list to take the dialog's height, the rest
                    // stays together at the top instead of spreading out.
                    if root.mod-versions.length == 0 : Rectangle { vertical-stretch: 1; }
                    // Leaving on the left, acting on the right, and the one
                    // that takes the selected release last. The two groups
                    // are placed by hand: when one row cannot hold both, the
                    // acting group moves to a row of its own under the other,
                    // whatever width the font gives the captions.
                    Rectangle {
                        property <length> gap: 8px;
                        property <bool> one-row: leaving.min-width + self.gap + acting.min-width <= self.width;
                        height: self.one-row ? Theme.control-height : 2 * Theme.control-height + self.gap;
                        leaving := HorizontalLayout {
                            x: 0px;
                            y: 0px;
                            width: self.min-width;
                            height: Theme.control-height;
                            spacing: parent.gap;
                            if root.mod-action-can-remove : AppButton { text: GuiI18n.text("gui-remove"); tone: "danger"; enabled: !root.mod-action-pending; hint: GuiI18n.text("gui-hint-mod-action-pending"); clicked => { root.mod-action-pending = true; root.modal-error = ""; root.mod-remove-returns-to-manager = true; root.plan-mod-removal(root.mod-action-host-kind, root.mod-action-host, root.mod-action-path); } }
                            AppButton { text: GuiI18n.text("gui-close"); clicked => { root.modal = ""; root.modal-error = ""; } }
                        }
                        acting := HorizontalLayout {
                            x: max(0px, parent.width - self.width);
                            y: parent.one-row ? 0px : Theme.control-height + parent.gap;
                            width: self.min-width;
                            height: Theme.control-height;
                            spacing: parent.gap;
                            if root.mod-action-is-pack-owned && root.mod-action-pack-original-version != "" : AppButton { text: GuiI18n.text("gui-mod-reset-to-pack-version"); enabled: !root.mod-action-pending; hint: GuiI18n.text("gui-hint-mod-action-pending"); clicked => { root.mod-action-pending = true; root.modal-error = ""; root.plan-mod-apply(root.mod-action-host, root.mod-action-path, root.mod-action-pack-original-version); } }
                            if root.mod-action-can-update : AppButton { text: GuiI18n.text("gui-mod-update"); enabled: !root.mod-action-pending; hint: GuiI18n.text("gui-hint-mod-action-pending"); clicked => { root.mod-action-pending = true; root.modal-error = ""; root.plan-mod-apply(root.mod-action-host, root.mod-action-path, ""); } }
                            if root.mod-action-can-change : AppButton { text: GuiI18n.text("gui-mod-change-version"); tone: "primary"; enabled: !root.mod-action-pending && root.mod-action-selected != "" && root.mod-action-selected != root.mod-action-installed; hint: root.mod-action-pending ? GuiI18n.text("gui-hint-mod-action-pending") : root.mod-action-selected == "" ? GuiI18n.text("gui-hint-choose-version") : GuiI18n.text("gui-hint-version-already-installed"); clicked => { root.mod-action-pending = true; root.modal-error = ""; root.plan-mod-apply(root.mod-action-host, root.mod-action-path, root.mod-action-selected); } }
                        }
                    }
                }
                if root.modal == "mod-acquire" : VerticalLayout { spacing: 11px;
                    BodyText { text: GuiI18n.value("gui-mod-acquire-detail", root.mod-acquisition-name); wrap: word-wrap; }
                    BodyText { text: GuiI18n.text("gui-mod-acquire-watching"); color: Theme.text-muted; wrap: word-wrap; }
                    Rectangle {
                        vertical-stretch: 1; border-radius: 6px; border-width: 1px; border-color: Theme.border; background: Theme.background;
                        ScrollView { viewport-width: self.width; VerticalLayout { alignment: start; padding: 6px; spacing: 6px;
                            for item in root.mod-acquisition-items : Rectangle {
                                height: 58px; border-radius: 6px; border-width: 1px; border-color: Theme.border; background: Theme.surface;
                                HorizontalLayout { padding: 8px; spacing: 8px;
                                    VerticalLayout { alignment: center; horizontal-stretch: 1;
                                        BodyText { text: item.project-line; overflow: elide; }
                                        BodyText { text: item.file-line; color: Theme.text-muted; overflow: elide; }
                                    }
                                    AppButton { text: GuiI18n.text("gui-open-in-browser"); tone: "primary"; enabled: item.browser-url != ""; hint: GuiI18n.text("gui-hint-no-project-page"); clicked => { root.open-blocked-file(item.browser-url); } }
                                }
                            }
                        } }
                    }
                    HorizontalLayout { spacing: 8px;
                        AppButton { text: GuiI18n.text("gui-import-open-watched-folders"); clicked => { root.cancel-mod-acquisition(root.mod-acquisition-id); root.modal = ""; root.close-workspace(); root.page = 4; root.settings-tab = "Storage"; } }
                        Rectangle { horizontal-stretch: 1; }
                        AppButton { text: GuiI18n.text("gui-cancel"); clicked => { root.cancel-mod-acquisition(root.mod-acquisition-id); root.modal = ""; root.modal-error = ""; root.mod-action-pending = false; } }
                    }
                }
                if root.modal == "mod-remove" : VerticalLayout { spacing: 12px;
                    BodyText { text: GuiI18n.value("gui-mod-remove-detail", root.mod-action-name); color: Theme.warning; wrap: word-wrap; }
                    if root.mod-removal-dependencies.length > 0 : BodyText { text: GuiI18n.count("gui-mod-remove-dependencies", root.mod-removal-dependencies.length); wrap: word-wrap; }
                    if root.mod-removal-dependencies.length > 0 : Rectangle {
                        // Sized to its own content so that the linked-server
                        // list beside it is not squeezed by an empty box.
                        vertical-stretch: 1; max-height: root.mod-removal-dependencies.length * 24px + 18px; border-radius: 6px; border-width: 1px; border-color: Theme.border; background: Theme.background;
                        ScrollView { viewport-width: self.width; VerticalLayout { alignment: start; padding: 9px; spacing: 4px; for name in root.mod-removal-dependencies : Text { text: name; color: Theme.text-secondary; font-size: Theme.label-size; height: 20px; overflow: elide; } } }
                    }
                    if root.mod-removal-dependencies.length == 0 && !root.mod-removal-unprovable : BodyText { text: GuiI18n.text("gui-mod-remove-no-dependencies"); color: Theme.text-muted; wrap: word-wrap; }
                    if root.mod-removal-unprovable : BodyText { text: GuiI18n.text("gui-mod-remove-dependencies-unprovable"); color: Theme.text-muted; wrap: word-wrap; }
                    if root.linked-targets.length > 0 : Text { text: GuiI18n.text("gui-linked-servers"); color: Theme.text-secondary; font-size: Theme.label-size; }
                    if root.linked-targets.length > 0 : LinkedTargetsPanel { vertical-stretch: 1; rows: root.linked-targets; selectable: true; toggled(index) => { root.linked-targets[index].selected = !root.linked-targets[index].selected; } }
                    if root.modal-error != "" : BodyText { text: root.modal-error; color: Theme.danger; wrap: word-wrap; }
                    HorizontalLayout { spacing: 8px; Rectangle { horizontal-stretch: 1; }
                        AppButton { text: GuiI18n.text("gui-cancel"); clicked => { root.modal = root.mod-remove-returns-to-manager ? "mod-manage" : ""; root.modal-error = ""; } }
                        AppButton { text: GuiI18n.text("gui-mod-remove-action"); tone: "danger"; enabled: !root.mod-action-pending; hint: GuiI18n.text("gui-hint-mod-action-pending"); clicked => { root.modal-error = ""; root.remove-mod(root.mod-action-host, root.mod-action-path); root.modal = ""; } }
                    }
                }
                if root.modal == "mod-apply" : VerticalLayout { spacing: 11px;
                    Heading { text: root.linked-name; font-size: Theme.section-size; overflow: elide; }
                    if root.linked-version-number != "" : BodyText { text: GuiI18n.value("gui-linked-exact-release", root.linked-version-number); wrap: word-wrap; }
                    if root.linked-support != "" : BodyText { text: root.linked-support; color: Theme.text-muted; wrap: word-wrap; }
                    Text { text: GuiI18n.text("gui-linked-servers"); color: Theme.text-secondary; font-size: Theme.label-size; }
                    LinkedTargetsPanel { vertical-stretch: 1; rows: root.linked-targets; selectable: true; toggled(index) => { root.linked-targets[index].selected = !root.linked-targets[index].selected; } }
                    if root.modal-error != "" : BodyText { text: root.modal-error; color: Theme.danger; wrap: word-wrap; }
                    HorizontalLayout { spacing: 8px; Rectangle { horizontal-stretch: 1; }
                        AppButton { text: GuiI18n.text("gui-cancel"); clicked => { root.modal = "mod-manage"; root.modal-error = ""; root.mod-action-pending = false; } }
                        AppButton { text: GuiI18n.text("gui-linked-apply"); tone: "primary"; enabled: !root.mod-action-pending; hint: GuiI18n.text("gui-hint-mod-action-pending"); clicked => { root.modal-error = ""; root.change-mod-version(root.mod-action-host, root.linked-path, root.linked-version); root.modal = ""; } }
                    }
                }
                if root.modal == "mod-result" : VerticalLayout { spacing: 11px;
                    Heading { text: root.linked-result-title; font-size: Theme.section-size; overflow: elide; }
                    BodyText { text: root.linked-result-summary; wrap: word-wrap; }
                    LinkedTargetsPanel { vertical-stretch: 1; rows: root.linked-results; }
                    ActionRow { Rectangle { horizontal-stretch: 1; } AppButton { text: GuiI18n.text("gui-close"); tone: "primary"; clicked => { root.modal = ""; } } }
                }
                if root.modal == "loader-change" : VerticalLayout { spacing: 12px;
                    BodyText { text: GuiI18n.text("gui-loader-change-detail"); wrap: word-wrap; }
                    HorizontalLayout { InspectorLabel { text: GuiI18n.text("gui-loader-change-current"); } BodyText { text: root.loader-change-current != "" ? root.loader-change-current : GuiI18n.text("gui-mod-version-unknown"); } }
                    Text { text: GuiI18n.text("gui-loader-change-target"); color: Theme.text-secondary; font-size: Theme.label-size; }
                    if root.loader-change-loading : BodyText { text: GuiI18n.text("gui-mod-versions-loading"); color: Theme.text-muted; }
                    if !root.loader-change-loading && root.loader-change-versions.length > 0 : ValueComboBox { label: GuiI18n.text("gui-loader-change-target"); model: root.loader-change-versions; value: root.loader-change-selected; selected(value) => { root.loader-change-selected = value; } }
                    if !root.loader-change-loading && root.loader-change-versions.length == 0 : BodyText { text: GuiI18n.text("gui-loader-change-unavailable"); color: Theme.warning; wrap: word-wrap; }
                    if root.loader-change-unverifiable > 0 : BodyText { text: GuiI18n.count("gui-loader-change-unverifiable", root.loader-change-unverifiable); color: Theme.text-muted; wrap: word-wrap; }
                    BodyText { text: GuiI18n.text("gui-loader-change-mods-untouched"); color: Theme.text-muted; wrap: word-wrap; }
                    if root.modal-error != "" : BodyText { text: root.modal-error; color: Theme.danger; wrap: word-wrap; }
                    HorizontalLayout { spacing: 8px; Rectangle { horizontal-stretch: 1; }
                        AppButton { text: GuiI18n.text("gui-cancel"); clicked => { root.modal = ""; root.modal-error = ""; } }
                        AppButton { text: GuiI18n.text("gui-loader-change-action"); tone: "primary"; enabled: !root.loader-change-pending && root.loader-change-selected != "" && root.loader-change-selected != root.loader-change-current-build; hint: root.loader-change-pending ? GuiI18n.text("gui-hint-busy") : root.loader-change-selected == "" ? GuiI18n.text("gui-hint-choose-build") : GuiI18n.text("gui-hint-build-already-current"); clicked => { root.loader-change-pending = true; root.modal-error = ""; root.change-loader-version(root.mod-action-host, root.loader-change-selected); } }
                    }
                }
                if root.modal == "eula" : VerticalLayout { spacing: 12px; BodyText { text: GuiI18n.text("gui-eula-detail"); wrap: word-wrap; } AppButton { text: GuiI18n.text("gui-open-minecraft-eula"); clicked => { root.open-eula-reference(); } } Rectangle { height: 70px; border-radius: 6px; border-width: 1px; border-color: root.eula-accepted ? Theme.success : Theme.warning; background: Theme.surface; BodyText { x: 12px; width: parent.width - 24px; text: root.eula-status; wrap: word-wrap; } } if !root.eula-accepted : BodyText { text: GuiI18n.text("gui-eula-confirm"); color: Theme.text; wrap: word-wrap; } ActionRow { Rectangle { horizontal-stretch: 1; } if root.eula-accepted : AppButton { text: GuiI18n.text("gui-revoke-consent"); tone: "danger"; clicked => { root.revoke-eula(); } } if !root.eula-accepted : AppButton { text: GuiI18n.text("gui-accept-eula"); tone: "primary"; clicked => { root.accept-eula(); } } } }
                if root.modal == "kill" : VerticalLayout { spacing: 14px; BodyText { text: GuiI18n.value("gui-force-kill-detail", root.pending-action-name != "" ? root.pending-action-name : GuiI18n.text("gui-this-server")); color: Theme.warning; wrap: word-wrap; } ActionRow { Rectangle { horizontal-stretch: 1; } AppButton { text: GuiI18n.text("gui-cancel"); clicked => { root.modal = ""; } } AppButton { text: GuiI18n.text("gui-force-kill-action"); tone: "danger"; clicked => { root.server-kill(root.pending-action-id); root.modal = ""; } } } }
                if root.modal == "groups" : VerticalLayout { spacing: 12px;
                    BodyText { text: GuiI18n.text("gui-groups-detail"); wrap: word-wrap; }
                    if root.instance-groups.length == 0 : BodyText { text: GuiI18n.text("gui-groups-none"); color: Theme.text-muted; wrap: word-wrap; }
                    ScrollView {
                        viewport-width: self.visible-width;
                        VerticalLayout {
                            alignment: start; spacing: 8px;
                            for group in root.instance-groups : Rectangle {
                                height: 56px; border-radius: 6px; border-width: 1px; border-color: Theme.border; background: Theme.surface;
                                HorizontalLayout {
                                    padding: 8px; padding-left: 12px; spacing: 8px;
                                    VerticalLayout { alignment: center; Rectangle { width: 10px; height: 10px; border-radius: 5px; background: Theme.group-tone(group.tone); } }
                                    VerticalLayout { horizontal-stretch: 1; alignment: center; Text { text: group.name; color: Theme.text; font-size: Theme.body-size; font-weight: 600; overflow: elide; } BodyText { text: GuiI18n.count("gui-group-members-count", group.members); color: Theme.text-muted; } }
                                    VerticalLayout { alignment: center; AppButton { text: GuiI18n.text("gui-rename"); clicked => { root.pending-action-kind = "group"; root.pending-action-id = group.id; root.pending-rename-text = group.name; root.modal-error = ""; root.modal = "rename"; } } }
                                    VerticalLayout { alignment: center; AppButton { text: GuiI18n.text("gui-delete-group"); tone: "danger"; clicked => { root.delete-group(group.id); } } }
                                }
                            }
                        }
                    }
                    ActionRow { Rectangle { horizontal-stretch: 1; } AppButton { text: GuiI18n.text("gui-new-group"); clicked => { root.pending-action-kind = "new-group"; root.pending-action-id = ""; root.pending-rename-text = ""; root.modal-error = ""; root.modal = "rename"; } } AppButton { text: GuiI18n.text("gui-close"); tone: "primary"; clicked => { root.modal = ""; } } }
                }
                if root.modal == "rename" : VerticalLayout { spacing: 14px; BodyText { text: root.pending-action-kind == "new-group" ? GuiI18n.text("gui-new-group-detail") : GuiI18n.text("gui-rename-detail"); wrap: word-wrap; } VerticalLayout { spacing: 6px; Text { text: GuiI18n.text("gui-name"); color: Theme.text-secondary; font-size: Theme.label-size; } TextField { text <=> root.pending-rename-text; accessible-name: GuiI18n.text("gui-name"); accepted => { root.rename-entity(root.pending-action-kind, root.pending-action-id, root.pending-rename-text); } } } if root.modal-error != "" : BodyText { text: root.modal-error; color: Theme.danger; wrap: word-wrap; } ActionRow { Rectangle { horizontal-stretch: 1; } AppButton { text: GuiI18n.text("gui-cancel"); clicked => { root.modal = ""; root.modal-error = ""; } } AppButton { text: root.pending-action-kind == "new-group" ? GuiI18n.text("gui-create-group") : GuiI18n.text("gui-rename"); tone: "primary"; enabled: root.pending-rename-text != ""; hint: GuiI18n.text("gui-hint-enter-name"); clicked => { root.rename-entity(root.pending-action-kind, root.pending-action-id, root.pending-rename-text); } } } }
                // Four groups, each hidden when empty, because each says
                // something different: these stop working, these lose a
                // feature, Ephervex has not asked about these, and
                // Ephervex cannot ask about these.
                if root.modal == "mod-impact" : VerticalLayout { spacing: 11px;
                    if root.mod-impact-breaks.length > 0 : BodyText { text: GuiI18n.count("gui-mod-impact-breaks", root.mod-impact-breaks.length); color: Theme.danger; wrap: word-wrap; }
                    if root.mod-impact-breaks.length > 0 : ImpactList { rows: root.mod-impact-breaks; }
                    if root.mod-requires-disabled.length > 0 : BodyText { text: GuiI18n.count("gui-mod-impact-needs", root.mod-requires-disabled.length); color: Theme.warning; wrap: word-wrap; }
                    if root.mod-requires-disabled.length > 0 : ImpactList { rows: root.mod-requires-disabled; }
                    if root.mod-requires-absent.length > 0 : BodyText { text: GuiI18n.count("gui-mod-impact-absent", root.mod-requires-absent.length); color: Theme.text-muted; wrap: word-wrap; }
                    if root.mod-requires-absent.length > 0 : ImpactList { rows: root.mod-requires-absent; }
                    if root.mod-requires-incompatible.length > 0 : BodyText { text: GuiI18n.count("gui-mod-impact-incompatible", root.mod-requires-incompatible.length); color: Theme.warning; wrap: word-wrap; }
                    if root.mod-requires-incompatible.length > 0 : ImpactList { rows: root.mod-requires-incompatible; }
                    if root.mod-impact-degrades.length > 0 : BodyText { text: GuiI18n.count("gui-mod-impact-degrades", root.mod-impact-degrades.length); color: Theme.text-secondary; wrap: word-wrap; }
                    if root.mod-impact-degrades.length > 0 : ImpactList { rows: root.mod-impact-degrades; }
                    if root.mod-impact-unknown.length > 0 : BodyText { text: GuiI18n.count("gui-mod-impact-unknown", root.mod-impact-unknown.length); color: Theme.text-muted; wrap: word-wrap; }
                    if root.mod-impact-unknown.length > 0 : ImpactList { rows: root.mod-impact-unknown; }
                    if root.mod-impact-unknown.length > 0 : HorizontalLayout { AppButton { text: GuiI18n.text("gui-mod-impact-refresh"); clicked => { root.refresh-mod-dependencies(root.mod-impact-kind, root.mod-impact-host, ""); root.modal = ""; } } Rectangle { horizontal-stretch: 1; } }
                    if root.mod-impact-unidentifiable.length > 0 : BodyText { text: GuiI18n.count("gui-mod-impact-unidentifiable", root.mod-impact-unidentifiable.length); color: Theme.text-muted; wrap: word-wrap; }
                    if root.mod-impact-unidentifiable.length > 0 : ImpactList { rows: root.mod-impact-unidentifiable; }
                    if root.mod-impact-breaks.length > 0 || root.mod-requires-disabled.length > 0 : LabeledToggle {
                        label: !root.mod-impact-enabling ? GuiI18n.text("gui-mod-impact-cascade-off") : GuiI18n.text("gui-mod-impact-cascade-on");
                        width: 100%;
                        checked <=> root.mod-impact-cascade;
                    }
                    LabeledToggle { label: GuiI18n.text("gui-mod-impact-remember"); width: 100%; checked <=> root.mod-impact-remember; }
                    if root.modal-error != "" : BodyText { text: root.modal-error; color: Theme.danger; wrap: word-wrap; }
                    ActionRow {
                        Rectangle { horizontal-stretch: 1; }
                        AppButton { text: GuiI18n.text("gui-cancel"); clicked => { root.modal = ""; root.modal-error = ""; } }
                        AppButton {
                            text: root.mod-impact-deleting ? GuiI18n.text("gui-delete") : root.mod-impact-enabling ? GuiI18n.text("gui-mod-impact-turn-on") : GuiI18n.text("gui-mod-impact-turn-off");
                            tone: !root.mod-impact-enabling ? "danger" : "primary";
                            clicked => { root.apply-mod-impact(root.mod-impact-cascade); }
                        }
                    }
                }
                if root.modal == "snapshot-create" : VerticalLayout { spacing: 14px;
                    BodyText { text: GuiI18n.text("gui-snapshot-create-detail"); wrap: word-wrap; }
                    FieldLabel { text: GuiI18n.text("gui-snapshot-label"); }
                    TextField { text <=> root.snapshot-action-label; placeholder: root.snapshot-label-suggestion; accessible-name: GuiI18n.text("gui-snapshot-label"); }
                    BodyText { text: GuiI18n.text("gui-snapshot-local-note"); color: Theme.text-muted; wrap: word-wrap; }
                    ActionRow { Rectangle { horizontal-stretch: 1; } AppButton { text: GuiI18n.text("gui-cancel"); clicked => { root.modal = ""; } } AppButton { text: GuiI18n.text("gui-snapshot-create"); tone: "primary"; enabled: root.snapshot-action-label != "" || root.snapshot-label-suggestion != ""; hint: GuiI18n.text("gui-hint-enter-name"); clicked => { root.modal = ""; root.create-snapshot(root.snapshot-host-kind, root.snapshot-host-id, root.snapshot-action-label != "" ? root.snapshot-action-label : root.snapshot-label-suggestion); } } }
                }
                if root.modal == "snapshot-restore" : VerticalLayout { spacing: 14px;
                    BodyText { text: GuiI18n.value("gui-snapshot-restore-detail", root.snapshot-action-label); color: Theme.warning; wrap: word-wrap; }
                    BodyText { text: GuiI18n.text("gui-snapshot-replacement-note"); wrap: word-wrap; }
                    LabeledToggle { label: GuiI18n.text("gui-snapshot-safety-copy"); width: 100%; checked <=> root.snapshot-safety-copy; }
                    ActionRow { Rectangle { horizontal-stretch: 1; } AppButton { text: GuiI18n.text("gui-cancel"); clicked => { root.modal = ""; } } AppButton { text: GuiI18n.text("gui-snapshot-restore"); tone: "danger"; clicked => { root.modal = ""; root.restore-snapshot(root.snapshot-host-kind, root.snapshot-host-id, root.snapshot-action-id, root.snapshot-safety-copy); } } }
                }
                if root.modal == "snapshot-rename" : VerticalLayout { spacing: 14px;
                    BodyText { text: GuiI18n.text("gui-snapshot-rename-detail"); wrap: word-wrap; }
                    FieldLabel { text: GuiI18n.text("gui-snapshot-label"); }
                    TextField { text <=> root.snapshot-action-label; accessible-name: GuiI18n.text("gui-snapshot-label"); }
                    ActionRow { Rectangle { horizontal-stretch: 1; } AppButton { text: GuiI18n.text("gui-cancel"); clicked => { root.modal = ""; } } AppButton { text: GuiI18n.text("gui-rename"); tone: "primary"; enabled: root.snapshot-action-label != ""; hint: GuiI18n.text("gui-hint-enter-name"); clicked => { root.modal = ""; root.rename-snapshot(root.snapshot-host-kind, root.snapshot-host-id, root.snapshot-action-id, root.snapshot-action-label); } } }
                }
                if root.modal == "snapshot-delete" : VerticalLayout { spacing: 14px;
                    BodyText { text: GuiI18n.value("gui-snapshot-delete-detail", root.snapshot-action-label); color: Theme.warning; wrap: word-wrap; }
                    BodyText { text: GuiI18n.text("gui-snapshot-delete-note"); wrap: word-wrap; }
                    ActionRow { Rectangle { horizontal-stretch: 1; } AppButton { text: GuiI18n.text("gui-cancel"); clicked => { root.modal = ""; } } AppButton { text: GuiI18n.text("gui-delete"); tone: "danger"; clicked => { root.modal = ""; root.delete-snapshot(root.snapshot-host-kind, root.snapshot-host-id, root.snapshot-action-id); } } }
                }
                if root.modal == "delete-mod" : VerticalLayout { spacing: 14px; BodyText { text: GuiI18n.value(root.mod-action-is-hand-placed ? "gui-delete-mod-detail" : "gui-delete-restorable-mod-detail", root.pending-action-name); color: Theme.warning; wrap: word-wrap; } BodyText { text: GuiI18n.text(root.mod-action-is-hand-placed ? "gui-delete-mod-note" : "gui-delete-restorable-mod-note"); wrap: word-wrap; } if root.modal-error != "" : BodyText { text: root.modal-error; color: Theme.danger; wrap: word-wrap; } ActionRow { Rectangle { horizontal-stretch: 1; } AppButton { text: GuiI18n.text("gui-cancel"); clicked => { root.modal = ""; root.modal-error = ""; } } AppButton { text: GuiI18n.text("gui-delete"); tone: "danger"; clicked => { root.delete-hand-placed-mod(root.pending-action-kind, root.pending-action-id, root.mod-action-path); } } } }
                if root.modal == "mod-stand-in" : VerticalLayout { spacing: 14px; BodyText { text: root.mod-stand-in-detail; color: Theme.warning; wrap: word-wrap; } BodyText { text: root.mod-stand-in-note; wrap: word-wrap; } ActionRow { Rectangle { horizontal-stretch: 1; } AppButton { text: GuiI18n.text("gui-cancel"); clicked => { root.answer-mod-stand-in(root.mod-stand-in-id, false); } } AppButton { text: GuiI18n.text("gui-mod-stand-in-accept"); tone: "primary"; clicked => { root.answer-mod-stand-in(root.mod-stand-in-id, true); } } } }
                if root.modal == "storage-cleanup" : VerticalLayout {
                    spacing: 12px;
                    vertical-stretch: 1;
                    ScrollView {
                        viewport-width: self.width;
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: 10px;
                            Heading { text: root.storage-plan-summary; font-size: Theme.row-heading-size; wrap: word-wrap; }
                            if root.storage-plan-empty : BodyText { text: GuiI18n.text("gui-storage-cleanup-empty"); wrap: word-wrap; }
                            for item in root.storage-plan-items : Rectangle {
                                border-radius: 8px;
                                border-width: 1px;
                                border-color: Theme.border;
                                background: Theme.surface;
                                height: plan-item-body.preferred-height;
                                plan-item-body := VerticalLayout {
                                    padding: 12px;
                                    spacing: 4px;
                                    HorizontalLayout {
                                        spacing: 10px;
                                        Heading { text: item.label; font-size: Theme.row-heading-size; horizontal-stretch: 1; }
                                        BodyText { text: item.size; vertical-alignment: center; }
                                    }
                                    for line in item.lines : BodyText { text: line; wrap: word-wrap; }
                                    BodyText { text: item.detail; color: Theme.text-secondary; wrap: word-wrap; }
                                    for example in item.examples : BodyText { text: example; color: Theme.text-muted; font-size: Theme.caption-size; wrap: word-wrap; }
                                }
                            }
                            if root.storage-plan-kept.length > 0 : Heading { text: GuiI18n.text("gui-storage-cleanup-kept"); font-size: Theme.row-heading-size; }
                            for kept in root.storage-plan-kept : BodyText { text: kept; color: Theme.text-secondary; wrap: word-wrap; }
                            if root.storage-plan-incomplete : BodyText { text: GuiI18n.text("gui-storage-cleanup-incomplete"); color: Theme.warning; wrap: word-wrap; }
                            BodyText { text: GuiI18n.text("gui-storage-cleanup-protected"); color: Theme.text-muted; wrap: word-wrap; }
                        }
                    }
                    ActionRow {
                        Rectangle { horizontal-stretch: 1; }
                        AppButton { text: GuiI18n.text("gui-cancel"); clicked => { root.modal = ""; } }
                        AppButton { text: root.storage-plan-confirm; tone: "danger"; enabled: !root.storage-plan-empty; hint: GuiI18n.text("gui-storage-cleanup-empty"); clicked => { root.confirm-storage-cleanup(root.storage-plan-id); root.modal = ""; } }
                    }
                }
                if root.modal == "remove-java-runtime" : VerticalLayout { spacing: 14px; BodyText { text: GuiI18n.value("gui-java-remove-runtime-detail", root.pending-action-name); color: Theme.warning; wrap: word-wrap; } BodyText { text: root.pending-action-id; color: Theme.text-muted; wrap: word-wrap; } if root.pending-java-pinning != "" : BodyText { text: GuiI18n.value("gui-java-remove-runtime-pinned", root.pending-java-pinning); color: Theme.warning; wrap: word-wrap; } if !root.pending-java-pins-known : BodyText { text: GuiI18n.text("gui-java-remove-runtime-pins-unknown"); color: Theme.warning; wrap: word-wrap; } BodyText { text: GuiI18n.text("gui-java-remove-runtime-note"); wrap: word-wrap; } if root.modal-error != "" : BodyText { text: root.modal-error; color: Theme.danger; wrap: word-wrap; } ActionRow { Rectangle { horizontal-stretch: 1; } AppButton { text: GuiI18n.text("gui-cancel"); clicked => { root.modal = ""; root.modal-error = ""; } } AppButton { text: GuiI18n.text("gui-remove"); tone: "danger"; clicked => { root.remove-java-runtime(root.pending-action-id); root.modal = ""; root.modal-error = ""; } } } }
                if root.modal == "mod-clash" && root.mod-clash-index < root.mod-clashes.length : VerticalLayout { spacing: 14px; BodyText { text: GuiI18n.value("gui-mod-clash-detail", root.mod-clashes[root.mod-clash-index].file-name); wrap: word-wrap; } if root.mod-clashes[root.mod-clash-index].existing-is-disabled : BodyText { text: GuiI18n.text("gui-mod-clash-disabled"); color: Theme.warning; wrap: word-wrap; } if root.mod-clashes[root.mod-clash-index].existing-is-recorded : BodyText { text: GuiI18n.text("gui-mod-clash-recorded"); color: Theme.warning; wrap: word-wrap; } if root.mod-clashes.length > 1 : BodyText { text: GuiI18n.values("gui-mod-clash-progress", root.mod-clash-index + 1, root.mod-clashes.length); color: Theme.text-muted; font-size: Theme.caption-size; } ActionRow { AppButton { text: GuiI18n.text("gui-skip-all"); clicked => { root.resolve-mod-clash("skip-all"); } } AppButton { text: GuiI18n.text("gui-overwrite-all"); clicked => { root.resolve-mod-clash("overwrite-all"); } } Rectangle { horizontal-stretch: 1; } AppButton { text: GuiI18n.text("gui-skip"); clicked => { root.resolve-mod-clash("skip"); } } AppButton { text: GuiI18n.text("gui-overwrite"); tone: "primary"; clicked => { root.resolve-mod-clash("overwrite"); } } } }
                if root.modal == "pane-host" : VerticalLayout { spacing: 12px;
                    TextField { text <=> root.pane-host-query; placeholder: GuiI18n.text("gui-filter-hosts"); input-type: InputType.search; edited(text) => { root.pane-host-query-changed(); } }
                    ScrollView {
                        viewport-width: self.visible-width;
                        VerticalLayout {
                            alignment: start; spacing: 8px;
                            Eyebrow { text: GuiI18n.text("gui-instances"); }
                            if root.workspace-client-choices.length == 0 : BodyText { text: GuiI18n.text("gui-pane-host-no-clients"); color: Theme.text-muted; wrap: word-wrap; }
                            for choice in root.workspace-client-choices : HostPickerCard {
                                item: choice; current-kind: root.pane-host-picker-kind; current-id: root.pane-host-picker-id;
                                picked(kind, id) => { root.modal = ""; root.choose-pane-host(root.pane-host-picker-pane, kind, id); }
                            }
                            Rectangle { height: 6px; }
                            Eyebrow { text: GuiI18n.text("gui-servers"); }
                            if root.workspace-server-choices.length == 0 : BodyText { text: GuiI18n.text("gui-pane-host-no-servers"); color: Theme.text-muted; wrap: word-wrap; }
                            for choice in root.workspace-server-choices : HostPickerCard {
                                item: choice; current-kind: root.pane-host-picker-kind; current-id: root.pane-host-picker-id;
                                picked(kind, id) => { root.modal = ""; root.choose-pane-host(root.pane-host-picker-pane, kind, id); }
                            }
                        }
                    }
                    ActionRow { Rectangle { horizontal-stretch: 1; } AppButton { text: GuiI18n.text("gui-cancel"); clicked => { root.modal = ""; } } }
                }
                if root.modal == "open-pack-link" : VerticalLayout { spacing: 14px;
                    BodyText { text: root.pack-link-downloading ? GuiI18n.text("gui-downloading-pack") : root.pack-link-redirected ? GuiI18n.text("gui-open-pack-link-redirected-detail") : GuiI18n.text("gui-open-pack-link-detail"); wrap: word-wrap; }
                    // The address itself, on its own line and selectable by
                    // eye: this is the thing being agreed to.
                    Rectangle { border-radius: 6px; border-width: 1px; border-color: Theme.border; background: Theme.background; VerticalLayout { padding: 12px; BodyText { text: root.pack-link-display; font-family: Theme.mono-family; wrap: word-wrap; } } }
                    if !root.pack-link-downloading : HorizontalLayout { spacing: 8px; VerticalLayout { alignment: center; Toggle { checked: root.pack-link-remember; accessible-name: GuiI18n.text("gui-open-pack-link-remember"); toggled(on) => { root.pack-link-remember = on; } } } BodyText { text: GuiI18n.text("gui-open-pack-link-remember"); vertical-alignment: center; } }
                    if root.modal-error != "" : BodyText { text: root.modal-error; color: Theme.danger; wrap: word-wrap; }
                    ActionRow { Rectangle { horizontal-stretch: 1; } AppButton { text: GuiI18n.text("gui-cancel"); clicked => { root.cancel-pack-link(); root.modal = ""; root.modal-error = ""; } } if !root.pack-link-downloading : AppButton { text: GuiI18n.text("gui-open-pack-link-confirm"); tone: "primary"; clicked => { root.open-pack-link(root.pack-link-url, root.pack-link-host, root.pack-link-remember); } } }
                }
                if root.modal == "make-persistent" : VerticalLayout { spacing: 14px;
                    BodyText { text: GuiI18n.value("gui-make-persistent-detail", root.promote-instance-name); wrap: word-wrap; }
                    // The exact destination, because a user who set their
                    // own persistent instance folder wants to see it.
                    BodyText { text: root.promote-destination; color: Theme.text-muted; font-size: Theme.caption-size; wrap: word-wrap; }
                    if root.promote-servers.length > 0 : BodyText { text: GuiI18n.count("gui-make-persistent-servers", root.promote-servers.length); wrap: word-wrap; }
                    if root.promote-servers.length > 0 : ScrollView {
                        viewport-width: self.width;
                        height: min(root.promote-servers.length * 28px, 168px);
                        vertical-stretch: 0;
                        VerticalLayout {
                            for server[index] in root.promote-servers : HorizontalLayout {
                                spacing: 8px;
                                height: 28px;
                                Toggle {
                                    checked: server.selected;
                                    accessible-name: server.display;
                                    toggled(on) => { root.promote-servers[index].selected = on; }
                                }
                                BodyText { text: server.display; overflow: elide; vertical-alignment: center; }
                            }
                        }
                    }
                    if root.modal-error != "" : BodyText { text: root.modal-error; color: Theme.danger; wrap: word-wrap; }
                    ActionRow { Rectangle { horizontal-stretch: 1; } AppButton { text: GuiI18n.text("gui-cancel"); clicked => { root.modal = ""; root.modal-error = ""; } } AppButton { text: GuiI18n.text("gui-make-persistent-confirm"); tone: "primary"; clicked => { root.submit-make-persistent(root.pending-action-id); } } }
                }
                if root.modal == "absent-mods" : VerticalLayout { spacing: 14px; BodyText { text: GuiI18n.count("gui-absent-mods-detail", root.absent-mods.length); wrap: word-wrap; } ScrollView { height: min(140px, root.absent-mods.length * 22px); vertical-stretch: 0; viewport-width: self.width; VerticalLayout { spacing: 2px; for name in root.absent-mods : BodyText { text: "\u{2022} " + name; color: Theme.text-secondary; font-size: Theme.caption-size; overflow: elide; } } } BodyText { text: GuiI18n.text("gui-absent-mods-note"); color: Theme.text-muted; font-size: Theme.caption-size; wrap: word-wrap; } ActionRow { Rectangle { horizontal-stretch: 1; } AppButton { text: GuiI18n.text("gui-cancel"); clicked => { root.modal = ""; } } AppButton { text: GuiI18n.text("gui-copy-without-them"); clicked => { root.duplicate-client-deciding(root.pending-action-id, true); } } AppButton { text: GuiI18n.text("gui-copy-with-them"); tone: "primary"; clicked => { root.duplicate-client-deciding(root.pending-action-id, false); } } } }
                if root.modal == "delete-instance" || root.modal == "delete-server" : VerticalLayout { spacing: 14px; BodyText { text: GuiI18n.value(root.modal == "delete-instance" ? "gui-delete-instance-detail" : "gui-delete-server-detail", root.pending-action-name); color: Theme.warning; wrap: word-wrap; } BodyText { text: GuiI18n.text("gui-delete-choice-detail"); wrap: word-wrap; } BodyText { text: root.pending-snapshot-deletion-note; color: Theme.warning; wrap: word-wrap; } if root.modal == "delete-instance" && root.pending-action-linked-servers > 0 : BodyText { text: GuiI18n.count("gui-delete-instance-linked", root.pending-action-linked-servers); color: Theme.warning; wrap: word-wrap; } if root.modal == "delete-instance" && root.pending-deletion-stops-servers : BodyText { text: GuiI18n.count("gui-delete-instance-stops-servers", root.pending-action-stoppable-linked-servers); color: Theme.warning; wrap: word-wrap; } if root.modal == "delete-instance" && root.pending-action-unstoppable-linked-servers > 0 : BodyText { text: GuiI18n.count("gui-delete-instance-unstoppable-servers", root.pending-action-unstoppable-linked-servers); color: Theme.danger; wrap: word-wrap; } if root.modal-error != "" : BodyText { text: root.modal-error; color: Theme.danger; wrap: word-wrap; } ActionRow { Rectangle { horizontal-stretch: 1; } AppButton { text: GuiI18n.text("gui-cancel"); clicked => { root.modal = ""; root.modal-error = ""; } } AppButton { text: GuiI18n.text(root.modal == "delete-instance" && root.pending-deletion-stops-servers ? "gui-stop-and-keep-files" : "gui-remove-from-ephervex"); clicked => { if root.modal == "delete-instance" { root.delete-client(root.pending-action-id, false, root.pending-deletion-stops-servers); } else { root.delete-server(root.pending-action-id, false); } } } AppButton { text: GuiI18n.text(root.modal == "delete-instance" && root.pending-deletion-stops-servers ? "gui-stop-and-delete-files" : "gui-delete-files"); tone: "danger"; clicked => { if root.modal == "delete-instance" { root.delete-client(root.pending-action-id, true, root.pending-deletion-stops-servers); } else { root.delete-server(root.pending-action-id, true); } } } } }
                if root.modal == "theme-problems" : VerticalLayout {
                    spacing: 14px;
                    BodyText { text: GuiI18n.value("gui-theme-problems-detail", root.themes-folder); wrap: word-wrap; }
                    ScrollView {
                        vertical-stretch: 1;
                        viewport-width: self.width;
                        viewport-height: theme-problem-list.preferred-height;
                        theme-problem-list := VerticalLayout {
                            alignment: start;
                            spacing: 8px;
                            for problem in root.theme-problems : BodyText { text: problem; color: Theme.text-secondary; wrap: word-wrap; }
                        }
                    }
                    ActionRow { Rectangle { horizontal-stretch: 1; } AppButton { text: GuiI18n.text("gui-close"); clicked => { root.modal = ""; } } }
                }
                if root.modal == "license" : ScrollView {
                    vertical-stretch: 1;
                    viewport-width: self.width;
                    // Without the content's own height the viewport keeps the ScrollView's, and a longer text is centered in it rather than scrolled from the top.
                    viewport-height: ephervex-license.preferred-height;
                    ephervex-license := HorizontalLayout {
                        alignment: center;
                        Text { text: root.license-text; color: Theme.text-secondary; font-family: Theme.mono-family; font-size: Theme.label-size; wrap: word-wrap; }
                    }
                }
                if root.modal == "third-party" && root.third-party-open < 0 : VerticalLayout {
                    spacing: 12px;
                    if root.third-party-error != "" : BodyText { text: root.third-party-error; color: Theme.danger; wrap: word-wrap; }
                    if root.third-party-error == "" : BodyText { text: root.third-party-summary; }
                    if root.third-party-error == "" : BodyText { text: GuiI18n.text("gui-third-party-select"); color: Theme.text-muted; font-size: Theme.caption-size; wrap: word-wrap; }
                    if root.third-party-error == "" : ListView {
                        vertical-stretch: 1;
                        for package[index] in root.third-party-packages : Rectangle {
                            height: Theme.license-row-height;
                            background: touch.has-hover ? Theme.selection : transparent;
                            border-radius: 4px;
                            touch := TouchArea {
                                // The whole row, because a list read with
                                // the eyes is pointed at with the mouse.
                                clicked => { root.third-party-open = index; }
                            }
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 10px;
                                BodyText { text: package.name; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                                BodyText { text: package.version; color: Theme.text-secondary; font-size: Theme.caption-size; vertical-alignment: center; }
                                BodyText { text: package.license; color: Theme.text-muted; font-size: Theme.caption-size; vertical-alignment: center; overflow: elide; width: 180px; horizontal-alignment: right; }
                            }
                        }
                    }
                    // Attribution itself, which the royalty-free license
                    // Ephervex uses Slint under asks for on this screen.
                    BodyText { text: GuiI18n.text("gui-slint-attribution"); color: Theme.text-muted; font-size: Theme.caption-size; wrap: word-wrap; }
                    if root.third-party-error == "" : BodyText { text: GuiI18n.text("gui-third-party-note"); color: Theme.text-muted; font-size: Theme.caption-size; wrap: word-wrap; }
                    ActionRow { Rectangle { horizontal-stretch: 1; } AppButton { text: GuiI18n.text("gui-close"); tone: "primary"; clicked => { root.modal = ""; } } }
                }
                if root.modal == "third-party" && root.third-party-open >= 0 : VerticalLayout {
                    spacing: 12px;
                    ScrollView {
                        vertical-stretch: 1;
                        // A dependency's license file is not hard-wrapped
                        // the way Ephervex's own LICENSE is, so the text
                        // has to be given the viewport's width to wrap
                        // against. Without it the paragraph takes its
                        // natural width and the reader scrolls sideways
                        // through every line.
                        viewport-width: self.width;
                        // And its height, or the viewport keeps the ScrollView's and centers a longer license in it instead of scrolling from the top.
                        viewport-height: third-party-license.preferred-height;
                        third-party-license := Text { text: root.third-party-packages[root.third-party-open].text; width: parent.width; color: Theme.text-secondary; font-family: Theme.mono-family; font-size: Theme.label-size; wrap: word-wrap; }
                    }
                    ActionRow { AppButton { text: GuiI18n.text("gui-third-party-back"); clicked => { root.third-party-open = -1; } } Rectangle { horizontal-stretch: 1; } AppButton { text: GuiI18n.text("gui-close"); tone: "primary"; clicked => { root.modal = ""; } } }
                }
            }
        }
    }

    dialog-end := FocusEdge { active: root.modal != ""; }
    FocusEdge { active: root.modal != ""; reached => { dialog-start.focus(); } }
    HoverNoteLayer { width: root.width; height: root.height; }
}
