    callback add-offline-account(string);
    callback set-default-account(string);
    callback remove-account(string);
    callback begin-microsoft-login();
    // The code and address the pending Microsoft sign-in waits for, shown in the
    // sign-in dialog. The address is only offered to the browser when it is a
