// The design tokens every other module paints and sizes with.

import { BuiltInPalettes, ThemePalette } from "palettes.slint";

export global Theme {
    in-out property <float> text-scale: 1;
    // The palette every color below reads, chosen from the user's
    // preference. Components read the tokens, never the palette.
    in-out property <ThemePalette> palette: BuiltInPalettes.dark;
    // The scheme the shipped widgets paint in to match.
    out property <ColorScheme> widget-scheme: palette.widget-scheme;
    // The fixed-width family this machine actually has, resolved once at
    // startup. `font-family` is matched as a literal family name, so the
    // generic "monospace" written here matches nothing and only stands
    // until the real name is set. See the `monospace` module.
    in-out property <string> mono-family: "monospace";
    out property <length> caption-size: 11px * text-scale;
    out property <length> label-size: 12px * text-scale;
    out property <length> body-size: 13px * text-scale;
    out property <length> row-heading-size: 14px * text-scale;
    out property <length> section-size: 16px * text-scale;
    out property <length> heading-size: 17px * text-scale;
    out property <length> item-title-size: 18px * text-scale;
    out property <length> brand-size: 20px * text-scale;
    out property <length> workspace-title-size: 23px * text-scale;
    out property <length> about-title-size: 24px * text-scale;
    out property <length> diagnostics-title-size: 25px * text-scale;
    out property <length> page-title-size: 27px * text-scale;
    out property <length> readout-size: 32px * text-scale;
    out property <color> background: palette.background;
    out property <color> surface: palette.surface;
    out property <color> elevated: palette.elevated;
    // One step past `elevated`, for a popover that has to read against
    // whatever is behind it - including a card that is `elevated` itself
    // because hovering it is what raised the popover.
    out property <color> overlay: palette.overlay;
    out property <color> border: palette.border;
    // One step under `background`, for the chrome that frames a page:
    // the top bar, the navigation column and the status bar.
    out property <color> bar: palette.bar;
    // The floor a technical view is read against - a console, a crash
    // report, a log file - held apart from `background` so a page and the
    // output on it are never the same surface.
    out property <color> well: palette.well;
    // A selected row, the card form of the same, and the stronger tint a
    // selected chip takes.
    out property <color> selection: palette.selection;
    out property <color> selection-card: palette.selection-card;
    out property <color> selection-strong: palette.selection-strong;
    // The track of a switch that is on, and the fill of a binding editor
    // waiting for a key. Both are an accent held far enough back that what
    // sits on them stays readable.
    out property <color> toggle-on: palette.toggle-on;
    out property <color> capture-active: palette.capture-active;
    out property <color> accent: palette.accent;
    out property <color> accent-secondary: palette.accent-secondary;
    out property <color> success: palette.success;
    out property <color> warning: palette.warning;
    out property <color> danger: palette.danger;
    // The filled tones a primary or destructive button is drawn in, and
    // what each becomes under the pointer. Kept here rather than derived,
    // because a fill has to stay legible under its own caption and an
    // alpha over the surface behind it does not.
    out property <color> primary-fill: palette.primary-fill;
    out property <color> primary-fill-hover: palette.primary-fill-hover;
    out property <color> danger-fill: palette.danger-fill;
    out property <color> danger-fill-hover: palette.danger-fill-hover;
    out property <color> text: palette.text;
    out property <color> text-secondary: palette.text-secondary;
    out property <color> text-muted: palette.text-muted;
    // A caption on a filled destructive button, which `text` is not quite
    // bright enough to carry.
    out property <color> on-danger: palette.on-danger;
    // An error line in a console. `danger` is a border and a button tone;
    // a page of fixed-width text needs it lifted to stay readable.
    out property <color> log-error: palette.log-error;
    out property <color> server: palette.server;
    // The two mod catalogs, in their own brand colors, so a row says which
    // one a mod came from without being read.
    out property <color> modrinth: palette.modrinth;
    out property <color> curseforge: palette.curseforge;
    // The game's own grass, at the color a plains biome tints it.
    out property <color> vanilla: palette.vanilla;
    // The two loaders in their own marks' colors, the same way the two
    // catalogs above are. NeoForge is the rust its fox is drawn in. Forge's
    // anvil sits on a navy so dark (#1e2d44) that it disappears against
    // this background, so its own hue is kept and lifted into the range the
    // rest of this palette works in.
    out property <color> forge: palette.forge;
    out property <color> neoforge: palette.neoforge;
    // What is drawn over the window rather than in it: a popover's shadow
    // and the wash that puts a modal in front of everything else.
    out property <color> shadow: palette.shadow;
    out property <color> scrim: palette.scrim;
    // Every control that can share a toolbar row is this tall, so a row
    // that mixes a button, a chip and a field lines up without each caller
    // having to know what the others chose.
    out property <length> control-height: 36px;
    // The primary navigation column. Named because the page bodies beside
    // it have to know how much of the window is left.
    out property <length> sidebar-width: 218px;
    // One entity card's height and the gap under it. Named because the
    // cards and the arithmetic that scrolls one into view have to agree,
    // and a list of fixed-height rows is the only reason that arithmetic
    // can be written at all.
    out property <length> card-height: 112px;
    out property <length> card-gap: 12px;
    // One dependency's row in the third-party license list. Named because a
    // ListView of several hundred rows only virtualizes when every row is
    // the same declared height, so the row and the list have to agree.
    out property <length> license-row-height: 30px;
    // The smallest a pane of a split workspace is drawn. Below it the
    // panes scroll together instead of overlapping or squeezing their
    // headers, and the pane geometry arithmetic reads the same numbers.
    out property <length> workspace-pane-min-width: 360px;
    out property <length> workspace-pane-min-height: 260px;
    // One host surface tab. Every tab is this wide so a tab bar can tell
    // how many fit before the rest move under More.
    out property <length> workspace-tab-width: 112px * text-scale;
}
